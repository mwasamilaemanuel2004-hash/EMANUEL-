    def _calc_rsi(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        period = config.params.get('period', 14)
        close = data.get('close', [])
        if len(close) < period + 1:
            return 50, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        gains, losses = [], []
        for i in range(1, len(close)):
            change = close[i] - close[i-1]
            gains.append(change if change > 0 else 0)
            losses.append(abs(change) if change < 0 else 0)
        
        avg_gain = sum(gains[-period:]) / period if period > 0 else 1
        avg_loss = sum(losses[-period:]) / period if period > 0 else 1
        
        rsi = 100 - (100 / (1 + avg_gain / avg_loss)) if avg_loss > 0 else 100
        
        oversold = self.adaptive_params.get('rsi_oversold', 30)
        overbought = self.adaptive_params.get('rsi_overbought', 70)
        
        if rsi < oversold:
            signal, confidence = "BUY", min(95, 80 + (oversold - rsi) / max(oversold, 1) * 20)
        elif rsi > overbought:
            signal, confidence = "SELL", min(95, 80 + (rsi - overbought) / (100 - overbought) * 20)
        else:
            signal, confidence = "NEUTRAL", 50
        
        return rsi, signal, confidence, {'rsi': rsi}
    
    def _calc_rsi_fast(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
