    def _calc_adx(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        period = config.params.get('period', 14)
        high, low, close = data.get('high', []), data.get('low', []), data.get('close', [])
        if len(close) < period * 2:
            return 25, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        adx_threshold = self.adaptive_params.get('adx_threshold', 25)
        
        tr = []
        for i in range(1, len(close)):
            tr.append(max(high[i] - low[i], abs(high[i] - close[i-1]), abs(low[i] - close[i-1])))
        
        atr = sum(tr[-period:]) / period if period > 0 else 1
        
        plus_dm, minus_dm = [], []
        for i in range(1, len(high)):
            up, down = high[i] - high[i-1], low[i-1] - low[i]
            plus_dm.append(up if up > down and up > 0 else 0)
            minus_dm.append(down if down > up and down > 0 else 0)
        
        plus_smoothed = sum(plus_dm[-period:]) / period if period > 0 else 1
        minus_smoothed = sum(minus_dm[-period:]) / period if period > 0 else 1
        
        plus_di = 100 * plus_smoothed / atr if atr > 0 else 0
        minus_di = 100 * minus_smoothed / atr if atr > 0 else 0
        dx = 100 * abs(plus_di - minus_di) / (plus_di + minus_di) if (plus_di + minus_di) > 0 else 0
        adx = dx
        
        if adx > adx_threshold:
            signal, confidence = ("BUY", min(95, 70 + adx / 100 * 30)) if plus_di > minus_di else ("SELL", min(95, 70 + adx / 100 * 30))
        else:
            signal, confidence = "NEUTRAL", 50
        
        return adx, signal, confidence, {'adx': adx, 'plus_di': plus_di, 'minus_di': minus_di}
    
    def _calc_macd(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        fast, slow, signal_period = config.params.get('fast', 12), config.params.get('slow', 26), config.params.get('signal', 9)
        close = data.get('close', [])
        if len(close) < slow + signal_period:
            return 0, "NEUTRAL", 0, {'error': 'Insufficient data'}
        
        def ema(arr, period):
            if len(arr) < period: return arr
            mult = 2 / (period + 1)
            ema_vals = [arr[0]]
            for val in arr[1:]:
                ema_vals.append((val - ema_vals[-1]) * mult + ema_vals[-1])
            return ema_vals
        
        fast_ema = ema(close, fast)
        slow_ema = ema(close, slow)
        macd_line = [fast_ema[i] - slow_ema[i] for i in range(len(fast_ema))]
        signal_line = ema(macd_line, signal_period)
        histogram = [macd_line[i] - signal_line[i] for i in range(len(macd_line))]
        
        current_hist = histogram[-1] if histogram else 0
        prev_hist = histogram[-2] if len(histogram) > 1 else current_hist
        
        if current_hist > 0 and prev_hist < 0:
            signal, confidence = "BUY", 75
        elif current_hist < 0 and prev_hist > 0:
            signal, confidence = "SELL", 75
        elif current_hist > 0:
            signal, confidence = "BUY", 65
        elif current_hist < 0:
            signal, confidence = "SELL", 65
        else:
            signal, confidence = "NEUTRAL", 50
        
        return macd_line[-1] if macd_line else 0, signal, confidence, {'histogram': current_hist}
    
    def _calc_supertrend(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        period = config.params.get('period', 10)
        multiplier = config.params.get('multiplier', 3.0)
        high, low, close = data.get('high', []), data.get('low', []), data.get('close', [])
        if len(close) < period:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        market_multiplier = self.adaptive_params.get('supertrend_multiplier', multiplier)
        
        tr = []
        for i in range(1, len(close)):
            tr.append(max(high[i] - low[i], abs(high[i] - close[i-1]), abs(low[i] - close[i-1])))
        atr = sum(tr[-period:]) / period if period > 0 else 1
        
        hl2 = (high[-1] + low[-1]) / 2
        upper = hl2 + market_multiplier * atr
        lower = hl2 - market_multiplier * atr
        
        if close[-1] > upper:
            signal, confidence = "BUY", 70
            direction = "up"
        elif close[-1] < lower:
            signal, confidence = "SELL", 70
            direction = "down"
        else:
            signal, confidence = "NEUTRAL", 50
            direction = "neutral"
        
        return close[-1], signal, confidence, {'upper': upper, 'lower': lower, 'direction': direction}
    
    def _calc_ichimoku(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        tenkan, kijun, senkou = config.params.get('tenkan', 9), config.params.get('kijun', 26), config.params.get('senkou', 52)
        high, low, close = data.get('high', []), data.get('low', []), data.get('close', [])
        if len(close) < senkou:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        tenkan_high = max(high[-tenkan:]) if len(high) >= tenkan else high[-1]
        tenkan_low = min(low[-tenkan:]) if len(low) >= tenkan else low[-1]
        tenkan_line = (tenkan_high + tenkan_low) / 2
        
        kijun_high = max(high[-kijun:]) if len(high) >= kijun else high[-1]
        kijun_low = min(low[-kijun:]) if len(low) >= kijun else low[-1]
        kijun_line = (kijun_high + kijun_low) / 2
        
        senkou_a = (tenkan_line + kijun_line) / 2
        senkou_high = max(high[-senkou:]) if len(high) >= senkou else high[-1]
        senkou_low = min(low[-senkou:]) if len(low) >= senkou else low[-1]
        senkou_b = (senkou_high + senkou_low) / 2
        
        cloud_top = max(senkou_a, senkou_b)
        cloud_bottom = min(senkou_a, senkou_b)
        current_price = close[-1]
        
        if current_price > cloud_top and tenkan_line > kijun_line:
            signal, confidence = "BUY", 75
        elif current_price < cloud_bottom and tenkan_line < kijun_line:
            signal, confidence = "SELL", 75
        elif current_price > cloud_top:
            signal, confidence = "BUY", 65
        elif current_price < cloud_bottom:
            signal, confidence = "SELL", 65
        else:
            signal, confidence = "NEUTRAL", 50
        
        return current_price, signal, confidence, {'tenkan': tenkan_line, 'kijun': kijun_line, 'cloud_top': cloud_top, 'cloud_bottom': cloud_bottom}
    
    def _calc_parabolic_sar(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
