    # SMART MONEY INDICATORS
    # ============================================
    
    def _calc_smart_money_flow(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        period = config.params.get('period', 14)
        high, low, close, volume = data.get('high', []), data.get('low', []), data.get('close', []), data.get('volume', [])
        if len(close) < period or not volume:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        # Smart Money Flow = MFI with different thresholds
        tp = [(high[i] + low[i] + close[i]) / 3 for i in range(len(close))]
        rmf = [tp[i] * volume[i] for i in range(len(tp))]
        
        pos_flow, neg_flow = [], []
        for i in range(1, len(tp)):
            if tp[i] > tp[i-1]:
                pos_flow.append(rmf[i])
                neg_flow.append(0)
            else:
                pos_flow.append(0)
                neg_flow.append(rmf[i])
        
        pos_sum = sum(pos_flow[-period:]) if len(pos_flow) >= period else sum(pos_flow)
        neg_sum = sum(neg_flow[-period:]) if len(neg_flow) >= period else sum(neg_flow)
        smf = 100 if neg_sum == 0 else 100 - (100 / (1 + pos_sum / neg_sum)) if neg_sum > 0 else 50
        
        if smf > 80:
            signal, confidence = "SELL", 65
        elif smf < 20:
            signal, confidence = "BUY", 65
        else:
            signal, confidence = "NEUTRAL", 50
        
        return smf, signal, confidence, {'smf': smf}
    
    def _calc_dark_pool(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        sensitivity = config.params.get('sensitivity', 0.001)
        high, low, close = data.get('high', []), data.get('low', []), data.get('close', [])
        if len(close) < 20:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        # Dark pool detection - look for large price moves with low volume
        avg_volume = sum(data.get('volume', [])[-20:]) / 20 if data.get('volume') else 1
        
        if data.get('volume'):
            current_volume = data.get('volume')[-1]
        else:
            current_volume = 1
        
        price_change = abs(close[-1] - close[-2]) / close[-2] if len(close) > 1 else 0
        
        # If large price movement with low volume, likely dark pool activity
        if price_change > sensitivity and current_volume < avg_volume * 0.5:
            signal, confidence = "BUY" if close[-1] > close[-2] else "SELL", 60
        else:
            signal, confidence = "NEUTRAL", 50
        
        return close[-1], signal, confidence, {'price_change': price_change, 'volume_ratio': current_volume / avg_volume if avg_volume > 0 else 1}
    
    def _calc_institutional_flow(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        lookback = config.params.get('lookback', 10)
        high, low, close, volume = data.get('high', []), data.get('low', []), data.get('close', []), data.get('volume', [])
        if len(close) < lookback or not volume:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        # Institutional flow detection
        avg_volume = sum(volume[-lookback:]) / lookback if lookback > 0 else 1
        avg_range = sum(high[i] - low[i] for i in range(-lookback, 0)) / lookback if lookback > 0 else 1
        
        if len(close) > 0 and len(volume) > 0:
            current_volume = volume[-1]
            current_range = high[-1] - low[-1]
            
            # Large volume with small range = institutional accumulation
            if current_volume > avg_volume * 1.5 and current_range < avg_range * 0.7:
                signal, confidence = "BUY", 65
            # Large volume with large range = institutional distribution
            elif current_volume > avg_volume * 1.5 and current_range > avg_range * 1.3:
                signal, confidence = "SELL", 65
            else:
                signal, confidence = "NEUTRAL", 50
        else:
            signal, confidence = "NEUTRAL", 50
        
        return close[-1] if close else 0, signal, confidence, {'volume_ratio': current_volume / avg_volume if avg_volume > 0 else 1}
    
    # ============================================
    # COMBINED SIGNAL
    # ============================================
    
    def get_combined_signal(self, data: Dict[str, List[float]]) -> Dict:
        results = self.calculate_all(data)
        
        if not results:
            return {'signal': 'NEUTRAL', 'confidence': 0, 'details': 'No indicators calculated'}
        
        signal_values = {'STRONG_BUY': 2, 'BUY': 1, 'NEUTRAL': 0, 'SELL': -1, 'STRONG_SELL': -2}
        total_score, total_weight = 0, 0
        details = {}
        
        for name, result in results.items():
            config = self.indicators.get(name)
            if not config or not config.enabled:
                continue
            
            weight = config.weight
            if self.current_market_type.value == 'crypto':
                if name in ['RSI', 'MACD', 'SuperTrend']:
                    weight *= 0.9
                elif name in ['VWAP', 'VolumeProfile']:
                    weight *= 1.2
                elif name in ['FVG', 'OrderBlock', 'BOS']:
                    weight *= 1.1  # ICT/SMC indicators more reliable in crypto
            
            score = signal_values.get(result.signal, 0) * (result.confidence / 100)
            total_score += score * weight
            total_weight += weight
            details[name] = {'signal': result.signal, 'confidence': result.confidence, 'value': result.value}
        
        if total_weight == 0:
            return {'signal': 'NEUTRAL', 'confidence': 0, 'details': details}
        
        avg_score = total_score / total_weight
        
        if avg_score > 1.2:
            signal, confidence = 'STRONG_BUY', min(95, 70 + (avg_score - 1.2) * 20)
        elif avg_score > 0.4:
            signal, confidence = 'BUY', 60 + (avg_score - 0.4) * 25
        elif avg_score < -1.2:
            signal, confidence = 'STRONG_SELL', min(95, 70 + (-1.2 - avg_score) * 20)
        elif avg_score < -0.4:
            signal, confidence = 'SELL', 60 + (-0.4 - avg_score) * 25
        else:
            signal, confidence = 'NEUTRAL', 50
        
        return {
            'signal': signal,
            'confidence': max(5, min(95, confidence)),
            'score': avg_score,
            'details': details,
            'total_indicators': len(results),
            'market_type': self.current_market_type.value,
            'timeframe': self.current_timeframe.value,
            'timestamp': datetime.now().isoformat()
        }
    
    def update_adaptive_params(self, params: Dict):
        for key, value in params.items():
            if key in self.adaptive_params:
                self.adaptive_params[key] = value
    
    def get_adaptive_params(self) -> Dict:
        return self.adaptive_params.copy()
    
    def get_performance(self) -> Dict:
        cache_stats = self.cache.get_stats()
        return {
            'calculations': self.performance['calculations'],
            'avg_time': self.performance['avg_time'],
            'errors': self.performance['errors'],
            'active_indicators': len([i for i in self.indicators.values() if i.enabled]),
            'total_indicators': len(self.indicators),
            'current_market': self.current_market_type.value,
            'current_timeframe': self.current_timeframe.value,
            'cache_hits': cache_stats['hits'],
            'cache_misses': cache_stats['misses'],
            'cache_hit_rate': cache_stats['hit_rate'],
            'fast_path': self.performance['fast_path'],
            'slow_path': self.performance['slow_path'],
            'metrics': self.metrics
        }
    
    def get_cache_stats(self) -> Dict:
        return self.cache.get_stats()
    
    def _save_state(self):
        try:
            import os
            os.makedirs("data/indicators", exist_ok=True)
            state_data = {
                'adaptive_params': self.adaptive_params,
                'performance': self.performance,
                'indicator_states': {name: {'enabled': config.enabled, 'weight': config.weight} for name, config in self.indicators.items()}
            }
            with open("data/indicators/state.json", "w") as f:
                json.dump(state_data, f, indent=2)
        except Exception as e:
            logger.error(f"Save state error: {e}")
    
    def _load_state(self):
        try:
            import os
            state_file = "data/indicators/state.json"
            if os.path.exists(state_file):
                with open(state_file, "r") as f:
                    state_data = json.load(f)
                    self.adaptive_params = state_data.get('adaptive_params', self.adaptive_params)
                    self.performance = state_data.get('performance', self.performance)
                    for name, state in state_data.get('indicator_states', {}).items():
                        if name in self.indicators:
                            self.indicators[name].enabled = state.get('enabled', True)
                            self.indicators[name].weight = state.get('weight', 1.0)
                    logger.info("📂 Indicator engine state loaded")
        except Exception as e:
            logger.warning(f"Load state error (starting fresh): {e}")