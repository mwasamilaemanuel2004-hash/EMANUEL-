    def _calc_ema(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        period = config.params.get('period', 20)
        price_key = config.params.get('price', 'close')
        close = data.get(price_key, [])
        if len(close) < period:
            return 0, "NEUTRAL", 0, {'error': 'Insufficient data'}
        
        multiplier = 2 / (period + 1)
        ema = [close[0]]
        for i in range(1, len(close)):
            ema.append((close[i] - ema[-1]) * multiplier + ema[-1])
        
        current_ema = ema[-1]
        prev_ema = ema[-2] if len(ema) > 1 else current_ema
        current_price = close[-1]
        
        if current_price > current_ema and current_ema > prev_ema:
            signal, confidence = "BUY", min(90, 65 + (current_price - current_ema) / max(current_ema, 0.001) * 50)
        elif current_price < current_ema and current_ema < prev_ema:
            signal, confidence = "SELL", min(90, 65 + (current_ema - current_price) / max(current_price, 0.001) * 50)
        else:
            signal, confidence = "NEUTRAL", 50
        
        return current_ema, signal, confidence, {'period': period}
    
    def _calc_ema_fast(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
