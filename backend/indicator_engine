    def _calc_vwap(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        high, low, close, volume = data.get('high', []), data.get('low', []), data.get('close', []), data.get('volume', [])
        if len(close) < 1 or not volume:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        tp = [(high[i] + low[i] + close[i]) / 3 for i in range(len(close))]
        cum_tp_vol = sum(tp[i] * volume[i] for i in range(len(tp)))
        cum_vol = sum(volume)
        vwap = cum_tp_vol / cum_vol if cum_vol > 0 else 0
        current_price = close[-1]
        
        threshold = 0.005 if self.current_market_type.value == 'crypto' else 0.003
        
        if current_price > vwap * (1 + threshold):
            signal, confidence = "BUY", 65
        elif current_price < vwap * (1 - threshold):
            signal, confidence = "SELL", 65
        else:
            signal, confidence = "NEUTRAL", 50
        
        return vwap, signal, confidence, {'vwap': vwap}
    
    def _calc_obv(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        close, volume = data.get('close', []), data.get('volume', [])
        if len(close) < 2 or not volume:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        obv = [volume[0]]
        for i in range(1, len(close)):
            if close[i] > close[i-1]:
                obv.append(obv[-1] + volume[i])
            elif close[i] < close[i-1]:
                obv.append(obv[-1] - volume[i])
            else:
                obv.append(obv[-1])
        
        current_obv = obv[-1]
        prev_obv = obv[-2] if len(obv) > 1 else current_obv
        
        if current_obv > prev_obv:
            signal, confidence = "BUY", 60
        elif current_obv < prev_obv:
            signal, confidence = "SELL", 60
        else:
            signal, confidence = "NEUTRAL", 50
        
        return current_obv, signal, confidence, {'obv': current_obv}
    
    def _calc_mfi(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        period = config.params.get('period', 14)
        high, low, close, volume = data.get('high', []), data.get('low', []), data.get('close', []), data.get('volume', [])
        if len(close) < period + 1 or not volume:
            return 50, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        tp = [(high[i] + low[i] + close[i]) / 3 for i in range(len(close))]
        rmf = [tp[i] * volume[i] for i in range(len(tp))]
        pos_flow, neg_flow = [], []
        
        for i in range(1, len(tp)):
            if tp[i] > tp[i-1]:
                pos_flow.append(rmf[i]); neg_flow.append(0)
            else:
                pos_flow.append(0); neg_flow.append(rmf[i])
        
        pos_sum = sum(pos_flow[-period:]) if len(pos_flow) >= period else sum(pos_flow)
        neg_sum = sum(neg_flow[-period:]) if len(neg_flow) >= period else sum(neg_flow)
        mfi = 100 if neg_sum == 0 else 100 - (100 / (1 + pos_sum / neg_sum)) if neg_sum > 0 else 50
        
        if self.current_market_type.value == 'crypto':
            oversold, overbought = 15, 85
        else:
            oversold, overbought = 20, 80
        
        if mfi < oversold:
            signal, confidence = "BUY", 70
        elif mfi > overbought:
            signal, confidence = "SELL", 70
        else:
            signal, confidence = "NEUTRAL", 50
        
        return mfi, signal, confidence, {'mfi': mfi}
    
    def _calc_volume_profile(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        levels = config.params.get('levels', 20)
        high, low, volume = data.get('high', []), data.get('low', []), data.get('volume', [])
        if len(high) < 1 or not volume:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        price_range = max(high) - min(low) if max(high) > min(low) else 1
        level_size = price_range / levels
        volume_by_level = {}
        
        for i in range(len(high)):
            price = (high[i] + low[i]) / 2
            level = int((price - min(low)) / level_size) if level_size > 0 else 0
            volume_by_level[level] = volume_by_level.get(level, 0) + volume[i]
        
        poc_level = max(volume_by_level, key=volume_by_level.get) if volume_by_level else 0
        poc_price = min(low) + (poc_level + 0.5) * level_size
        
        current_price = data.get('close', [0])[-1] if data.get('close') else 0
        
        if current_price > poc_price * 1.01:
            signal, confidence = "BUY", 60
        elif current_price < poc_price * 0.99:
            signal, confidence = "SELL", 60
        else:
            signal, confidence = "NEUTRAL", 50
        
        return poc_price, signal, confidence, {'poc': poc_price, 'levels': levels}
    
    def _calc_accum_dist(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        high, low, close, volume = data.get('high', []), data.get('low', []), data.get('close', []), data.get('volume', [])
        if len(close) < 2 or not volume:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        clv = []
        for i in range(len(close)):
            if high[i] != low[i]:
                clv.append(((close[i] - low[i]) - (high[i] - close[i])) / (high[i] - low[i]) * volume[i])
            else:
                clv.append(0)
        
        acc_dist = [clv[0]]
        for i in range(1, len(clv)):
            acc_dist.append(acc_dist[-1] + clv[i])
        
        current_ad = acc_dist[-1] if acc_dist else 0
        prev_ad = acc_dist[-2] if len(acc_dist) > 1 else current_ad
        
        if current_ad > prev_ad:
            signal, confidence = "BUY", 60
        elif current_ad < prev_ad:
            signal, confidence = "SELL", 60
        else:
            signal, confidence = "NEUTRAL", 50
        
        return current_ad, signal, confidence, {'accum_dist': current_ad}
    
    def _calc_eom(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        high, low, close, volume = data.get('high', []), data.get('low', []), data.get('close', []), data.get('volume', [])
        if len(close) < 2 or not volume:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        # Ease of Movement
        midpoint = [(high[i] + low[i]) / 2 for i in range(len(high))]
        distance = []
        for i in range(1, len(midpoint)):
            distance.append(midpoint[i] - midpoint[i-1])
        
        box_ratio = []
        for i in range(len(high) - 1):
            if volume[i] > 0 and high[i] - low[i] > 0:
                box_ratio.append(volume[i] / (high[i] - low[i]))
            else:
                box_ratio.append(0)
        
        eom = []
        for i in range(len(distance)):
            if box_ratio[i] > 0:
                eom.append(distance[i] / box_ratio[i])
            else:
                eom.append(0)
        
        if len(eom) > 0:
            current_eom = eom[-1] if eom else 0
        else:
            current_eom = 0
        
        if current_eom > 0:
            signal, confidence = "BUY", 55
        elif current_eom < 0:
            signal, confidence = "SELL", 55
        else:
            signal, confidence = "NEUTRAL", 50
        
        return current_eom, signal, confidence, {'eom': current_eom}
    
