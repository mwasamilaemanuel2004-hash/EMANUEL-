    def _calc_zigzag(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        deviation = config.params.get('deviation', 0.05)
        high, low, close = data.get('high', []), data.get('low', []), data.get('close', [])
        if len(close) < 10:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        # Simplified ZigZag
        last_pivot = close[-1]
        for i in range(len(close) - 1, 0, -1):
            if abs(close[i] - close[i-1]) / close[i-1] > deviation:
                last_pivot = close[i]
                break
        
        if last_pivot > close[-1]:
            signal, confidence = "BUY", 60
        elif last_pivot < close[-1]:
            signal, confidence = "SELL", 60
        else:
            signal, confidence = "NEUTRAL", 50
        
        return last_pivot, signal, confidence, {'pivot': last_pivot}
    
    def _calc_fractals(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        period = config.params.get('period', 2)
        high, low = data.get('high', []), data.get('low', [])
        if len(high) < period * 2 + 1:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        # Simplified Fractals
        up_fractal = False
        down_fractal = False
        
        if len(high) > period * 2 + 1:
            if high[-1] > max(high[-period*2-1:-1]):
                up_fractal = True
            if low[-1] < min(low[-period*2-1:-1]):
                down_fractal = True
        
        if up_fractal:
            signal, confidence = "BUY", 65
        elif down_fractal:
            signal, confidence = "SELL", 65
        else:
            signal, confidence = "NEUTRAL", 50
        
        return high[-1] if up_fractal else low[-1], signal, confidence, {'up_fractal': up_fractal, 'down_fractal': down_fractal}
    
