    def _calc_bollinger(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        period = config.params.get('period', 20)
        std_mult = self.adaptive_params.get('bb_std', 2.0)
        close = data.get('close', [])
        if len(close) < period:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        sma = sum(close[-period:]) / period
        variance = sum((close[i] - sma) ** 2 for i in range(-period, 0)) / period
        std = math.sqrt(variance)
        upper, lower = sma + std_mult * std, sma - std_mult * std
        current_price = close[-1]
        
        if current_price > upper:
            signal, confidence = "SELL", 80
        elif current_price < lower:
            signal, confidence = "BUY", 80
        elif current_price > sma:
            signal, confidence = "BUY", 60
        elif current_price < sma:
            signal, confidence = "SELL", 60
        else:
            signal, confidence = "NEUTRAL", 50
        
        return current_price, signal, confidence, {'upper': upper, 'middle': sma, 'lower': lower}
    
    def _calc_atr(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        period = config.params.get('period', 14)
        high, low, close = data.get('high', []), data.get('low', []), data.get('close', [])
        if len(close) < period + 1:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        tr = [max(high[i] - low[i], abs(high[i] - close[i-1]), abs(low[i] - close[i-1])) for i in range(1, len(close))]
        atr = sum(tr[-period:]) / period if period > 0 else 0
        
        return atr, "NEUTRAL", 50, {'atr': atr}
    
