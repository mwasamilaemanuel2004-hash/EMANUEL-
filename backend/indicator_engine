    def _calc_trendline(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        lookback = config.params.get('lookback', 20)
        high, low, close = data.get('high', []), data.get('low', []), data.get('close', [])
        if len(close) < lookback:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        # Simplified trendline detection
        recent_highs = high[-lookback:]
        recent_lows = low[-lookback:]
        
        # Find support and resistance
        support = min(recent_lows)
        resistance = max(recent_highs)
        
        current_price = close[-1]
        
        if current_price > resistance:
            signal, confidence = "BUY", 65
        elif current_price < support:
            signal, confidence = "SELL", 65
        else:
            signal, confidence = "NEUTRAL", 50
        
        return current_price, signal, confidence, {'support': support, 'resistance': resistance}
    
    def _calc_support_resistance(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        lookback = config.params.get('lookback', 20)
        high, low, close = data.get('high', []), data.get('low', []), data.get('close', [])
        if len(close) < lookback:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        # Find support and resistance levels
        supports = []
        resistances = []
        
        # Simplified pivot detection
        for i in range(2, len(high) - 2):
            if high[i] > high[i-1] and high[i] > high[i+1]:
                resistances.append(high[i])
            if low[i] < low[i-1] and low[i] < low[i+1]:
                supports.append(low[i])
        
        if supports:
            support = supports[-1] if supports else close[-1] * 0.95
        else:
            support = close[-1] * 0.95
        
        if resistances:
            resistance = resistances[-1] if resistances else close[-1] * 1.05
        else:
            resistance = close[-1] * 1.05
        
        current_price = close[-1]
        
        if current_price > resistance:
            signal, confidence = "BUY", 60
        elif current_price < support:
            signal, confidence = "SELL", 60
        else:
            signal, confidence = "NEUTRAL", 50
        
        return current_price, signal, confidence, {'support': support, 'resistance': resistance}
    
