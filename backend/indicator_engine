    def _calc_fvg(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        sensitivity = config.params.get('sensitivity', 0.002)
        high, low, close = data.get('high', []), data.get('low', []), data.get('close', [])
        if len(close) < 3:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        if self.current_market_type.value == 'crypto':
            sensitivity = sensitivity * 0.7
        
        fvg_found = False
        fvg_type = None
        fvg_upper = 0
        fvg_lower = 0
        
        for i in range(-3, 0):
            if i + 1 < len(close) and i + 2 < len(close):
                if low[i] > high[i+2]:
                    fvg_found = True
                    fvg_type = 'bullish'
                    fvg_lower = high[i+2]
                    fvg_upper = low[i]
                    break
                elif high[i] < low[i+2]:
                    fvg_found = True
                    fvg_type = 'bearish'
                    fvg_lower = high[i]
                    fvg_upper = low[i+2]
                    break
        
        current_price = close[-1]
        
        if fvg_found and fvg_type == 'bullish' and current_price > fvg_lower:
            signal, confidence = "BUY", 70
        elif fvg_found and fvg_type == 'bearish' and current_price < fvg_upper:
            signal, confidence = "SELL", 70
        else:
            signal, confidence = "NEUTRAL", 50
        
        return current_price, signal, confidence, {
            'fvg_found': fvg_found,
            'fvg_type': fvg_type,
            'fvg_upper': fvg_upper,
            'fvg_lower': fvg_lower
        }
    
    def _calc_order_block(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        lookback = config.params.get('lookback', 5)
        high, low, close = data.get('high', []), data.get('low', []), data.get('close', [])
        if len(close) < lookback + 1:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        threshold = 0.6 if self.current_market_type.value == 'crypto' else 0.7
        
        order_blocks = []
        for i in range(-lookback, 0):
            body = abs(close[i] - close[i-1])
            range_size = high[i] - low[i]
            if range_size > 0 and body / range_size > threshold:
                order_blocks.append({
                    'price': close[i],
                    'type': 'bullish' if close[i] > close[i-1] else 'bearish',
                    'strength': body / range_size
                })
        
        if order_blocks:
            last_block = order_blocks[-1]
            current_price = close[-1]
            
            if last_block['type'] == 'bullish' and current_price > last_block['price']:
                signal, confidence = "BUY", 65
            elif last_block['type'] == 'bearish' and current_price < last_block['price']:
                signal, confidence = "SELL", 65
            else:
                signal, confidence = "NEUTRAL", 50
        else:
            signal, confidence = "NEUTRAL", 50
        
        return close[-1] if close else 0, signal, confidence, {'blocks_found': len(order_blocks)}
    
