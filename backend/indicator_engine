    def _calc_stochastic(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        k_period, d_period, smooth = config.params.get('k', 14), config.params.get('d', 3), config.params.get('smooth', 3)
        high, low, close = data.get('high', []), data.get('low', []), data.get('close', [])
        if len(close) < k_period + d_period + smooth:
            return 50, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        k_values = []
        for i in range(k_period - 1, len(close)):
            high_high = max(high[i - k_period + 1:i + 1])
            low_low = min(low[i - k_period + 1:i + 1])
            k = 100 * (close[i] - low_low) / (high_high - low_low) if high_high != low_low else 50
            k_values.append(k)
        
        k_smooth = [sum(k_values[i - smooth + 1:i + 1]) / smooth for i in range(smooth - 1, len(k_values))]
        d_values = [sum(k_smooth[i - d_period + 1:i + 1]) / d_period for i in range(d_period - 1, len(k_smooth))]
        
        if not k_smooth or not d_values:
            return 50, "NEUTRAL", 50, {}
        
        current_k, current_d = k_smooth[-1], d_values[-1]
        prev_k = k_smooth[-2] if len(k_smooth) > 1 else current_k
        
        if current_k < 20 and current_k > prev_k and current_k > current_d:
            signal, confidence = "BUY", 75
        elif current_k > 80 and current_k < prev_k and current_k < current_d:
            signal, confidence = "SELL", 75
        elif current_k < 20:
            signal, confidence = "BUY", 60
        elif current_k > 80:
            signal, confidence = "SELL", 60
        else:
            signal, confidence = "NEUTRAL", 50
        
        return current_k, signal, confidence, {'k': current_k, 'd': current_d}
    
    def _calc_cci(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
        period = config.params.get('period', 20)
        high, low, close = data.get('high', []), data.get('low', []), data.get('close', [])
        if len(close) < period:
            return 0, "NEUTRAL", 50, {'error': 'Insufficient data'}
        
        tp = [(high[i] + low[i] + close[i]) / 3 for i in range(len(close))]
        sma = sum(tp[-period:]) / period
        mean_dev = sum(abs(tp[i] - sma) for i in range(-period, 0)) / period if period > 0 else 1
        cci = (tp[-1] - sma) / (0.015 * mean_dev) if mean_dev > 0 else 0
        
        if cci < -100:
            signal, confidence = "BUY", 70
        elif cci > 100:
            signal, confidence = "SELL", 70
        else:
            signal, confidence = "NEUTRAL", 50
        
        return cci, signal, confidence, {'cci': cci}
    
    def _calc_williams_r(self, data: Dict[str, List[float]], config: IndicatorConfig) -> Tuple[float, str, float, Dict]:
