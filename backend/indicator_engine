    async def calculate_all_async(self, data: Dict[str, List[float]]) -> Dict[str, IndicatorResult]:
        loop = asyncio.get_event_loop()
        return await loop.run_in_executor(None, self.calculate_all, data)
    
    async def calculate_indicator_async(self, data: Dict[str, List[float]], name: str) -> Optional[IndicatorResult]:
        loop = asyncio.get_event_loop()
        return await loop.run_in_executor(None, self.calculate_indicator_wrapper, data, name)
    
    def calculate_indicator_wrapper(self, data: Dict[str, List[float]], name: str) -> Optional[IndicatorResult]:
        config = self.indicators.get(name)
        if not config:
            return None
        
        market_type = self.current_market_type.value
        market_config = self.get_market_config()
        
        data_hash = hashlib.md5(json.dumps({k: str(v[-50:]) for k, v in data.items()}).encode()).hexdigest()
        cache_key = self._get_cache_key(name, data_hash, market_type, self.current_timeframe.value)
        
        cached = self.cache.get(cache_key)
        if cached:
            self.performance['cache_hits'] += 1
            return IndicatorResult(**cached)
        
        self.performance['cache_misses'] += 1
        
        result = self.calculate_indicator(data, name, config, market_type, market_config)
        
        if result:
            result.cache_key = cache_key
            self.cache.set(cache_key, {
                'name': result.name,
                'type': result.type,
                'value': result.value,
                'signal': result.signal,
                'confidence': result.confidence,
                'timestamp': result.timestamp.isoformat(),
                'metadata': result.metadata,
                'market_type': result.market_type,
                'timeframe': result.timeframe,
                'trend': result.trend,
                'strength': result.strength
            })
        
        return result
    
    # ============================================
    # MAIN CALCULATION METHOD
    # ============================================
    
    def calculate_all(self, data: Dict[str, List[float]]) -> Dict[str, IndicatorResult]:
        start_time = time.time()
        results = {}
        
        if not data or len(data.get('close', [])) < 50:
            return results
        
        market_config = self.get_market_config()
        market_type = self.current_market_type.value
        
        for name, config in self.indicators.items():
            if not self.is_indicator_enabled(name):
                continue
            
            try:
                # Fast path for simple indicators
                if name in ['RSI', 'MACD', 'EMA', 'SMA']:
                    self.performance['fast_path'] += 1
                    result = self.calculate_indicator(data, name, config, market_type, market_config)
                else:
                    self.performance['slow_path'] += 1
                    result = self.calculate_indicator(data, name, config, market_type, market_config)
                
                if result:
                    result.market_type = market_type
                    result.timeframe = self.current_timeframe.value
                    results[name] = result
                    self.results[name] = result
                    
                    if name not in self.history:
                        self.history[name] = []
                    self.history[name].append(result)
                    if len(self.history[name]) > 100:
                        self.history[name] = self.history[name][-100:]
                            
            except Exception as e:
                logger.error(f"Indicator {name} calculation error: {e}")
                self.performance['errors'] += 1
        
        self.performance['calculations'] += 1
        elapsed = time.time() - start_time
        self.performance['avg_time'] = (
            (self.performance['avg_time'] * (self.performance['calculations'] - 1) + elapsed) / 
            max(1, self.performance['calculations'])
        )
        
        return results
    
    def calculate_indicator(self, data: Dict[str, List[float]], name: str, config: IndicatorConfig,
                           market_type: str, market_config: MarketConfig) -> Optional[IndicatorResult]:
        calc_funcs = {
            # TREND
            "EMA": self._calc_ema,
            "EMA_FAST": self._calc_ema_fast,
            "EMA_SLOW": self._calc_ema_slow,
            "SMA": self._calc_sma,
            "SMA_200": self._calc_sma_200,
            "ADX": self._calc_adx,
            "MACD": self._calc_macd,
            "SuperTrend": self._calc_supertrend,
            "Ichimoku": self._calc_ichimoku,
            "ParabolicSAR": self._calc_parabolic_sar,
            "ZigZag": self._calc_zigzag,
            "Fractals": self._calc_fractals,
            # MOMENTUM
            "RSI": self._calc_rsi,
            "RSI_FAST": self._calc_rsi_fast,
            "RSI_SLOW": self._calc_rsi_slow,
            "Stochastic": self._calc_stochastic,
            "CCI": self._calc_cci,
            "WilliamsR": self._calc_williams_r,
            "AwesomeOsc": self._calc_awesome_osc,
            "Momentum": self._calc_momentum,
            "ROC": self._calc_roc,
            "PPO": self._calc_ppo,
            "KST": self._calc_kst,
            "TRIX": self._calc_trix,
            # VOLATILITY
            "BollingerBands": self._calc_bollinger,
            "ATR": self._calc_atr,
            "Keltner": self._calc_keltner,
            "Donchian": self._calc_donchian,
            "AverageTrueRange": self._calc_atr,
            "VolatilityIndex": self._calc_volatility_index,
            "ChoppinessIndex": self._calc_choppiness,
            # VOLUME
            "VWAP": self._calc_vwap,
            "OBV": self._calc_obv,
            "MFI": self._calc_mfi,
            "VolumeProfile": self._calc_volume_profile,
            "AccumDist": self._calc_accum_dist,
            "EOM": self._calc_eom,
            # ICT/SMC
            "FVG": self._calc_fvg,
            "OrderBlock": self._calc_order_block,
            "LiquiditySweep": self._calc_liquidity_sweep,
            "BOS": self._calc_bos,
            "CHOCH": self._calc_cho_ch,
            "MSS": self._calc_mss,
            "PDArray": self._calc_pd_array,
            "Killzone": self._calc_killzone,
            # TRENDLINE
            "Trendline": self._calc_trendline,
            "SupportResistance": self._calc_support_resistance,
            # SMART MONEY
            "SmartMoneyFlow": self._calc_smart_money_flow,
            "DarkPool": self._calc_dark_pool,
            "InstitutionalFlow": self._calc_institutional_flow
        }
        
        if name not in calc_funcs:
            return None
        
        try:
            adjusted_params = config.params.copy()
            
            if 'period' in adjusted_params:
                if market_type == 'crypto':
                    adjusted_params['period'] = int(adjusted_params['period'] * 0.8)
                elif market_type == 'stocks':
                    adjusted_params['period'] = int(adjusted_params['period'] * 1.2)
            
            if 'multiplier' in adjusted_params and market_type == 'crypto':
                adjusted_params['multiplier'] = adjusted_params['multiplier'] * 0.8
            
            if 'std' in adjusted_params and market_type == 'crypto':
                adjusted_params['std'] = adjusted_params['std'] * 1.2
            
            if 'sensitivity' in adjusted_params and market_type == 'crypto':
                adjusted_params['sensitivity'] = adjusted_params['sensitivity'] * 0.7
            
            config.params = adjusted_params
            
            value, signal, confidence, metadata = calc_funcs[name](data, config)
            
            if market_type == 'crypto':
                confidence = min(95, confidence * 0.9)
            elif market_type == 'stocks':
                confidence = min(95, confidence * 0.95)
            
            vol_scale = market_config.volatility_scale
            if vol_scale > 2.0:
                confidence = min(95, confidence * (1.0 - (vol_scale - 2.0) * 0.05))
            
            return IndicatorResult(
                name=name,
                type=config.type,
                value=value,
                signal=signal,
                confidence=confidence,
                market_type=market_type,
                timeframe=self.current_timeframe.value,
                metadata=metadata
            )
        except Exception as e:
            logger.error(f"Calculate {name} error: {e}")
            return None
    
