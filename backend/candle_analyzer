    def _detect_hammer(self, data: Dict, candles: List[Candle]) -> Optional[PatternResult]:
        """Detect Hammer (Bullish Reversal)"""
        if len(candles) < 1:
            return None
        
        candle = candles[-1]
        
        if (candle.body_ratio < 0.35 and 
            candle.lower_wick > 2 * candle.body and 
            candle.upper_wick < 0.15 * candle.body and
            candle.close_percent < 0):
            
            confidence = min(90, 60 + (candle.lower_wick / max(candle.body, 0.001)) * 8)
            
            # Volume confirmation
            volume_confirmed = self._check_volume(data, len(data.get('volume', [])) - 1)
            
            return PatternResult(
                name="HAMMER",
                type="REVERSAL_BULLISH",
                strength=candle.strength,
                confidence=confidence,
                price_level=candle.close,
                timestamp=datetime.now(),
                description="Hammer pattern - Potential bullish reversal",
                metadata={'body_ratio': candle.body_ratio, 'lower_wick': candle.lower_wick},
                volume_confirmation=volume_confirmed
            )
        return None
    
