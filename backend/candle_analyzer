    def _check_volume(self, data: Dict, index: int) -> bool:
        """Check if volume is above average (confirmation)"""
        try:
            volumes = data.get('volume', [])
            if len(volumes) < 20:
                return False
            
            if index < 0 or index >= len(volumes):
                return False
            
            current_volume = volumes[index]
            avg_volume = sum(volumes[-20:]) / 20
            
            return current_volume > avg_volume * self.thresholds['volume_multiplier']
            
        except Exception:
            return False
    
    def get_combined_signal(self, data: Dict[str, List[float]]) -> Dict[str, Any]:
        """Get combined candle analysis signal"""
        patterns = self.analyze(data)
        
        if not patterns:
            return {
                'signal': 'NEUTRAL',
                'confidence': 0,
                'patterns': [],
                'summary': 'No patterns detected',
                'timestamp': datetime.now().isoformat()
            }
        
        bullish_reversal = len([p for p in patterns if p.type == "REVERSAL_BULLISH"])
        bearish_reversal = len([p for p in patterns if p.type == "REVERSAL_BEARISH"])
        bullish_continuation = len([p for p in patterns if p.type == "CONTINUATION_BULLISH"])
        bearish_continuation = len([p for p in patterns if p.type == "CONTINUATION_BEARISH"])
        
        bullish_score = (bullish_reversal * 1.5 + bullish_continuation * 1.0)
        bearish_score = (bearish_reversal * 1.5 + bearish_continuation * 1.0)
        avg_confidence = sum(p.confidence for p in patterns) / len(patterns) if patterns else 0
        
        # Check if any very strong patterns exist
        has_very_strong = any(p.strength == "VERY_STRONG" for p in patterns)
        has_strong = any(p.strength == "STRONG" for p in patterns)
        
        if bullish_score > bearish_score * 1.3:
            signal = 'STRONG_BUY' if (bullish_score > bearish_score * 2 or has_very_strong) else 'BUY'
        elif bearish_score > bullish_score * 1.3:
            signal = 'STRONG_SELL' if (bearish_score > bullish_score * 2 or has_very_strong) else 'SELL'
        else:
            signal = 'NEUTRAL'
        
        return {
            'signal': signal,
            'confidence': min(95, avg_confidence + (abs(bullish_score - bearish_score) * 5)),
            'patterns': [{'name': p.name, 'type': p.type, 'confidence': p.confidence, 'strength': p.strength} for p in patterns[:5]],
            'summary': f"{len(patterns)} patterns detected",
            'bullish_count': bullish_reversal + bullish_continuation,
            'bearish_count': bearish_reversal + bearish_continuation,
            'top_pattern': patterns[0].name if patterns else 'None',
            'has_strong_pattern': has_strong,
            'has_very_strong_pattern': has_very_strong,
            'timestamp': datetime.now().isoformat()
        }
    
    def update_pattern_accuracy(self, pattern_name: str, correct: bool):
        """Update pattern accuracy"""
        with self._lock:
            if pattern_name not in self.pattern_accuracy:
                self.pattern_accuracy[pattern_name] = {'correct': 0, 'total': 0, 'accuracy': 0}
            
            self.pattern_accuracy[pattern_name]['total'] += 1
            if correct:
                self.pattern_accuracy[pattern_name]['correct'] += 1
            
            self.pattern_accuracy[pattern_name]['accuracy'] = (
                self.pattern_accuracy[pattern_name]['correct'] / 
                max(1, self.pattern_accuracy[pattern_name]['total'])
            )
            
            if correct:
                self.performance['successful_patterns'] += 1
            else:
                self.performance['failed_patterns'] += 1
    
    def get_pattern_statistics(self) -> Dict[str, Any]:
        """Get pattern statistics"""
        return {
            'total_patterns': len(self.recent_patterns),
            'average_confidence': sum(p.confidence for p in self.recent_patterns) / len(self.recent_patterns) if self.recent_patterns else 0,
            'pattern_accuracy': self.pattern_accuracy,
            'performance': self.performance,
            'recent_patterns': [{'name': p.name, 'type': p.type, 'confidence': p.confidence, 'timestamp': p.timestamp.isoformat()} for p in self.recent_patterns[-10:]]
        }
    
    def _save_state(self):
        """Save state to disk"""
        try:
            os.makedirs("data/candles", exist_ok=True)
            
            state_data = {
                'pattern_accuracy': self.pattern_accuracy,
                'performance': self.performance,
                'thresholds': self.thresholds
            }
            
            with open("data/candles/state.json", "w") as f:
                json.dump(state_data, f, indent=2)
                
        except Exception as e:
            logger.error(f"Save state error: {e}")
    
    def _load_state(self):
        """Load state from disk"""
        try:
            state_file = "data/candles/state.json"
            if os.path.exists(state_file):
                with open(state_file, "r") as f:
                    state_data = json.load(f)
                    
                    self.pattern_accuracy = state_data.get('pattern_accuracy', {})
                    self.performance = state_data.get('performance', self.performance)
                    self.thresholds = state_data.get('thresholds', self.thresholds)
                    
                    logger.info("📂 Candle analyzer state loaded")
                
        except Exception as e:
            logger.warning(f"Load state error (starting fresh): {e}")