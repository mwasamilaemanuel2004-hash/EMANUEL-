    def analyze(self, data: Dict[str, List[float]]) -> List[PatternResult]:
        """Analyze candles and detect all patterns"""
        start_time = time.time()
        results = []
        
        try:
            self.performance['total_analyses'] += 1
            
            # Validate data
            if not data or len(data.get('close', [])) < 3:
                logger.warning("Data too short for candle analysis")
                return results
            
            with self._lock:
                # Calculate candle metrics
                candles = self._calculate_candles(data)
                
                if len(candles) < 3:
                    return results
                
                # Detect patterns
                for pattern_name, pattern_func in self.patterns.items():
                    try:
                        result = pattern_func(data, candles)
                        if result:
                            results.append(result)
                            self.recent_patterns.append(result)
                            
                            if pattern_name not in self.pattern_history:
                                self.pattern_history[pattern_name] = []
                            self.pattern_history[pattern_name].append({
                                'result': result,
                                'timestamp': datetime.now()
                            })
                            
                            if len(self.pattern_history[pattern_name]) > self.max_history:
                                self.pattern_history[pattern_name] = self.pattern_history[pattern_name][-self.max_history:]
                            
                    except Exception as e:
                        logger.debug(f"Pattern {pattern_name} detection error: {e}")
                
                # Update performance
                elapsed = time.time() - start_time
                self.performance['patterns_detected'] += len(results)
                self.performance['avg_detection_time'] = (
                    (self.performance['avg_detection_time'] * (self.performance['total_analyses'] - 1) + elapsed) /
                    max(1, self.performance['total_analyses'])
                )
                
                # Sort by confidence
                results.sort(key=lambda x: x.confidence, reverse=True)
                
                self._last_analysis_time = datetime.now()
                
                return results
            
        except Exception as e:
            self.performance['errors'] += 1
            logger.error(f"Candle analysis error: {e}\n{traceback.format_exc()}")
            return results
    
    def _calculate_candles(self, data: Dict[str, List[float]]) -> List[Candle]:
        """Calculate candle metrics for each candle"""
        candles = []
        
        open_prices = data.get('open', [])
        high_prices = data.get('high', [])
        low_prices = data.get('low', [])
        close_prices = data.get('close', [])
        volumes = data.get('volume', [])
        
        min_len = min(len(open_prices), len(high_prices), len(low_prices), len(close_prices))
        
        for i in range(min_len):
            try:
                open_price = open_prices[i] if i < len(open_prices) else close_prices[i]
                high = high_prices[i] if i < len(high_prices) else close_prices[i]
                low = low_prices[i] if i < len(low_prices) else close_prices[i]
                close = close_prices[i]
                volume = volumes[i] if i < len(volumes) else 0
                
                # Calculate metrics
                body = abs(close - open_price)
                upper_wick = high - max(open_price, close)
                lower_wick = min(open_price, close) - low
                total_range = high - low
                
                body_ratio = body / total_range if total_range > 0 else 0
                upper_wick_ratio = upper_wick / total_range if total_range > 0 else 0
                lower_wick_ratio = lower_wick / total_range if total_range > 0 else 0
                range_percent = (total_range / open_price) * 100 if open_price > 0 else 0
                close_percent = ((close - open_price) / open_price) * 100 if open_price > 0 else 0
                
                # Determine candle type with improved logic
                if body_ratio < self.thresholds['doji_threshold']:
                    candle_type = "DOJI"
                elif body_ratio > 0.85:
                    candle_type = "MARUBOZU"
                elif upper_wick_ratio > 0.35 and lower_wick_ratio > 0.35:
                    candle_type = "SPINNING_TOP"
                elif upper_wick_ratio > 2 * body_ratio and close < open_price:
                    candle_type = "SHOOTING_STAR"
                elif lower_wick_ratio > 2 * body_ratio and close > open_price:
                    candle_type = "HAMMER"
                elif close > open_price:
                    candle_type = "BULLISH"
                else:
                    candle_type = "BEARISH"
                
                # Determine strength
                if body_ratio > 0.85 and range_percent > 0.5:
                    strength = "VERY_STRONG"
                elif body_ratio > 0.6 and range_percent > 0.3:
                    strength = "STRONG"
                elif body_ratio > 0.35:
                    strength = "MODERATE"
                elif body_ratio > 0.15:
                    strength = "WEAK"
                else:
                    strength = "VERY_WEAK"
                
                candle = Candle(
                    open=open_price,
                    high=high,
                    low=low,
                    close=close,
                    volume=volume,
                    timestamp=datetime.now(),
                    body=body,
                    upper_wick=upper_wick,
                    lower_wick=lower_wick,
                    body_ratio=body_ratio,
                    candle_type=candle_type,
                    strength=strength,
                    range_percent=range_percent,
                    close_percent=close_percent
                )
                
                candles.append(candle)
                
            except Exception as e:
                logger.debug(f"Candle calculation error at index {i}: {e}")
                continue
        
        return candles
    
