    def _detect_engulfing_bullish(self, data: Dict, candles: List[Candle]) -> Optional[PatternResult]:
        """Detect Bullish Engulfing"""
        if len(candles) < 2:
            return None
        
        prev = candles[-2]
        curr = candles[-1]
        
        if (prev.close < prev.open and 
            curr.close > curr.open and 
            curr.open < prev.close and 
            curr.close > prev.open):
            
            confidence = min(92, 70 + (curr.body / max(prev.body, 0.001)) * 5)
            volume_confirmed = self._check_volume(data, len(data.get('volume', [])) - 1)
            
            return PatternResult(
                name="ENGULFING_BULLISH",
                type="REVERSAL_BULLISH",
                strength="STRONG" if curr.body > prev.body * 1.5 else curr.strength,
                confidence=confidence,
                price_level=curr.close,
