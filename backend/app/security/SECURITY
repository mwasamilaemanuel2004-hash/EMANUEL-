    def check_request(self, ip: str, method: str, path: str, 
                     headers: Dict = None, body: str = "",
                     user_agent: str = "") -> Tuple[bool, Optional[str]]:
        """
        Check request through all firewall layers
        Returns (is_allowed, block_reason)
        """
        headers = headers or {}
        
        # 1. IP Check
        if not self._check_ip(ip):
            with self._lock:
                self.firewall_stats['ip_blocked'] += 1
                self.firewall_stats['total_blocked'] += 1
            return False, "ip_blocked"
        
        # 2. Method Check
        if not self._check_method(method):
            with self._lock:
                self.firewall_stats['method_blocked'] += 1
                self.firewall_stats['total_blocked'] += 1
            return False, "invalid_method"
        
        # 3. User-Agent Check
        if user_agent and self._is_blocked_user_agent(user_agent):
            return False, "blocked_user_agent"
        
        # 4. Check all attack patterns
        data_to_check = f"{path}\n{json.dumps(headers)}\n{body}\n{user_agent}"
        
        for attack_type, patterns in self.attack_patterns.items():
            for pattern in patterns:
                if re.search(pattern, data_to_check, re.IGNORECASE):
                    with self._lock:
                        stat_key = f"{attack_type}_blocked"
                        if stat_key in self.firewall_stats:
                            self.firewall_stats[stat_key] += 1
                        self.firewall_stats['total_blocked'] += 1
                    
                    return False, attack_type
        
        return True, None
    
    def _check_ip(self, ip: str) -> bool:
        """Check IP address"""
        if ip in self.allowed_ips:
            return True
        
        if ip in self.blocked_ips:
            return False
        
        try:
            ip_obj = ipaddress.ip_address(ip)
            
            # Check private IPs (should not be blocked by default)
            if ip_obj.is_private or ip_obj.is_loopback:
                return True
            
            for network in self.blocked_ranges:
                if ip_obj in network:
                    return False
            
            return True
        except ValueError:
            return False
    
    def _check_method(self, method: str) -> bool:
        """Check HTTP method"""
        allowed_methods = ['GET', 'POST', 'PUT', 'DELETE', 'PATCH', 'OPTIONS', 'HEAD']
        return method.upper() in allowed_methods
    
    def _is_blocked_user_agent(self, user_agent: str) -> bool:
        """Check if user agent is blocked"""
        blocked_patterns = [
            r'curl', r'wget', r'python', r'sqlmap', r'nikto', 
            r'nmap', r'nessus', r'burp', r'fuzz'
        ]
        
        for pattern in blocked_patterns:
            if re.search(pattern, user_agent, re.IGNORECASE):
                return True
        
        return False
    
    def block_ip(self, ip: str) -> None:
        """Block IP"""
        self.blocked_ips.add(ip)
    
    def unblock_ip(self, ip: str) -> None:
        """Unblock IP"""
        self.blocked_ips.discard(ip)
    
    def allow_ip(self, ip: str) -> None:
        """Allow IP (whitelist)"""
        self.allowed_ips.add(ip)
    
    def block_range(self, network: str) -> None:
        """Block IP range"""
        try:
            self.blocked_ranges.append(ipaddress.ip_network(network))
        except ValueError:
            pass
    
    def block_country(self, country_code: str) -> None:
        """Block country (requires geo IP database)"""
        self.blocked_countries.add(country_code.upper())
    
    def get_stats(self) -> Dict[str, int]:
        """Get firewall statistics"""
        return dict(self.firewall_stats)


