        except Exception as e:
            logger.error(f"Admin login error: {e}")
            return {'success': False, 'error': str(e)}
    
    # ============ USER LOGIN ============
    
    def user_login(self, ip: str, username: str, password: str,
                  headers: Dict = None, user_agent: str = "") -> Dict[str, Any]:
        """User login with firewall"""
        try:
            is_allowed, reason = self.check_request(ip, 'POST', '/login', headers, 
                                                   f"username={username}", user_agent)
            
            if not is_allowed:
                return {'success': False, 'error': f'Blocked: {reason}'}
            
            if not self.check_rate_limit(ip, 'login', 5, 60):
                return {'success': False, 'error': 'Too many attempts'}
            
            if username not in self.users:
                return {'success': False, 'error': 'Invalid credentials'}
            
            user = self.users[username]
            
            if user.get('locked_until') and datetime.utcnow() < user['locked_until']:
                return {'success': False, 'error': 'Account locked'}
            
            hashed = hashlib.pbkdf2_hmac('sha256', password.encode(), user['salt'].encode(), 100000).hex()
            
            if not secrets.compare_digest(hashed, user['password_hash']):
                user['failed_attempts'] += 1
                return {'success': False, 'error': 'Invalid credentials'}
            
            user['failed_attempts'] = 0
            
            access_token = self.create_access_token(username, role='user')
            refresh_token = self.create_refresh_token(username)
            
            return {
                'success': True,
                'access_token': access_token,
                'refresh_token': refresh_token,
                'username': username,
                'role': 'user'
            }
            
        except Exception as e:
            return {'success': False, 'error': str(e)}
    
    # ============ OTHER METHODS (same as before) ============
    
    def register_user(self, username: str, email: str, password: str) -> Dict[str, Any]:
        try:
            if username in self.users:
                return {'success': False, 'error': 'Username exists'}
            
            salt = secrets.token_hex(16)
            hashed = hashlib.pbkdf2_hmac('sha256', password.encode(), salt.encode(), 100000).hex()
            
            self.users[username] = {
                'username': username,
                'email': email,
                'password_hash': hashed,
                'salt': salt,
                'role': UserRole.USER,
                'failed_attempts': 0,
                'locked_until': None,
                'totp_enabled': False,
                'biometric_enabled': False
            }
            
            return {'success': True}
        except Exception as e:
            return {'success': False, 'error': str(e)}
    
    def setup_totp(self, user_id: str, email: str) -> Dict[str, Any]:
        try:
            secret = self.totp.generate_secret()
            self.totp_secrets[user_id] = secret
            uri = self.totp.generate_uri(secret, email)
            qr_path = self.totp.generate_qr(uri)
            backup_codes = self.totp.generate_backup_codes()
            self.backup_codes[user_id] = backup_codes
            
            if user_id in self.users:
                self.users[user_id]['totp_enabled'] = True
            
            return {'success': True, 'secret': secret, 'uri': uri, 'backup_codes': backup_codes}
        except Exception as e:
            return {'success': False, 'error': str(e)}
    
    def verify_totp(self, user_id: str, code: str) -> bool:
        try:
            if user_id not in self.totp_secrets:
                return False
            return self.totp.verify_code(self.totp_secrets[user_id], code)
        except:
            return False
    
    def setup_biometric(self, user_id: str, device_info: Dict) -> Dict[str, Any]:
        try:
            result = self.biometric.register_biometric(user_id, device_info)
            if result.get('success') and user_id in self.users:
                self.users[user_id]['biometric_enabled'] = True
            return result
        except Exception as e:
            return {'success': False, 'error': str(e)}
    
    def verify_biometric(self, user_id: str, challenge: str, signature: str) -> bool:
        return self.biometric.verify_biometric(user_id, challenge, signature)
    
    def generate_biometric_challenge(self, user_id: str) -> str:
        return self.biometric.generate_challenge(user_id)
    
    def send_email_otp(self, user_id: str, email: str, purpose: str = "login") -> Dict[str, Any]:
        try:
            otp = ''.join([str(secrets.randbelow(10)) for _ in range(6)])
            
            with self._lock:
                self.otp_store[user_id] = {
                    'otp': otp,
                    'purpose': purpose,
                    'created_at': datetime.utcnow(),
                    'expires_at': datetime.utcnow() + timedelta(minutes=5),
                    'attempts': 0
                }
            
            success = self.email_sender.send_otp_email(email, otp, purpose)
            return {'success': success}
        except Exception as e:
            return {'success': False, 'error': str(e)}
    
    def verify_email_otp(self, user_id: str, code: str) -> bool:
        try:
            if user_id not in self.otp_store:
                return False
            
            otp_data = self.otp_store[user_id]
            
            if datetime.utcnow() > otp_data['expires_at']:
                self.otp_store.pop(user_id, None)
                return False
            
            if otp_data['attempts'] >= 3:
                self.otp_store.pop(user_id, None)
                return False
            
            if secrets.compare_digest(otp_data['otp'], code):
                self.otp_store.pop(user_id, None)
                return True
            
            otp_data['attempts'] += 1
            return False
        except:
            return False
    
    def create_access_token(self, user_id: str, role: str = "user") -> str:
        try:
            payload = {
                'user_id': user_id,
                'role': role,
                'type': 'access',
                'exp': datetime.utcnow() + self.access_expiry,
                'iat': datetime.utcnow(),
                'jti': secrets.token_hex(16),
                'version': self.token_versions.get(user_id, 1)
            }
            return jwt.encode(payload, self.jwt_secret, algorithm=self.algorithm)
        except:
            return ""
    
    def create_refresh_token(self, user_id: str) -> str:
        payload = {
            'user_id': user_id,
            'type': 'refresh',
            'exp': datetime.utcnow() + self.refresh_expiry,
            'iat': datetime.utcnow(),
            'jti': secrets.token_hex(16)
        }
        return jwt.encode(payload, self.jwt_secret, algorithm=self.algorithm)
    
    def verify_token(self, token: str) -> Optional[Dict]:
        try:
            if not token or token in self.blacklisted_tokens:
                return None
            return jwt.decode(token, self.jwt_secret, algorithms=[self.algorithm])
        except:
            return None
    
    def check_rate_limit(self, ip: str, endpoint: str = 'default',
                        max_requests: int = None, window_seconds: int = None) -> bool:
        try:
            if ip in self.whitelist:
                return True
            
            if ip in self.banned_ips:
                if time.time() < self.banned_ips[ip]:
                    return False
                del self.banned_ips[ip]
            
            if max_requests is None:
                limits = self.rate_limits.get(endpoint, self.rate_limits['default'])
                max_requests, window_seconds = limits
            
            with self._lock:
                key = f"{ip}:{endpoint}"
                now = time.time()
                
                if key not in self.requests:
                    self.requests[key] = deque()
                
                queue = self.requests[key]
                while queue and now - queue[0] > window_seconds:
                    queue.popleft()
                
                if len(queue) >= max_requests:
                    self.banned_ips[ip] = now + 300
                    return False
                
                queue.append(now)
                return True
        except:
            return False
    
    def encrypt_data(self, data: str) -> str:
        try:
            if self.fernet:
                return self.fernet.encrypt(data.encode()).decode()
            return base64.b64encode(data.encode()).decode()
        except:
            return base64.b64encode(data.encode()).decode()
    
    def decrypt_data(self, encrypted: str) -> str:
        try:
            if self.fernet:
                return self.fernet.decrypt(encrypted.encode()).decode()
            return base64.b64decode(encrypted.encode()).decode()
        except:
            return ""
    
    def hash_password(self, password: str, salt: str = None) -> Dict[str, str]:
        salt = salt or secrets.token_hex(16)
        hashed = hashlib.pbkdf2_hmac('sha256', password.encode(), salt.encode(), 100000).hex()
        return {'hash': hashed, 'salt': salt}
    
    def _log_event(self, event_type: SecurityEventType, user_id: str, details: Dict = None) -> None:
        try:
            event = {
                'timestamp': datetime.now().isoformat(),
                'type': event_type.value,
                'user_id': user_id,
                'details': details or {}
            }
            
            self.security_events.append(event)
            self.audit_logs.append(event)
            
            with open(self.audit_file, 'a') as f:
                f.write(json.dumps(event, default=str) + '\n')
        except:
            pass
    
    def get_firewall_stats(self) -> Dict[str, int]:
        """Get firewall statistics"""
        return self.firewall.get_stats()
    
    def cleanup(self) -> None:
        try:
            with self._lock:
                now = datetime.utcnow()
                
                expired_otps = [uid for uid, d in self.otp_store.items() if now > d['expires_at']]
                for uid in expired_otps:
                    self.otp_store.pop(uid, None)
                
                gc.collect()
        except:
            pass


