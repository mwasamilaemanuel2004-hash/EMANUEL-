class FreeTOTP:
    """BURE TOTP"""
    
    def __init__(self):
        self.issuer = "ESH.TRADE"
        self.digits = 6
        self.interval = 30
    
    def generate_secret(self) -> str:
        return base64.b32encode(secrets.token_bytes(20)).decode().rstrip('=')
    
    def generate_uri(self, secret: str, email: str) -> str:
        return f"otpauth://totp/{self.issuer}:{email}?secret={secret}&issuer={self.issuer}"
    
    def generate_qr(self, uri: str) -> Optional[str]:
        if not QRCODE_AVAILABLE:
            return None
        try:
            qr = qrcode.QRCode(version=1, box_size=10, border=5)
            qr.add_data(uri)
            qr.make(fit=True)
            img = qr.make_image(fill_color="black", back_color="white")
            path = f"data/totp_{hashlib.md5(uri.encode()).hexdigest()[:10]}.png"
            img.save(path)
            return path
        except:
            return None
    
    def generate_code(self, secret: str) -> str:
        try:
            if PYOTP_AVAILABLE:
                return pyotp.TOTP(secret).now()
            return self._manual_code(secret)
        except:
            return self._manual_code(secret)
    
    def _manual_code(self, secret: str) -> str:
        try:
            padding = '=' * ((8 - len(secret) % 8) % 8)
            key = base64.b32decode(secret + padding)
            counter = int(time.time() // self.interval)
            msg = struct.pack('>Q', counter)
            digest = hmac.new(key, msg, hashlib.sha1).digest()
            offset = digest[-1] & 0x0F
            code = struct.unpack('>I', digest[offset:offset+4])[0] & 0x7FFFFFFF
            return str(code % 1000000).zfill(6)
        except:
            return ''.join([str(secrets.randbelow(10)) for _ in range(6)])
    
    def verify_code(self, secret: str, code: str) -> bool:
        try:
            if PYOTP_AVAILABLE:
                return pyotp.TOTP(secret).verify(code, valid_window=1)
            return self._manual_verify(secret, code)
        except:
            return self._manual_verify(secret, code)
    
    def _manual_verify(self, secret: str, code: str) -> bool:
        try:
            padding = '=' * ((8 - len(secret) % 8) % 8)
            key = base64.b32decode(secret + padding)
            current = int(time.time() // self.interval)
            
            for offset in [-1, 0, 1]:
                counter = current + offset
                msg = struct.pack('>Q', counter)
                digest = hmac.new(key, msg, hashlib.sha1).digest()
                off = digest[-1] & 0x0F
                val = struct.unpack('>I', digest[off:off+4])[0] & 0x7FFFFFFF
                expected = str(val % 1000000).zfill(6)
                if hmac.compare_digest(expected, code):
                    return True
            return False
        except:
            return False
    
    def generate_backup_codes(self, count: int = 10) -> List[str]:
        return ['-'.join([secrets.token_hex(2).upper() for _ in range(3)]) for _ in range(count)]


class BiometricAuth:
    """BIOMETRIC AUTHENTICATION"""
    
    def __init__(self):
        self.biometric_keys: Dict[str, Dict] = {}
        self.challenge_store: Dict[str, Dict] = {}
        self.device_registry: Dict[str, List[str]] = {}
        self._lock = threading.Lock()
    
    def generate_challenge(self, user_id: str) -> str:
        challenge = secrets.token_urlsafe(32)
        with self._lock:
            self.challenge_store[user_id] = {
                'challenge': challenge,
                'created_at': datetime.utcnow(),
                'expires_at': datetime.utcnow() + timedelta(minutes=5)
            }
        return challenge
    
    def register_biometric(self, user_id: str, device_info: Dict) -> Dict[str, Any]:
        try:
            with self._lock:
                credential_id = secrets.token_hex(16)
                device_name = device_info.get('device_name', 'Unknown')
                biometric_type = device_info.get('biometric_type', 'fingerprint')
                
                self.biometric_keys[user_id] = {
                    'credential_id': credential_id,
                    'private_key': secrets.token_hex(32),
                    'device_name': device_name,
                    'biometric_type': biometric_type,
                    'created_at': datetime.utcnow(),
                    'sign_count': 0
                }
                
                if user_id not in self.device_registry:
                    self.device_registry[user_id] = []
                self.device_registry[user_id].append(device_name)
                
                return {'success': True, 'credential_id': credential_id}
        except Exception as e:
            return {'success': False, 'error': str(e)}
    
    def verify_biometric(self, user_id: str, challenge: str, signature: str) -> bool:
        try:
            if user_id not in self.biometric_keys:
                return False
            
            if user_id not in self.challenge_store:
                return False
            
            challenge_data = self.challenge_store[user_id]
            
            if datetime.utcnow() > challenge_data['expires_at']:
                self.challenge_store.pop(user_id, None)
                return False
            
            if challenge != challenge_data['challenge']:
                return False
            
            expected = hashlib.sha256(
                f"{challenge}:{self.biometric_keys[user_id]['private_key']}".encode()
            ).hexdigest()
            
            if not hmac.compare_digest(expected, signature):
                return False
            
            self.biometric_keys[user_id]['sign_count'] += 1
            self.challenge_store.pop(user_id, None)
            
            return True
        except:
            return False


