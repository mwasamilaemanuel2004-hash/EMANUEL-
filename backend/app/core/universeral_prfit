            "market_score": market_score,
            "market_regime": self.market.current_regime.value if self.market.current_regime else "unknown",
            "capital": capital_status,
            "user_settings": self.user_settings.to_dict(),
            "timestamp": datetime.now().isoformat(),
        }
    
    def get_best_assets_to_trade(self, limit: int = 10) -> List[Dict]:
        """Get best assets to trade based on current conditions"""
        recommendations = []
        
        for symbol, data in ASSET_DATABASE.items():
            # Check minimum account
            if self.capital.current_balance < data["min_account"]:
                continue
            
            # Check user preferences
            asset_class = data["class"]
            if asset_class in ["forex_major", "forex_minor"] and not self.user_settings.allow_forex:
                continue
            if asset_class in ["commodity_metal", "commodity_energy"] and not self.user_settings.allow_commodities:
                continue
            if asset_class in ["crypto_major", "crypto_alt"] and not self.user_settings.allow_crypto:
                continue
            
            # Check spread
            if data["spread_pips"] > self.user_settings.max_spread_pips:
                continue
            
            # Check liquidity
            if data["liquidity"] < self.user_settings.min_liquidity_score:
                continue
            
            # Calculate suitability score
            score = 0
            score += data["liquidity"] * 40
            score += (1 - min(data["spread_pips"] / 50, 1)) * 30
            score += (1 - data["volatility"]) * 20
            score += 10 if data["small_account_friendly"] else 0
            
            recommendations.append({
                "symbol": symbol,
                "class": data["class"],
                "description": data.get("description", ""),
                "suitability_score": round(score, 1),
                "spread_pips": data["spread_pips"],
                "liquidity": data["liquidity"],
                "volatility": data["volatility"],
                "min_account": data["min_account"],
                "small_account_friendly": data["small_account_friendly"],
                "best_session": data.get("best_trading_hours", "N/A"),
            })
        
        recommendations.sort(key=lambda x: x["suitability_score"], reverse=True)
        return recommendations[:limit]
    
    def get_assets_to_avoid(self) -> List[Dict]:
        """Get assets that should be avoided"""
        avoid = []
        
        for symbol, data in ASSET_DATABASE.items():
            reasons = []
            
            if self.capital.current_balance < data["min_account"]:
                reasons.append(f"Minimum ${data['min_account']} required")
            
            if not data["small_account_friendly"] and self.capital.current_balance < 50:
                reasons.append("Not friendly for small accounts")
            
            if data["spread_pips"] > self.user_settings.max_spread_pips:
                reasons.append(f"Spread {data['spread_pips']} pips too high")
            
            if data["liquidity"] < self.user_settings.min_liquidity_score:
                reasons.append(f"Liquidity {data['liquidity']} too low")
            
            if reasons:
                avoid.append({
                    "symbol": symbol,
                    "class": data["class"],
                    "reasons": reasons,
                })
        
        return avoid


