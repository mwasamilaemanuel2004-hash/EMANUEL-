# ═══════════════════════════════════════════════════════════════════════════════

class CorrelationManager:
    """
    Complete Correlation Management System
    Prevents over-exposure to correlated assets
    """
    
    def __init__(self):
        self.correlation_groups = {
            "usd_pairs": {
                "symbols": ["EURUSD", "GBPUSD", "AUDUSD", "NZDUSD"],
                "description": "USD-correlated pairs",
                "max_exposure": 2,  # Max positions in this group
            },
            "jpy_pairs": {
                "symbols": ["USDJPY", "EURJPY", "GBPJPY", "AUDJPY"],
                "description": "JPY-correlated pairs",
                "max_exposure": 2,
            },
            "gold_silver": {
                "symbols": ["XAUUSD", "XAGUSD"],
                "description": "Precious metals",
                "max_exposure": 1,
            },
            "crypto_majors": {
                "symbols": ["BTCUSD", "ETHUSD"],
                "description": "Major cryptocurrencies",
                "max_exposure": 1,
            },
            "energy": {
                "symbols": ["WTIUSD", "BRENTUSD", "NATGASUSD"],
                "description": "Energy commodities",
                "max_exposure": 1,
            },
        }
    
    def get_group(self, symbol: str) -> str:
        """Get correlation group for symbol"""
        symbol_upper = symbol.upper()
        for group, data in self.correlation_groups.items():
            if symbol_upper in data["symbols"]:
                return group
        return "independent"
    
    def check_correlation_risk(
        self,
        symbol: str,
        current_positions: Dict[str, Any]
    ) -> Tuple[bool, str]:
        """
        Check if opening a position creates correlation risk
        
        Args:
            symbol: Symbol to check
            current_positions: Currently open positions
        
        Returns:
            (has_risk, explanation)
        """
        symbol_upper = symbol.upper()
        group = self.get_group(symbol_upper)
        
        if group == "independent":
            return False, "No correlation risk - independent asset"
        
        group_data = self.correlation_groups[group]
        max_exposure = group_data["max_exposure"]
        
        # Count positions in same group
        correlated_positions = []
        for pos_symbol in current_positions:
            if self.get_group(pos_symbol.upper()) == group:
                correlated_positions.append(pos_symbol)
        
        if len(correlated_positions) >= max_exposure:
            return True, (
                f"Maximum exposure reached for {group_data['description']}. "
                f"Already holding: {', '.join(correlated_positions)}"
            )
        
        if len(correlated_positions) >= 1:
            return True, (
                f"Correlated position exists: {correlated_positions[0]}. "
                f"Consider different asset class."
            )
        
        return False, "OK"
    
    def get_group_exposure(
        self,
        group: str,
        current_positions: Dict[str, Any]
    ) -> Dict:
        """Get current exposure in a correlation group"""
        positions = []
        total_size = 0.0
        
        for symbol, pos in current_positions.items():
            if self.get_group(symbol.upper()) == group:
                positions.append({
                    "symbol": symbol,
                    "direction": pos.get("direction", "unknown"),
                    "size": pos.get("position_size", 0),
                })
                total_size += pos.get("position_size", 0)
        
        return {
            "group": group,
            "positions": positions,
            "position_count": len(positions),
            "total_size": total_size,
            "max_allowed": self.correlation_groups.get(group, {}).get("max_exposure", 0),
        }
    
    def get_all_group_exposures(self, current_positions: Dict[str, Any]) -> Dict:
        """Get exposure for all correlation groups"""
        exposures = {}
        for group in self.correlation_groups:
            exposure = self.get_group_exposure(group, current_positions)
            if exposure["position_count"] > 0:
                exposures[group] = exposure
        return exposures


