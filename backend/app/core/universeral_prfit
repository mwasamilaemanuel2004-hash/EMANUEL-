# EQUITY CURVE MONITOR
# ═══════════════════════════════════════════════════════════════════════════════

class EquityCurveMonitor:
    """
    Complete Equity Curve Monitoring System
    Tracks balance history and detects anomalies
    """
    
    def __init__(self, max_points: int = 1000):
        self.equity_points: deque = deque(maxlen=max_points)
        self.max_points = max_points
        self.alert_threshold_drawdown: float = 5.0
        self.alert_threshold_rapid_decline: float = 3.0
        self.anomaly_history: List[Dict] = []
    
    def add_point(self, balance: float) -> None:
        """Add equity point to curve"""
        self.equity_points.append({
            'balance': balance,
            'timestamp': datetime.now(),
            'timestamp_unix': int(datetime.now().timestamp()),
        })
    
    def get_current_drawdown(self) -> float:
        """Calculate current drawdown from peak"""
        if not self.equity_points:
            return 0.0
        
        balances = [p['balance'] for p in self.equity_points]
        peak = max(balances)
        current = balances[-1]
        
        if peak == 0:
            return 0.0
        
        return ((peak - current) / peak) * 100
    
    def get_max_drawdown(self) -> float:
        """Get maximum historical drawdown"""
        if not self.equity_points:
            return 0.0
        
        balances = [p['balance'] for p in self.equity_points]
        max_dd = 0.0
        peak = balances[0]
        
        for balance in balances:
            if balance > peak:
                peak = balance
            dd = ((peak - balance) / peak) * 100 if peak > 0 else 0
            max_dd = max(max_dd, dd)
        
        return max_dd
    
    def get_daily_pnl(self) -> float:
        """Get today's PnL"""
        if not self.equity_points:
            return 0.0
        
        today = datetime.now().date()
        today_points = [
            p for p in self.equity_points
            if p['timestamp'].date() == today
        ]
        
        if not today_points:
            return 0.0
        
        return today_points[-1]['balance'] - today_points[0]['balance']
    
    def get_weekly_pnl(self) -> float:
        """Get this week's PnL"""
        if not self.equity_points:
            return 0.0
        
        today = datetime.now()
        week_start = today - timedelta(days=today.weekday())
        week_points = [
            p for p in self.equity_points
            if p['timestamp'].date() >= week_start.date()
        ]
        
        if not week_points:
            return 0.0
        
        return week_points[-1]['balance'] - week_points[0]['balance']
    
    def check_anomalies(self) -> List[str]:
        """Check for equity curve anomalies"""
        anomalies = []
        
        # Check drawdown
        drawdown = self.get_current_drawdown()
        if drawdown > self.alert_threshold_drawdown:
            anomalies.append(f"Drawdown alert: {drawdown:.1f}%")
        
        # Check rapid decline
        if len(self.equity_points) >= 5:
            recent = list(self.equity_points)[-5:]
            balances = [p['balance'] for p in recent]
            total_change = balances[-1] - balances[0]
            change_percent = (total_change / balances[0]) * 100 if balances[0] > 0 else 0
            
            if change_percent < -self.alert_threshold_rapid_decline:
                anomalies.append(f"Rapid decline: {change_percent:.1f}% in last 5 points")
        
        # Store anomalies
        for anomaly in anomalies:
            self.anomaly_history.append({
                "anomaly": anomaly,
                "timestamp": datetime.now().isoformat(),
            })
        
        return anomalies
    
    def get_equity_stats(self) -> Dict:
        """Get comprehensive equity statistics"""
        if not self.equity_points:
            return {}
        
        balances = [p['balance'] for p in self.equity_points]
        
        return {
            "current_balance": balances[-1],
            "peak_balance": max(balances),
            "min_balance": min(balances),
            "avg_balance": np.mean(balances),
            "std_dev": np.std(balances),
            "current_drawdown": round(self.get_current_drawdown(), 2),
            "max_drawdown": round(self.get_max_drawdown(), 2),
            "daily_pnl": round(self.get_daily_pnl(), 2),
            "weekly_pnl": round(self.get_weekly_pnl(), 2),
            "total_points": len(balances),
        }
    
    def reset(self) -> None:
        """Reset equity monitor"""
        self.equity_points.clear()
        self.anomaly_history.clear()
        logger.info("Equity curve monitor reset")


