# TRADE JOURNAL - Complete Trade History
# ═══════════════════════════════════════════════════════════════════════════════

class TradeJournal:
    """
    Complete Trade Journal and Analytics System
    Tracks every trade with full details
    """
    
    def __init__(self):
        self.trades: List[Dict] = []
        self.daily_stats: Dict = {}
        self.total_pnl = 0.0
        self.total_trades = 0
        self.total_wins = 0
        self.total_losses = 0
        self.best_trade = None
        self.worst_trade = None
    
    def log_trade(self, trade_info: Dict) -> None:
        """
        Log a complete trade record
        
        Args:
            trade_info: Dictionary with trade details
        """
        # Add timestamp information
        trade_info['timestamp'] = datetime.now().isoformat()
        trade_info['date'] = datetime.now().strftime('%Y-%m-%d')
        trade_info['day_of_week'] = datetime.now().strftime('%A')
        trade_info['hour'] = datetime.now().hour
        trade_info['minute'] = datetime.now().minute
        trade_info['trade_id'] = hashlib.md5(
            f"{trade_info.get('symbol', '')}{datetime.now().timestamp()}".encode()
        ).hexdigest()[:16]
        
        self.trades.append(trade_info)
        self.total_trades += 1
        
        pnl = trade_info.get('pnl', 0)
        self.total_pnl += pnl
        
        if pnl > 0:
            self.total_wins += 1
            if self.best_trade is None or pnl > self.best_trade.get('pnl', 0):
                self.best_trade = trade_info
        else:
            self.total_losses += 1
            if self.worst_trade is None or pnl < self.worst_trade.get('pnl', 0):
                self.worst_trade = trade_info
        
        # Update daily stats
        date_key = trade_info['date']
        if date_key not in self.daily_stats:
            self.daily_stats[date_key] = {
                'date': date_key,
                'trades': 0,
                'wins': 0,
                'losses': 0,
                'total_pnl': 0.0,
                'max_win': 0.0,
                'max_loss': 0.0,
                'symbols_traded': set(),
                'exit_reasons': {},
            }
        
        stats = self.daily_stats[date_key]
        stats['trades'] += 1
        stats['total_pnl'] += pnl
        stats['symbols_traded'].add(trade_info.get('symbol', 'unknown'))
        
        if pnl > 0:
            stats['wins'] += 1
            stats['max_win'] = max(stats['max_win'], pnl)
        else:
            stats['losses'] += 1
            stats['max_loss'] = min(stats['max_loss'], pnl)
        
        exit_reason = trade_info.get('reason', 'unknown')
        stats['exit_reasons'][exit_reason] = stats['exit_reasons'].get(exit_reason, 0) + 1
    
    def get_performance_summary(self, max_trades: int = 100) -> Dict:
        """
        Get comprehensive performance summary
        
        Args:
            max_trades: Number of recent trades to analyze
        
        Returns:
            Dictionary with performance metrics
        """
        if not self.trades:
            return {
                "total_trades": 0,
                "win_rate": 0,
                "total_pnl": 0,
                "profit_factor": 0,
                "avg_win": 0,
                "avg_loss": 0,
                "best_trade": None,
                "worst_trade": None,
            }
        
        recent = self.trades[-max_trades:]
        wins = [t for t in recent if t.get('pnl', 0) > 0]
        losses = [t for t in recent if t.get('pnl', 0) <= 0]
        
        total_pnl = sum(t.get('pnl', 0) for t in recent)
        gross_win = sum(t.get('pnl', 0) for t in wins)
        gross_loss = abs(sum(t.get('pnl', 0) for t in losses))
        
        return {
            "total_trades": len(recent),
            "win_rate": round(len(wins) / len(recent) * 100, 1) if recent else 0,
            "total_pnl": round(total_pnl, 2),
            "profit_factor": round(gross_win / gross_loss, 2) if gross_loss > 0 else float('inf'),
            "avg_win": round(np.mean([t['pnl'] for t in wins]), 2) if wins else 0,
            "avg_loss": round(np.mean([t['pnl'] for t in losses]), 2) if losses else 0,
            "best_trade": self.best_trade,
            "worst_trade": self.worst_trade,
            "total_wins": self.total_wins,
            "total_losses": self.total_losses,
            "overall_total_pnl": round(self.total_pnl, 2),
        }
    
    def get_daily_summary(self) -> List[Dict]:
        """Get daily trading summary"""
        summaries = []
        for date, stats in sorted(self.daily_stats.items()):
            summaries.append({
                "date": date,
                "trades": stats['trades'],
                "wins": stats['wins'],
                "losses": stats['losses'],
                "win_rate": round(stats['wins'] / stats['trades'] * 100, 1) if stats['trades'] > 0 else 0,
                "total_pnl": round(stats['total_pnl'], 2),
                "max_win": round(stats['max_win'], 2),
                "max_loss": round(stats['max_loss'], 2),
                "symbols": list(stats['symbols_traded']),
            })
        return summaries
    
    def get_exit_reason_analysis(self) -> Dict:
        """Analyze exit reasons"""
        reasons = {}
        for trade in self.trades:
            reason = trade.get('reason', 'unknown')
            if reason not in reasons:
                reasons[reason] = {"count": 0, "total_pnl": 0, "wins": 0, "losses": 0}
            
            reasons[reason]["count"] += 1
            pnl = trade.get('pnl', 0)
            reasons[reason]["total_pnl"] += pnl
            
            if pnl > 0:
                reasons[reason]["wins"] += 1
            else:
                reasons[reason]["losses"] += 1
        
        return reasons
    
    def get_trade_frequency_by_hour(self) -> Dict[int, int]:
        """Get trade frequency by hour of day"""
        hours = {}
        for trade in self.trades:
            hour = trade.get('hour', 0)
            hours[hour] = hours.get(hour, 0) + 1
        return dict(sorted(hours.items()))
    
    def get_trade_frequency_by_day(self) -> Dict[str, int]:
        """Get trade frequency by day of week"""
        days = {}
        for trade in self.trades:
            day = trade.get('day_of_week', '')
            days[day] = days.get(day, 0) + 1
        return days
    
    def get_r_multiple_distribution(self) -> Dict:
        """Get R-multiple distribution"""
        r_values = [t.get('r_multiple', 0) for t in self.trades if 'r_multiple' in t]
        
        if not r_values:
            return {}
        
        return {
            "avg_r": round(np.mean(r_values), 2),
            "median_r": round(np.median(r_values), 2),
            "max_r": round(max(r_values), 2),
            "min_r": round(min(r_values), 2),
            "positive_r_count": sum(1 for r in r_values if r > 0),
            "negative_r_count": sum(1 for r in r_values if r <= 0),
        }
    
    def export_to_json(self, filepath: str = "trade_journal.json") -> bool:
        """Export journal to JSON file"""
        try:
            with open(filepath, 'w', encoding='utf-8') as f:
                json.dump(self.trades, f, indent=2, default=str)
            logger.info(f"Trade journal exported to {filepath}")
            return True
        except Exception as e:
            logger.error(f"Failed to export journal: {e}")
            return False


