# CAPITAL DETECTOR - Complete Account Management
# ═══════════════════════════════════════════════════════════════════════════════

class CapitalDetector:
    """
    Complete Capital Detection and Management System
    Detects account size and manages protection
    """
    
    def __init__(self, initial_balance: float):
        self.initial_balance = initial_balance
        self.current_balance = initial_balance
        self.peak_balance = initial_balance
        self.tier = self._detect_tier()
        self.protection_level = CapitalProtectionLevel.NORMAL
        self.growth_mode = GrowthMode.BALANCED
        self.consecutive_losses = 0
        self.daily_pnl = 0.0
        self.weekly_pnl = 0.0
        self.daily_trades = 0
        self.total_trades = 0
        self.total_wins = 0
        self.total_losses = 0
        self.equity_monitor = EquityCurveMonitor()
        self.equity_monitor.add_point(initial_balance)
        
        logger.info(f"💰 Capital Detected: ${initial_balance:.2f} | Tier: {self.tier.value}")
    
    def _detect_tier(self) -> AccountTier:
        """Detect account tier based on balance"""
        if self.current_balance <= 10:
            return AccountTier.NANO
        elif self.current_balance <= 50:
            return AccountTier.MICRO
        elif self.current_balance <= 500:
            return AccountTier.MINI
        elif self.current_balance <= 5000:
