    def can_open_position(
        self,
        symbol: str,
        candles: Optional[pd.DataFrame] = None
    ) -> Tuple[bool, str]:
        """Check if position can be opened"""
        can_trade, reason = self.capital.can_trade()
        if not can_trade:
            return False, reason
        
        symbol_upper = symbol.upper()
        if symbol_upper not in ASSET_DATABASE:
            return False, f"Asset '{symbol}' not found in database"
        
        data = ASSET_DATABASE[symbol_upper]
        
        # Account check
        if self.capital.current_balance < data["min_account"]:
            return False, f"Minimum ${data['min_account']} required for {symbol}"
        
        # User preference checks
        asset_class = data["class"]
        if asset_class in ["forex_major", "forex_minor"] and not self.user_settings.allow_forex:
            return False, "Forex trading disabled in settings"
        if asset_class in ["commodity_metal", "commodity_energy"] and not self.user_settings.allow_commodities:
            return False, "Commodities disabled in settings"
        if asset_class in ["crypto_major", "crypto_alt"] and not self.user_settings.allow_crypto:
            return False, "Crypto disabled in settings"
        
        # Spread check
        if data["spread_pips"] > self.user_settings.max_spread_pips:
            return False, f"Spread {data['spread_pips']} pips exceeds max {self.user_settings.max_spread_pips}"
        
        # Correlation check
        if self.user_settings.auto_correlation_check:
            has_corr, corr_reason = self.correlation.check_correlation_risk(symbol_upper, self.positions)
            if has_corr:
                return False, corr_reason
        
        # News check
        if self.user_settings.auto_news_filter:
            avoid, news_reason = self.news_filter.should_avoid_trading(symbol_upper)
            if avoid:
                return False, news_reason
        
        return True, "✅ OK"
    
    def open_position(
        self,
        symbol: str,
        direction: TradeDirection,
        entry_price: float,
        stop_loss: float,
        candles: Optional[pd.DataFrame] = None,
        user_risk_percent: Optional[float] = None,
        take_profit: Optional[float] = None
    ) -> Optional[Dict]:
        """Open a new position"""
        can_open, reason = self.can_open_position(symbol, candles)
        if not can_open:
            logger.warning(f"❌ Cannot open {symbol}: {reason}")
            self.alert_system.send_alert(AlertType.WARNING, f"Cannot open {symbol}: {reason}")
            return None
        
        position_size, risk_amount = self.capital.calculate_position_size(
            entry_price, stop_loss, user_risk_percent
        )
        
        if position_size <= 0:
            logger.warning("Position size is zero")
            return None
        
        position = {
            "symbol": symbol.upper(),
            "direction": direction.value,
            "entry_price": entry_price,
            "stop_loss": stop_loss,
            "take_profit": take_profit,
            "position_size": position_size,
            "risk_amount": risk_amount,
            "open_time": datetime.now(),
            "partial_exits": 0,
            "trailing_stop": None,
            "breakeven_activated": False,
            "highest_price": entry_price,
            "lowest_price": entry_price,
            "r_multiple": 0.0,
            "max_r_multiple": 0.0,
        }
        
        self.positions[symbol.upper()] = position
        self.capital.daily_trades += 1
        
        logger.info(f"✅ Opened: {symbol} {direction.value} @ {entry_price} | Size: {position_size:.6f} | Risk: ${risk_amount:.3f}")
        self.alert_system.send_alert(
            AlertType.SUCCESS,
            f"Position opened: {symbol} {direction.value} @ {entry_price}"
        )
        
        return position
    
    def update_position(self, symbol: str, current_price: float) -> None:
        """Update position with current price"""
        symbol = symbol.upper()
        if symbol not in self.positions:
            return
        
        pos = self.positions[symbol]
        pos["highest_price"] = max(pos["highest_price"], current_price)
        pos["lowest_price"] = min(pos["lowest_price"], current_price)
        
        stop_distance = abs(pos["entry_price"] - pos["stop_loss"])
        if stop_distance > 0:
            if pos["direction"] == "long":
                pos["r_multiple"] = (current_price - pos["entry_price"]) / stop_distance
            else:
                pos["r_multiple"] = (pos["entry_price"] - current_price) / stop_distance
        
        pos["max_r_multiple"] = max(pos["max_r_multiple"], pos["r_multiple"])
        
        # Auto breakeven
        if self.user_settings.auto_breakeven and not pos["breakeven_activated"]:
            if pos["r_multiple"] >= self.user_settings.breakeven_activation_r:
                pos["stop_loss"] = pos["entry_price"]
                pos["breakeven_activated"] = True
                logger.info(f"🛡️ Breakeven activated: {symbol}")
        
        # Auto trailing stop
        if self.user_settings.auto_trailing_stop:
            if pos["r_multiple"] >= self.user_settings.take_profit_1_r:
                atr_estimate = (pos["highest_price"] - pos["lowest_price"]) * 0.1
                
                if pos["direction"] == "long":
                    new_stop = pos["highest_price"] - atr_estimate * self.user_settings.trailing_stop_atr_multiplier
                    if new_stop > pos["stop_loss"]:
                        pos["stop_loss"] = new_stop
                        pos["trailing_stop"] = new_stop
                else:
                    new_stop = pos["lowest_price"] + atr_estimate * self.user_settings.trailing_stop_atr_multiplier
                    if new_stop < pos["stop_loss"]:
                        pos["stop_loss"] = new_stop
                        pos["trailing_stop"] = new_stop
    
    def manage_position(self, symbol: str, current_price: float) -> Dict:
        """Manage a position"""
        symbol = symbol.upper()
        if symbol not in self.positions:
            return {"action": "no_position", "symbol": symbol}
        
        self.update_position(symbol, current_price)
        pos = self.positions[symbol]
        
        # Check stop loss
        if pos["direction"] == "long" and current_price <= pos["stop_loss"]:
            return self._close_position(symbol, ExitReason.STOP_LOSS.value, current_price)
        if pos["direction"] == "short" and current_price >= pos["stop_loss"]:
            return self._close_position(symbol, ExitReason.STOP_LOSS.value, current_price)
        
        # Check take profit
        if pos["take_profit"] is not None:
            if pos["direction"] == "long" and current_price >= pos["take_profit"]:
                return self._close_position(symbol, ExitReason.TP2_PARTIAL.value, current_price)
            if pos["direction"] == "short" and current_price <= pos["take_profit"]:
                return self._close_position(symbol, ExitReason.TP2_PARTIAL.value, current_price)
        
        r = pos["r_multiple"]
        
        # Partial exits
        if self.user_settings.auto_partial_exits:
            if pos["partial_exits"] == 0 and r >= self.user_settings.take_profit_1_r:
                pos["partial_exits"] += 1
                return {
                    "action": "partial_exit",
                    "symbol": symbol,
                    "type": "tp1",
                    "exit_percent": self.user_settings.partial_exit_1_percent,
                    "r_multiple": round(r, 2),
                    "price": current_price,
                }
            
            if pos["partial_exits"] == 1 and r >= self.user_settings.take_profit_2_r:
                pos["partial_exits"] += 1
                return {
                    "action": "partial_exit",
                    "symbol": symbol,
                    "type": "tp2",
                    "exit_percent": self.user_settings.partial_exit_2_percent,
                    "r_multiple": round(r, 2),
                    "price": current_price,
                }
        
        # Trend runner exit
        if r >= self.user_settings.trend_runner_r:
            return self._close_position(symbol, ExitReason.TREND_RUNNER_EXIT.value, current_price)
        
        return {"action": "hold", "symbol": symbol, "r_multiple": round(r, 2)}
    
    def _close_position(self, symbol: str, reason: str, current_price: float) -> Dict:
        """Internal position close"""
        symbol = symbol.upper()
        if symbol not in self.positions:
            return {"action": "no_position"}
        
        pos = self.positions[symbol]
        
        if pos["direction"] == "long":
            pnl = (current_price - pos["entry_price"]) * pos["position_size"]
        else:
            pnl = (pos["entry_price"] - current_price) * pos["position_size"]
        
        self.capital.register_trade_result(pnl)
        
        self.journal.log_trade({
            "symbol": symbol,
            "direction": pos["direction"],
            "entry": pos["entry_price"],
            "exit": current_price,
            "pnl": round(pnl, 2),
            "reason": reason,
            "r_multiple": pos["r_multiple"],
            "max_r_multiple": pos["max_r_multiple"],
            "holding_hours": round((datetime.now() - pos["open_time"]).total_seconds() / 3600, 2),
        })
        
        self.trade_history.append({
            "symbol": symbol,
            "direction": pos["direction"],
            "entry": pos["entry_price"],
            "exit": current_price,
            "pnl": round(pnl, 2),
            "reason": reason,
            "r_multiple": round(pos["r_multiple"], 2),
            "timestamp": datetime.now().isoformat(),
        })
        
        del self.positions[symbol]
        
        icon = "✅" if pnl > 0 else "❌"
        logger.info(f"{icon} Closed: {symbol} | PnL: ${pnl:.2f} | {reason}")
        self.alert_system.send_alert(
            AlertType.SUCCESS if pnl > 0 else AlertType.WARNING,
            f"Closed: {symbol} | PnL: ${pnl:.2f} | {reason}"
        )
        
        return {
            "action": "exit_full",
            "symbol": symbol,
            "pnl": round(pnl, 2),
            "reason": reason,
            "r_multiple": round(pos["r_multiple"], 2),
        }
    
    def close_position_manually(self, symbol: str, current_price: float) -> Dict:
        """Manually close a position"""
        return self._close_position(symbol, ExitReason.MANUAL_EXIT.value, current_price)
    
    def close_all_positions(self, current_prices: Dict[str, float]) -> List[Dict]:
        """Close all positions"""
        results = []
        for symbol in list(self.positions.keys()):
            if symbol in current_prices:
                results.append(self._close_position(symbol, ExitReason.SYSTEM_EXIT.value, current_prices[symbol]))
        return results
    
