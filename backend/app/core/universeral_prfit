        event_name: str,
        impact: str = "medium"
    ) -> None:
        """
        Add a news event
        
        Args:
            event_time: Time of the event
            currency: Affected currency (USD, EUR, etc.)
            event_name: Name of the event
            impact: Impact level (high, medium, low)
        """
        self.upcoming_events.append({
            "time": event_time,
            "currencies": [currency],
            "name": event_name,
            "impact": impact,
        })
        
        logger.info(f"News event added: {event_name} ({currency}) at {event_time}")
    
    def check_news_proximity(self, symbol: str) -> Tuple[bool, int]:
        """
        Check if there's upcoming news for this symbol
        
        Returns:
            (has_news_nearby, minutes_until_news)
        """
        current_time = datetime.utcnow()
        symbol_currencies = self._extract_currencies(symbol)
        
        for event in self.upcoming_events:
            event_time = event.get('time', datetime.utcnow())
            event_currencies = event.get('currencies', [])
            
            # Check if event affects this symbol
            if any(cur in event_currencies for cur in symbol_currencies):
                time_diff = (event_time - current_time).total_seconds() / 60
                
                if 0 <= time_diff <= self.buffer_minutes:
                    return True, int(time_diff)
                elif -5 <= time_diff < 0:
                    # Just passed within last 5 minutes
                    return True, 0
        
        return False, 0
    
    def should_avoid_trading(self, symbol: str) -> Tuple[bool, str]:
        """Check if trading should be avoided"""
        has_news, minutes = self.check_news_proximity(symbol)
        
        if has_news:
            if minutes <= 5:
                return True, f"🚨 HIGH IMPACT NEWS IMMINENT ({minutes} min) - DO NOT TRADE"
            elif minutes <= 15:
                return True, f"⚠️ News in {minutes} minutes - wait for release"
            else:
                return True, f"⚠️ News approaching ({minutes} min) - use caution"
        
        return False, "OK"
    
    def _extract_currencies(self, symbol: str) -> List[str]:
        """Extract currencies from symbol"""
        symbol_upper = symbol.upper()
        
        if 'XAU' in symbol_upper:
            return ['USD', 'XAU']
        if 'XAG' in symbol_upper:
            return ['USD', 'XAG']
        if 'BTC' in symbol_upper:
            return ['USD', 'BTC']
        if 'ETH' in symbol_upper:
            return ['USD', 'ETH']
        if len(symbol_upper) == 6:
            return [symbol_upper[:3], symbol_upper[3:]]
        
        return ['USD']
    
    def clear_old_events(self) -> None:
        """Clear events that have already passed"""
        current_time = datetime.utcnow()
        self.upcoming_events = [
            e for e in self.upcoming_events
            if e.get('time', current_time) > current_time - timedelta(minutes=5)
        ]


