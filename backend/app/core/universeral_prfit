# MARKET DETECTOR - Complete Market Analysis
# ═══════════════════════════════════════════════════════════════════════════════

class MarketDetector:
    """
    Complete Market Detection and Analysis System
    Analyzes all aspects of market conditions
    """
    
    def __init__(self):
        self.current_regime: Optional[MarketRegime] = None
        self.current_quality: Optional[MarketQuality] = None
        self.market_score: float = 50.0
        self.last_analysis: Optional[Dict] = None
        self.analysis_history: deque = deque(maxlen=100)
    
    def analyze_market(
        self,
        candles: pd.DataFrame,
        symbol: str = ""
    ) -> Dict:
        """
        Complete market analysis
        
        Args:
            candles: OHLCV DataFrame
            symbol: Trading symbol
        
        Returns:
            Complete analysis dictionary
        """
        if candles is None or len(candles) < 20:
            return {
                "error": "Insufficient data",
                "score": 0,
                "regime": "unknown",
                "quality": "unknown",
                "recommendation": "Need at least 20 candles",
            }
        
        close = candles['close'].values
        high = candles['high'].values
        low = candles['low'].values
        volume = candles['volume'].values if 'volume' in candles.columns else np.zeros(len(close))
        
        # ═══════════════════════════════════════════════════════════════
        # 1. ATR Calculation
        # ═══════════════════════════════════════════════════════════════
        atr = self._calculate_atr(high, low, close)
        current_atr = atr[-1] if len(atr) > 0 else 0
        atr_percent = current_atr / close[-1] if close[-1] > 0 else 0
        
        # ═══════════════════════════════════════════════════════════════
        # 2. Moving Averages
        # ═══════════════════════════════════════════════════════════════
        sma_20 = np.mean(close[-20:]) if len(close) >= 20 else np.mean(close)
        sma_50 = np.mean(close[-50:]) if len(close) >= 50 else sma_20
        sma_200 = np.mean(close[-200:]) if len(close) >= 200 else sma_50
        
        # ═══════════════════════════════════════════════════════════════
        # 3. Trend Analysis
        # ═══════════════════════════════════════════════════════════════
        price_above_sma20 = close[-1] > sma_20
        price_above_sma50 = close[-1] > sma_50
        price_above_sma200 = close[-1] > sma_200
        sma20_above_sma50 = sma_20 > sma_50
        sma50_above_sma200 = sma_50 > sma_200
        
        # Determine trend direction
        if price_above_sma20 and price_above_sma50 and price_above_sma200 and sma20_above_sma50 and sma50_above_sma200:
            trend_direction = 1.0  # Strong bullish
        elif not price_above_sma20 and not price_above_sma50 and not price_above_sma200 and not sma20_above_sma50 and not sma50_above_sma200:
            trend_direction = -1.0  # Strong bearish
        elif price_above_sma20 and price_above_sma50:
            trend_direction = 0.7  # Moderate bullish
        elif not price_above_sma20 and not price_above_sma50:
            trend_direction = -0.7  # Moderate bearish
        elif price_above_sma20:
            trend_direction = 0.3  # Weak bullish
        else:
            trend_direction = -0.3  # Weak bearish
        
        # Trend strength (based on distance from SMAs)
        distance_from_sma20 = abs(close[-1] - sma_20) / (current_atr + 1e-10)
        trend_strength = min(distance_from_sma20 / 3.0, 1.0)
        
        # ═══════════════════════════════════════════════════════════════
        # 4. RSI (Momentum)
        # ═══════════════════════════════════════════════════════════════
        rsi = self._calculate_rsi(close)
        current_rsi = rsi[-1] if len(rsi) > 0 else 50
        momentum = (current_rsi - 50) / 50.0
        
        # ═══════════════════════════════════════════════════════════════
        # 5. Volatility State
        # ═══════════════════════════════════════════════════════════════
        volatility_state = self._calculate_volatility_state(atr_percent)
        
        # ═══════════════════════════════════════════════════════════════
        # 6. ADX (Trend Strength)
        # ═══════════════════════════════════════════════════════════════
        adx, plus_di, minus_di = self._calculate_adx(high, low, close)
        current_adx = adx[-1] if len(adx) > 0 else 25
        
        # ═══════════════════════════════════════════════════════════════
        # 7. Market Structure
        # ═══════════════════════════════════════════════════════════════
        structure_bias = self._calculate_structure_bias(high, low)
        
        # ═══════════════════════════════════════════════════════════════
        # 8. Volume Analysis
        # ═══════════════════════════════════════════════════════════════
        volume_ratio = 1.0
        if len(volume) > 20 and np.mean(volume[-20:]) > 0:
            volume_ratio = volume[-1] / np.mean(volume[-20:])
        
        # ═══════════════════════════════════════════════════════════════
        # 9. Regime Classification
        # ═══════════════════════════════════════════════════════════════
        regime = self._classify_regime(
            trend_strength, trend_direction, volatility_state, current_adx
        )
        self.current_regime = regime
        
        # ═══════════════════════════════════════════════════════════════
        # 10. Market Quality Score
        # ═══════════════════════════════════════════════════════════════
        quality_score = self._calculate_quality_score(
            trend_strength, abs(trend_direction), volatility_state,
            current_adx, atr_percent, volume_ratio
        )
        self.market_score = quality_score
        
        # ═══════════════════════════════════════════════════════════════
        # 11. Quality Classification
        # ═══════════════════════════════════════════════════════════════
        quality = self._classify_quality(quality_score)
        self.current_quality = quality
        
        # Build analysis result
        analysis = {
            "symbol": symbol,
            "timestamp": datetime.now().isoformat(),
            "regime": regime.value,
            "quality": quality.value,
            "quality_score": round(quality_score, 1),
            "trend_direction": round(trend_direction, 2),
            "trend_strength": round(trend_strength, 2),
            "adx": round(current_adx, 1),
            "rsi": round(current_rsi, 1),
            "momentum": round(momentum, 2),
            "volatility_state": round(volatility_state, 2),
            "atr": round(current_atr, 5),
            "atr_percent": round(atr_percent * 100, 3),
            "structure_bias": round(structure_bias, 2),
            "volume_ratio": round(volume_ratio, 2),
            "sma_20": round(sma_20, 5),
            "sma_50": round(sma_50, 5),
            "sma_200": round(sma_200, 5),
            "recommendation": self._get_recommendation(quality, trend_direction, trend_strength),
        }
        
        self.last_analysis = analysis
        self.analysis_history.append(analysis)
        
        return analysis
    
    def _calculate_atr(self, high: np.ndarray, low: np.ndarray, close: np.ndarray, period: int = 14) -> np.ndarray:
        """Calculate Average True Range"""
        tr = np.zeros(len(close))
        for i in range(1, len(close)):
            tr[i] = max(
                high[i] - low[i],
                abs(high[i] - close[i-1]),
                abs(low[i] - close[i-1])
            )
        tr[0] = high[0] - low[0]
        
        atr = np.zeros(len(close))
        if len(close) >= period:
            atr[period-1] = np.mean(tr[:period])
            for i in range(period, len(close)):
                atr[i] = (atr[i-1] * (period - 1) + tr[i]) / period
        return atr
    
    def _calculate_rsi(self, close: np.ndarray, period: int = 14) -> np.ndarray:
        """Calculate Relative Strength Index"""
        rsi = np.zeros(len(close))
        if len(close) <= period:
            return rsi
        
        gains = np.zeros(len(close))
        losses = np.zeros(len(close))
        
        for i in range(1, len(close)):
            change = close[i] - close[i-1]
            gains[i] = max(change, 0)
            losses[i] = max(-change, 0)
        
        avg_gain = np.mean(gains[1:period+1])
        avg_loss = np.mean(losses[1:period+1])
        
        if avg_loss == 0:
            rsi[period] = 100
        else:
            rs = avg_gain / avg_loss
            rsi[period] = 100 - (100 / (1 + rs))
        
        for i in range(period+1, len(close)):
            avg_gain = (avg_gain * (period - 1) + gains[i]) / period
            avg_loss = (avg_loss * (period - 1) + losses[i]) / period
            
            if avg_loss == 0:
                rsi[i] = 100
            else:
                rs = avg_gain / avg_loss
                rsi[i] = 100 - (100 / (1 + rs))
        
        return rsi
    
    def _calculate_adx(self, high: np.ndarray, low: np.ndarray, close: np.ndarray, period: int = 14) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
        """Calculate Average Directional Index"""
        plus_dm = np.zeros(len(close))
        minus_dm = np.zeros(len(close))
        tr = np.zeros(len(close))
        
        for i in range(1, len(close)):
            up_move = high[i] - high[i-1]
            down_move = low[i-1] - low[i]
            
            plus_dm[i] = up_move if up_move > down_move and up_move > 0 else 0
            minus_dm[i] = down_move if down_move > up_move and down_move > 0 else 0
            
            tr[i] = max(
                high[i] - low[i],
                abs(high[i] - close[i-1]),
                abs(low[i] - close[i-1])
            )
        
        plus_di = np.zeros(len(close))
        minus_di = np.zeros(len(close))
        adx = np.zeros(len(close))
        
        if len(close) > period:
            tr_sum = np.sum(tr[:period])
            plus_dm_sum = np.sum(plus_dm[:period])
            minus_dm_sum = np.sum(minus_dm[:period])
            
            if tr_sum > 0:
                plus_di[period-1] = 100 * plus_dm_sum / tr_sum
                minus_di[period-1] = 100 * minus_dm_sum / tr_sum
            
            for i in range(period, len(close)):
                tr_sum = tr_sum - tr_sum/period + tr[i]
                plus_dm_sum = plus_dm_sum - plus_dm_sum/period + plus_dm[i]
                minus_dm_sum = minus_dm_sum - minus_dm_sum/period + minus_dm[i]
                
                if tr_sum > 0:
                    plus_di[i] = 100 * plus_dm_sum / tr_sum
                    minus_di[i] = 100 * minus_dm_sum / tr_sum
                
                dx_sum = plus_di[i] + minus_di[i]
                dx = 100 * abs(plus_di[i] - minus_di[i]) / dx_sum if dx_sum > 0 else 0
                
                if i == period:
                    adx[i] = dx
                else:
                    adx[i] = (adx[i-1] * (period - 1) + dx) / period
        
        return adx, plus_di, minus_di
    
    def _calculate_volatility_state(self, atr_percent: float) -> float:
        """Calculate volatility state from ATR percentage"""
        if atr_percent < 0.002:
            return 0.2   # Very low volatility
        elif atr_percent < 0.005:
            return 0.4   # Low volatility
        elif atr_percent < 0.01:
            return 0.6   # Moderate volatility
        elif atr_percent < 0.02:
            return 0.8   # High volatility
        else:
            return 1.0   # Extreme volatility
    
    def _calculate_structure_bias(self, high: np.ndarray, low: np.ndarray) -> float:
        """Calculate market structure bias"""
        if len(high) < 10:
            return 0.0
        
        recent_highs = high[-10:]
        recent_lows = low[-10:]
        
        higher_highs = sum(1 for i in range(1, len(recent_highs)) if recent_highs[i] > recent_highs[i-1])
        higher_lows = sum(1 for i in range(1, len(recent_lows)) if recent_lows[i] > recent_lows[i-1])
        lower_highs = sum(1 for i in range(1, len(recent_highs)) if recent_highs[i] < recent_highs[i-1])
        lower_lows = sum(1 for i in range(1, len(recent_lows)) if recent_lows[i] < recent_lows[i-1])
        
        if higher_highs > lower_highs and higher_lows > lower_lows:
            return 1.0   # Bullish structure
        elif lower_highs > higher_highs and lower_lows > higher_lows:
            return -1.0  # Bearish structure
        else:
            return 0.0   # Neutral/mixed structure
    
    def _classify_regime(
        self,
        trend_strength: float,
        trend_direction: float,
        volatility_state: float,
        adx: float
    ) -> MarketRegime:
        """Classify market regime"""
        if volatility_state > 0.7:
            return MarketRegime.HIGH_VOLATILITY
        
        if adx > 30 and trend_strength > 0.6:
            if trend_direction > 0.5:
                return MarketRegime.STRONG_TRENDING_UP
            elif trend_direction < -0.5:
                return MarketRegime.STRONG_TRENDING_DOWN
        
        if adx > 20 and trend_strength > 0.35:
            if trend_direction > 0.3:
                return MarketRegime.MODERATE_TRENDING_UP
            elif trend_direction < -0.3:
                return MarketRegime.MODERATE_TRENDING_DOWN
        
        if volatility_state < 0.3:
            return MarketRegime.LOW_VOLATILITY
        
        return MarketRegime.RANGING
    
    def _calculate_quality_score(
        self,
        trend_strength: float,
        trend_direction_abs: float,
        volatility_state: float,
        adx: float,
        atr_percent: float,
        volume_ratio: float
    ) -> float:
        """Calculate comprehensive market quality score (0-100)"""
        score = 50.0  # Base score
        
        # Trend bonus (up to +25)
        score += trend_strength * 25
        
        # Direction bonus (up to +10)
        score += trend_direction_abs * 10
        
        # ADX bonus (up to +10)
        score += min(adx / 50.0, 1.0) * 10
        
        # Volatility adjustment
        if 0.3 <= volatility_state <= 0.6:
            score += 10  # Optimal volatility
        elif volatility_state > 0.7:
            score -= 20  # Too volatile
        elif volatility_state < 0.2:
            score -= 10  # Too quiet
        
        # ATR penalty for extreme volatility
        if atr_percent > 0.03:
            score -= 15
        elif atr_percent > 0.02:
            score -= 5
        
        # Volume bonus
        if volume_ratio > 1.5:
            score += 5
        elif volume_ratio < 0.5:
            score -= 5
        
        return float(np.clip(score, 0, 100))
    
    def _classify_quality(self, score: float) -> MarketQuality:
        """Classify market quality from score"""
        if score >= 75:
            return MarketQuality.EXCELLENT
        elif score >= 60:
            return MarketQuality.GOOD
        elif score >= 45:
            return MarketQuality.FAIR
        elif score >= 30:
            return MarketQuality.POOR
        elif score >= 15:
            return MarketQuality.DANGEROUS
        else:
            return MarketQuality.UNTRADEABLE
    
    def _get_recommendation(
        self,
        quality: MarketQuality,
        trend_direction: float,
        trend_strength: float
    ) -> str:
        """Get trading recommendation based on market quality"""
        recommendations = {
            MarketQuality.EXCELLENT: "✅ SOKO ZURI SANA! Trade kwa confidence. Ongeza position size kidogo.",
            MarketQuality.GOOD: "✅ Soko ni nzuri. Trade kawaida na fuata mfumo wako.",
            MarketQuality.FAIR: "⚠️ Soko la wastani. Trade kwa tahadhari na punguza size.",
            MarketQuality.POOR: "❌ Soko ni baya. Punguza size au subiri soko bora.",
            MarketQuality.DANGEROUS: "🚫 Soko ni hatari! Usitrade au risk kidogo sana.",
            MarketQuality.UNTRADEABLE: "⛔ Soko haliwezi ku-trade. Subiri hadi hali ibadilike.",
        }
        return recommendations.get(quality, "Hali ya soko haijulikani")


