    def get_risk_multiplier(self) -> float:
        """Get risk multiplier based on protection level"""
        multipliers = {
            CapitalProtectionLevel.NORMAL: 1.0,
            CapitalProtectionLevel.CAUTION: 0.7,
            CapitalProtectionLevel.HIGH_ALERT: 0.4,
            CapitalProtectionLevel.CRITICAL: 0.2,
            CapitalProtectionLevel.EMERGENCY: 0.1,
            CapitalProtectionLevel.LOCKDOWN: 0.0,
        }
        return multipliers.get(self.protection_level, 1.0)
    
    def update_protection_level(self) -> None:
        """Update protection level based on drawdown and losses"""
        if self.peak_balance > 0:
            drawdown = (self.peak_balance - self.current_balance) / self.peak_balance * 100
        else:
            drawdown = 0
        
        old_level = self.protection_level
        
        if drawdown >= 12 or self.consecutive_losses >= 5:
            self.protection_level = CapitalProtectionLevel.LOCKDOWN
        elif drawdown >= 9 or self.consecutive_losses >= 4:
            self.protection_level = CapitalProtectionLevel.EMERGENCY
        elif drawdown >= 6 or self.consecutive_losses >= 3:
            self.protection_level = CapitalProtectionLevel.CRITICAL
        elif drawdown >= 4 or self.consecutive_losses >= 2:
            self.protection_level = CapitalProtectionLevel.HIGH_ALERT
        elif drawdown >= 2:
            self.protection_level = CapitalProtectionLevel.CAUTION
        else:
            self.protection_level = CapitalProtectionLevel.NORMAL
        
        # Update growth mode
        if self.protection_level == CapitalProtectionLevel.LOCKDOWN:
            self.growth_mode = GrowthMode.EMERGENCY
        elif self.protection_level == CapitalProtectionLevel.EMERGENCY:
            self.growth_mode = GrowthMode.RECOVERY
        elif self.protection_level == CapitalProtectionLevel.CRITICAL:
            self.growth_mode = GrowthMode.PROTECTIVE
        elif self.protection_level == CapitalProtectionLevel.HIGH_ALERT:
            self.growth_mode = GrowthMode.CONSERVATIVE
        else:
            self.growth_mode = GrowthMode.BALANCED
        
        if old_level != self.protection_level:
            logger.warning(
                f"Protection level changed: {old_level.value} → {self.protection_level.value} | "
                f"Drawdown: {drawdown:.1f}% | Consecutive losses: {self.consecutive_losses}"
            )
    
    def register_trade_result(self, pnl: float) -> None:
        """Register trade result and update all metrics"""
        self.current_balance += pnl
        self.equity_monitor.add_point(self.current_balance)
        self.daily_pnl += pnl
        self.weekly_pnl += pnl
        self.daily_trades += 1
        self.total_trades += 1
        
        if self.current_balance > self.peak_balance:
            self.peak_balance = self.current_balance
        
        if pnl > 0:
            self.total_wins += 1
            self.consecutive_losses = 0
        else:
            self.total_losses += 1
            self.consecutive_losses += 1
        
        self.tier = self._detect_tier()
        self.update_protection_level()
    
    def can_trade(self) -> Tuple[bool, str]:
        """Check if trading is allowed"""
        if self.protection_level == CapitalProtectionLevel.LOCKDOWN:
            return False, "🔒 LOCKDOWN: Trading halted - maximum drawdown reached"
        
        if self.protection_level == CapitalProtectionLevel.EMERGENCY and self.consecutive_losses >= 1:
            return False, "🚨 EMERGENCY: Stop trading - consecutive losses detected"
        
        settings = self.get_recommended_settings()
        if self.daily_trades >= settings["max_trades_per_day"]:
            return False, f"📊 Max daily trades reached ({settings['max_trades_per_day']})"
        
        daily_limit = self.current_balance * settings["max_daily_loss"] / 100
        if self.daily_pnl <= -daily_limit:
            return False, f"💸 Daily loss limit reached (${daily_limit:.2f})"
        
        return True, "✅ OK"
    
    def calculate_position_size(
        self,
        entry_price: float,
        stop_loss: float,
        user_risk_percent: Optional[float] = None
    ) -> Tuple[float, float]:
        """
        Calculate position size based on risk
        
        Returns:
            (position_size, risk_amount)
        """
        settings = self.get_recommended_settings()
        
        if user_risk_percent is not None:
            risk_percent = user_risk_percent / 100
        else:
            risk_percent = settings["risk_per_trade"] / 100
        
        # Apply protection multiplier
        risk_percent *= self.get_risk_multiplier()
        
        risk_amount = self.current_balance * risk_percent
        stop_distance = abs(entry_price - stop_loss)
        
        if stop_distance == 0:
            return 0.0, 0.0
        
        position_size = risk_amount / stop_distance
        
        # Cap at 50% of account
        max_position = (self.current_balance * 0.5) / entry_price if entry_price > 0 else 0
        position_size = min(position_size, max_position)
        
        return position_size, risk_amount
    
    def get_status(self) -> Dict:
        """Get comprehensive capital status"""
        can_trade, reason = self.can_trade()
        settings = self.get_recommended_settings()
        equity_stats = self.equity_monitor.get_equity_stats()
        
        return {
            "balance": self.current_balance,
            "initial_balance": self.initial_balance,
            "peak_balance": self.peak_balance,
            "tier": self.tier.value,
            "protection_level": self.protection_level.value,
            "growth_mode": self.growth_mode.value,
            "drawdown_percent": round(
                (self.peak_balance - self.current_balance) / self.peak_balance * 100, 2
            ) if self.peak_balance > 0 else 0,
            "consecutive_losses": self.consecutive_losses,
            "daily_pnl": round(self.daily_pnl, 2),
            "weekly_pnl": round(self.weekly_pnl, 2),
            "daily_trades": self.daily_trades,
            "total_trades": self.total_trades,
            "win_rate": round(self.total_wins / self.total_trades * 100, 1) if self.total_trades > 0 else 0,
            "risk_multiplier": self.get_risk_multiplier(),
            "can_trade": can_trade,
            "can_trade_reason": reason,
            "recommended_risk_percent": settings["risk_per_trade"],
            "recommended_max_daily_loss": settings["max_daily_loss"],
            "recommended_max_trades": settings["max_trades_per_day"],
            "recommended_assets": settings["recommended_assets"],
            "avoid_assets": settings["avoid_assets"],
            "strategy": settings["strategy"],
            "description": settings["description"],
            "equity_stats": equity_stats,
        }
    
    def reset_daily(self) -> None:
        """Reset daily counters"""
        self.daily_pnl = 0.0
        self.daily_trades = 0
        logger.info("Daily counters reset")


