class AlertSystem:
    """
    Complete Alert and Notification System
    Handles all types of alerts with callbacks
    """
    
    def __init__(self):
        self.alerts: deque = deque(maxlen=1000)
        self.alert_callbacks: List[Callable] = []
        self.enabled = True
        self.alert_count = 0
        self.alert_counts_by_type: Dict[str, int] = {}
    
    def add_callback(self, callback: Callable) -> None:
        """
        Add a callback function to receive alerts
        
        Args:
            callback: Function that takes alert dict as argument
        """
        self.alert_callbacks.append(callback)
        logger.info(f"Alert callback added: {callback.__name__ if hasattr(callback, '__name__') else 'anonymous'}")
    
    def remove_callback(self, callback: Callable) -> bool:
        """Remove a callback function"""
        if callback in self.alert_callbacks:
            self.alert_callbacks.remove(callback)
            return True
        return False
    
    def send_alert(
        self,
        alert_type: AlertType,
        message: str,
        data: Optional[Dict] = None
    ) -> None:
        """
        Send an alert to all subscribers
        
        Args:
            alert_type: Type of alert (INFO, WARNING, CRITICAL, SUCCESS)
            message: Alert message
            data: Optional additional data
        """
        if not self.enabled:
            return
        
        alert = {
            "id": self.alert_count + 1,
            "type": alert_type.value,
            "message": message,
            "data": data or {},
            "timestamp": datetime.now().isoformat(),
            "timestamp_unix": int(datetime.now().timestamp()),
        }
        
        self.alerts.append(alert)
        self.alert_count += 1
        
        # Update type counts
        self.alert_counts_by_type[alert_type.value] = (
            self.alert_counts_by_type.get(alert_type.value, 0) + 1
        )
        
        # Log with appropriate level and icon
        icons = {
            AlertType.INFO: "ℹ️",
            AlertType.WARNING: "⚠️",
            AlertType.CRITICAL: "🚨",
            AlertType.SUCCESS: "✅",
        }
        icon = icons.get(alert_type, "📢")
        
        if alert_type == AlertType.CRITICAL:
            logger.critical(f"{icon} {message}")
        elif alert_type == AlertType.WARNING:
            logger.warning(f"{icon} {message}")
        elif alert_type == AlertType.SUCCESS:
            logger.info(f"{icon} {message}")
        else:
            logger.info(f"{icon} {message}")
        
        # Execute callbacks
        for callback in self.alert_callbacks:
            try:
                callback(alert)
            except Exception as e:
                logger.error(f"Alert callback error: {e}")
    
    def get_recent_alerts(self, limit: int = 10) -> List[Dict]:
        """Get recent alerts"""
        return list(self.alerts)[-limit:]
    
    def get_alerts_by_type(self, alert_type: str, limit: int = 50) -> List[Dict]:
        """Get alerts filtered by type"""
        return [a for a in self.alerts if a["type"] == alert_type][-limit:]
    
    def get_alert_statistics(self) -> Dict:
        """Get alert statistics"""
        return {
            "total_alerts": self.alert_count,
            "alerts_by_type": self.alert_counts_by_type,
            "recent_alerts": len(self.alerts),
        }
    
    def clear_alerts(self) -> None:
        """Clear all alerts"""
        self.alerts.clear()
        logger.info("All alerts cleared")


