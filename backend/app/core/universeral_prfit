def create_sample_candles(n: int = 200, symbol: str = "EURUSD") -> pd.DataFrame:
    """Create sample candle data for testing"""
    np.random.seed(42)
    
    base_price = 1.1000 if "EURUSD" in symbol else 1800 if "XAU" in symbol else 50000 if "BTC" in symbol else 100
    returns = np.random.normal(0.0002, 0.001, n)
    close = base_price * np.cumprod(1 + returns)
    
    high = close * (1 + np.abs(np.random.normal(0, 0.0008, n)))
    low = close * (1 - np.abs(np.random.normal(0, 0.0008, n)))
    open_price = np.roll(close, 1)
    open_price[0] = base_price
    
    volume = np.random.uniform(1000, 10000, n)
    
    return pd.DataFrame({
        'open': open_price,
        'high': high,
        'low': low,
        'close': close,
        'volume': volume,
    })


