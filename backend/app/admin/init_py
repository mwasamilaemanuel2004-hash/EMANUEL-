# Convenience functions
def create_admin(username: str, password: str, email: str, role: str = 'admin') -> Dict[str, Any]:
    """Create admin account"""
    from .admin_auth import AdminRole
    role_map = {
        'admin': AdminRole.ADMIN,
        'moderator': AdminRole.MODERATOR,
        'support': AdminRole.SUPPORT,
        'super_admin': AdminRole.SUPER_ADMIN
    }
    return admin_manager.auth.create_admin(
        username=username,
        password=password,
        email=email,
        role=role_map.get(role, AdminRole.ADMIN)
    )


def login_admin(username: str, password: str, ip: str = None) -> Dict[str, Any]:
    """Login admin"""
    result = admin_manager.auth.login(username, password, ip)
    if result.get('success'):
        admin_manager.record_login(username)
    return result


