class AdminManager:
    """
    ULTRA ADVANCED ADMIN MANAGER
    Central manager for all admin components
    Singleton pattern
    """
    
    _instance = None
    _lock = threading.Lock()
    
    def __new__(cls):
        """Singleton pattern"""
        if cls._instance is None:
            with cls._lock:
                if cls._instance is None:
                    cls._instance = super().__new__(cls)
                    cls._instance._initialized = False
        return cls._instance
    
    def __init__(self):
        """Initialize Admin Manager"""
        if self._initialized:
            return
        
        self._initialized = True
        
        # Initialize components
        self.auth = AdminAuth()
        self.controller = AdminController()
        self.trade_override = TradeOverride()
        self.system_updater = SystemUpdater()
        
        # Statistics
        self.stats = {
            'total_logins': 0,
            'total_actions': 0,
            'total_overrides': 0,
            'total_updates': 0,
            'last_activity': None
        }
        
        # Threading
        self._lock = threading.RLock()
        
        logger.info("👑 ULTRA ADVANCED Admin Manager initialized")
        logger.info(f"   Version: {__version__}")
        logger.info(f"   Auth: {'✅' if self.auth else '❌'}")
        logger.info(f"   Controller: {'✅' if self.controller else '❌'}")
        logger.info(f"   Trade Override: {'✅' if self.trade_override else '❌'}")
        logger.info(f"   System Updater: {'✅' if self.system_updater else '❌'}")
    
    def get_stats(self) -> Dict[str, Any]:
        """Get admin statistics"""
        return {
            **self.stats,
            'auth': self.auth.get_security_status(),
            'timestamp': datetime.utcnow().isoformat()
        }
    
    def record_action(self, action: str, details: Dict = None) -> None:
        """Record admin action"""
        with self._lock:
            self.stats['total_actions'] += 1
            self.stats['last_activity'] = datetime.utcnow().isoformat()
            
            logger.info(f"📝 Admin action: {action}")
    
    def record_login(self, username: str) -> None:
        """Record admin login"""
        with self._lock:
            self.stats['total_logins'] += 1
            self.stats['last_activity'] = datetime.utcnow().isoformat()
    
    def record_override(self, details: Dict = None) -> None:
        """Record trade override"""
        with self._lock:
            self.stats['total_overrides'] += 1
            self.stats['last_activity'] = datetime.utcnow().isoformat()
    
    def record_update(self, details: Dict = None) -> None:
        """Record system update"""
        with self._lock:
            self.stats['total_updates'] += 1
            self.stats['last_activity'] = datetime.utcnow().isoformat()
    
    def health_check(self) -> Dict[str, Any]:
        """Check admin system health"""
        return {
            'status': 'healthy',
            'auth': True,
            'controller': True,
            'trade_override': True,
            'system_updater': True,
            'stats': self.stats,
            'timestamp': datetime.utcnow().isoformat()
        }
    
    def shutdown(self) -> None:
        """Shutdown admin manager"""
        logger.info("👋 Admin Manager shutting down")
        
        # Cleanup
        self.stats['last_activity'] = datetime.utcnow().isoformat()


