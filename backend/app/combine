class ConnectionPool:
    """Advanced Connection Pool"""
    
    def __init__(self, max_connections: int = 10):
        self.max_connections = max_connections
        self.connections = []
        self.in_use = set()
        self._lock = threading.Lock()
        self._condition = threading.Condition(self._lock)
    
    def acquire(self, database_path: str) -> sqlite3.Connection:
        """Acquire connection"""
        with self._condition:
            while len(self.in_use) >= self.max_connections:
                self._condition.wait()
            
            conn = sqlite3.connect(database_path, check_same_thread=False)
            conn.row_factory = sqlite3.Row
            self.in_use.add(id(conn))
            return conn
    
    def release(self, conn: sqlite3.Connection):
        """Release connection"""
        with self._condition:
            self.in_use.discard(id(conn))
            conn.close()
            self._condition.notify()


class CacheManager:
    """Redis Cache Manager"""
    
    def __init__(self, enabled: bool = False, host: str = 'localhost', port: int = 6379):
        self.enabled = enabled
        self.redis_client = None
        
        if enabled and REDIS_AVAILABLE:
            try:
                self.redis_client = redis.Redis(host=host, port=port, decode_responses=True)
                self.redis_client.ping()
                logger.info("✅ Redis connected")
            except:
                self.redis_client = None
                logger.warning("Redis connection failed - using in-memory cache")
        
        self.memory_cache = {}
        self.cache_timestamps = {}
        self._lock = threading.Lock()
    
    def get(self, key: str) -> Optional[Any]:
        """Get from cache"""
        if self.redis_client:
            try:
                value = self.redis_client.get(key)
                return json.loads(value) if value else None
            except:
                pass
        
        with self._lock:
            if key in self.memory_cache:
                timestamp = self.cache_timestamps.get(key, 0)
                if time.time() - timestamp < 300:  # 5 min default
                    return self.memory_cache[key]
                else:
                    del self.memory_cache[key]
                    del self.cache_timestamps[key]
        
        return None
    
    def set(self, key: str, value: Any, ttl: int = 300) -> None:
        """Set cache"""
        if self.redis_client:
            try:
                self.redis_client.setex(key, ttl, json.dumps(value))
                return
            except:
                pass
        
        with self._lock:
            self.memory_cache[key] = value
            self.cache_timestamps[key] = time.time()
    
    def delete(self, key: str) -> None:
        """Delete from cache"""
        if self.redis_client:
            try:
                self.redis_client.delete(key)
                return
            except:
                pass
        
        with self._lock:
            self.memory_cache.pop(key, None)
            self.cache_timestamps.pop(key, None)
    
    def clear(self) -> None:
        """Clear all cache"""
        if self.redis_client:
            try:
                self.redis_client.flushdb()
                return
            except:
                pass
        
        with self._lock:
            self.memory_cache.clear()
            self.cache_timestamps.clear()


