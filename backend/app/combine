    @contextmanager
    def get_connection(self):
        """Get connection from pool"""
        conn = self.pool.acquire(self._get_db_path())
        try:
            yield conn
            conn.commit()
        except Exception as e:
            conn.rollback()
            raise e
        finally:
            self.pool.release(conn)
    
    @asynccontextmanager
    async def get_async_connection(self):
        """Get async connection"""
        loop = asyncio.get_event_loop()
        conn = await loop.run_in_executor(self.executor, self.pool.acquire, self._get_db_path())
        try:
            yield conn
            conn.commit()
        except Exception as e:
            conn.rollback()
            raise e
        finally:
            await loop.run_in_executor(self.executor, self.pool.release, conn)
    
    def execute(self, query: str, params: Tuple = None) -> int:
        """Execute query with cache invalidation"""
        with self.get_connection() as conn:
            cursor = conn.cursor()
            if params:
                cursor.execute(query, params)
            else:
                cursor.execute(query)
            return cursor.lastrowid
    
    def fetch_one(self, query: str, params: Tuple = None, use_cache: bool = False) -> Optional[Dict]:
        """Fetch one with optional cache"""
        if use_cache:
            cache_key = f"{query}:{params}"
            cached = self.cache.get(cache_key)
            if cached:
                return cached
        
        with self.get_connection() as conn:
            cursor = conn.cursor()
            if params:
                cursor.execute(query, params)
            else:
                cursor.execute(query)
            row = cursor.fetchone()
            result = dict(row) if row else None
        
        if use_cache and result:
            self.cache.set(f"{query}:{params}", result)
        
        return result
    
    def fetch_all(self, query: str, params: Tuple = None, use_cache: bool = False) -> List[Dict]:
        """Fetch all with optional cache"""
        if use_cache:
            cache_key = f"{query}:{params}"
            cached = self.cache.get(cache_key)
            if cached:
                return cached
        
        with self.get_connection() as conn:
            cursor = conn.cursor()
            if params:
                cursor.execute(query, params)
            else:
                cursor.execute(query)
            rows = cursor.fetchall()
            results = [dict(row) for row in rows]
        
        if use_cache and results:
            self.cache.set(f"{query}:{params}", results)
        
        return results
    
    # ============ BULK OPERATIONS ============
    
    def bulk_insert(self, table: str, data: List[Dict]) -> bool:
        """Bulk insert for performance"""
        try:
            if not data:
                return False
            
            columns = list(data[0].keys())
            placeholders = ', '.join(['?' for _ in columns])
            column_names = ', '.join(columns)
            
            query = f"INSERT INTO {table} ({column_names}) VALUES ({placeholders})"
            
            with self.get_connection() as conn:
                cursor = conn.cursor()
                values = [tuple(d[col] for col in columns) for d in data]
                cursor.executemany(query, values)
            
            return True
        except Exception as e:
            logger.error(f"Bulk insert failed: {e}")
            return False
    
    def transaction(self, operations: List[Tuple[str, Tuple]]) -> bool:
        """Execute multiple operations in transaction"""
        try:
            with self.get_connection() as conn:
                cursor = conn.cursor()
                for query, params in operations:
                    if params:
                        cursor.execute(query, params)
                    else:
                        cursor.execute(query)
            return True
        except Exception as e:
            logger.error(f"Transaction failed: {e}")
            return False
    
    def get_table_stats(self) -> Dict[str, int]:
        """Get table statistics"""
        stats = {}
        tables = ['users', 'trades', 'positions', 'orders', 'api_keys', 
                  'bots', 'portfolios', 'sessions', 'audit_logs', 'alerts']
        
        for table in tables:
            result = self.fetch_one(f"SELECT COUNT(*) as count FROM {table}")
            stats[table] = result['count'] if result else 0
        
        return stats
    
    def backup(self, backup_path: str = None) -> bool:
        """Backup database"""
        try:
            if not backup_path:
                backup_path = f"data/backups/estrade_{datetime.now().strftime('%Y%m%d_%H%M%S')}.db"
            
            if self.database_type == 'sqlite':
                import shutil
                shutil.copy2(self._get_db_path(), backup_path)
                
                logger.info(f"✅ Database backed up to {backup_path}")
                return True
            
            return False
        except Exception as e:
            logger.error(f"Backup failed: {e}")
            return False
    
    def restore(self, backup_path: str) -> bool:
        """Restore database from backup"""
        try:
            if self.database_type == 'sqlite':
                import shutil
                shutil.copy2(backup_path, self._get_db_path())
                
                logger.info(f"✅ Database restored from {backup_path}")
                return True
            
            return False
        except Exception as e:
            logger.error(f"Restore failed: {e}")
            return False


