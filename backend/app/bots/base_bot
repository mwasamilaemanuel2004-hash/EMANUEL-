                       basic: Dict[str, Any],
                       neural: Dict[str, Any],
                       order_flows: List[OrderFlowType],
                       quantum_signal: float) -> Dict[str, Any]:
        """Combine all signals using weighted ensemble"""
        
        # Extract signals
        trend_strength = basic.get('trend_strength', 0)
        volatility = basic.get('volatility', 0)
        sentiment = basic.get('sentiment', 0)
        
        nn_signal = neural.get('signal', 0)
        nn_confidence = neural.get('confidence', 0.33)
        
        # Order flow signal
        flow_signal = 0
        flow_confidence = 0
        
        for flow in order_flows:
            if flow in [OrderFlowType.INSTITUTIONAL_BUY, OrderFlowType.ACCUMULATION_ZONE]:
                flow_signal += 1
                flow_confidence += 0.8
            elif flow in [OrderFlowType.INSTITUTIONAL_SELL, OrderFlowType.DISTRIBUTION_ZONE]:
                flow_signal -= 1
                flow_confidence += 0.8
            elif flow in [OrderFlowType.LIQUIDITY_SWEEP, OrderFlowType.STOP_HUNT]:
                flow_confidence += 0.6
        
        # Normalize flow signal
        if len(order_flows) > 0:
            flow_signal = flow_signal / len(order_flows)
            flow_confidence = flow_confidence / len(order_flows)
        
        # Weighted combination
        weights = {
            'trend': 0.25,
            'neural': 0.30,
            'flow': 0.25,
            'quantum': 0.10,
            'sentiment': 0.10
        }
        
        # Calculate combined signal
        trend_signal = np.sign(trend_strength) * min(1.0, abs(trend_strength))
        quantum_norm = np.tanh(quantum_signal) if quantum_signal != 0 else 0
        
        combined = (
            weights['trend'] * trend_signal +
            weights['neural'] * nn_signal +
            weights['flow'] * flow_signal +
            weights['quantum'] * quantum_norm +
            weights['sentiment'] * sentiment
        )
        
        # Calculate confidence
        confidence = (
            weights['neural'] * nn_confidence +
            weights['flow'] * flow_confidence +
            weights['trend'] * abs(trend_strength) +
            weights['sentiment'] * abs(sentiment)
        )
        
        # Determine direction
        if combined > 0.2:
            direction = 'long'
        elif combined < -0.2:
            direction = 'short'
        else:
            direction = 'neutral'
        
        return {
            'signal': combined,
            'direction': direction,
            'confidence': min(1.0, confidence),
            'strength': abs(combined)
        }
    
    def adaptive_strategy_selection(self, market_data: Dict[str, Any]) -> str:
        """Select best strategy based on market conditions"""
        analysis = self.comprehensive_analysis(market_data)
        
        regime = analysis['basic_analysis'].get('regime', 'unknown')
        volatility = analysis['basic_analysis'].get('volatility', 0.01)
        trend_strength = analysis['basic_analysis'].get('trend_strength', 0)
        
        # Strategy selection logic
        if regime in ['strong_bull', 'strong_bear', 'trending_up', 'trending_down']:
            if trend_strength > 0.7:
                return 'trend_following_aggressive'
            else:
                return 'trend_following_conservative'
        
        elif regime in ['range_bound', 'low_volatility']:
            return 'mean_reversion'
        
        elif regime in ['high_volatility', 'choppy']:
            return 'breakout_momentum'
        
        elif regime in ['accumulation']:
            return 'accumulation_breakout'
        
        elif regime in ['distribution']:
            return 'distribution_short'
        
        elif regime in ['news_driven']:
            return 'news_momentum'
        
        else:
            return 'adaptive_mixed'
    
    def execute_intelligent_trade(self, market_data: Dict[str, Any]) -> Dict[str, Any]:
        """Execute trade using all intelligence"""
        
        # Comprehensive analysis
        analysis = self.comprehensive_analysis(market_data)
        
        # Strategy selection
        strategy = self.adaptive_strategy_selection(market_data)
        
        # Get signal
        signal = analysis['combined_signal']
        
        # Check if signal is strong enough
        if signal['confidence'] < 0.5 or signal['strength'] < 0.3:
            return {
                'action': 'hold',
                'reason': 'weak_signal',
                'analysis': analysis,
                'strategy': strategy
            }
        
        # Calculate position size with all factors
        price = market_data['prices'][-1] if 'prices' in market_data else 0
        
        if price == 0:
            return {
                'action': 'hold',
                'reason': 'no_price',
                'analysis': analysis
            }
        
        # Adaptive position sizing
        position_size = self.calculate_ultra_adaptive_size(
            price,
            signal['confidence'],
            analysis['basic_analysis'].get('volatility', 0.01),
            strategy
        )
        
        # Execute trade
        if signal['direction'] == 'long':
            position = self.open_position(
                'long',
                price,
                signal['confidence'],
                position_size
            )
            action = 'buy'
        elif signal['direction'] == 'short':
            position = self.open_position(
                'short',
                price,
                signal['confidence'],
                position_size
            )
            action = 'sell'
        else:
            position = None
            action = 'hold'
        
        # Record prediction for learning
        self.prediction_history.append({
            'timestamp': datetime.now(),
            'features': self.neural_engine.prepare_features(market_data),
            'prediction': signal,
            'actual': None  # Will be filled later
        })
        
        return {
            'action': action,
            'reason': f'strategy_{strategy}',
            'analysis': analysis,
            'strategy': strategy,
            'position': position,
            'confidence': signal['confidence']
        }
    
    def calculate_ultra_adaptive_size(self, 
                                     price: float,
                                     confidence: float,
                                     volatility: float,
                                     strategy: str) -> float:
        """Calculate ultra adaptive position size"""
        
        # Base size
        base_size = self.risk_params.base_max_position_size
        
        # Confidence multiplier
        confidence_mult = 0.5 + confidence
        
        # Volatility adjustment
        vol_mult = 1.0 / (1.0 + volatility * 10)
        
        # Strategy-based adjustment
        strategy_multipliers = {
            'trend_following_aggressive': 1.2,
            'trend_following_conservative': 0.8,
            'mean_reversion': 1.0,
            'breakout_momentum': 1.1,
            'accumulation_breakout': 1.15,
            'distribution_short': 1.0,
            'news_momentum': 0.9,
            'adaptive_mixed': 0.85
        }
        
        strategy_mult = strategy_multipliers.get(strategy, 0.9)
        
        # Quantum optimization
        quantum_factor = self.quantum_optimizer.optimization_power
        
        # Calculate final size
        final_size = base_size * confidence_mult * vol_mult * strategy_mult * quantum_factor
        
        # Apply limits
        final_size = min(final_size, self.risk_params.base_max_position_size * 1.5)
        final_size = max(final_size, self.risk_params.base_max_position_size * 0.25)
        
        # Calculate quantity
        position_value = self.current_capital * final_size
        quantity = position_value / price
        
        # Kelly Criterion
        if self.risk_params.use_kelly_criterion:
            win_rate = self.winning_trades / self.total_trades if self.total_trades > 0 else 0.5
            avg_win = self.calculate_average_win()
            avg_loss = abs(self.calculate_average_loss())
            
            if avg_loss > 0:
                kelly = (win_rate * avg_win - (1 - win_rate) * avg_loss) / (avg_win * avg_loss)
                kelly = max(0, min(kelly, 0.5))  # Cap at half Kelly
                quantity *= (1 + kelly * self.risk_params.kelly_fraction)
        
        return quantity
    
    def learn_from_outcomes(self) -> None:
        """Learn from trade outcomes"""
        if len(self.prediction_history) < 10:
            return
        
        # Prepare training data
        X = []
        y = []
        
        for prediction in self.prediction_history:
            if prediction['actual'] is not None:
                X.append(prediction['features'].flatten())
                y.append(prediction['actual'])
        
        if len(X) < 10:
            return
        
        X = np.array(X)
        y = np.array(y)
        
        # Train neural network
        self.neural_engine.train_models(X, y)
        
        # Update strategy weights based on performance
        self.update_strategy_weights()
        
        # Adapt risk parameters
        self.adapt_to_market()
        
        self.logger.info(f"Learned from {len(X)} trade outcomes")
    
    def update_strategy_weights(self) -> None:
        """Update strategy weights based on performance"""
        strategy_performance = {}
        
        for trade in self.trade_history:
            strategy = trade.get('strategy', 'unknown')
            pnl = trade['position']['realized_pnl']
            
            if strategy not in strategy_performance:
                strategy_performance[strategy] = {
                    'pnl': 0,
                    'trades': 0,
                    'wins': 0
                }
            
            strategy_performance[strategy]['pnl'] += pnl
            strategy_performance[strategy]['trades'] += 1
            if pnl > 0:
                strategy_performance[strategy]['wins'] += 1
        
        # Calculate weights
        total_pnl = sum(abs(p['pnl']) for p in strategy_performance.values())
        
        if total_pnl > 0:
            for strategy, perf in strategy_performance.items():
                win_rate = perf['wins'] / perf['trades'] if perf['trades'] > 0 else 0
                pnl_weight = perf['pnl'] / total_pnl if total_pnl > 0 else 0
                
                self.strategy_weights[strategy] = 0.7 * win_rate + 0.3 * pnl_weight
    
    def get_ultra_metrics(self) -> Dict[str, Any]:
        """Get ultra advanced metrics"""
        base_metrics = self.get_performance_metrics()
        
        # Neural network metrics
        nn_accuracy = np.mean(list(self.neural_engine.accuracy_history)) if self.neural_engine.accuracy_history else 0
        
        # Quantum metrics
        quantum_power = self.quantum_optimizer.optimization_power
        
        # Order flow metrics
        flow_types = {}
        for flow in self.order_flow_detector.order_flow_history:
            if isinstance(flow, OrderFlowType):
                flow_types[flow.value] = flow_types.get(flow.value, 0) + 1
        
        ultra_metrics = {
            **base_metrics,
            'neural_network_accuracy': nn_accuracy,
            'quantum_optimization_power': quantum_power,
            'order_flow_detection': flow_types,
            'strategy_weights': self.strategy_weights,
            'adaptive_parameters': self.adaptive_parameters,
            'rolling_sharpe': np.mean(self.rolling_sharpe) if self.rolling_sharpe else 0,
            'rolling_win_rate': np.mean(self.rolling_win_rate) if self.rolling_win_rate else 0
        }
        
        return ultra_metrics