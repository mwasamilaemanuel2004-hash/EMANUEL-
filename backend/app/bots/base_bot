    def prepare_features(self, market_data: Dict[str, Any]) -> np.ndarray:
        """Prepare features for neural network"""
        features = []
        
        # Price features
        prices = market_data.get('prices', [])
        if prices:
            features.extend([
                prices[-1],
                np.mean(prices[-10:]),
                np.std(prices[-20:]),
                (prices[-1] - prices[-20]) / prices[-20],
                (prices[-1] - prices[-50]) / prices[-50] if len(prices) >= 50 else 0
            ])
        
        # Volume features
        volumes = market_data.get('volumes', [])
        if volumes:
            features.extend([
                volumes[-1],
                np.mean(volumes[-10:]),
                np.std(volumes[-20:]),
                volumes[-1] / np.mean(volumes[-20:]) if np.mean(volumes[-20:]) > 0 else 1
            ])
        
        # Technical indicators
        if len(prices) >= 20:
            sma_20 = np.mean(prices[-20:])
            sma_50 = np.mean(prices[-50:]) if len(prices) >= 50 else sma_20
            features.extend([
                (prices[-1] - sma_20) / sma_20,
                (sma_20 - sma_50) / sma_50,
                self.calculate_rsi(prices),
                self.calculate_macd(prices)
            ])
        
        # Ensure consistent feature count
        while len(features) < 20:
            features.append(0.0)
        
        return np.array(features[:20]).reshape(1, -1)
    
    def calculate_rsi(self, prices: List[float], period: int = 14) -> float:
        """Calculate RSI"""
        if len(prices) < period + 1:
            return 50.0
        
        deltas = np.diff(prices[-period-1:])
        gains = np.where(deltas > 0, deltas, 0)
        losses = np.where(deltas < 0, -deltas, 0)
        
        avg_gain = np.mean(gains)
        avg_loss = np.mean(losses)
        
        if avg_loss == 0:
            return 100.0
        
        rs = avg_gain / avg_loss
        rsi = 100 - (100 / (1 + rs))
        return rsi
    
    def calculate_macd(self, prices: List[float]) -> float:
        """Calculate MACD"""
        if len(prices) < 26:
            return 0.0
        
        ema_12 = self.calculate_ema(prices, 12)
        ema_26 = self.calculate_ema(prices, 26)
        
        if not ema_12 or not ema_26:
            return 0.0
        
        macd = ema_12[-1] - ema_26[-1]
        return macd
    
    def calculate_ema(self, data: List[float], period: int) -> List[float]:
        """Calculate EMA"""
        if len(data) < period:
            return []
        
        ema = [np.mean(data[:period])]
        multiplier = 2 / (period + 1)
        
        for price in data[period:]:
            ema.append((price - ema[-1]) * multiplier + ema[-1])
        
        return ema
    
    def train_models(self, X_train: np.ndarray, y_train: np.ndarray) -> None:
        """Train all models"""
        if ML_AVAILABLE:
            for name, model in self.models.items():
                try:
                    if hasattr(model, 'fit'):
                        model.fit(X_train, y_train)
                except Exception as e:
                    print(f"Error training {name}: {e}")
    
    def predict(self, features: np.ndarray) -> Dict[str, Any]:
        """Get predictions from all models"""
        predictions = {}
        
        for name, model in self.models.items():
            try:
                if hasattr(model, 'predict_proba'):
                    proba = model.predict_proba(features.reshape(1, -1))
                    predictions[name] = proba[0]
                elif hasattr(model, 'predict'):
                    predictions[name] = model.predict(features.reshape(1, -1))
            except Exception as e:
                predictions[name] = np.array([0.33, 0.33, 0.34])
        
        # Ensemble prediction
        if predictions:
            ensemble = np.mean([p for p in predictions.values() if isinstance(p, np.ndarray)], axis=0)
        else:
            ensemble = np.array([0.33, 0.33, 0.34])
        
        return {
            'individual': predictions,
            'ensemble': ensemble,
            'confidence': np.max(ensemble),
            'signal': np.argmax(ensemble) - 1  # -1 sell, 0 hold, 1 buy
        }

class InstitutionalOrderFlowDetector:
    """Detect institutional order flow"""
    
    def __init__(self):
        self.order_flow_history = deque(maxlen=1000)
        self.institutional_levels = []
        self.smart_money_positions = {}
        self.liquidity_pools = {'buy': [], 'sell': []}
        self.stop_hunt_levels = []
    
    def detect_order_flow(self, market_data: Dict[str, Any]) -> List[OrderFlowType]:
        """Detect institutional order flow"""
        flows = []
        
        prices = market_data.get('prices', [])
        volumes = market_data.get('volumes', [])
        high = market_data.get('high', [])
        low = market_data.get('low', [])
        
        if len(prices) < 20:
            return flows
        
        # Detect liquidity sweeps
        if self.detect_liquidity_sweep(prices, high, low):
            flows.append(OrderFlowType.LIQUIDITY_SWEEP)
        
        # Detect stop hunts
        if self.detect_stop_hunt(prices, high, low):
            flows.append(OrderFlowType.STOP_HUNT)
        
        # Detect accumulation
        if self.detect_accumulation(prices, volumes):
            flows.append(OrderFlowType.ACCUMULATION_ZONE)
        
        # Detect distribution
        if self.detect_distribution(prices, volumes):
            flows.append(OrderFlowType.DISTRIBUTION_ZONE)
        
        # Detect institutional buying/selling
        if self.detect_institutional_activity(prices, volumes):
            if np.mean(volumes[-5:]) > np.mean(volumes[-20:]) * 1.5:
                if prices[-1] > prices[-5]:
                    flows.append(OrderFlowType.INSTITUTIONAL_BUY)
                else:
                    flows.append(OrderFlowType.INSTITUTIONAL_SELL)
        
        # Detect absorption
        if self.detect_absorption(prices, volumes):
            flows.append(OrderFlowType.ABSORPTION)
        
        return flows
    
    def detect_liquidity_sweep(self, prices: List[float], high: List[float], low: List[float]) -> bool:
        """Detect liquidity sweep"""
        if len(prices) < 10 or len(high) < 10:
            return False
        
        # Check for sweep of recent highs/lows
        recent_high = max(high[-10:-1])
        recent_low = min(low[-10:-1])
        
        current_high = high[-1]
        current_low = low[-1]
        
        # Sweep above recent high then reverse
        if current_high > recent_high and prices[-1] < recent_high:
            return True
        
        # Sweep below recent low then reverse
        if current_low < recent_low and prices[-1] > recent_low:
            return True
        
        return False
    
    def detect_stop_hunt(self, prices: List[float], high: List[float], low: List[float]) -> bool:
        """Detect stop hunt"""
        if len(prices) < 20:
            return False
        
        # Look for sharp move to trigger stops followed by reversal
        for i in range(2, min(10, len(prices))):
            # Sharp drop then recovery (hunting sell stops)
            if low[-i] < min(low[-20:-i]) and prices[-1] > prices[-i]:
                return True
            
            # Sharp rise then reversal (hunting buy stops)
            if high[-i] > max(high[-20:-i]) and prices[-1] < prices[-i]:
                return True
        
        return False
    
    def detect_accumulation(self, prices: List[float], volumes: List[float]) -> bool:
        """Detect accumulation phase"""
        if len(prices) < 20:
            return False
        
        # Low volatility with increasing volume
        price_range = (max(prices[-20:]) - min(prices[-20:])) / np.mean(prices[-20:])
        
        if price_range < 0.02 and np.mean(volumes[-5:]) > np.mean(volumes[-20:]) * 1.2:
            return True
        
        return False
    
    def detect_distribution(self, prices: List[float], volumes: List[float]) -> bool:
        """Detect distribution phase"""
        if len(prices) < 20:
            return False
        
        # Price near highs with increasing volume but no progress
        recent_high = max(prices[-20:])
        if prices[-1] > recent_high * 0.98:
            if np.mean(volumes[-5:]) > np.mean(volumes[-20:]) * 1.3:
                return True
        
        return False
    
    def detect_institutional_activity(self, prices: List[float], volumes: List[float]) -> bool:
        """Detect institutional activity"""
        if len(volumes) < 20:
            return False
        
        # Large volume spikes
        avg_volume = np.mean(volumes[-20:])
        recent_volumes = volumes[-5:]
        
        # Check for multiple large volume bars
        large_bars = sum(1 for v in recent_volumes if v > avg_volume * 1.5)
        
        return large_bars >= 2
    
    def detect_absorption(self, prices: List[float], volumes: List[float]) -> bool:
        """Detect absorption pattern"""
        if len(prices) < 10:
            return False
        
        # High volume but price not moving much
        price_change = abs(prices[-1] - prices[-10]) / prices[-10]
        volume_ratio = np.mean(volumes[-5:]) / np.mean(volumes[-20:])
        
        if volume_ratio > 1.5 and price_change < 0.005:
            return True
        
        return False
    
    def identify_liquidity_pools(self, prices: List[float], high: List[float], low: List[float]) -> Dict[str, List[float]]:
        """Identify liquidity pools"""
        liquidity = {'buy': [], 'sell': []}
        
        if len(prices) < 50:
            return liquidity
        
        # Find equal highs and lows
        for i in range(20, len(high)):
            # Check for double/triple tops (sell-side liquidity)
            for j in range(i+1, len(high)):
                if abs(high[i] - high[j]) / high[i] < 0.001:
                    liquidity['sell'].append(high[i])
                    break
        
        for i in range(20, len(low)):
            # Check for double/triple bottoms (buy-side liquidity)
            for j in range(i+1, len(low)):
                if abs(low[i] - low[j]) / low[i] < 0.001:
                    liquidity['buy'].append(low[i])
                    break
        
        # Cluster levels
        liquidity['buy'] = self.cluster_levels(liquidity['buy'])
        liquidity['sell'] = self.cluster_levels(liquidity['sell'])
        
        return liquidity
    
    def cluster_levels(self, levels: List[float], tolerance: float = 0.002) -> List[float]:
        """Cluster price levels"""
        if not levels:
            return []
        
        levels.sort()
        clusters = []
        current_cluster = [levels[0]]
        
        for level in levels[1:]:
            if abs(level - current_cluster[-1]) / current_cluster[-1] < tolerance:
                current_cluster.append(level)
            else:
                clusters.append(np.mean(current_cluster))
                current_cluster = [level]
        
        clusters.append(np.mean(current_cluster))
        return clusters

