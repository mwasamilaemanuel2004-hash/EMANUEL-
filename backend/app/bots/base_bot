    def _initialize_tensorflow_models(self):
        """Initialize TensorFlow models"""
        try:
            # LSTM Model
            self.models['lstm'] = self._create_lstm_model()
            
            # GRU Model
            self.models['gru'] = self._create_gru_model()
            
            # Attention Model
            self.models['attention'] = self._create_attention_model()
            
            # Transformer Model
            self.models['transformer'] = self._create_transformer_model()
            
        except Exception as e:
            print(f"Error initializing TensorFlow models: {e}")
    
    def _create_lstm_model(self):
        """Create LSTM model"""
        model = models.Sequential([
            layers.LSTM(128, return_sequences=True, input_shape=(100, 20)),
            layers.LSTM(64, return_sequences=False),
            layers.Dense(32, activation='relu'),
            layers.Dropout(0.3),
            layers.Dense(16, activation='relu'),
            layers.Dense(3, activation='softmax')  # Buy, Sell, Hold
        ])
        model.compile(
            optimizer=optimizers.Adam(learning_rate=0.001),
            loss='categorical_crossentropy',
            metrics=['accuracy']
        )
        return model
    
    def _create_gru_model(self):
        """Create GRU model"""
        model = models.Sequential([
            layers.GRU(128, return_sequences=True, input_shape=(100, 20)),
            layers.GRU(64, return_sequences=False),
            layers.Dense(32, activation='relu'),
            layers.Dropout(0.3),
            layers.Dense(3, activation='softmax')
        ])
        model.compile(
            optimizer=optimizers.Adam(learning_rate=0.001),
            loss='categorical_crossentropy',
            metrics=['accuracy']
        )
        return model
    
    def _create_attention_model(self):
        """Create Attention model"""
        inputs = layers.Input(shape=(100, 20))
        
        # Multi-head attention
        attention = layers.MultiHeadAttention(num_heads=8, key_dim=64)(inputs, inputs)
        attention = layers.LayerNormalization()(attention + inputs)
        
        # Feed forward
        ffn = layers.Dense(128, activation='relu')(attention)
        ffn = layers.Dense(20)(ffn)
        ffn = layers.LayerNormalization()(ffn + attention)
        
        # Global pooling
        pooled = layers.GlobalAveragePooling1D()(ffn)
        
        # Output
        outputs = layers.Dense(64, activation='relu')(pooled)
        outputs = layers.Dropout(0.3)(outputs)
        outputs = layers.Dense(3, activation='softmax')(outputs)
        
        model = models.Model(inputs=inputs, outputs=outputs)
        model.compile(
            optimizer=optimizers.Adam(learning_rate=0.001),
            loss='categorical_crossentropy',
            metrics=['accuracy']
        )
        return model
    
    def _create_transformer_model(self):
        """Create simplified Transformer model"""
        inputs = layers.Input(shape=(100, 20))
        
        # Positional encoding
        positions = tf.range(start=0, limit=100, delta=1)
        position_embeddings = layers.Embedding(100, 20)(positions)
        x = inputs + position_embeddings
        
        # Transformer blocks
        for _ in range(3):
            # Self-attention
            attention = layers.MultiHeadAttention(num_heads=8, key_dim=64)(x, x)
            x = layers.LayerNormalization()(attention + x)
            
            # Feed-forward
            ffn = layers.Dense(128, activation='relu')(x)
            ffn = layers.Dense(20)(ffn)
            x = layers.LayerNormalization()(ffn + x)
        
        # Global pooling
        pooled = layers.GlobalAveragePooling1D()(x)
        
        # Output
        outputs = layers.Dense(64, activation='relu')(pooled)
        outputs = layers.Dropout(0.3)(outputs)
        outputs = layers.Dense(3, activation='softmax')(outputs)
        
        model = models.Model(inputs=inputs, outputs=outputs)
        model.compile(
            optimizer=optimizers.Adam(learning_rate=0.001),
            loss='categorical_crossentropy',
            metrics=['accuracy']
        )
        return model
    
