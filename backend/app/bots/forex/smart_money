            nn_prediction = self.neural_engine.predict(nn_features)
            
            # Institutional activity detection
            institutional_activity = self.detect_institutional_activity(market_data)
            
            # Liquidity engineering detection
            liquidity_engineering = self.detect_liquidity_engineering(market_data)
            
            analysis = {
                'smc': smc_analysis,
                'order_flows': order_flows,
                'neural_prediction': nn_prediction,
                'institutional_activity': institutional_activity,
                'liquidity_engineering': liquidity_engineering,
                'timestamp': datetime.now()
            }
            
            # Cache analysis
            self.analysis_cache[cache_key] = {
                'analysis': analysis,
                'timestamp': datetime.now()
            }
            
            return analysis
            
        except Exception as e:
            self.logger.error(f"Error in analyze_market: {e}")
            return self._get_fallback_analysis()
    
    def _generate_cache_key(self, market_data: Dict[str, Any]) -> str:
        """Generate cache key"""
        prices = market_data.get('prices', [])
        if not prices:
            return "empty"
        
        key_data = str(prices[-10:]) + str(market_data.get('volumes', [])[-10:])
        return hashlib.md5(key_data.encode()).hexdigest()
    
    def detect_institutional_activity(self, market_data: Dict[str, Any]) -> Dict[str, Any]:
        """Detect institutional activity"""
        prices = market_data.get('prices', [])
        volumes = market_data.get('volumes', [])
        
        if len(prices) < 20 or not volumes:
            return {}
        
        # Large volume detection
        avg_volume = np.mean(volumes[-20:])
        recent_volumes = volumes[-5:]
        
        large_volume_bars = [i for i, v in enumerate(recent_volumes) if v > avg_volume * 1.5]
        
        # Price action with volume
        bullish_pressure = 0
        bearish_pressure = 0
        
        for i in range(1, min(20, len(prices))):
            if prices[-i] > prices[-i-1]:
                bullish_pressure += volumes[-i]
            else:
                bearish_pressure += volumes[-i]
        
        total_pressure = bullish_pressure + bearish_pressure
        buy_ratio = bullish_pressure / total_pressure if total_pressure > 0 else 0.5
        
        activity = {
            'large_volume_bars': len(large_volume_bars),
            'buy_ratio': buy_ratio,
            'institutional_buying': buy_ratio > 0.6,
            'institutional_selling': buy_ratio < 0.4,
            'volume_spike': bool(large_volume_bars),
            'activity_score': min(1.0, len(large_volume_bars) / 3)
        }
        
        self.institutional_activity.append(activity)
        
        return activity
    
    def detect_liquidity_engineering(self, market_data: Dict[str, Any]) -> Dict[str, Any]:
        """Detect liquidity engineering patterns"""
        prices = market_data.get('prices', [])
        high = market_data.get('high', prices)
        low = market_data.get('low', prices)
        
        if len(prices) < 20:
            return {}
        
        engineering = {
            'liquidity_grab': False,
            'stop_hunt': False,
            'fake_breakout': False,
            'inducement': False,
            'trap': False,
            'engineered_move': False,
            'confidence': 0.0
        }
        
        # Detect liquidity grab
        if self.detect_liquidity_grab(prices, high, low):
            engineering['liquidity_grab'] = True
            engineering['confidence'] += 0.3
            self.liquidity_grabs.append({
                'time': datetime.now(),
                'type': 'liquidity_grab',
                'price': prices[-1]
            })
        
        # Detect stop hunt
        if self.detect_stop_hunt(prices, high, low):
            engineering['stop_hunt'] = True
            engineering['confidence'] += 0.25
            self.manipulation_events.append({
                'time': datetime.now(),
                'type': 'stop_hunt',
                'price': prices[-1]
            })
        
        # Detect fake breakout
        if self.detect_fake_breakout(prices, high, low):
            engineering['fake_breakout'] = True
            engineering['confidence'] += 0.25
            self.manipulation_events.append({
                'time': datetime.now(),
                'type': 'fake_breakout',
                'price': prices[-1]
            })
        
        # Detect inducement
        if self.detect_inducement(prices):
            engineering['inducement'] = True
            engineering['confidence'] += 0.2
        
        if engineering['confidence'] >= 0.5:
            engineering['engineered_move'] = True
        
        return engineering
    
    def detect_liquidity_grab(self, prices: List[float], high: List[float], low: List[float]) -> bool:
        """Detect liquidity grab"""
        if len(prices) < 10:
            return False
        
        # Check for sweep of recent highs/lows followed by reversal
        recent_high = max(high[-10:-1])
        recent_low = min(low[-10:-1])
        
        current_high = high[-1]
        current_low = low[-1]
        current_price = prices[-1]
        
        # Sweep above high then close below
        if current_high > recent_high and current_price < recent_high:
            return True
        
        # Sweep below low then close above
        if current_low < recent_low and current_price > recent_low:
            return True
        
        return False
    
    def detect_stop_hunt(self, prices: List[float], high: List[float], low: List[float]) -> bool:
        """Detect stop hunt"""
        if len(prices) < 20:
            return False
        
        # Look for sharp move to trigger stops followed by reversal
        for i in range(2, min(10, len(prices))):
            # Sharp drop then recovery
            if low[-i] < min(low[-20:-i]) and prices[-1] > prices[-i]:
                return True
            
            # Sharp rise then reversal
            if high[-i] > max(high[-20:-i]) and prices[-1] < prices[-i]:
                return True
        
        return False
    
    def detect_fake_breakout(self, prices: List[float], high: List[float], low: List[float]) -> bool:
        """Detect fake breakout"""
        if len(prices) < 20:
            return False
        
        # Check for breakout that fails
        range_high = max(high[-20:-5])
        range_low = min(low[-20:-5])
        
        current_price = prices[-1]
        current_high = high[-1]
        current_low = low[-1]
        
        # Breakout above range then close back inside
        if current_high > range_high and current_price < range_high:
            return True
        
        # Breakdown below range then close back inside
        if current_low < range_low and current_price > range_low:
            return True
        
        return False
    
    def detect_inducement(self, prices: List[float]) -> bool:
        """Detect inducement pattern"""
        if len(prices) < 15:
            return False
        
        # Look for false move to induce retail traders
        recent_prices = prices[-15:]
        
        # Check for sharp move against trend
        if prices[-1] > prices[-5]:
            # Sharp drop then strong recovery (induce sell)
            if min(recent_prices) < prices[-10] * 0.998:
                return True
        else:
            # Sharp rise then strong drop (induce buy)
            if max(recent_prices) > prices[-10] * 1.002:
                return True
        
        return False
    
    def generate_signal(self, analysis: Dict[str, Any]) -> Dict[str, Any]:
        """Generate Smart Money trading signal"""
        try:
            smc = analysis.get('smc', {})
            institutional = analysis.get('institutional_activity', {})
            liquidity_eng = analysis.get('liquidity_engineering', {})
            order_flows = analysis.get('order_flows', [])
            nn_prediction = analysis.get('neural_prediction', {})
            
            # Extract key data
            market_structure = smc.get('market_structure', {})
            premium_discount = smc.get('premium_discount', {})
            manipulation_score = smc.get('manipulation_score', 0)
            order_blocks = smc.get('order_blocks', [])
            fvgs = smc.get('fair_value_gaps', [])
            liquidity_pools = smc.get('liquidity_pools', {})
            
            # Initialize signal
            signal = {
                'action': 'neutral',
                'confidence': 0,
                'strength': 0,
                'reasons': [],
                'timestamp': datetime.now()
            }
            
            # Check market structure
            structure_type = market_structure.get('type', 'ranging')
            trend = market_structure.get('trend', 'neutral')
            
            # Check for manipulation
            if self.config.get('avoid_manipulation', True):
                if manipulation_score > self.config.get('min_manipulation_score', 0.7):
                    signal['reasons'].append('high_manipulation')
                    return signal
            
            # Check institutional activity
            if self.config.get('trade_with_institutional_flow', True):
                buy_ratio = institutional.get('buy_ratio', 0.5)
                if buy_ratio > 0.6:
                    signal['reasons'].append('institutional_buying')
                    signal['strength'] += 0.2
                elif buy_ratio < 0.4:
                    signal['reasons'].append('institutional_selling')
                    signal['strength'] += 0.2
            
            # Check liquidity engineering
            if liquidity_eng.get('engineered_move', False):
                if liquidity_eng.get('liquidity_grab'):
                    signal['reasons'].append('liquidity_grab_detected')
                    signal['strength'] += 0.15
                if liquidity_eng.get('stop_hunt'):
                    signal['reasons'].append('stop_hunt_detected')
                    signal['strength'] += 0.15
            
            # Check order blocks
            relevant_blocks = [ob for ob in order_blocks if ob.get('strength', 0) >= self.config.get('min_order_block_strength', 0.6)]
            
            bullish_blocks = [ob for ob in relevant_blocks if ob['type'] == 'bullish']
            bearish_blocks = [ob for ob in relevant_blocks if ob['type'] == 'bearish']
            
            # Determine direction based on Smart Money concepts
            if structure_type == 'bullish' and trend == 'up':
                if bullish_blocks or fvgs:
                    signal['action'] = 'long'
                    signal['confidence'] += 0.3
                    signal['strength'] += 0.3
                    signal['reasons'].append('bullish_structure')
            
            elif structure_type == 'bearish' and trend == 'down':
                if bearish_blocks or fvgs:
                    signal['action'] = 'short'
                    signal['confidence'] += 0.3
                    signal['strength'] += 0.3
                    signal['reasons'].append('bearish_structure')
            
            # Check premium/discount zones
            if premium_discount:
                current_zone = premium_discount.get('current_zone', 'neutral')
                current_price = premium_discount.get('current_price', 0)
                equilibrium = premium_discount.get('equilibrium', 0)
                
                if signal['action'] == 'long' and current_zone == 'discount':
                    signal['confidence'] += 0.2
                    signal['strength'] += 0.2
                    signal['reasons'].append('discount_zone_entry')
                
                elif signal['action'] == 'short' and current_zone == 'premium':
                    signal['confidence'] += 0.2
                    signal['strength'] += 0.2
                    signal['reasons'].append('premium_zone_entry')
            
            # Neural network confirmation
            if nn_prediction:
                nn_signal = nn_prediction.get('signal', 0)
                nn_confidence = nn_prediction.get('confidence', 0)
                
                if (signal['action'] == 'long' and nn_signal == 1) or \
                   (signal['action'] == 'short' and nn_signal == -1):
                    signal['confidence'] += nn_confidence * 0.2
                    signal['strength'] += 0.1
                    signal['reasons'].append('neural_confirmation')
            
            # Normalize values
            signal['confidence'] = min(1.0, signal['confidence'])
            signal['strength'] = min(1.0, signal['strength'])
            
            # Final check
            if signal['confidence'] < 0.6 or signal['strength'] < 0.5:
                signal['action'] = 'neutral'
                signal['reasons'].append('insufficient_confidence')
            
            return signal
            
        except Exception as e:
            self.logger.error(f"Error in generate_signal: {e}")
            return {'action': 'neutral', 'confidence': 0, 'strength': 0}
    
    def execute_strategy(self, market_data: Dict[str, Any]) -> Dict[str, Any]:
        """Execute Smart Money strategy"""
        try:
            with self.smc_lock:
                # Analyze market
                analysis = self.analyze_market(market_data)
                
                # Generate signal
                signal = self.generate_signal(analysis)
                
                if signal['action'] == 'neutral':
                    return {
                        'action': 'hold',
                        'reason': 'no_smart_money_signal',
                        'analysis': analysis,
                        'signal': signal
                    }
                
                # Get current price
                prices = market_data.get('prices', [])
                if not prices:
                    return {'action': 'hold', 'reason': 'no_price'}
                
                current_price = prices[-1]
                
                # Calculate position size
                position_size = self._calculate_smc_position_size(
                    current_price,
                    signal['confidence']
                )
                
                # Set stop loss and take profit based on Smart Money levels
                stop_loss, take_profit = self._calculate_smc_levels(
                    signal['action'],
                    current_price,
                    analysis
                )
                
                # Open position
                position = self.open_position(
                    signal['action'],
                    current_price,
                    signal['confidence'],
                    position_size
                )
                
                if position:
                    # Override stop loss and take profit
                    position.stop_loss = stop_loss
                    position.take_profit = take_profit
                    
                    # Record signal
                    self.smc_signals.append({
                        'time': datetime.now(),
                        'action': signal['action'],
                        'confidence': signal['confidence'],
                        'reasons': signal['reasons'],
                        'price': current_price
                    })
                    
                    return {
                        'action': 'buy' if signal['action'] == 'long' else 'sell',
                        'reason': 'smart_money_signal',
                        'analysis': analysis,
                        'signal': signal,
                        'position': position
                    }
                
                return {
                    'action': 'hold',
                    'reason': 'position_not_opened',
                    'signal': signal
                }
                
        except Exception as e:
            self.logger.error(f"Error in execute_strategy: {e}")
            return {'action': 'hold', 'reason': 'error', 'error': str(e)}
    
    def _calculate_smc_position_size(self, price: float, confidence: float) -> float:
        """Calculate position size for Smart Money trading"""
        risk_per_trade = self.config.get('risk_per_trade', 0.02)
        max_position_size = self.config.get('max_position_size', 0.15)
        
        # Base size
        risk_amount = self.current_capital * risk_per_trade
        
        # Adjust for confidence
        size_multiplier = 0.5 + confidence
        
        # Calculate position value
        position_value = risk_amount * size_multiplier * 5  # 5x for SMC
        position_size = position_value / price
        
        # Apply maximum
        max_value = self.current_capital * max_position_size
        max_size = max_value / price
        
        return min(position_size, max_size)
    
    def _calculate_smc_levels(self, action: str, current_price: float, analysis: Dict[str, Any]) -> Tuple[float, float]:
        """Calculate stop loss and take profit based on SMC levels"""
        smc = analysis.get('smc', {})
        order_blocks = smc.get('order_blocks', [])
        liquidity_pools = smc.get('liquidity_pools', {})
        
        if action == 'long':
            # Stop loss below nearest demand/order block
            bullish_blocks = [ob for ob in order_blocks if ob['type'] == 'bullish']
            
            if bullish_blocks:
                stop_loss = min(ob['low'] for ob in bullish_blocks[:3])
            else:
                stop_loss = current_price * 0.99
            
            # Take profit at sell-side liquidity
            sell_liquidity = liquidity_pools.get('sell', [])
            
            if sell_liquidity:
                take_profit = min(sell_liquidity)
            else:
                take_profit = current_price * 1.03
            
        else:  # Short
            # Stop loss above nearest supply/order block
            bearish_blocks = [ob for ob in order_blocks if ob['type'] == 'bearish']
            
            if bearish_blocks:
                stop_loss = max(ob['high'] for ob in bearish_blocks[:3])
            else:
                stop_loss = current_price * 1.01
            
            # Take profit at buy-side liquidity
            buy_liquidity = liquidity_pools.get('buy', [])
            
            if buy_liquidity:
                take_profit = max(buy_liquidity)
            else:
                take_profit = current_price * 0.97
        
        # Ensure minimum risk-reward
        risk = abs(current_price - stop_loss)
        reward = abs(take_profit - current_price)
        
        min_rr = self.config.get('risk_reward_min', 2.5)
        
        if reward / risk < min_rr if risk > 0 else False:
            take_profit = current_price + (stop_loss - current_price) * min_rr if action == 'long' else current_price - (current_price - stop_loss) * min_rr
        
        return stop_loss, take_profit
    
