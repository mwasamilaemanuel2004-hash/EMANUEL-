    def adaptive_optimization(self) -> None:
        """Optimize Smart Money parameters"""
        if len(self.closed_positions) < 10:
            return
        
        # Calculate recent performance
        recent_trades = self.closed_positions[-20:]
        win_rate = sum(1 for t in recent_trades if t.realized_pnl > 0) / len(recent_trades)
        
        # Adjust parameters
        if win_rate < 0.4:
            self.config['min_order_block_strength'] = min(0.8, self.config['min_order_block_strength'] * 1.1)
            self.config['risk_reward_min'] = min(3.0, self.config['risk_reward_min'] * 1.1)
            self.logger.info("Adjusted SMC parameters for conservative trading")
        elif win_rate > 0.6:
            self.config['min_order_block_strength'] = max(0.5, self.config['min_order_block_strength'] * 0.95)
            self.config['risk_reward_min'] = max(2.0, self.config['risk_reward_min'] * 0.95)
            self.logger.info("Adjusted SMC parameters for aggressive trading")