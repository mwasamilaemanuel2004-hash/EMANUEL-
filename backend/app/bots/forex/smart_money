@njit(cache=True, parallel=True)
def calculate_order_flow_numba(volumes: np.ndarray, prices: np.ndarray, period: int = 20) -> Tuple[float, float]:
    """Numba optimized order flow calculation"""
    if len(volumes) < period or len(prices) < period:
        return 0.0, 0.0
    
    # Calculate buy/sell pressure
    buy_pressure = 0.0
    sell_pressure = 0.0
    
    for i in range(len(volumes) - period, len(volumes)):
        if prices[i] > prices[i-1]:
            buy_pressure += volumes[i]
        else:
            sell_pressure += volumes[i]
    
    total_pressure = buy_pressure + sell_pressure
    if total_pressure == 0:
        return 0.0, 0.0
    
    buy_ratio = buy_pressure / total_pressure
    sell_ratio = sell_pressure / total_pressure
    
    return buy_ratio, sell_ratio

@njit(cache=True, parallel=True)
def detect_manipulation_numba(prices: np.ndarray, volumes: np.ndarray, period: int = 50) -> float:
    """Numba optimized manipulation detection"""
    if len(prices) < period:
        return 0.0
    
    manipulation_score = 0.0
    
    # Detect sharp price movements with low volume (manipulation)
    for i in range(len(prices) - 10, len(prices)):
        price_change = abs(prices[i] - prices[i-5]) / prices[i-5]
        avg_volume = np.mean(volumes[max(0, i-5):i])
        
        if price_change > 0.003 and avg_volume < np.mean(volumes[max(0, i-20):i]) * 0.7:
            manipulation_score += 1.0
    
    return manipulation_score / 10.0

@njit(cache=True, parallel=True)
def calculate_cvd_numba(prices: np.ndarray, volumes: np.ndarray) -> np.ndarray:
    """Numba optimized Cumulative Volume Delta"""
    if len(prices) < 2 or len(volumes) < 2:
        return np.array([0.0])
    
    cvd = np.zeros(len(prices))
    
    for i in range(1, len(prices)):
        if prices[i] > prices[i-1]:
            cvd[i] = cvd[i-1] + volumes[i]
        elif prices[i] < prices[i-1]:
            cvd[i] = cvd[i-1] - volumes[i]
        else:
            cvd[i] = cvd[i-1]
    
    return cvd

