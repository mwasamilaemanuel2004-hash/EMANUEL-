    def detect_order_blocks(self, prices: np.ndarray, high: np.ndarray, low: np.ndarray, volumes: np.ndarray) -> List[Dict[str, Any]]:
        """Detect institutional order blocks"""
        order_blocks = []
        
        if len(prices) < 20:
            return order_blocks
        
        # Look for strong moves followed by consolidation
        for i in range(10, len(prices) - 5):
            # Bullish order block
            if prices[i] < prices[i-1] and prices[i+1] > prices[i] * 1.002:
                # Check for consolidation after move
                if np.std(prices[i+1:i+6]) / np.mean(prices[i+1:i+6]) < 0.001:
                    order_blocks.append({
                        'type': 'bullish',
                        'price': prices[i],
                        'high': high[i],
                        'low': low[i],
                        'volume': volumes[i] if i < len(volumes) else 0,
                        'index': i,
                        'strength': self.calculate_block_strength(prices, volumes, i, 'bullish')
                    })
            
            # Bearish order block
            if prices[i] > prices[i-1] and prices[i+1] < prices[i] * 0.998:
                if np.std(prices[i+1:i+6]) / np.mean(prices[i+1:i+6]) < 0.001:
                    order_blocks.append({
                        'type': 'bearish',
                        'price': prices[i],
                        'high': high[i],
                        'low': low[i],
                        'volume': volumes[i] if i < len(volumes) else 0,
                        'index': i,
                        'strength': self.calculate_block_strength(prices, volumes, i, 'bearish')
                    })
        
        # Sort by strength
        order_blocks.sort(key=lambda x: x['strength'], reverse=True)
        
        return order_blocks[:10]  # Top 10 order blocks
    
    def calculate_block_strength(self, prices: np.ndarray, volumes: np.ndarray, index: int, block_type: str) -> float:
        """Calculate order block strength"""
        if index >= len(volumes) or index < 5:
            return 0.0
        
        # Volume analysis
        volume_ratio = volumes[index] / np.mean(volumes[max(0, index-20):index]) if np.mean(volumes[max(0, index-20):index]) > 0 else 1
        
        # Price movement analysis
        if block_type == 'bullish':
            move_strength = (prices[index+1] - prices[index]) / prices[index] if index + 1 < len(prices) else 0
        else:
            move_strength = (prices[index] - prices[index+1]) / prices[index] if index + 1 < len(prices) else 0
        
        # Combine factors
        strength = volume_ratio * 0.5 + abs(move_strength) * 100 * 0.5
        
        return min(1.0, strength)
    
    def detect_fair_value_gaps(self, prices: np.ndarray, high: np.ndarray, low: np.ndarray) -> List[Dict[str, Any]]:
        """Detect Fair Value Gaps (FVG)"""
        fvgs = []
        
        if len(prices) < 3:
            return fvgs
        
        for i in range(2, len(prices) - 1):
            # Bullish FVG
            if low[i] > high[i-2]:
                fvgs.append({
                    'type': 'bullish',
                    'top': low[i],
                    'bottom': high[i-2],
                    'index': i,
                    'size': (low[i] - high[i-2]) / high[i-2]
                })
            
            # Bearish FVG
            if high[i] < low[i-2]:
                fvgs.append({
                    'type': 'bearish',
                    'top': high[i],
                    'bottom': low[i-2],
                    'index': i,
                    'size': (low[i-2] - high[i]) / low[i-2]
                })
        
        # Filter significant gaps
        significant_fvgs = [fvg for fvg in fvgs if fvg['size'] > 0.0005]
        
        return significant_fvgs[-10:]  # Last 10 FVGs
    
    def detect_liquidity_pools(self, prices: np.ndarray, high: np.ndarray, low: np.ndarray) -> Dict[str, List[float]]:
        """Detect liquidity pools"""
        liquidity = {'buy': [], 'sell': []}
        
        if len(prices) < 20:
            return liquidity
        
        # Find equal highs (sell-side liquidity)
        if SCIPY_AVAILABLE:
            # Use scipy to find peaks
            peaks, _ = find_peaks(high, distance=5)
            for peak in peaks:
                # Check for equal highs
                for other_peak in peaks:
                    if peak != other_peak and abs(high[peak] - high[other_peak]) / high[peak] < 0.001:
                        liquidity['sell'].append(high[peak])
                        break
            
            # Find equal lows (buy-side liquidity)
            troughs, _ = find_peaks(-low, distance=5)
            for trough in troughs:
                for other_trough in troughs:
                    if trough != other_trough and abs(low[trough] - low[other_trough]) / low[trough] < 0.001:
                        liquidity['buy'].append(low[trough])
                        break
        else:
            # Manual detection
            for i in range(20, len(high)):
                # Check for double tops
                for j in range(i+1, len(high)):
                    if abs(high[i] - high[j]) / high[i] < 0.001:
                        liquidity['sell'].append(high[i])
                        break
            
            for i in range(20, len(low)):
                # Check for double bottoms
                for j in range(i+1, len(low)):
                    if abs(low[i] - low[j]) / low[i] < 0.001:
                        liquidity['buy'].append(low[i])
                        break
        
        # Cluster similar levels
        liquidity['buy'] = self.cluster_levels(liquidity['buy'])
        liquidity['sell'] = self.cluster_levels(liquidity['sell'])
        
        return liquidity
    
    def cluster_levels(self, levels: List[float], tolerance: float = 0.002) -> List[float]:
        """Cluster price levels"""
        if not levels:
            return []
        
        levels.sort()
        clusters = []
        current_cluster = [levels[0]]
        
        for level in levels[1:]:
            if abs(level - current_cluster[-1]) / current_cluster[-1] < tolerance:
                current_cluster.append(level)
            else:
                clusters.append(np.mean(current_cluster))
                current_cluster = [level]
        
        clusters.append(np.mean(current_cluster))
        return clusters
    
    def detect_supply_demand(self, prices: np.ndarray, high: np.ndarray, low: np.ndarray, volumes: np.ndarray) -> Tuple[List[Dict], List[Dict]]:
        """Detect supply and demand zones"""
        supply_zones = []
        demand_zones = []
        
        if len(prices) < 30:
            return supply_zones, demand_zones
        
        # Find strong moves
        for i in range(15, len(prices) - 5):
            # Calculate move strength
            move = (prices[i] - prices[i-5]) / prices[i-5]
            
            # Strong downward move = supply zone
            if move < -0.005:
                supply_zones.append({
                    'price': prices[i],
                    'high': max(high[i-5:i]),
                    'low': min(low[i-5:i]),
                    'strength': abs(move),
                    'volume': np.mean(volumes[i-5:i]) if i < len(volumes) else 0
                })
            
            # Strong upward move = demand zone
            elif move > 0.005:
                demand_zones.append({
                    'price': prices[i],
                    'high': max(high[i-5:i]),
                    'low': min(low[i-5:i]),
                    'strength': abs(move),
                    'volume': np.mean(volumes[i-5:i]) if i < len(volumes) else 0
                })
        
        # Sort by strength
        supply_zones.sort(key=lambda x: x['strength'], reverse=True)
        demand_zones.sort(key=lambda x: x['strength'], reverse=True)
        
        return supply_zones[:5], demand_zones[:5]
    
    def detect_breaker_blocks(self, prices: np.ndarray, high: np.ndarray, low: np.ndarray) -> List[Dict[str, Any]]:
        """Detect breaker blocks"""
        breaker_blocks = []
        
        if len(prices) < 20:
            return breaker_blocks
        
        # Look for broken order blocks that become support/resistance
        for i in range(10, len(prices) - 5):
            # Bullish breaker (broken resistance becomes support)
            if prices[i] > max(high[max(0, i-10):i]) and prices[i+1] > prices[i]:
                breaker_blocks.append({
                    'type': 'bullish',
                    'price': prices[i],
                    'level': max(high[max(0, i-10):i]),
                    'index': i,
                    'strength': 0.7
                })
            
            # Bearish breaker (broken support becomes resistance)
            if prices[i] < min(low[max(0, i-10):i]) and prices[i+1] < prices[i]:
                breaker_blocks.append({
                    'type': 'bearish',
                    'price': prices[i],
                    'level': min(low[max(0, i-10):i]),
                    'index': i,
                    'strength': 0.7
                })
        
        return breaker_blocks[-5:]
    
    def calculate_premium_discount(self, prices: np.ndarray) -> Dict[str, float]:
        """Calculate premium and discount zones"""
        if len(prices) < 50:
            return {}
        
        # Calculate range
        range_high = np.max(prices[-50:])
        range_low = np.min(prices[-50:])
        range_size = range_high - range_low
        
        if range_size == 0:
            return {}
        
        # Calculate equilibrium
        equilibrium = (range_high + range_low) / 2
        
        # Premium zone (above equilibrium)
        premium_high = equilibrium + range_size * 0.25
        premium_low = equilibrium + range_size * 0.05
        
        # Discount zone (below equilibrium)
        discount_high = equilibrium - range_size * 0.05
        discount_low = equilibrium - range_size * 0.25
        
        return {
            'range_high': range_high,
            'range_low': range_low,
            'equilibrium': equilibrium,
            'premium_high': premium_high,
            'premium_low': premium_low,
            'discount_high': discount_high,
            'discount_low': discount_low,
            'current_price': prices[-1],
            'current_zone': 'premium' if prices[-1] > equilibrium else 'discount'
        }
    
    def analyze_market_structure(self, prices: np.ndarray, high: np.ndarray, low: np.ndarray) -> Dict[str, Any]:
        """Analyze market structure"""
        if len(prices) < 30:
            return {}
        
        structure = {
            'type': 'ranging',
            'trend': 'neutral',
            'hh': False,  # Higher High
            'hl': False,  # Higher Low
            'lh': False,  # Lower High
            'll': False,  # Lower Low
            'bos': False,  # Break of Structure
            'choch': False  # Change of Character
        }
        
        # Find swing points
        swings_high = []
        swings_low = []
        
        for i in range(2, len(high) - 2):
            if high[i] > high[i-1] and high[i] > high[i-2] and high[i] > high[i+1] and high[i] > high[i+2]:
                swings_high.append((i, high[i]))
            if low[i] < low[i-1] and low[i] < low[i-2] and low[i] < low[i+1] and low[i] < low[i+2]:
                swings_low.append((i, low[i]))
        
        if len(swings_high) >= 2 and len(swings_low) >= 2:
            # Check for higher highs
            if swings_high[-1][1] > swings_high[-2][1]:
                structure['hh'] = True
            else:
                structure['lh'] = True
            
            # Check for higher lows
            if swings_low[-1][1] > swings_low[-2][1]:
                structure['hl'] = True
            else:
                structure['ll'] = True
            
            # Determine structure type
            if structure['hh'] and structure['hl']:
                structure['type'] = 'bullish'
                structure['trend'] = 'up'
            elif structure['lh'] and structure['ll']:
                structure['type'] = 'bearish'
                structure['trend'] = 'down'
            else:
                structure['type'] = 'ranging'
                structure['trend'] = 'neutral'
            
            # Check for break of structure
            if structure['trend'] == 'up' and prices[-1] > swings_high[-2][1]:
                structure['bos'] = True
            elif structure['trend'] == 'down' and prices[-1] < swings_low[-2][1]:
                structure['bos'] = True
            
            # Check for change of character
            if structure['trend'] == 'up' and prices[-1] < swings_low[-1][1]:
                structure['choch'] = True
            elif structure['trend'] == 'down' and prices[-1] > swings_high[-1][1]:
                structure['choch'] = True
        
        return structure
    
