        volatility_state = conditions.get('volatility_state', 'normal')
        volume_trend = conditions.get('volume_trend', 'stable')
        range_position = conditions.get('range_position', 0.5)
        momentum = conditions.get('momentum', 0)
        efficiency = conditions.get('market_efficiency', 0.5)
        
        # Determine condition
        if abs(trend_strength) > 0.7 and volatility_state in ['expanding', 'high']:
            return MarketCondition.STRONG_TREND
        elif abs(trend_strength) > 0.3:
            return MarketCondition.WEAK_TREND
        elif volatility_state == 'expanding':
            return MarketCondition.EXPANSION
        elif volatility_state == 'contracting':
            return MarketCondition.CONSOLIDATION
        elif range_position > 0.8 or range_position < 0.2:
            return MarketCondition.BREAKOUT_READY
        elif efficiency < 0.4:
            return MarketCondition.RANGING
        else:
            return MarketCondition.POST_BREAKOUT
    
