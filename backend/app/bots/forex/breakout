            if not enhanced_breakout.get('active', False):
                return signal
            
            # Check confirmation
            if not enhanced_breakout.get('confirmed', False):
                signal['reasons'].append('not_confirmed')
                return signal
            
            # Apply adaptive parameters
            min_strength = adapted_params.get('min_breakout_strength', self.config['min_breakout_strength'])
            max_false_prob = adapted_params.get('max_false_probability', self.config['max_false_probability'])
            
            # Check strength
            strength = enhanced_breakout.get('strength', 0)
            if strength < min_strength:
                signal['reasons'].append('insufficient_strength')
                return signal
            
            # Check false probability
            false_prob = enhanced_breakout.get('false_probability', 0)
            if false_prob > max_false_prob:
                signal['reasons'].append('high_false_probability')
                return signal
            
            # Determine action
            direction = enhanced_breakout.get('direction', 'neutral')
            
            # Adjust confidence based on adaptive state
            state_multiplier = self._get_state_confidence_multiplier()
            
            if direction == 'long':
                signal['action'] = 'long'
                signal['strength'] = strength
                signal['confidence'] = (strength * 0.6 + (1 - false_prob) * 0.4) * state_multiplier
            elif direction == 'short':
                signal['action'] = 'short'
                signal['strength'] = strength
                signal['confidence'] = (strength * 0.6 + (1 - false_prob) * 0.4) * state_multiplier
            
            # Record adaptive adjustments
            signal['adaptive_adjustments'] = {
                'base_strength_threshold': self.config['min_breakout_strength'],
                'adapted_strength_threshold': min_strength,
                'base_false_probability': self.config['max_false_probability'],
                'adapted_false_probability': max_false_prob,
                'market_condition': market_condition,
                'state_multiplier': state_multiplier
            }
            
            signal['reasons'].append(f'adaptive_breakout_{direction}')
            
            return signal
            
        except Exception as e:
            self.logger.error(f"Error in generate_signal: {e}")
            return {'action': 'neutral', 'confidence': 0, 'strength': 0}
    
    def _get_state_confidence_multiplier(self) -> float:
        """Get confidence multiplier based on adaptive state"""
        state = self._determine_adaptive_state()
        
        multipliers = {
            AdaptiveState.LEARNING: 0.7,
            AdaptiveState.OPTIMIZING: 0.8,
            AdaptiveState.TRADING: 1.0,
            AdaptiveState.CAUTIOUS: 0.6,
            AdaptiveState.AGGRESSIVE: 1.2,
            AdaptiveState.RECOVERY: 0.5,
            AdaptiveState.CONSERVATIVE: 0.7
        }
        
        return multipliers.get(state, 0.8)
    
    def execute_strategy(self, market_data: Dict[str, Any]) -> Dict[str, Any]:
        """Execute adaptive breakout strategy"""
        try:
            with self.adaptive_lock:
                # Analyze market
                analysis = self.analyze_market(market_data)
                
                # Generate signal
                signal = self.generate_signal(analysis)
                
                if signal['action'] == 'neutral':
                    return {
                        'action': 'hold',
                        'reason': signal.get('reasons', ['no_signal'])[0],
                        'analysis': analysis,
                        'signal': signal
                    }
                
                # Get current price
                prices = market_data.get('prices', [])
                if not prices:
                    return {'action': 'hold', 'reason': 'no_price'}
                
                current_price = prices[-1]
                
                # Calculate adaptive position size
                position_size = self._calculate_adaptive_position_size(
                    current_price,
                    signal['confidence'],
                    analysis
                )
                
                # Calculate adaptive stop loss and take profit
                stop_loss, take_profit = self._calculate_adaptive_levels(
                    signal['action'],
                    current_price,
                    analysis
                )
                
                # Open position
                position = self.open_position(
                    signal['action'],
                    current_price,
                    signal['confidence'],
                    position_size
                )
                
                if position:
                    position.stop_loss = stop_loss
                    position.take_profit = take_profit
                    
                    # Record trade
                    self.adaptive_performance.append(0)  # Will update on close
                    
                    return {
                        'action': 'buy' if signal['action'] == 'long' else 'sell',
                        'reason': 'adaptive_breakout_signal',
                        'analysis': analysis,
                        'signal': signal,
                        'position': position
                    }
                
                return {
                    'action': 'hold',
                    'reason': 'position_not_opened',
                    'signal': signal
                }
                
        except Exception as e:
            self.logger.error(f"Error in execute_strategy: {e}")
            return {'action': 'hold', 'reason': 'error', 'error': str(e)}
    
    def _calculate_adaptive_position_size(self, price: float, confidence: float, analysis: Dict[str, Any]) -> float:
        """Calculate adaptive position size"""
        base_risk = self.config.get('risk_per_trade', 0.02)
        adapted_params = analysis.get('adaptive', {}).get('adapted_params', {})
        
        # Use adapted risk if available
        risk_per_trade = adapted_params.get('risk_per_trade', base_risk)
        
        # Get state multiplier
        state_multiplier = self._get_state_confidence_multiplier()
        
        # Calculate position size
        risk_amount = self.current_capital * risk_per_trade
        position_value = risk_amount * (0.5 + confidence) * state_multiplier * 5
        position_size = position_value / price
        
        # Apply maximum
        max_value = self.current_capital * self.config.get('max_position_size', 0.15)
        max_size = max_value / price
        
        return min(position_size, max_size)
    
    def _calculate_adaptive_levels(self, action: str, current_price: float, analysis: Dict[str, Any]) -> Tuple[float, float]:
        """Calculate adaptive stop loss and take profit"""
        adaptive = analysis.get('adaptive', {})
        enhanced_breakout = adaptive.get('enhanced_breakout', {})
        breakout_level = enhanced_breakout.get('level', current_price)
        
        # Get ATR for dynamic stops
        volatility = analysis.get('volatility', {})
        atr = volatility.get('atr', current_price * 0.005)
        
        # Adaptive trailing stop percentage
        adapted_params = adaptive.get('adapted_params', {})
        trailing_pct = adapted_params.get('trailing_stop_percentage', self.config.get('trailing_stop_percentage', 0.015))
        
        if action == 'long':
            stop_loss = min(breakout_level - atr * 0.5, current_price - atr * 1.5)
            measured_move = abs(current_price - breakout_level) * 2
            take_profit = current_price + measured_move
        else:
            stop_loss = max(breakout_level + atr * 0.5, current_price + atr * 1.5)
            measured_move = abs(breakout_level - current_price) * 2
            take_profit = current_price - measured_move
        
        return stop_loss, take_profit
    
    def close_position(self, position_id: str, price: float, reason: str) -> Optional[Position]:
        """Close position and update adaptive learning"""
        position = super().close_position(position_id, price, reason)
        
        if position:
            # Update adaptive performance
            self.adaptive_performance.append(position.realized_pnl)
            
            # Update parameter optimizer
            current_performance = self._calculate_current_performance()
            self.parameter_optimizer.update_performance(self.config, current_performance)
            
            # Trigger adaptation if needed
            if len(self.closed_positions) >= self.config.get('adaptation_threshold', 10):
                self._trigger_adaptation()
        
        return position
    
    def _calculate_current_performance(self) -> float:
        """Calculate current performance score"""
        recent_trades = self.closed_positions[-20:]
        
        if not recent_trades:
            return 0.0
        
        win_rate = sum(1 for t in recent_trades if t.realized_pnl > 0) / len(recent_trades)
        profit_factor = self._calculate_profit_factor(recent_trades)
        
        # Combined performance score
        performance = (win_rate * 0.5 + min(1.0, profit_factor / 3) * 0.5)
        
        return performance
    
    def _calculate_profit_factor(self, trades: List[Position]) -> float:
        """Calculate profit factor"""
        gross_profit = sum(t.realized_pnl for t in trades if t.realized_pnl > 0)
        gross_loss = abs(sum(t.realized_pnl for t in trades if t.realized_pnl < 0))
        
        return gross_profit / gross_loss if gross_loss > 0 else float('inf')
    
    def _trigger_adaptation(self) -> None:
        """Trigger parameter adaptation"""
        if self.is_optimizing:
            return
        
        self.is_optimizing = True
        self.optimization_thread = threading.Thread(target=self._perform_adaptation)
        self.optimization_thread.start()
    
    def _perform_adaptation(self) -> None:
        """Perform adaptive optimization"""
        try:
            self.adaptation_count += 1
            current_performance = self._calculate_current_performance()
            
            # Optimize parameters
            optimized_params = self.parameter_optimizer.optimize_parameters(current_performance)
            
            # Update config with optimized parameters
            old_config = self.config.copy()
            self.config.update(optimized_params)
            
            # Track adaptation effectiveness
            self.learning_episodes.append({
                'timestamp': datetime.now(),
                'old_params': old_config,
                'new_params': optimized_params,
                'performance': current_performance
            })
            
            # Update adaptive state
            self.adaptive_state = self._determine_adaptive_state()
            
            self.logger.info(f"Adaptation #{self.adaptation_count} completed")
            self.logger.info(f"Performance: {current_performance:.2f}")
            self.logger.info(f"State: {self.adaptive_state.value}")
            
        except Exception as e:
            self.logger.error(f"Error in adaptation: {e}")
            self.failed_adaptations += 1
        finally:
            self.is_optimizing = False
    
    def get_performance_metrics(self) -> Dict[str, Any]:
        """Get enhanced adaptive performance metrics"""
        metrics = super().get_performance_metrics()
        
        # Adaptive metrics
        adaptive_metrics = {
            'adaptation_count': self.adaptation_count,
            'adaptive_state': self.adaptive_state.value,
            'successful_adaptations': self.successful_adaptations,
            'failed_adaptations': self.failed_adaptations,
            'adaptation_effectiveness': np.mean(self.adaptation_effectiveness) if self.adaptation_effectiveness else 0,
            'learning_episodes': len(self.learning_episodes),
            'current_performance_score': self._calculate_current_performance(),
            'parameter_changes': len(self.parameter_optimizer.optimization_history),
            'best_performance': self.parameter_optimizer.get_best_performance() if self.parameter_optimizer.optimization_history else 0
        }
        
        metrics.update(adaptive_metrics)
        return metrics
    
    def save_state(self, filename: str = None) -> None:
        """Save bot state including adaptive parameters"""
        try:
            if filename is None:
                filename = f"adaptive_breakout_{self.symbol}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
            
            state = {
                'bot_id': self.bot_id,
                'bot_name': self.bot_name,
                'symbol': self.symbol,
                'capital': self.current_capital,
                'performance': self.get_performance_metrics(),
                'positions': [p.to_dict() for p in self.positions.values()],
                'trade_count': self.total_trades,
                'config': self.config,
                'adaptive_state': self.adaptive_state.value,
                'adaptation_count': self.adaptation_count,
                'best_parameters': self.parameter_optimizer.best_parameters,
                'learning_episodes': list(self.learning_episodes)[-10:]  # Last 10 episodes
            }
            
            with open(filename, 'w') as f:
                json.dump(state, f, indent=2, default=str)
            
            self.logger.info(f"State saved to {filename}")
            
        except Exception as e:
            self.logger.error(f"Error saving state: {e}")
    
    def reset_adaptation(self) -> None:
        """Reset adaptive learning"""
        self.adaptive_state = AdaptiveState.LEARNING
        self.adaptation_count = 0
        self.successful_adaptations = 0
        self.failed_adaptations = 0
        self.learning_episodes.clear()
        self.adaptive_performance.clear()
        self.parameter_optimizer.optimization_history.clear()
        
        self.logger.info("Adaptive learning reset")