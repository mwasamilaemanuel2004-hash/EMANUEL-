class AdaptiveParameterOptimizer:
    """Self-optimizing parameter system"""
    
    def __init__(self):
        self.parameters = {}
        self.performance_history = {}
        self.optimization_history = deque(maxlen=1000)
        self.best_parameters = {}
        self.parameter_sensitivity = {}
        
    def initialize_parameters(self, base_params: Dict[str, Any]) -> None:
        """Initialize adaptive parameters"""
        self.parameters = base_params.copy()
        self.best_parameters = base_params.copy()
        
        # Initialize sensitivity tracking
        for key in base_params:
            self.parameter_sensitivity[key] = {
                'values': deque(maxlen=100),
                'performance': deque(maxlen=100)
            }
    
    def update_performance(self, params: Dict[str, Any], performance: float) -> None:
        """Update parameter performance"""
        for key, value in params.items():
            if key in self.parameter_sensitivity:
                self.parameter_sensitivity[key]['values'].append(value)
                self.parameter_sensitivity[key]['performance'].append(performance)
        
        # Track optimization
        self.optimization_history.append({
            'timestamp': datetime.now(),
            'params': params.copy(),
            'performance': performance
        })
        
        # Update best parameters
        if performance > self.get_best_performance():
            self.best_parameters = params.copy()
    
    def get_best_performance(self) -> float:
        """Get best performance"""
        if not self.optimization_history:
            return -float('inf')
        
        return max(opt['performance'] for opt in self.optimization_history)
    
    def optimize_parameters(self, current_performance: float) -> Dict[str, Any]:
        """Optimize parameters based on performance"""
        optimized = self.parameters.copy()
        
        # Adjust based on recent performance
        recent_performances = [opt['performance'] for opt in list(self.optimization_history)[-10:]]
        
        if len(recent_performances) < 5:
            return optimized
        
        avg_performance = np.mean(recent_performances)
        performance_trend = np.polyfit(range(len(recent_performances)), recent_performances, 1)[0]
        
        # Determine optimization direction
        if performance_trend < 0:  # Declining performance
            # Become more conservative
            optimized['min_breakout_strength'] *= 1.1
            optimized['max_false_probability'] *= 0.9
            optimized['risk_per_trade'] *= 0.9
            optimized['confirmation_bars'] += 1
        else:  # Improving or stable performance
            # Can be slightly more aggressive
            if avg_performance > 0.6:
                optimized['min_breakout_strength'] *= 0.95
                optimized['max_false_probability'] *= 1.05
                optimized['risk_per_trade'] *= 1.05
        
        # Clamp values
        optimized['min_breakout_strength'] = np.clip(optimized['min_breakout_strength'], 0.4, 0.9)
        optimized['max_false_probability'] = np.clip(optimized['max_false_probability'], 0.1, 0.5)
        optimized['risk_per_trade'] = np.clip(optimized['risk_per_trade'], 0.005, 0.05)
        optimized['confirmation_bars'] = int(np.clip(optimized['confirmation_bars'], 1, 5))
        
        return optimized

