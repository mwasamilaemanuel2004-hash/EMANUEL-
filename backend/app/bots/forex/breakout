@njit(cache=True, parallel=True)
def adaptive_breakout_score_numba(prices: np.ndarray, volumes: np.ndarray, 
                                 high: np.ndarray, low: np.ndarray,
                                 breakout_level: float, direction: int,
                                 lookback: int = 50) -> float:
    """Numba optimized adaptive breakout scoring"""
    if len(prices) < lookback:
        return 0.0
    
    score = 0.0
    
    # Price momentum
    momentum = abs(prices[-1] - breakout_level) / breakout_level
    score += min(1.0, momentum * 50) * 0.3
    
    # Volume surge
    avg_volume = np.mean(volumes[-lookback:])
    current_volume = volumes[-1] if len(volumes) > 0 else 0
    volume_ratio = current_volume / avg_volume if avg_volume > 0 else 1.0
    score += min(1.0, (volume_ratio - 0.5) / 2) * 0.25
    
    # Volatility expansion
    returns = np.diff(prices[-lookback:]) / prices[-lookback-1:-1]
    current_vol = np.std(returns[-10:])
    hist_vol = np.std(returns)
    vol_expansion = current_vol / hist_vol if hist_vol > 0 else 1.0
    score += min(1.0, vol_expansion) * 0.25
    
    # Candle strength
    body = abs(prices[-1] - prices[-2])
    range_candle = high[-1] - low[-1]
    candle_strength = body / range_candle if range_candle > 0 else 0
    score += candle_strength * 0.2
    
    return min(1.0, score)

