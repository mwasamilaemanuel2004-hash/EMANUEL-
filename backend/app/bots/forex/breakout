            'volume_trend': self._calculate_volume_trend(volumes),
            'range_position': self._calculate_range_position(prices),
            'momentum': self._calculate_momentum(prices),
            'market_efficiency': self._calculate_market_efficiency(prices)
        }
        
        self.market_conditions.append(conditions)
        
        return conditions
    
    def _calculate_trend_strength(self, prices: List[float]) -> float:
        """Calculate trend strength"""
        if len(prices) < 50:
            return 0.0
        
        # Use multiple timeframes
        short_ma = np.mean(prices[-10:])
        medium_ma = np.mean(prices[-30:])
        long_ma = np.mean(prices[-50:])
        
        # Calculate alignment
        alignment = 0
        if short_ma > medium_ma > long_ma:
            alignment = 1
        elif short_ma < medium_ma < long_ma:
            alignment = -1
        
        # Calculate strength
        price_change = abs(prices[-1] - prices[-20]) / prices[-20]
        
        return alignment * min(1.0, price_change * 50)
    
    def _calculate_volatility_state(self, prices: List[float]) -> str:
        """Calculate volatility state"""
        if len(prices) < 30:
            return 'normal'
        
        returns = np.diff(prices[-30:]) / prices[-30:-1]
        current_vol = np.std(returns[-5:])
        hist_vol = np.std(returns)
        
        ratio = current_vol / hist_vol if hist_vol > 0 else 1.0
        
        if ratio > 1.5:
            return 'expanding'
        elif ratio < 0.7:
            return 'contracting'
        elif current_vol > hist_vol * 1.2:
            return 'high'
        elif current_vol < hist_vol * 0.8:
            return 'low'
        else:
            return 'normal'
    
    def _calculate_volume_trend(self, volumes: List[float]) -> str:
        """Calculate volume trend"""
        if len(volumes) < 20:
            return 'unknown'
        
        recent_vol = np.mean(volumes[-5:])
        hist_vol = np.mean(volumes[-20:])
        
        ratio = recent_vol / hist_vol if hist_vol > 0 else 1.0
        
        if ratio > 1.5:
            return 'increasing'
        elif ratio < 0.7:
            return 'decreasing'
        else:
            return 'stable'
    
    def _calculate_range_position(self, prices: List[float]) -> float:
        """Calculate position within range"""
        if len(prices) < 50:
            return 0.5
        
        range_high = np.max(prices[-50:])
        range_low = np.min(prices[-50:])
        
        if range_high == range_low:
            return 0.5
        
        return (prices[-1] - range_low) / (range_high - range_low)
    
    def _calculate_momentum(self, prices: List[float]) -> float:
        """Calculate momentum"""
        if len(prices) < 20:
            return 0.0
        
        # Multi-period momentum
        momentum_5 = (prices[-1] - prices[-5]) / prices[-5]
        momentum_10 = (prices[-1] - prices[-10]) / prices[-10]
        momentum_20 = (prices[-1] - prices[-20]) / prices[-20]
        
        return (momentum_5 + momentum_10 * 0.7 + momentum_20 * 0.3) / 2
    
    def _calculate_market_efficiency(self, prices: List[float]) -> float:
        """Calculate market efficiency (Hurst exponent approximation)"""
        if len(prices) < 100:
            return 0.5
        
        # Simplified Hurst exponent calculation
        lags = range(2, 20)
        tau = [np.sqrt(np.std(np.subtract(prices[lag:], prices[:-lag]))) for lag in lags]
        
        if len(tau) < 2:
            return 0.5
        
        # Linear fit
        poly = np.polyfit(np.log(lags), np.log(tau), 1)
        hurst = poly[0] * 2.0
        
        return np.clip(hurst, 0, 1)
    
    def detect_market_condition(self, market_data: Dict[str, Any]) -> MarketCondition:
        """Detect current market condition"""
        conditions = self._analyze_market_conditions(market_data)
        
