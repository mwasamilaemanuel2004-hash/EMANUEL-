        current_price = indicators.get('current_price', 0)
        
        signal_strength = 0
        direction = 'neutral'
        
        # Overbought/Oversold conditions
        if zscore > 2 and current_price > upper_bb:
            direction = 'short'
            signal_strength = min(1.0, (zscore - 2) * 0.3)
        elif zscore < -2 and current_price < lower_bb:
            direction = 'long'
            signal_strength = min(1.0, (-zscore - 2) * 0.3)
        
        return {
            'direction': direction,
            'strength': signal_strength,
            'confidence': signal_strength * 0.7
        }
    
