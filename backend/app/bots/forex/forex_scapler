        }
    
    def generate_order_flow_signal(self, order_flows: List[OrderFlowType], micro_structure: Dict[str, Any]) -> Dict[str, Any]:
        """Generate order flow based signal"""
        signal_strength = 0
        direction = 'neutral'
        
        # Count bullish and bearish flows
        bullish_flows = sum(1 for flow in order_flows if flow in [
            OrderFlowType.INSTITUTIONAL_BUY,
            OrderFlowType.ACCUMULATION_ZONE,
            OrderFlowType.MOMENTUM_IGNITION
        ])
        
        bearish_flows = sum(1 for flow in order_flows if flow in [
            OrderFlowType.INSTITUTIONAL_SELL,
            OrderFlowType.DISTRIBUTION_ZONE,
            OrderFlowType.MOMENTUM_IGNITION
        ])
        
        # Order book imbalance
        imbalance = micro_structure.get('imbalance_ratio', 0)
        
        if bullish_flows > bearish_flows or imbalance > 0.3:
            direction = 'long'
            signal_strength = min(1.0, 0.4 + imbalance)
        elif bearish_flows > bullish_flows or imbalance < -0.3:
            direction = 'short'
            signal_strength = min(1.0, 0.4 + abs(imbalance))
        
        return {
            'direction': direction,
            'strength': signal_strength,
            'confidence': signal_strength * 0.9
        }
    
    def generate_micro_structure_signal(self, micro_structure: Dict[str, Any]) -> Dict[str, Any]:
        """Generate micro structure signal"""
        tick_velocity = micro_structure.get('tick_velocity', 0)
        flow_toxicity = micro_structure.get('flow_toxicity', 0)
        micro_trend = micro_structure.get('micro_trend', 'neutral')
        price_impact = micro_structure.get('price_impact', 0)
        
        signal_strength = 0
        direction = 'neutral'
        
        # Combine micro structure signals
        if micro_trend == 'up' and tick_velocity > 0 and flow_toxicity < 0.5:
            direction = 'long'
            signal_strength = min(1.0, abs(tick_velocity) * 100 + 0.3)
        elif micro_trend == 'down' and tick_velocity < 0 and flow_toxicity < 0.5:
            direction = 'short'
            signal_strength = min(1.0, abs(tick_velocity) * 100 + 0.3)
        
        # Adjust for price impact
        if price_impact > 0.01:
            signal_strength *= 0.8  # Reduce size for high impact
        
        return {
            'direction': direction,
            'strength': signal_strength,
            'confidence': signal_strength * 0.75
        }
    
    def combine_scalp_signals(self, signals: Dict[str, Dict[str, Any]]) -> Dict[str, Any]:
        """Combine all scalp signals"""
        long_score = 0
        short_score = 0
        total_confidence = 0
        
        weights = {
            'momentum': 0.25,
            'mean_reversion': 0.15,
            'breakout': 0.20,
            'order_flow': 0.25,
            'micro_structure': 0.15
        }
        
        for strategy, signal_data in signals.items():
            weight = weights.get(strategy, 0.15)
            direction = signal_data.get('direction', 'neutral')
            strength = signal_data.get('strength', 0)
            confidence = signal_data.get('confidence', 0)
            
            if direction == 'long':
                long_score += strength * weight
            elif direction == 'short':
                short_score += strength * weight
            
            total_confidence += confidence * weight
        
        # Determine final direction
        if long_score > short_score * 1.2:
            direction = 'long'
            strength = min(1.0, long_score)
            strategy = self.get_best_strategy(signals, 'long')
        elif short_score > long_score * 1.2:
            direction = 'short'
            strength = min(1.0, short_score)
            strategy = self.get_best_strategy(signals, 'short')
        else:
            direction = 'neutral'
            strength = 0
            strategy = 'none'
        
        return {
            'direction': direction,
            'strength': strength,
            'confidence': min(1.0, total_confidence),
            'strategy': strategy,
            'long_score': long_score,
            'short_score': short_score
        }
    
    def get_best_strategy(self, signals: Dict[str, Dict[str, Any]], direction: str) -> str:
        """Get best performing strategy"""
        best_strategy = 'none'
        best_strength = 0
        
        for strategy, signal_data in signals.items():
            if signal_data.get('direction') == direction:
                strength = signal_data.get('strength', 0)
                if strength > best_strength:
                    best_strength = strength
                    best_strategy = strategy
        
        return best_strategy

