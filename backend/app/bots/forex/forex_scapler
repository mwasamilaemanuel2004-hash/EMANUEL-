class Position:
    """Simple position class"""
    def __init__(self, position_id: str, side: str, entry_price: float, quantity: float, 
                 stop_loss: float, take_profit: float):
        self.id = position_id
        self.side = TradeSide.LONG if side == "long" else TradeSide.SHORT
        self.entry_price = entry_price
        self.quantity = quantity
        self.stop_loss = stop_loss
        self.take_profit = take_profit
        self.current_price = entry_price
        self.realized_pnl = 0.0
        self.unrealized_pnl = 0.0
        self.entry_time = datetime.now()
        self.exit_time = None
        self.is_open = True
        self.confidence = 0.5
    
    def update_pnl(self, current_price: float):
        self.current_price = current_price
        if self.side == TradeSide.LONG:
            self.unrealized_pnl = (current_price - self.entry_price) * self.quantity
        else:
            self.unrealized_pnl = (self.entry_price - current_price) * self.quantity
    
    def close(self, exit_price: float):
        self.current_price = exit_price
        if self.side == TradeSide.LONG:
            self.realized_pnl = (exit_price - self.entry_price) * self.quantity
        else:
            self.realized_pnl = (self.entry_price - exit_price) * self.quantity
        self.is_open = False
        self.exit_time = datetime.now()


class UltraAdvancedBaseBot:
    """Base bot with common functionality"""
    
    def __init__(self, bot_name: str, symbol: str, initial_capital: float):
        self.bot_name = bot_name
        self.symbol = symbol
        self.current_capital = initial_capital
        self.initial_capital = initial_capital
        self.positions = {}
        self.closed_positions = []
        self.daily_pnl = 0.0
        self.total_pnl = 0.0
        self.daily_start = datetime.now()
        self.logger = logger
        
        # Mock engines
        self.order_flow_detector = type('Mock', (), {'detect_order_flow': lambda self, x: []})()
        self.neural_engine = type('Mock', (), {
            'prepare_features': lambda self, x: {},
            'predict': lambda self, x: {'direction': 'neutral', 'confidence': 0.5}
        })()
    
    def open_position(self, side: str, price: float, confidence: float, quantity: float) -> Optional[Position]:
        """Open a position"""
        try:
            position_id = f"pos_{int(time.time()*1000)}_{hashlib.md5(str(time.time()).encode()).hexdigest()[:6]}"
            stop_loss = price * 0.999 if side == "long" else price * 1.001
            take_profit = price * 1.002 if side == "long" else price * 0.998
            
            position = Position(position_id, side, price, quantity, stop_loss, take_profit)
            position.confidence = confidence
            self.positions[position_id] = position
            return position
        except Exception as e:
            self.logger.error(f"Open position error: {e}")
            return None
    
    def close_position(self, position_id: str, price: float, reason: str) -> Optional[Position]:
        """Close a position"""
        try:
            if position_id in self.positions:
                position = self.positions[position_id]
                position.close(price)
                self.closed_positions.append(position)
                self.total_pnl += position.realized_pnl
                self.daily_pnl += position.realized_pnl
                del self.positions[position_id]
                return position
            return None
        except Exception as e:
            self.logger.error(f"Close position error: {e}")
            return None
    
    def get_performance_metrics(self) -> Dict[str, Any]:
        """Get performance metrics"""
        total_trades = len(self.closed_positions)
        wins = sum(1 for p in self.closed_positions if p.realized_pnl > 0)
        losses = sum(1 for p in self.closed_positions if p.realized_pnl < 0)
        
        return {
            'total_trades': total_trades,
            'wins': wins,
            'losses': losses,
            'win_rate': (wins / total_trades * 100) if total_trades > 0 else 0,
            'total_pnl': self.total_pnl,
            'daily_pnl': self.daily_pnl,
            'current_capital': self.current_capital,
            'total_profit_percent': (self.total_pnl / self.initial_capital * 100) if self.initial_capital > 0 else 0
        }
    
    def get_status(self) -> Dict[str, Any]:
        """Get bot status"""
        return {
            'bot_name': self.bot_name,
            'symbol': self.symbol,
            'capital': self.current_capital,
            'open_positions': len(self.positions),
            'total_trades': len(self.closed_positions),
            'daily_pnl': self.daily_pnl
        }


