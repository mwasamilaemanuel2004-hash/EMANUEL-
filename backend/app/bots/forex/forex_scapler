@njit(cache=True)
def calculate_momentum_numba(prices: np.ndarray, period: int = 5) -> float:
    if len(prices) < period:
        return 0.0
    return (prices[-1] - prices[-period]) / prices[-period] if prices[-period] > 0 else 0.0

@njit(cache=True)
def calculate_volatility_numba(prices: np.ndarray, period: int = 20) -> float:
    if len(prices) < period:
        return 0.0
    returns = np.diff(prices[-period-1:]) / (prices[-period-1:-1] + 0.000001)
    return np.std(returns) * np.sqrt(252)

@njit(cache=True)
def calculate_zscore_numba(prices: np.ndarray, period: int = 20) -> float:
    if len(prices) < period:
        return 0.0
    window = prices[-period:]
    mean = np.mean(window)
    std = np.std(window)
    if std == 0:
        return 0.0
    return (prices[-1] - mean) / std


