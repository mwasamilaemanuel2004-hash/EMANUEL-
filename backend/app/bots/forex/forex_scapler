            high = market_data.get('high', prices)
            low = market_data.get('low', prices)
            volumes = market_data.get('volumes', [])
            
            if not prices:
                return {}
            
            indicators = self.scalp_indicators.calculate_all_scalp_indicators(prices)
            indicators['current_price'] = prices[-1]
            
            if volumes and len(volumes) >= 20:
                avg_volume = np.mean(volumes[-20:]) if np.mean(volumes[-20:]) > 0 else 1
                indicators['volume_ratio'] = volumes[-1] / avg_volume
            else:
                indicators['volume_ratio'] = 1.0
            
            micro_data = {}
            if self.config.get('use_micro_structure', True):
                ticks = market_data.get('ticks', [])
                if ticks:
                    micro_data = self.micro_structure.analyze_tick_flow(ticks)
                    micro_data['imbalance_ratio'] = self.micro_structure.imbalance_ratio
            
            order_flows = []
            if self.config.get('use_order_flow', True):
                order_flows = self.order_flow_detector.detect_order_flow(market_data)
            
            signal_data = self.signal_generator.generate_scalp_signal(
                market_data, indicators, micro_data, order_flows
            )
            
            nn_prediction = None
            if self.config.get('use_ml', True):
                nn_features = self.neural_engine.prepare_features(market_data)
                nn_prediction = self.neural_engine.predict(nn_features)
            
            return {
                'indicators': indicators,
                'micro_structure': micro_data,
                'order_flows': order_flows,
                'signal': signal_data,
                'neural_prediction': nn_prediction,
                'timestamp': datetime.now()
            }
        except Exception as e:
            self.logger.error(f"Analyze market error: {e}")
            return {}
    
    def generate_signal(self, analysis: Dict[str, Any]) -> Dict[str, Any]:
        if not analysis:
            return {'action': 'neutral', 'confidence': 0}
        
        signal_data = analysis.get('signal', {})
        combined_signal = signal_data.get('combined_signal', {})
        
        direction = combined_signal.get('direction', 'neutral')
        strength = combined_signal.get('strength', 0)
        confidence = combined_signal.get('confidence', 0)
        
        if not self._check_session_filter():
            return {'action': 'neutral', 'confidence': 0, 'reason': 'session_filter'}
        
        if not self._check_spread_filter(analysis):
            return {'action': 'neutral', 'confidence': 0, 'reason': 'spread_filter'}
        
        if strength < self.config.get('min_signal_strength', 0.6):
            return {'action': 'neutral', 'confidence': 0, 'reason': 'weak_signal'}
        
        if confidence < self.config.get('min_confidence', 0.55):
            return {'action': 'neutral', 'confidence': 0, 'reason': 'low_confidence'}
        
        if not self._check_cooldown():
            return {'action': 'neutral', 'confidence': 0, 'reason': 'cooldown'}
        
        return {
            'action': direction,
            'confidence': confidence,
            'strength': strength,
            'strategy': combined_signal.get('strategy', 'none'),
            'timestamp': datetime.now()
        }
    
    def _check_session_filter(self) -> bool:
        hour = datetime.now().hour
        if 0 <= hour < 8 and not self.config.get('trade_asian_session', True):
            return False
        if 8 <= hour < 16 and not self.config.get('trade_london_session', True):
            return False
        if 13 <= hour < 21 and not self.config.get('trade_ny_session', True):
            return False
        return True
    
    def _check_spread_filter(self, analysis: Dict[str, Any]) -> bool:
        spread = analysis.get('spread', 0)
        max_spread = self.config.get('max_spread_pips', 1.5) * 0.0001
        if spread > max_spread:
            return False
        return True
    
    def _check_cooldown(self) -> bool:
        if not self.closed_positions:
            return True
        last_trade = self.closed_positions[-1]
        time_since_last = (datetime.now() - last_trade.entry_time).total_seconds()
        if last_trade.realized_pnl > 0:
            cooldown = self.config.get('cooldown_after_win', 15)
        else:
            cooldown = self.config.get('cooldown_after_loss', 60)
        return time_since_last >= cooldown
    
    def execute_strategy(self, market_data: Dict[str, Any]) -> Dict[str, Any]:
        try:
            with self.scalp_lock:
                if not self._check_daily_limits():
                    return {'action': 'hold', 'reason': 'daily_limit_reached'}
                
                analysis = self.analyze_market(market_data)
                signal = self.generate_signal(analysis)
                
                if signal['action'] == 'neutral':
                    return {
                        'action': 'hold',
                        'reason': signal.get('reason', 'no_signal'),
                        'analysis': analysis,
                        'signal': signal
                    }
                
                prices = market_data.get('prices', [])
                if not prices:
                    return {'action': 'hold', 'reason': 'no_price'}
                
                current_price = prices[-1]
                position_size = self._calculate_scalp_position_size(current_price, signal['confidence'])
                
                if not self._check_scalp_risk_limits(position_size, current_price):
                    return {'action': 'hold', 'reason': 'risk_limit'}
                
                pip_size = self._get_pip_size()
                stop_loss_pips = self.config.get('scalp_stop_pips', 3)
                target_pips = self.config.get('scalp_target_pips', 5)
                
                if signal['action'] == 'long':
                    stop_loss = current_price - stop_loss_pips * pip_size
                    take_profit = current_price + target_pips * pip_size
                    side = "long"
                else:
                    stop_loss = current_price + stop_loss_pips * pip_size
                    take_profit = current_price - target_pips * pip_size
                    side = "short"
                
                position = self.open_position(side, current_price, signal['confidence'], position_size)
                
                if position:
                    position.stop_loss = stop_loss
                    position.take_profit = take_profit
                    
                    self.scalp_trades.append({
                        'position_id': position.id,
                        'entry_time': position.entry_time,
                        'entry_price': position.entry_price,
                        'side': position.side.value,
                        'strategy': signal.get('strategy', 'unknown'),
                        'confidence': signal['confidence']
                    })
                    
                    self.trades_today += 1
                    self.last_trade_time = datetime.now()
                    
                    return {
                        'action': 'buy' if side == 'long' else 'sell',
                        'reason': f"scalp_{signal.get('strategy', 'unknown')}",
                        'analysis': analysis,
                        'signal': signal,
                        'position': position
                    }
                
                return {'action': 'hold', 'reason': 'position_not_opened', 'signal': signal}
        except Exception as e:
            self.logger.error(f"Execute strategy error: {e}")
            return {'action': 'hold', 'reason': 'error', 'error': str(e)}
    
    def _calculate_scalp_position_size(self, price: float, confidence: float) -> float:
        risk_per_trade = self.config.get('risk_per_trade', 0.005)
        max_position_size = self.config.get('max_position_size', 0.05)
        risk_amount = self.current_capital * risk_per_trade
        confidence_multiplier = 0.5 + confidence
        if self.win_streak > 3:
            confidence_multiplier *= 1.2
        elif self.loss_streak > 2:
            confidence_multiplier *= 0.7
        position_value = risk_amount * confidence_multiplier * 10
        position_size = position_value / price if price > 0 else 0
        max_value = self.current_capital * max_position_size
        max_size = max_value / price if price > 0 else 0
        return min(position_size, max_size)
    
    def _check_scalp_risk_limits(self, position_size: float, current_price: float) -> bool:
        if self.loss_streak >= self.config.get('max_consecutive_losses', 5):
            self.logger.warning("Maximum consecutive losses reached")
            return False
        total_exposure = sum(p.quantity * p.current_price for p in self.positions.values())
        new_exposure = position_size * current_price
        max_exposure = self.current_capital * self.config.get('max_position_size', 0.05) * 2
        if total_exposure + new_exposure > max_exposure:
            return False
        return True
    
    def _check_daily_limits(self) -> bool:
        if self.trades_today >= self.config.get('max_daily_trades', 100):
            return False
        if self.daily_pnl >= self.current_capital * self.config.get('daily_pnl_target', 0.02):
            self.logger.info("Daily profit target reached")
            return False
        if self.daily_pnl <= -self.current_capital * self.config.get('daily_pnl_stop', 0.04):
            self.logger.info("Daily stop loss reached")
            return False
        return True
    
    def _get_pip_size(self) -> float:
        if 'JPY' in self.symbol:
            return 0.01
        return 0.0001
    
    def update_positions(self, current_price: float) -> None:
        for position in list(self.positions.values()):
            if not position.is_open:
                continue
            position.update_pnl(current_price)
            trade_duration = (datetime.now() - position.entry_time).total_seconds()
            if trade_duration > self.config.get('max_trade_duration', 300):
                self.close_position(position.id, current_price, "time_exit")
                continue
            if position.side == TradeSide.LONG:
                trail_pips = self.config.get('trailing_stop_pips', 2)
                trail_distance = trail_pips * self._get_pip_size()
                new_stop = current_price - trail_distance
                if new_stop > position.stop_loss:
                    position.stop_loss = new_stop
            else:
                trail_pips = self.config.get('trailing_stop_pips', 2)
                trail_distance = trail_pips * self._get_pip_size()
                new_stop = current_price + trail_distance
                if new_stop < position.stop_loss:
                    position.stop_loss = new_stop
    
    def close_position(self, position_id: str, price: float, reason: str) -> Optional[Position]:
        position = super().close_position(position_id, price, reason)
        if position:
            if position.realized_pnl > 0:
                self.win_streak += 1
                self.loss_streak = 0
                self.max_win_streak = max(self.max_win_streak, self.win_streak)
            else:
                self.loss_streak += 1
                self.win_streak = 0
                self.max_loss_streak = max(self.max_loss_streak, self.loss_streak)
            trade_duration = (datetime.now() - position.entry_time).total_seconds()
            self.avg_trade_duration.append(trade_duration)
            self.scalp_pnl.append(position.realized_pnl)
            self.logger.info(f"📊 Scalp closed: {reason} | PnL: ${position.realized_pnl:+.2f} | Duration: {trade_duration:.1f}s")
        return position
    
    def get_performance_metrics(self) -> Dict[str, Any]:
        metrics = super().get_performance_metrics()
        scalp_metrics = {
            'trades_today': self.trades_today,
            'win_streak': self.win_streak,
            'loss_streak': self.loss_streak,
            'max_win_streak': self.max_win_streak,
            'max_loss_streak': self.max_loss_streak,
            'avg_trade_duration': np.mean(self.avg_trade_duration) if self.avg_trade_duration else 0,
            'scalp_win_rate': (sum(1 for p in self.scalp_pnl if p > 0) / len(self.scalp_pnl) * 100) if self.scalp_pnl else 0,
            'avg_scalp_pnl': np.mean(self.scalp_pnl) if self.scalp_pnl else 0,
            'total_scalp_pnl': sum(self.scalp_pnl) if self.scalp_pnl else 0,
            'best_scalp': max(self.scalp_pnl) if self.scalp_pnl else 0,
            'worst_scalp': min(self.scalp_pnl) if self.scalp_pnl else 0
        }
        metrics.update(scalp_metrics)
        return metrics
    
    def get_status(self) -> Dict[str, Any]:
        return {
