class ScalpSignalGenerator:
    """Advanced scalp signal generator"""
    
    def __init__(self):
        self.signal_history = deque(maxlen=1000)
        self.signal_accuracy = deque(maxlen=100)
        self.strategy_performance = {}
    
    def generate_scalp_signal(self, market_data: Dict[str, Any], indicators: Dict[str, float],
                             micro_structure: Dict[str, Any], order_flows: List[Any]) -> Dict[str, Any]:
        try:
            signals = {}
            
            momentum_signal = self.generate_momentum_signal(indicators)
            signals['momentum'] = momentum_signal
            
            mean_reversion_signal = self.generate_mean_reversion_signal(indicators)
            signals['mean_reversion'] = mean_reversion_signal
            
            breakout_signal = self.generate_breakout_signal(indicators, market_data)
            signals['breakout'] = breakout_signal
            
            order_flow_signal = self.generate_order_flow_signal(order_flows, micro_structure)
            signals['order_flow'] = order_flow_signal
            
            micro_signal = self.generate_micro_structure_signal(micro_structure)
            signals['micro_structure'] = micro_signal
            
            combined_signal = self.combine_scalp_signals(signals)
            
            return {
                'individual_signals': signals,
                'combined_signal': combined_signal,
                'best_strategy': combined_signal.get('strategy', 'none'),
                'confidence': combined_signal.get('confidence', 0),
                'direction': combined_signal.get('direction', 'neutral'),
                'timestamp': datetime.now()
            }
        except Exception as e:
            logger.debug(f"Generate scalp signal error: {e}")
            return {'direction': 'neutral', 'confidence': 0}
    
    def generate_momentum_signal(self, indicators: Dict[str, float]) -> Dict[str, Any]:
        momentum = indicators.get('momentum', 0)
        ema_5 = indicators.get('ema_5', 0)
        ema_20 = indicators.get('ema_20', 0)
        rsi = indicators.get('rsi', 50)
        
        direction = 'neutral'
        strength = 0
        
        if momentum > 0.0005 and ema_5 > ema_20 and rsi > 50:
            direction = 'long'
            strength = min(1.0, momentum * 100 + 0.3)
        elif momentum < -0.0005 and ema_5 < ema_20 and rsi < 50:
            direction = 'short'
            strength = min(1.0, abs(momentum) * 100 + 0.3)
        
        return {'direction': direction, 'strength': strength, 'confidence': strength * 0.8}
    
    def generate_mean_reversion_signal(self, indicators: Dict[str, float]) -> Dict[str, Any]:
        zscore = indicators.get('zscore', 0)
        current_price = indicators.get('current_price', 0)
        
        direction = 'neutral'
        strength = 0
        
        if zscore > 2:
            direction = 'short'
            strength = min(1.0, (zscore - 2) * 0.3)
        elif zscore < -2:
            direction = 'long'
            strength = min(1.0, (-zscore - 2) * 0.3)
        
        return {'direction': direction, 'strength': strength, 'confidence': strength * 0.7}
    
    def generate_breakout_signal(self, indicators: Dict[str, float], market_data: Dict[str, Any]) -> Dict[str, Any]:
        upper_bb, _, lower_bb = indicators.get('bollinger', (0, 0, 0))
        current_price = indicators.get('current_price', 0)
        volume_ratio = market_data.get('volume_ratio', 1)
        
        direction = 'neutral'
        strength = 0
        
        if current_price > upper_bb and volume_ratio > 1.5:
            direction = 'long'
            strength = min(1.0, volume_ratio * 0.3)
        elif current_price < lower_bb and volume_ratio > 1.5:
            direction = 'short'
            strength = min(1.0, volume_ratio * 0.3)
        
        return {'direction': direction, 'strength': strength, 'confidence': strength * 0.85}
    
    def generate_order_flow_signal(self, order_flows: List[Any], micro_structure: Dict[str, Any]) -> Dict[str, Any]:
        imbalance = micro_structure.get('imbalance_ratio', 0)
        direction = 'neutral'
        strength = 0
        
        if imbalance > 0.3:
            direction = 'long'
            strength = min(1.0, 0.4 + imbalance)
        elif imbalance < -0.3:
            direction = 'short'
            strength = min(1.0, 0.4 + abs(imbalance))
        
        return {'direction': direction, 'strength': strength, 'confidence': strength * 0.9}
    
    def generate_micro_structure_signal(self, micro_structure: Dict[str, Any]) -> Dict[str, Any]:
        tick_velocity = micro_structure.get('tick_velocity', 0)
        micro_trend = micro_structure.get('micro_trend', 'neutral')
        
        direction = 'neutral'
        strength = 0
        
        if micro_trend == 'up' and tick_velocity > 0:
            direction = 'long'
            strength = min(1.0, abs(tick_velocity) * 100 + 0.3)
        elif micro_trend == 'down' and tick_velocity < 0:
            direction = 'short'
            strength = min(1.0, abs(tick_velocity) * 100 + 0.3)
        
        return {'direction': direction, 'strength': strength, 'confidence': strength * 0.75}
    
    def combine_scalp_signals(self, signals: Dict[str, Dict[str, Any]]) -> Dict[str, Any]:
        long_score = 0
        short_score = 0
        total_confidence = 0
        
        weights = {
            'momentum': 0.25,
            'mean_reversion': 0.15,
            'breakout': 0.20,
            'order_flow': 0.25,
            'micro_structure': 0.15
        }
        
        for strategy, signal_data in signals.items():
            weight = weights.get(strategy, 0.15)
            direction = signal_data.get('direction', 'neutral')
            strength = signal_data.get('strength', 0)
            confidence = signal_data.get('confidence', 0)
            
            if direction == 'long':
                long_score += strength * weight
            elif direction == 'short':
                short_score += strength * weight
            
            total_confidence += confidence * weight
        
        if long_score > short_score * 1.2:
            direction = 'long'
            strength = min(1.0, long_score)
            strategy = 'momentum'
        elif short_score > long_score * 1.2:
            direction = 'short'
            strength = min(1.0, short_score)
            strategy = 'momentum'
        else:
            direction = 'neutral'
            strength = 0
            strategy = 'none'
        
        return {
            'direction': direction,
            'strength': strength,
            'confidence': min(1.0, total_confidence),
            'strategy': strategy,
            'long_score': long_score,
            'short_score': short_score
        }


