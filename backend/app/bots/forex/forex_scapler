class MicroMarketStructure:
    """Micro market structure analysis for scalping"""
    
    def __init__(self):
        self.order_book = {}
        self.tick_history = deque(maxlen=10000)
        self.micro_trends = {}
        self.liquidity_levels = {'bid': [], 'ask': []}
        self.imbalance_ratio = 0.0
        self.flow_toxicity = 0.0  # VPIN-like metric
        
    def update_order_book(self, bids: List[Tuple[float, float]], asks: List[Tuple[float, float]]) -> None:
        """Update order book data"""
        self.order_book = {
            'bids': sorted(bids, key=lambda x: x[0], reverse=True),
            'asks': sorted(asks, key=lambda x: x[0])
        }
        
        # Calculate imbalance
        total_bid_volume = sum(volume for _, volume in bids[:10])
        total_ask_volume = sum(volume for _, volume in asks[:10])
        
        if total_bid_volume + total_ask_volume > 0:
            self.imbalance_ratio = (total_bid_volume - total_ask_volume) / (total_bid_volume + total_ask_volume)
        
        # Update liquidity levels
        self.liquidity_levels = {
            'bid': [price for price, _ in bids[:5]],
            'ask': [price for price, _ in asks[:5]]
        }
    
    def analyze_tick_flow(self, ticks: List[Dict[str, Any]]) -> Dict[str, Any]:
        """Analyze tick flow for scalping signals"""
        if not ticks:
            return {}
        
        # Extract tick data
        prices = [tick.get('price', 0) for tick in ticks]
        volumes = [tick.get('volume', 0) for tick in ticks]
        sides = [tick.get('side', 'neutral') for tick in ticks]
        
        # Calculate tick velocity
        tick_velocity = self.calculate_tick_velocity(prices)
        
        # Calculate volume weighted average price
        vwap = self.calculate_vwap(prices, volumes)
        
        # Calculate flow toxicity
        self.flow_toxicity = self.calculate_flow_toxicity(volumes, sides)
        
        return {
            'tick_velocity': tick_velocity,
            'vwap': vwap,
            'flow_toxicity': self.flow_toxicity,
            'price_impact': self.calculate_price_impact(prices, volumes),
            'micro_trend': self.detect_micro_trend(prices)
        }
    
    def calculate_tick_velocity(self, prices: List[float]) -> float:
        """Calculate tick velocity"""
        if len(prices) < 2:
            return 0.0
        
        # Calculate rate of price change
        price_changes = np.diff(prices)
        time_intervals = np.ones_like(price_changes)  # Assume uniform time
        
        velocity = np.mean(price_changes) / np.mean(time_intervals)
        return velocity
    
    def calculate_vwap(self, prices: List[float], volumes: List[float]) -> float:
        """Calculate Volume Weighted Average Price"""
        if not prices or not volumes:
            return 0.0
        
        total_volume = sum(volumes)
        if total_volume == 0:
            return np.mean(prices)
        
        vwap = sum(p * v for p, v in zip(prices, volumes)) / total_volume
        return vwap
    
    def calculate_flow_toxicity(self, volumes: List[float], sides: List[str]) -> float:
        """Calculate flow toxicity (VPIN)"""
        if not volumes:
            return 0.0
        
        buy_volume = sum(v for v, s in zip(volumes, sides) if s == 'buy')
        sell_volume = sum(v for v, s in zip(volumes, sides) if s == 'sell')
        
        total_volume = buy_volume + sell_volume
        if total_volume == 0:
            return 0.0
        
        toxicity = abs(buy_volume - sell_volume) / total_volume
        return toxicity
    
    def calculate_price_impact(self, prices: List[float], volumes: List[float]) -> float:
        """Calculate price impact of trades"""
        if len(prices) < 2 or not volumes:
            return 0.0
        
        # Kyle's Lambda approximation
        price_changes = np.abs(np.diff(prices))
        avg_volume = np.mean(volumes)
        
        if avg_volume == 0:
            return 0.0
        
        impact = np.mean(price_changes) / avg_volume
        return impact
    
    def detect_micro_trend(self, prices: List[float]) -> str:
        """Detect micro trend from tick data"""
        if len(prices) < 5:
            return 'neutral'
        
        # Short-term trend detection
        short_ma = np.mean(prices[-3:])
        long_ma = np.mean(prices[-5:])
        
        if short_ma > long_ma * 1.0001:
            return 'up'
        elif short_ma < long_ma * 0.9999:
            return 'down'
        else:
            return 'neutral'

@njit(cache=True, parallel=True)
def calculate_momentum_numba(prices: np.ndarray, period: int = 5) -> float:
    """Numba optimized momentum calculation"""
    if len(prices) < period:
        return 0.0
    
    momentum = (prices[-1] - prices[-period]) / prices[-period]
    return momentum

@njit(cache=True, parallel=True)
def calculate_volatility_numba(prices: np.ndarray, period: int = 20) -> float:
    """Numba optimized volatility calculation"""
    if len(prices) < period:
        return 0.0
    
    returns = np.diff(prices[-period-1:]) / prices[-period-1:-1]
    volatility = np.std(returns) * np.sqrt(252)  # Annualized
    return volatility

@njit(cache=True, parallel=True)
def calculate_zscore_numba(prices: np.ndarray, period: int = 20) -> float:
    """Numba optimized Z-Score calculation"""
    if len(prices) < period:
        return 0.0
    
    window = prices[-period:]
    mean = np.mean(window)
    std = np.std(window)
    
    if std == 0:
        return 0.0
    
    zscore = (prices[-1] - mean) / std
    return zscore

@vectorize(['float64(float64, float64)'], target='parallel')
def calculate_spread_vectorized(bid: float, ask: float) -> float:
    """Vectorized spread calculation"""
    return (ask - bid) / ask

class UltraScalpIndicators:
    """Ultra-fast scalping indicators"""
    
    def __init__(self):
        self._cache = {}
        self._cache_timestamps = {}
        self._cache_duration = 0.1  # 100ms for scalping
        
    @lru_cache(maxsize=512)
    def calculate_ema_scalp(self, prices_tuple: Tuple[float, ...], period: int) -> float:
        """Ultra-fast EMA for scalping"""
        prices = np.array(prices_tuple)
        if len(prices) < period:
            return prices[-1] if len(prices) > 0 else 0.0
        
        alpha = 2.0 / (period + 1)
        ema = prices[0]
        
        for price in prices[1:]:
            ema = alpha * price + (1 - alpha) * ema
        
        return ema
    
    @lru_cache(maxsize=512)
    def calculate_rsi_scalp(self, prices_tuple: Tuple[float, ...], period: int = 14) -> float:
        """Ultra-fast RSI for scalping"""
        prices = np.array(prices_tuple)
        
        if NUMBA_AVAILABLE:
            from ..base_bot import calculate_rsi_numba
            return calculate_rsi_numba(prices, period)
        
        if len(prices) < period + 1:
            return 50.0
        
        deltas = np.diff(prices[-period-1:])
        gains = np.where(deltas > 0, deltas, 0)
        losses = np.where(deltas < 0, -deltas, 0)
        
        avg_gain = np.mean(gains)
        avg_loss = np.mean(losses)
        
        if avg_loss == 0:
            return 100.0
        
        rs = avg_gain / avg_loss
        return 100.0 - (100.0 / (1.0 + rs))
    
    @lru_cache(maxsize=256)
    def calculate_bollinger_scalp(self, prices_tuple: Tuple[float, ...], period: int = 20, std_dev: float = 2.0) -> Tuple[float, float, float]:
        """Ultra-fast Bollinger Bands for scalping"""
        prices = np.array(prices_tuple)
        
        if len(prices) < period:
            middle = np.mean(prices)
            return middle, middle, middle
        
        middle = np.mean(prices[-period:])
        std = np.std(prices[-period:])
        
        upper = middle + std_dev * std
        lower = middle - std_dev * std
        
        return upper, middle, lower
    
    def calculate_all_scalp_indicators(self, prices: List[float]) -> Dict[str, float]:
        """Calculate all scalping indicators in parallel"""
        if not prices:
            return {}
        
        prices_tuple = tuple(prices[-50:])  # Keep last 50 for calculation
        
        # Submit parallel calculations
        with ThreadPoolExecutor(max_workers=8) as executor:
            futures = {
                'ema_5': executor.submit(self.calculate_ema_scalp, prices_tuple, 5),
                'ema_10': executor.submit(self.calculate_ema_scalp, prices_tuple, 10),
                'ema_20': executor.submit(self.calculate_ema_scalp, prices_tuple, 20),
                'rsi': executor.submit(self.calculate_rsi_scalp, prices_tuple, 14),
                'bollinger': executor.submit(self.calculate_bollinger_scalp, prices_tuple, 20, 2.0)
            }
            
            results = {}
            for key, future in futures.items():
                try:
                    results[key] = future.result(timeout=0.5)
                except Exception as e:
                    results[key] = None
        
        # Add momentum and volatility
        prices_np = np.array(prices[-50:])
        if NUMBA_AVAILABLE:
            results['momentum'] = calculate_momentum_numba(prices_np, 5)
            results['volatility'] = calculate_volatility_numba(prices_np, 20)
            results['zscore'] = calculate_zscore_numba(prices_np, 20)
        else:
            results['momentum'] = (prices[-1] - prices[-5]) / prices[-5] if len(prices) >= 5 else 0
            results['volatility'] = np.std(np.diff(prices[-21:])) if len(prices) >= 21 else 0
            results['zscore'] = (prices[-1] - np.mean(prices[-20:])) / np.std(prices[-20:]) if len(prices) >= 20 and np.std(prices[-20:]) > 0 else 0
        
        return results

