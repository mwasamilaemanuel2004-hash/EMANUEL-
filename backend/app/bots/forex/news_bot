class NewsDataStream:
    """Real-time news data stream processor"""
    
    def __init__(self):
        self.news_stream = deque(maxlen=10000)
        self.source_weights = {
            NewsSourceType.REUTERS: 1.0,
            NewsSourceType.BLOOMBERG: 1.0,
            NewsSourceType.CNBC: 0.8,
            NewsSourceType.FOREX_FACTORY: 0.9,
            NewsSourceType.TWITTER: 0.5,
            NewsSourceType.REDDIT: 0.3,
            NewsSourceType.TELEGRAM: 0.4,
            NewsSourceType.OFFICIAL: 1.2,
            NewsSourceType.CENTRAL_BANK: 1.5,
            NewsSourceType.GOVERNMENT: 1.3
        }
        self.processing_queue = asyncio.Queue(maxsize=1000)
        
    def add_news(self, news_item: Dict[str, Any]) -> None:
        """Add news item to stream"""
        self.news_stream.append({
            **news_item,
            'timestamp': datetime.now(),
            'processed': False
        })
    
    def get_recent_news(self, seconds: int = 60) -> List[Dict[str, Any]]:
        """Get recent news items"""
        cutoff = datetime.now() - timedelta(seconds=seconds)
        return [n for n in self.news_stream if n['timestamp'] >= cutoff]
    
    def get_weighted_news(self, seconds: int = 300) -> List[Dict[str, Any]]:
        """Get weighted news items"""
        recent = self.get_recent_news(seconds)
        
        for item in recent:
            source = item.get('source', NewsSourceType.FOREX_FACTORY)
            item['weight'] = self.source_weights.get(source, 0.5)
        
        return sorted(recent, key=lambda x: x['weight'], reverse=True)

class AdvancedSentimentEngine:
    """Advanced multi-model sentiment analysis"""
    
    def __init__(self):
        self.models = {}
        self.sentiment_history = deque(maxlen=5000)
        self.category_sentiment = {}
        self.entity_sentiment = {}
        
        # Initialize models
        if NLTK_AVAILABLE:
            self.models['vader'] = SentimentIntensityAnalyzer()
        
        if SKLEARN_AVAILABLE:
            self.models['tfidf'] = TfidfVectorizer(max_features=5000)
            self.models['naive_bayes'] = MultinomialNB()
            self.models['random_forest'] = RandomForestClassifier(n_estimators=100)
            self.models['gradient_boosting'] = GradientBoostingClassifier(n_estimators=100)
            self.models['svm'] = SVC(probability=True)
        
        self.trained = False
    
    def analyze_sentiment(self, text: str, source: NewsSourceType = NewsSourceType.FOREX_FACTORY) -> Dict[str, Any]:
        """Analyze sentiment using multiple models"""
        sentiment_scores = {}
        confidences = {}
        
        # VADER analysis
        if 'vader' in self.models:
            vader_scores = self.models['vader'].polarity_scores(text)
            sentiment_scores['vader'] = vader_scores['compound']
            confidences['vader'] = max(abs(vader_scores['pos']), abs(vader_scores['neg']))
        
        # TextBlob analysis
        if TEXTBLOB_AVAILABLE:
            blob = TextBlob(text)
            sentiment_scores['textblob'] = blob.sentiment.polarity
            confidences['textblob'] = blob.sentiment.subjectivity
        
        # Keyword analysis
        keyword_score = self._keyword_sentiment(text)
        sentiment_scores['keyword'] = keyword_score
        confidences['keyword'] = 0.6
        
        # Combine scores
        if sentiment_scores:
            # Weighted average
            weights = {
                'vader': 1.0,
                'textblob': 0.8,
                'keyword': 0.6
            }
            
            total_weight = sum(weights.get(k, 0.5) for k in sentiment_scores)
            weighted_score = sum(sentiment_scores[k] * weights.get(k, 0.5) for k in sentiment_scores) / total_weight
            
            # Average confidence
            avg_confidence = np.mean(list(confidences.values()))
            
            # Determine sentiment level
            sentiment_level = self._score_to_level(weighted_score)
            
            result = {
                'score': weighted_score,
                'confidence': avg_confidence,
                'level': sentiment_level,
                'individual_scores': sentiment_scores,
                'individual_confidences': confidences,
                'source': source.value if isinstance(source, NewsSourceType) else str(source)
            }
            
            # Store in history
            self.sentiment_history.append(result)
            
            return result
        
        return {'score': 0, 'confidence': 0, 'level': SentimentLevel.NEUTRAL}
    
    def _keyword_sentiment(self, text: str) -> float:
        """Enhanced keyword sentiment analysis"""
        bullish_words = {
            'growth': 1, 'increase': 1, 'improve': 1, 'strong': 1, 'positive': 1,
            'beat': 2, 'exceed': 2, 'up': 0.5, 'gain': 1, 'rally': 2,
            'bullish': 2, 'optimistic': 1, 'surge': 2, 'boom': 2, 'expand': 1,
            'record': 2, 'breakthrough': 2, 'success': 1, 'profit': 1, 'upgrade': 2
        }
        
        bearish_words = {
            'decline': -1, 'decrease': -1, 'worse': -1, 'weak': -1, 'negative': -1,
            'miss': -2, 'below': -2, 'down': -0.5, 'loss': -1, 'fall': -1,
            'bearish': -2, 'pessimistic': -1, 'crash': -2, 'recession': -2, 'contract': -1,
            'downgrade': -2, 'failure': -1, 'debt': -1, 'crisis': -2, 'collapse': -2
        }
        
        text_lower = text.lower()
        score = 0
        word_count = 0
        
        for word, weight in bullish_words.items():
            if word in text_lower:
                score += weight
                word_count += 1
        
        for word, weight in bearish_words.items():
            if word in text_lower:
                score += weight
                word_count += 1
        
        return score / max(1, word_count) if word_count > 0 else 0
    
    def _score_to_level(self, score: float) -> SentimentLevel:
        """Convert score to sentiment level"""
        if score > 0.8:
            return SentimentLevel.EXTREME_BULLISH
        elif score > 0.6:
            return SentimentLevel.VERY_BULLISH
        elif score > 0.3:
            return SentimentLevel.BULLISH
        elif score > 0.1:
            return SentimentLevel.SLIGHTLY_BULLISH
        elif score < -0.8:
            return SentimentLevel.EXTREME_BEARISH
        elif score < -0.6:
            return SentimentLevel.VERY_BEARISH
        elif score < -0.3:
            return SentimentLevel.BEARISH
        elif score < -0.1:
            return SentimentLevel.SLIGHTLY_BEARISH
        else:
            return SentimentLevel.NEUTRAL
    
    def train_models(self, X: List[str], y: List[int]) -> None:
        """Train ML models"""
        if not SKLEARN_AVAILABLE or len(X) < 10:
            return
        
        try:
            # TF-IDF transformation
            X_tfidf = self.models['tfidf'].fit_transform(X)
            
            # Train models
            self.models['naive_bayes'].fit(X_tfidf, y)
            self.models['random_forest'].fit(X_tfidf, y)
            self.models['gradient_boosting'].fit(X_tfidf, y)
            self.models['svm'].fit(X_tfidf, y)
            
            self.trained = True
            logger.info("Sentiment models trained")
            
        except Exception as e:
            logger.error(f"Error training sentiment models: {e}")
    
    def get_sentiment_momentum(self, period: int = 10) -> float:
        """Get sentiment momentum"""
        if len(self.sentiment_history) < period:
            return 0.0
        
        recent_scores = [s['score'] for s in list(self.sentiment_history)[-period:]]
        
        if NUMBA_AVAILABLE:
            return sentiment_momentum_numba(np.array(recent_scores), period)
        
        return (recent_scores[-1] - recent_scores[0]) / period

class PredictiveNewsEngine:
    """Predictive analytics for news impact"""
    
    def __init__(self):
        self.impact_predictions = {}
        self.historical_impacts = {}
        self.prediction_history = deque(maxlen=1000)
        self.accuracy_history = deque(maxlen=100)
        self.feature_importance = {}
        
    def predict_impact(self, event: Dict[str, Any], market_data: Dict[str, Any]) -> Dict[str, Any]:
        """Predict news impact using multiple methods"""
        
        # Extract event features
        category = event.get('category')
        impact_level = event.get('impact')
        forecast = event.get('forecast')
        previous = event.get('previous')
        
        # Historical impact analysis
        historical_impact = self._get_historical_impact(category, impact_level)
        
        # Market condition factor
        market_factor = self._get_market_condition_factor(market_data)
        
        # Surprise factor
        surprise = self._calculate_surprise_factor(forecast, previous)
        
        # Volatility prediction
        predicted_volatility = self._predict_volatility(historical_impact, market_factor, surprise)
        
        # Direction prediction
        predicted_direction = self._predict_direction(event, market_data)
        
        # Confidence calculation
        confidence = self._calculate_prediction_confidence(
            historical_impact,
            market_factor,
            surprise
        )
        
        prediction = {
            'predicted_volatility': predicted_volatility,
            'predicted_direction': predicted_direction,
            'confidence': confidence,
            'historical_impact': historical_impact,
            'market_factor': market_factor,
            'surprise_factor': surprise
        }
        
        # Store prediction
        self.prediction_history.append({
            'timestamp': datetime.now(),
            'event': event.get('title', 'unknown'),
            'prediction': prediction
        })
        
        return prediction
    
    def _get_historical_impact(self, category: str, impact_level: str) -> float:
        """Get historical impact for category"""
        if category in self.historical_impacts:
            impacts = self.historical_impacts[category]
            if impacts:
                return np.mean(impacts)
        
        # Default based on impact level
        impact_values = {
            'low': 0.2,
            'medium': 0.4,
            'high': 0.6,
            'critical': 0.8,
            'extreme': 1.0
        }
        
        return impact_values.get(impact_level.lower(), 0.4)
    
    def _get_market_condition_factor(self, market_data: Dict[str, Any]) -> float:
        """Get market condition factor"""
        prices = market_data.get('prices', [])
        
        if len(prices) < 50:
            return 1.0
        
        # Calculate current volatility
        returns = np.diff(prices[-50:]) / prices[-50:-1]
        current_vol = np.std(returns)
        
        # Normalize
        return min(2.0, max(0.5, current_vol * 100))
    
    def _calculate_surprise_factor(self, forecast: Optional[float], previous: Optional[float]) -> float:
        """Calculate surprise factor"""
        if forecast is None or previous is None:
            return 1.0
        
        expected_change = abs(forecast - previous) / abs(previous) if previous != 0 else 0
        
        return 1.0 + expected_change * 10
    
    def _predict_volatility(self, historical: float, market_factor: float, surprise: float) -> float:
        """Predict volatility"""
        base = historical * 0.5 + market_factor * 0.3 + surprise * 0.2
        return min(1.0, base)
    
    def _predict_direction(self, event: Dict[str, Any], market_data: Dict[str, Any]) -> float:
        """Predict direction of impact"""
        # Use sentiment if available
        sentiment = event.get('sentiment', {})
        sentiment_score = sentiment.get('score', 0) if sentiment else 0
        
        # Use forecast vs previous
        forecast = event.get('forecast')
        previous = event.get('previous')
        
        forecast_direction = 0
        if forecast is not None and previous is not None:
            if forecast > previous:
                forecast_direction = 0.3
            elif forecast < previous:
                forecast_direction = -0.3
        
        # Combine
        direction = sentiment_score * 0.7 + forecast_direction * 0.3
        
        return max(-1.0, min(1.0, direction))
    
    def _calculate_prediction_confidence(self, historical: float, market_factor: float, surprise: float) -> float:
        """Calculate prediction confidence"""
        # More confidence with higher impact and stable market
        confidence = (historical * 0.4 + (2 - abs(market_factor - 1)) * 0.3 + min(surprise, 3) / 3 * 0.3)
        return min(1.0, confidence)
    
    def update_accuracy(self, predicted: float, actual: float) -> None:
        """Update prediction accuracy"""
        accuracy = 1.0 - abs(predicted - actual)
        self.accuracy_history.append(accuracy)

