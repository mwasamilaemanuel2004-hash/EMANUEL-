@njit(cache=True, parallel=True)
def news_impact_scorer_numba(historical_impacts: np.ndarray, 
                            current_forecast: float, 
                            previous_value: float,
                            market_volatility: float) -> float:
    """Numba optimized news impact scoring"""
    if len(historical_impacts) == 0:
        return 0.5
    
    # Calculate deviation
    deviation = abs(current_forecast - previous_value) / abs(previous_value) if previous_value != 0 else 0
    
    # Historical impact analysis
    avg_impact = np.mean(historical_impacts)
    max_impact = np.max(historical_impacts)
    
    # Combine factors
    impact_score = (deviation * 10 + avg_impact * 0.5 + market_volatility * 0.3) / (1 + max_impact)
    
    return min(1.0, impact_score)

@njit(cache=True, parallel=True)
def sentiment_momentum_numba(sentiment_series: np.ndarray, period: int = 10) -> float:
    """Numba optimized sentiment momentum"""
    if len(sentiment_series) < period:
        return 0.0
    
    recent = sentiment_series[-period:]
    momentum = (recent[-1] - recent[0]) / period
    
    return momentum

