            description = news_item.get('description', '')
            text = f"{title} {description}"
            
            # Analyze sentiment
            sentiment = self.sentiment_engine.analyze_sentiment(text)
            
            # Predict impact
            prediction = self.predictive_engine.predict_impact(news_item, {})
            
            # Determine tradability
            impact_level = news_item.get('impact', 'low')
            tradable = self._is_tradable(impact_level, sentiment, prediction)
            
            result = {
                'news_item': news_item,
                'sentiment': sentiment,
                'prediction': prediction,
                'tradable': tradable,
                'timestamp': datetime.now()
            }
            
            # Add to buffer
            self.news_buffer.append(result)
            
            # Generate trading signal if tradable
            if tradable:
                signal = self._generate_news_signal(result)
                if signal['action'] != 'neutral':
                    self._execute_news_trade(signal, result)
            
            return result
            
        except Exception as e:
            self.logger.error(f"Error processing news: {e}")
            return {}
    
    def _is_tradable(self, impact_level: str, sentiment: Dict[str, Any], prediction: Dict[str, Any]) -> bool:
        """Check if news is tradable"""
        # Check impact level
        impact_mapping = {
            'low': NewsImpactLevel.LOW,
            'medium': NewsImpactLevel.MEDIUM,
            'high': NewsImpactLevel.HIGH,
            'critical': NewsImpactLevel.CRITICAL,
            'extreme': NewsImpactLevel.EXTREME
        }
        
        impact = impact_mapping.get(impact_level.lower(), NewsImpactLevel.LOW)
        
        if impact.value < self.config['min_impact_level'].value:
            return False
        
        # Check sentiment confidence
        if self.config.get('use_sentiment_analysis', True):
            if sentiment.get('confidence', 0) < self.config.get('min_sentiment_confidence', 0.35):
                return False
        
        # Check prediction confidence
        if self.config.get('use_predictive_analytics', True):
            if prediction.get('confidence', 0) < self.config.get('min_prediction_confidence', 0.4):
                return False
        
        return True
    
    def _generate_news_signal(self, news_result: Dict[str, Any]) -> Dict[str, Any]:
        """Generate news trading signal"""
        sentiment = news_result.get('sentiment', {})
        prediction = news_result.get('prediction', {})
        
        sentiment_score = sentiment.get('score', 0)
        predicted_direction = prediction.get('predicted_direction', 0)
        predicted_volatility = prediction.get('predicted_volatility', 0.5)
        
        # Combine signals
        combined_direction = sentiment_score * 0.6 + predicted_direction * 0.4
        confidence = (abs(combined_direction) * 0.5 + predicted_volatility * 0.5)
        
        # Determine action
        if combined_direction > 0.2:
            action = 'long'
        elif combined_direction < -0.2:
            action = 'short'
        else:
            action = 'neutral'
        
        return {
            'action': action,
            'confidence': min(1.0, confidence),
            'strength': abs(combined_direction),
            'predicted_volatility': predicted_volatility,
            'sentiment_score': sentiment_score
        }
    
    def _execute_news_trade(self, signal: Dict[str, Any], news_result: Dict[str, Any]) -> None:
        """Execute news trade"""
        try:
            with self.news_lock:
                # Check concurrent trades
                if len(self.news_positions) >= self.config.get('max_concurrent_news_trades', 3):
                    return
                
                # Calculate position size
                position_size = self._calculate_position_size(signal['confidence'])
                
                # Open position
                position = self.open_position(
                    signal['action'],
                    self.current_market_context.price if self.current_market_context else 0,
                    signal['confidence'],
                    position_size
                )
                
                if position:
                    # Set news-specific stops
                    stop_loss = position.entry_price * (1 - self.config['news_stop_loss']) if signal['action'] == 'long' else position.entry_price * (1 + self.config['news_stop_loss'])
                    take_profit = position.entry_price * (1 + self.config['news_take_profit']) if signal['action'] == 'long' else position.entry_price * (1 - self.config['news_take_profit'])
                    
                    position.stop_loss = stop_loss
                    position.take_profit = take_profit
                    
                    # Store position info
                    self.news_positions[position.id] = {
                        'position': position,
                        'news_result': news_result,
                        'signal': signal,
                        'entry_time': datetime.now()
                    }
                    
                    self.logger.info(f"News trade opened: {signal['action']} @ {position.entry_price}")
                    
        except Exception as e:
            self.logger.error(f"Error executing news trade: {e}")
    
    def _calculate_position_size(self, confidence: float) -> float:
        """Calculate position size"""
        risk_amount = self.current_capital * self.config.get('risk_per_news_trade', 0.015)
        position_value = risk_amount * (0.5 + confidence) * 3
        
        if self.current_market_context and self.current_market_context.price > 0:
            return position_value / self.current_market_context.price
        
        return 0
    
    def start_real_time_processing(self) -> None:
        """Start real-time news processing"""
        if self.is_processing:
            return
        
        self.is_processing = True
        self.processing_thread = threading.Thread(target=self._process_stream)
        self.processing_thread.start()
        
        self.logger.info("Real-time news processing started")
    
    def stop_real_time_processing(self) -> None:
        """Stop real-time news processing"""
        self.is_processing = False
        self.logger.info("Real-time news processing stopped")
    
    def _process_stream(self) -> None:
        """Process news stream"""
        while self.is_processing:
            try:
                # Process buffered news
                while self.news_buffer:
                    news_result = self.news_buffer.popleft()
                    self._update_strategy_performance(news_result)
                
                # Check for new news
                recent_news = self.news_stream.get_recent_news(seconds=5)
                
                for news_item in recent_news:
                    if not news_item.get('processed', False):
                        self.process_news_item(news_item)
                        news_item['processed'] = True
                
                time.sleep(self.config.get('processing_interval', 0.5))
                
            except Exception as e:
                self.logger.error(f"Error in news processing: {e}")
                time.sleep(1)
    
