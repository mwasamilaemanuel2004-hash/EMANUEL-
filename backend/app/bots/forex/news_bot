    def update_positions(self, current_price: float) -> None:
        """Update positions with news-specific logic"""
        super().update_positions(current_price)
        
        # Update news positions
        for position_id, trade_info in list(self.news_positions.items()):
            position = trade_info['position']
            
            # Check time-based exit
            trade_duration = (datetime.now() - trade_info['entry_time']).total_seconds()
            
            if trade_duration > self.config.get('news_window_after', 1800):
                self.close_position(position_id, current_price, "news_window_expired")
                del self.news_positions[position_id]
                continue
            
            # Update position
            position.update_pnl(current_price)
            
            # Check stop loss and take profit
            if position.side == TradeSide.LONG:
                if current_price <= position.stop_loss:
                    self.close_position(position_id, current_price, "stop_loss")
                    del self.news_positions[position_id]
                elif current_price >= position.take_profit:
                    self.close_position(position_id, current_price, "take_profit")
                    del self.news_positions[position_id]
            else:
                if current_price >= position.stop_loss:
                    self.close_position(position_id, current_price, "stop_loss")
                    del self.news_positions[position_id]
                elif current_price <= position.take_profit:
                    self.close_position(position_id, current_price, "take_profit")
                    del self.news_positions[position_id]
    
    def close_position(self, position_id: str, price: float, reason: str) -> Optional[Position]:
        """Close position with news metrics"""
        position = super().close_position(position_id, price, reason)
        
        if position:
            # Update news trade history
            self.news_trade_history.append({
                'position_id': position.id,
                'entry_time': position.entry_time,
                'exit_time': datetime.now(),
                'pnl': position.realized_pnl,
                'reason': reason
            })
            
            # Update performance
            self.news_win_rate.append(1 if position.realized_pnl > 0 else 0)
            self.avg_news_profit.append(position.realized_pnl)
        
        return position
    
    def get_performance_metrics(self) -> Dict[str, Any]:
        """Get comprehensive performance metrics"""
        metrics = super().get_performance_metrics()
        
        # News-specific metrics
        news_metrics = {
            'total_news_trades': len(self.news_trade_history),
            'news_win_rate': np.mean(self.news_win_rate) * 100 if self.news_win_rate else 0,
            'avg_news_profit': np.mean(self.avg_news_profit) if self.avg_news_profit else 0,
            'total_news_pnl': sum(t['pnl'] for t in self.news_trade_history) if self.news_trade_history else 0,
            'active_news_positions': len(self.news_positions),
            'prediction_accuracy': np.mean(self.predictive_engine.accuracy_history) if self.predictive_engine.accuracy_history else 0,
            'sentiment_momentum': self.sentiment_engine.get_sentiment_momentum(),
            'processed_news_count': len(self.news_buffer),
            'strategy_performance': self.strategy_performance
        }
        
        metrics.update(news_metrics)
        return metrics
    
    def adaptive_optimization(self) -> None:
        """Adaptive optimization for news trading"""
        if len(self.news_trade_history) < 10:
            return
        
        # Calculate performance
        recent_trades = list(self.news_trade_history)[-20:]
        win_rate = sum(1 for t in recent_trades if t['pnl'] > 0) / len(recent_trades)
        
        # Adjust parameters
        if win_rate < 0.4:
            self.config['risk_per_news_trade'] *= 0.8
            self.config['min_sentiment_confidence'] = min(0.5, self.config['min_sentiment_confidence'] * 1.1)
            self.config['news_stop_loss'] *= 0.9
            self.logger.info("Conservative news trading parameters applied")
        elif win_rate > 0.6:
            self.config['risk_per_news_trade'] = min(0.03, self.config['risk_per_news_trade'] * 1.1)
            self.config['min_sentiment_confidence'] = max(0.25, self.config['min_sentiment_confidence'] * 0.95)
            self.config['news_take_profit'] = min(0.01, self.config['news_take_profit'] * 1.05)
            self.logger.info("Aggressive news trading parameters applied")
        
        # Update prediction accuracy
        if self.predictive_engine.accuracy_history:
            avg_accuracy = np.mean(self.predictive_engine.accuracy_history)
            self.prediction_accuracy.append(avg_accuracy)