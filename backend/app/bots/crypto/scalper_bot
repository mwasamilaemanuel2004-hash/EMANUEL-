    def _calculate_scalp_position_size(self, price: float, signal: Dict[str, Any], 
                                      micro_analysis: Dict[str, Any], mode: ScalpMode) -> float:
        """Calculate adaptive scalp position size"""
        risk_per_scalp = self.config.get('risk_per_scalp', 0.002)
        
        # Mode multipliers
        mode_multipliers = {
            ScalpMode.ULTRA_FAST: 1.5,
            ScalpMode.FAST: 1.2,
            ScalpMode.STANDARD: 1.0,
            ScalpMode.SLOW: 0.7,
            ScalpMode.ADAPTIVE: 1.0
        }
        
        mode_multiplier = mode_multipliers.get(mode, 1.0)
        
        # Signal quality adjustment
        quality_multiplier = 0.5 + signal.get('quality', 0.5)
        
        # Consecutive win/loss adjustment
        if self.consecutive_wins >= 3:
            streak_multiplier = 1.2
        elif self.consecutive_losses >= 2:
            streak_multiplier = 0.5
        else:
            streak_multiplier = 1.0
        
        # Calculate position value
        position_value = self.current_capital * risk_per_scalp * mode_multiplier * quality_multiplier * streak_multiplier
        
        # Apply leverage for scalping (10x)
        position_value *= 10
        
        # Calculate quantity
        quantity = position_value / price if price > 0 else 0
        
        return quantity
    
    def _calculate_scalp_levels(self, action: str, current_price: float, 
                               micro_analysis: Dict[str, Any], mode: ScalpMode) -> Tuple[float, float]:
        """Calculate adaptive stop loss and take profit"""
        # Base percentages
        min_profit = self.config.get('min_scalp_profit', 0.001)
        max_loss = self.config.get('max_scalp_loss', 0.0005)
        
        # Mode adjustments
        mode_adjustments = {
            ScalpMode.ULTRA_FAST: {'tp': 0.5, 'sl': 0.5},
            ScalpMode.FAST: {'tp': 0.8, 'sl': 0.8},
            ScalpMode.STANDARD: {'tp': 1.0, 'sl': 1.0},
            ScalpMode.SLOW: {'tp': 1.5, 'sl': 1.2},
            ScalpMode.ADAPTIVE: {'tp': 1.0, 'sl': 1.0}
        }
        
        adjustment = mode_adjustments.get(mode, {'tp': 1.0, 'sl': 1.0})
        
        # Adjust for volatility
        volatility = micro_analysis.get('spread', 0.001)
        volatility_multiplier = 1.0 + volatility * 10
        
        # Calculate levels
        tp_percentage = min_profit * adjustment['tp'] * volatility_multiplier
        sl_percentage = max_loss * adjustment['sl'] * volatility_multiplier
        
        if action == 'long':
            stop_loss = current_price * (1 - sl_percentage)
            take_profit = current_price * (1 + tp_percentage)
        else:
            stop_loss = current_price * (1 + sl_percentage)
            take_profit = current_price * (1 - tp_percentage)
        
        return stop_loss, take_profit
    
