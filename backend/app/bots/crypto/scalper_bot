    def _analyze_microstructure(self, market_data: Dict[str, Any]) -> Dict[str, Any]:
        """Analyze market microstructure"""
        prices = market_data.get('prices', [])
        volumes = market_data.get('volumes', [])
        high = market_data.get('high', prices)
        low = market_data.get('low', prices)
        
        if not prices:
            return {}
        
        # Calculate microstructure metrics
        avg_volume = np.mean(volumes[-20:]) if len(volumes) >= 20 else np.mean(volumes) if volumes else 1
        current_volume = volumes[-1] if volumes else 0
        volume_ratio = current_volume / avg_volume if avg_volume > 0 else 1
        
        # Spread calculation
        spread = (high[-1] - low[-1]) / prices[-1] if prices[-1] > 0 else 0
        
        # Order book imbalance
        bids = market_data.get('bids', [])
        asks = market_data.get('asks', [])
        
        imbalance = 0
        if bids and asks:
            total_bid = sum(v for _, v in bids[:10])
            total_ask = sum(v for _, v in asks[:10])
            imbalance = (total_bid - total_ask) / (total_bid + total_ask) if (total_bid + total_ask) > 0 else 0
        
        # Determine microstructure state
        state = self._determine_microstructure_state(volume_ratio, spread, imbalance)
        
        return {
            'state': state,
            'volume_ratio': volume_ratio,
            'spread': spread,
            'imbalance': imbalance,
            'liquidity': avg_volume,
            'current_volume': current_volume
        }
    
    def _determine_microstructure_state(self, volume_ratio: float, spread: float, imbalance: float) -> MarketMicrostructure:
        """Determine market microstructure state"""
        if volume_ratio > 2.0:
            if imbalance > 0.2:
                return MarketMicrostructure.IMBALANCED_BUY
            elif imbalance < -0.2:
                return MarketMicrostructure.IMBALANCED_SELL
            else:
                return MarketMicrostructure.MOMENTUM
        elif volume_ratio > 1.2:
            return MarketMicrostructure.ABSORPTION
        elif spread < 0.0005:
            return MarketMicrostructure.HIGH_LIQUIDITY
        elif spread > 0.002:
            return MarketMicrostructure.LOW_LIQUIDITY
        elif abs(imbalance) < 0.05:
            return MarketMicrostructure.BALANCED
        else:
            return MarketMicrostructure.CHOPPY
    
    def _determine_optimal_mode(self, micro_analysis: Dict[str, Any]) -> ScalpMode:
        """Determine optimal scalping mode"""
        state = micro_analysis.get('state', MarketMicrostructure.BALANCED)
        volume_ratio = micro_analysis.get('volume_ratio', 1)
        spread = micro_analysis.get('spread', 0.001)
        
        if state == MarketMicrostructure.HIGH_LIQUIDITY and spread < 0.0003:
            return ScalpMode.ULTRA_FAST
        elif state == MarketMicrostructure.MOMENTUM or volume_ratio > 1.5:
            return ScalpMode.FAST
        elif state == MarketMicrostructure.ABSORPTION:
            return ScalpMode.STANDARD
        elif state in [MarketMicrostructure.LOW_LIQUIDITY, MarketMicrostructure.CHOPPY]:
            return ScalpMode.SLOW
        else:
            return ScalpMode.ADAPTIVE
    
