        Initialize Bot Coordinator
        
        Args:
            total_capital: Total capital ($5 minimum)
            mode: Coordination mode
            allocation_strategy: Portfolio allocation strategy
        """
        # Validate capital - MINIMUM $5
        if total_capital < 5:
            logger.warning(f"Capital ${total_capital} below minimum $5")
            total_capital = 5.0
            logger.info(f"Using minimum capital: $5")
        
        self.total_capital = total_capital
        self.available_capital = total_capital
        self.mode = mode
        self.allocation_strategy = allocation_strategy
        
        # Detect capital tier
        self.capital_tier = self._detect_capital_tier(total_capital)
        
        # Bot management
        self.bots: Dict[str, BaseBot] = {}
        self.allocations: Dict[str, BotAllocation] = {}
        self.bot_categories: Dict[BotCategory, List[str]] = {
            BotCategory.FOREX: [],
            BotCategory.CRYPTO: [],
            BotCategory.STOCKS: []
        }
        
        # Risk management
        self.risk_parameters = self._get_mode_parameters(mode, self.capital_tier)
        self.risk_history = deque(maxlen=5000)
        self.drawdown_history = deque(maxlen=1000)
        
        # Performance tracking
        self.performance_history: List[Dict] = []
        self.rebalance_history = deque(maxlen=1000)
        self.allocation_history = deque(maxlen=1000)
        
        # Correlation matrix
        self.correlation_matrix: Dict[str, Dict[str, float]] = {}
        
        # Threading
        self.coordinator_lock = threading.RLock()
        self.monitoring_thread = None
        self.rebalance_thread = None
        self.is_monitoring = False
        
        # Timing
        self.start_time = datetime.now()
        self.last_rebalance_time = datetime.now()
        self.rebalance_interval = timedelta(hours=24)
        self.monitoring_interval = 60  # seconds
        
        logger.info(f"✅ Bot Coordinator initialized with ${total_capital}")
        logger.info(f"   Capital Tier: {self.capital_tier.value}")
        logger.info(f"   Mode: {mode.value}")
        logger.info(f"   Allocation Strategy: {allocation_strategy.value}")
        logger.info(f"   MINIMUM CAPITAL: $5 SUPPORTED")
    
    def _detect_capital_tier(self, capital: float) -> CapitalTier:
        """Detect capital tier"""
        if capital < 50:
            return CapitalTier.MICRO
        elif capital < 500:
            return CapitalTier.MINI
        elif capital < 5000:
            return CapitalTier.SMALL
        elif capital < 50000:
            return CapitalTier.MEDIUM
        elif capital < 500000:
            return CapitalTier.LARGE
        else:
            return CapitalTier.INSTITUTIONAL
    
