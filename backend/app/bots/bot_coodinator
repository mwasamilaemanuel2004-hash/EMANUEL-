class CapitalTier(Enum):
    """Capital tiers - STARTING FROM $5"""
    MICRO = "micro"           # $5 - $50
    MINI = "mini"            # $50 - $500
    SMALL = "small"          # $500 - $5,000
    MEDIUM = "medium"        # $5,000 - $50,000
    LARGE = "large"          # $50,000 - $500,000
    INSTITUTIONAL = "institutional"  # $500,000+

class CoordinatorMode(Enum):
    """Coordinator operation modes"""
    CONSERVATIVE = "conservative"
    BALANCED = "balanced"
    AGGRESSIVE = "aggressive"
    ADAPTIVE = "adaptive"
    MAXIMIZE = "maximize"
    RECOVERY = "recovery"

class AllocationStrategy(Enum):
    """Portfolio allocation strategies"""
    EQUAL_WEIGHT = "equal_weight"
    RISK_PARITY = "risk_parity"
    PERFORMANCE_BASED = "performance_based"
    VOLATILITY_ADJUSTED = "volatility_adjusted"
    SHARPE_OPTIMIZED = "sharpe_optimized"
    ADAPTIVE = "adaptive"

class BotCategory(Enum):
    """Bot categories"""
    FOREX = "forex"
    CRYPTO = "crypto"
    STOCKS = "stocks"

