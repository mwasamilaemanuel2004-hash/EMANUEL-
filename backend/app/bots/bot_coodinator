    def register_bot(self, 
                     bot: BaseBot,
                     category: BotCategory,
                     allocation_percentage: Optional[float] = None) -> bool:
        """
        Register a bot with the coordinator
        Supports $5 minimum capital
        """
        try:
            with self.coordinator_lock:
                # Validate bot
                if bot.bot_id in self.bots:
                    logger.error(f"Bot {bot.bot_name} already registered")
                    return False
                
                # Calculate allocation
                if allocation_percentage is None:
                    allocation_percentage = self._calculate_default_allocation(category)
                
                # Apply maximum allocation limit
                max_allocation = self.risk_parameters['max_per_bot_allocation']
                allocation_percentage = min(allocation_percentage, max_allocation)
                
                # Calculate capital
                allocated_capital = self.total_capital * allocation_percentage
                
                # Check MINIMUM $5
                if allocated_capital < 5:
                    allocated_capital = 5.0
                    allocation_percentage = allocated_capital / self.total_capital
                
                # Check available capital
                if allocated_capital > self.available_capital + 0.01:
                    # Adjust to available
                    allocated_capital = self.available_capital
                    allocation_percentage = allocated_capital / self.total_capital
                
                # Create allocation
                allocation = BotAllocation(
                    bot_id=bot.bot_id,
                    bot_name=bot.bot_name,
                    category=category,
                    allocated_capital=allocated_capital,
                    risk_weight=allocation_percentage,
                    status="active",
                    min_capital_required=5.0
                )
                
                # Register bot
                self.bots[bot.bot_id] = bot
                self.allocations[bot.bot_id] = allocation
                self.bot_categories[category].append(bot.bot_id)
                
                # Update available capital
                self.available_capital -= allocated_capital
                
                logger.info(f"✅ Registered bot: {bot.bot_name}")
                logger.info(f"   Category: {category.value}")
                logger.info(f"   Allocation: {allocation_percentage:.1%} (${allocated_capital:,.2f})")
                
                return True
                
        except Exception as e:
            logger.error(f"Error registering bot: {e}")
            return False
    
    def _calculate_default_allocation(self, category: BotCategory) -> float:
        """Calculate default allocation for category"""
        # Get current category exposure
        category_exposure = sum(
            self.allocations[bot_id].risk_weight
            for bot_id in self.bot_categories[category]
        )
        
        # Calculate remaining allocation
        max_category = self.risk_parameters['max_category_exposure']
        remaining = max_category - category_exposure
        
        # Distribute equally among bots in category
        bot_count = max(1, len(self.bot_categories[category]) + 1)
        
        return max(0.05, min(remaining, remaining / bot_count))
    
    def register_multiple_bots(self, bot_configs: List[Dict[str, Any]]) -> Dict[str, bool]:
        """
        Register multiple bots at once
        Supports $5 minimum capital distribution
        """
        results = {}
        
        for config in bot_configs:
            bot = config.get('bot')
            category = config.get('category', BotCategory.CRYPTO)
            allocation = config.get('allocation', None)
            
            if bot:
                results[bot.bot_id] = self.register_bot(bot, category, allocation)
            else:
                results['unknown'] = False
        
        return results
    
