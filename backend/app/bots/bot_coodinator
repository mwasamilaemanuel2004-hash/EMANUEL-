    def optimize_for_small_capital(self) -> None:
        """Optimize portfolio for small capital"""
        if self.capital_tier in [CapitalTier.MICRO, CapitalTier.MINI]:
            logger.info("Optimizing for small capital...")
            
            # Reduce number of bots
            if len(self.bots) > 2:
                logger.info("Reducing bot count for small capital")
                
                # Keep only best performing bots
                self.update_performance_metrics()
                
                sorted_bots = sorted(
                    self.allocations.items(),
                    key=lambda x: x[1].performance_score,
                    reverse=True
                )
                
                # Remove underperforming bots
                for bot_id, allocation in sorted_bots[2:]:
                    self.unregister_bot(bot_id)
            
            # Increase position size multiplier
            self.risk_parameters['position_size_multiplier'] *= 1.5
            
            # Reduce rebalance interval
            self.rebalance_interval = timedelta(hours=6)
            
            logger.info("Small capital optimization completed")
    
    def get_portfolio_summary(self) -> Dict[str, Any]:
        """Get comprehensive portfolio summary"""
        summary = {
            'total_capital': self.total_capital,
            'available_capital': self.available_capital,
            'allocated_capital': sum(a.allocated_capital for a in self.allocations.values()),
            'total_pnl': sum(a.total_pnl for a in self.allocations.values()),
            'total_pnl_percentage': sum(a.total_pnl for a in self.allocations.values()) / self.total_capital * 100 if self.total_capital > 0 else 0,
            'active_bots': sum(1 for a in self.allocations.values() if a.status == "running"),
            'total_bots': len(self.bots),
            'mode': self.mode.value,
            'allocation_strategy': self.allocation_strategy.value,
            'capital_tier': self.capital_tier.value,
            'minimum_capital_supported': 5,
            'uptime': str(datetime.now() - self.start_time),
            'bots': {}
        }
        
        for bot_id, allocation in self.allocations.items():
            summary['bots'][bot_id] = {
                'name': allocation.bot_name,
                'category': allocation.category.value,
                'status': allocation.status,
                'allocated_capital': allocation.allocated_capital,
                'risk_weight': allocation.risk_weight,
                'performance_score': allocation.performance_score,
                'sharpe_ratio': allocation.sharpe_ratio,
                'win_rate': allocation.win_rate,
                'total_pnl': allocation.total_pnl,
                'max_drawdown': allocation.max_drawdown,
                'min_capital': allocation.min_capital_required
            }
        
        return summary

