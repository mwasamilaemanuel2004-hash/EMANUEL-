import uuid
import hashlib
import secrets
import json
from datetime import datetime, timedelta
from typing import Optional, Dict, Any, List, Tuple
from enum import Enum
import logging
import threading

logger = logging.getLogger(__name__)


class SessionStatus(Enum):
    """Session status"""
    ACTIVE = "active"
    EXPIRED = "expired"
    TERMINATED = "terminated"
    REVOKED = "revoked"
    SUSPENDED = "suspended"


class SessionType(Enum):
    """Session types"""
    WEB = "web"
    MOBILE = "mobile"
    API = "api"
    WEBSOCKET = "websocket"
    BOT = "bot"
    ADMIN = "admin"


class DeviceType(Enum):
    """Device types"""
    DESKTOP = "desktop"
    MOBILE = "mobile"
    TABLET = "tablet"
    BOT = "bot"
    SERVER = "server"
    UNKNOWN = "unknown"


class Session:
    """DEBUGGED ULTRA ADVANCED Session Model"""
    
    def __init__(self,
                 user_id: str,
                 session_type: SessionType = SessionType.WEB,
                 ip_address: str = None,
                 user_agent: str = None):
        
        # FIX: Validate user_id
        if not user_id:
            raise ValueError("user_id is required")
        
        # Basic
        self.id = str(uuid.uuid4())
        self.user_id = user_id
        self.session_type = session_type
        self.status = SessionStatus.ACTIVE
        
        # FIX: Generate token safely
        self.token = secrets.token_urlsafe(64)
        self.token_hash = hashlib.sha256(self.token.encode()).hexdigest()
        
        # Device info
        self.ip_address = ip_address
        self.user_agent = user_agent
        self.device_type = self._detect_device_type(user_agent)
        self.device_name: Optional[str] = None
        self.device_id: Optional[str] = None
        
        # Location
        self.country: Optional[str] = None
        self.city: Optional[str] = None
        self.timezone: Optional[str] = None
        
        # Timestamps
        self.created_at = datetime.utcnow()
        self.expires_at = datetime.utcnow() + timedelta(hours=12)
        self.last_activity = datetime.utcnow()
        self.terminated_at: Optional[datetime] = None
        
        # Activity
        self.request_count: int = 0
        self.total_duration: float = 0.0
        
        # Security
        self.is_trusted: bool = False
        self.two_factor_verified: bool = False
        
        # Thread safety
        self._lock = threading.RLock()
    
    def _detect_device_type(self, user_agent: str) -> DeviceType:
        """FIX: Better device detection"""
        try:
            if not user_agent:
                return DeviceType.UNKNOWN
            
            user_agent = user_agent.lower()
            
            # FIX: Check tablet before mobile
            if 'ipad' in user_agent or 'tablet' in user_agent:
                return DeviceType.TABLET
            elif 'mobile' in user_agent or 'android' in user_agent or 'iphone' in user_agent:
                return DeviceType.MOBILE
            elif 'bot' in user_agent or 'crawler' in user_agent or 'spider' in user_agent:
                return DeviceType.BOT
            elif 'server' in user_agent or 'curl' in user_agent or 'wget' in user_agent:
                return DeviceType.SERVER
            elif 'windows' in user_agent or 'macintosh' in user_agent or 'linux' in user_agent:
                return DeviceType.DESKTOP
            else:
                return DeviceType.UNKNOWN
                
        except Exception as e:
            logger.error(f"Error detecting device: {e}")
            return DeviceType.UNKNOWN
    
    def is_active(self) -> bool:
        """FIX: Check active with thread safety"""
        try:
            with self._lock:
                if self.status != SessionStatus.ACTIVE:
                    return False
                
                if datetime.utcnow() >= self.expires_at:
                    self.status = SessionStatus.EXPIRED
                    return False
                
                return True
                
        except Exception as e:
            logger.error(f"Error checking active: {e}")
            return False
    
    def is_expired(self) -> bool:
        """FIX: Check expired safely"""
        try:
            return datetime.utcnow() > self.expires_at
        except Exception:
            return True
    
    def update_activity(self) -> None:
        """FIX: Update activity with thread safety"""
        try:
            with self._lock:
                self.last_activity = datetime.utcnow()
                self.request_count += 1
                
                # FIX: Auto-extend if close to expiry
                time_to_expiry = (self.expires_at - datetime.utcnow()).total_seconds()
                if time_to_expiry < 1800:  # Less than 30 minutes
                    self.expires_at = datetime.utcnow() + timedelta(hours=1)
                    
        except Exception as e:
            logger.error(f"Error updating activity: {e}")
    
    def terminate(self, reason: str = "manual") -> bool:
        """FIX: Terminate safely"""
        try:
            with self._lock:
                if self.status not in [SessionStatus.ACTIVE]:
                    return False
                
                self.status = SessionStatus.TERMINATED
                self.terminated_at = datetime.utcnow()
                self.total_duration = (self.terminated_at - self.created_at).total_seconds()
                
                return True
                
        except Exception as e:
            logger.error(f"Error terminating: {e}")
            return False
    
    def extend(self, hours: int = 12) -> bool:
        """FIX: Extend with validation"""
        try:
            if hours <= 0:
                logger.warning("Extension hours must be positive")
                return False
            
            with self._lock:
                if self.status != SessionStatus.ACTIVE:
                    return False
                
                self.expires_at = datetime.utcnow() + timedelta(hours=hours)
                return True
                
        except Exception as e:
            logger.error(f"Error extending: {e}")
            return False
    
    def get_remaining_time(self) -> float:
        """FIX: Get remaining time in seconds"""
        try:
            remaining = (self.expires_at - datetime.utcnow()).total_seconds()
            return max(0, remaining)
        except Exception:
            return 0
    
    def to_dict(self) -> Dict[str, Any]:
        """FIX: Safe dict conversion"""
        try:
            return {
                'id': self.id,
                'user_id': self.user_id,
                'session_type': self.session_type.value,
                'status': self.status.value,
                'ip_address': self.ip_address,
                'device_type': self.device_type.value,
                'device_name': self.device_name,
                'country': self.country,
                'city': self.city,
                'created_at': self.created_at.isoformat(),
                'expires_at': self.expires_at.isoformat(),
                'last_activity': self.last_activity.isoformat(),
                'request_count': self.request_count,
                'is_trusted': self.is_trusted,
                'remaining_seconds': self.get_remaining_time()
            }
        except Exception as e:
            logger.error(f"Error converting to dict: {e}")
            return {'id': self.id}
    
    def __repr__(self) -> str:
        return f"<Session {self.session_type.value} user={self.user_id} status={self.status.value}>"


class SessionManager:
    """DEBUGGED ULTRA ADVANCED Session Manager"""
    
    def __init__(self):
        self.sessions: Dict[str, Session] = {}
        self._lock = threading.RLock()
        self.max_sessions_per_user = 10
        self.session_expiry_hours = 12
    
    def create_session(self,
                      user_id: str,
                      session_type: SessionType = SessionType.WEB,
                      ip_address: str = None,
                      user_agent: str = None) -> Optional[Session]:
        """FIX: Create session with validation"""
        try:
            if not user_id:
                logger.error("user_id required")
                return None
            
            with self._lock:
                # FIX: Check existing active sessions
                user_sessions = [
                    s for s in self.sessions.values()
                    if s.user_id == user_id and s.is_active()
                ]
                
                if len(user_sessions) >= self.max_sessions_per_user:
                    # FIX: Terminate oldest safely
                    oldest = min(user_sessions, key=lambda s: s.created_at)
                    oldest.terminate("session_limit_reached")
                    logger.info(f"Oldest session terminated for {user_id}")
                
                # Create new session
                session = Session(
                    user_id=user_id,
                    session_type=session_type,
                    ip_address=ip_address,
                    user_agent=user_agent
                )
                
                self.sessions[session.id] = session
                
                logger.info(f"✅ Session created: {session.id[:8]} for {user_id}")
                
                return session
                
        except Exception as e:
            logger.error(f"Error creating session: {e}")
            return None
    
    def verify_session(self, token: str) -> Optional[Session]:
        """FIX: Verify session safely"""
        try:
            if not token:
                return None
            
            token_hash = hashlib.sha256(token.encode()).hexdigest()
            
            with self._lock:
                for session in self.sessions.values():
                    if session.token_hash == token_hash:
                        if session.is_active():
                            session.update_activity()
                            return session
                        else:
                            return None
                return None
                
        except Exception as e:
            logger.error(f"Error verifying session: {e}")
            return None
    
    def get_session(self, session_id: str) -> Optional[Session]:
        """FIX: Get session with validation"""
        try:
            if not session_id:
                return None
            
            with self._lock:
                return self.sessions.get(session_id)
                
        except Exception as e:
            logger.error(f"Error getting session: {e}")
            return None
    
    def terminate_session(self, session_id: str, reason: str = "manual") -> bool:
        """FIX: Terminate with validation"""
        try:
            if not session_id:
                return False
            
            with self._lock:
                if session_id in self.sessions:
                    return self.sessions[session_id].terminate(reason)
                return False
                
        except Exception as e:
            logger.error(f"Error terminating session: {e}")
            return False
    
    def terminate_user_sessions(self, user_id: str, reason: str = "user_logout") -> int:
        """FIX: Terminate user sessions safely"""
        try:
            if not user_id:
                return 0
            
            count = 0
            with self._lock:
                for session in self.sessions.values():
                    if session.user_id == user_id and session.is_active():
                        if session.terminate(reason):
                            count += 1
            return count
                
        except Exception as e:
            logger.error(f"Error terminating user sessions: {e}")
            return 0
    
    def get_user_sessions(self, user_id: str, active_only: bool = True) -> List[Session]:
        """FIX: Get user sessions safely"""
        try:
            if not user_id:
                return []
            
            with self._lock:
                sessions = [s for s in self.sessions.values() if s.user_id == user_id]
                if active_only:
                    sessions = [s for s in sessions if s.is_active()]
                return sessions
                
        except Exception as e:
            logger.error(f"Error getting user sessions: {e}")
            return []
    
    def get_active_sessions(self) -> List[Session]:
        """FIX: Get active sessions"""
        with self._lock:
            return [s for s in self.sessions.values() if s.is_active()]
    
    def cleanup(self) -> int:
        """FIX: Cleanup with thread safety"""
        try:
            count = 0
            with self._lock:
                expired = [
                    session_id for session_id, session in self.sessions.items()
                    if not session.is_active()
                ]
                
                for session_id in expired:
                    del self.sessions[session_id]
                    count += 1
                
                logger.debug(f"Cleanup: {count} sessions removed")
                return count
                
        except Exception as e:
            logger.error(f"Error cleaning up: {e}")
            return 0
    
    def get_stats(self) -> Dict[str, Any]:
        """FIX: Get stats safely"""
        try:
            with self._lock:
                active = self.get_active_sessions()
                user_sessions = {}
                device_sessions = {}
                type_sessions = {}
                
                for session in active:
                    # User count
                    user_sessions[session.user_id] = user_sessions.get(session.user_id, 0) + 1
                    
                    # Device count
                    device_sessions[session.device_type.value] = device_sessions.get(session.device_type.value, 0) + 1
                    
                    # Type count
                    type_sessions[session.session_type.value] = type_sessions.get(session.session_type.value, 0) + 1
                
                return {
                    'total_sessions': len(self.sessions),
                    'active_sessions': len(active),
                    'expired_sessions': sum(1 for s in self.sessions.values() if s.is_expired()),
                    'terminated_sessions': sum(1 for s in self.sessions.values() if s.status == SessionStatus.TERMINATED),
                    'users_online': len(user_sessions),
                    'device_types': device_sessions,
                    'session_types': type_sessions,
                    'avg_session_duration': self._calculate_avg_duration()
                }
                
        except Exception as e:
            logger.error(f"Error getting stats: {e}")
            return {}
    
    def _calculate_avg_duration(self) -> float:
        """FIX: Calculate average duration safely"""
        try:
            durations = [
                (datetime.utcnow() - s.created_at).total_seconds()
                for s in self.sessions.values()
                if s.is_active()
            ]
            
            return round(sum(durations) / len(durations), 2) if durations else 0.0
            
        except Exception as e:
            logger.error(f"Error calculating duration: {e}")
            return 0.0
    
    def extend_session(self, session_id: str, hours: int = 12) -> bool:
        """FIX: Extend with validation"""
        try:
            if not session_id or hours <= 0:
                return False
            
            session = self.get_session(session_id)
            if session:
                return session.extend(hours)
            return False
            
        except Exception as e:
            logger.error(f"Error extending session: {e}")
            return False
    
    def mark_trusted(self, session_id: str) -> bool:
        """FIX: Mark trusted safely"""
        try:
            session = self.get_session(session_id)
            if session and session.is_active():
                session.is_trusted = True
                return True
            return False
            
        except Exception as e:
            logger.error(f"Error marking trusted: {e}")
            return False
    
    def get_sessions_by_ip(self, ip_address: str) -> List[Session]:
        """FIX: Get sessions by IP"""
        try:
            if not ip_address:
                return []
            
            with self._lock:
                return [s for s in self.sessions.values() if s.ip_address == ip_address]
                
        except Exception as e:
            logger.error(f"Error getting by IP: {e}")
            return []
    
    def get_sessions_by_device(self, device_type: DeviceType) -> List[Session]:
        """FIX: Get sessions by device"""
        try:
            with self._lock:
                return [s for s in self.sessions.values() if s.device_type == device_type]
                
        except Exception as e:
            logger.error(f"Error getting by device: {e}")
            return []


