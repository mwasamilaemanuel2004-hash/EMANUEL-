class VerificationManager:
    """ULTRA ADVANCED Verification Manager"""
    
    def __init__(self):
        self.verifications: Dict[str, Verification] = {}
        self._lock = threading.RLock()
    
    def create_verification(self,
                           user_id: str,
                           verification_type: VerificationType,
                           method: VerificationMethod = VerificationMethod.EMAIL,
                           expires_in: int = 300) -> Optional[Verification]:
        """Create verification"""
        try:
            with self._lock:
                # Invalidate old verifications of same type
                self._invalidate_old(user_id, verification_type)
                
                verification = Verification(
                    user_id=user_id,
                    verification_type=verification_type,
                    method=method,
                    expires_in=expires_in
                )
                
                self.verifications[verification.id] = verification
                
                return verification
                
        except Exception as e:
            logger.error(f"Error creating verification: {e}")
            return None
    
    def _invalidate_old(self, user_id: str, verification_type: VerificationType) -> None:
        """Invalidate old verifications"""
        for v in self.verifications.values():
            if v.user_id == user_id and v.verification_type == verification_type:
                if v.status == VerificationStatus.PENDING:
                    v.status = VerificationStatus.CANCELLED
    
    def verify(self, verification_id: str, code: str) -> bool:
        """Verify code"""
        try:
            with self._lock:
                if verification_id in self.verifications:
                    return self.verifications[verification_id].verify(code)
                return False
        except Exception as e:
            logger.error(f"Error verifying: {e}")
            return False
    
    def get_verification(self, verification_id: str) -> Optional[Verification]:
        """Get verification"""
        with self._lock:
            return self.verifications.get(verification_id)
    
    def get_user_verifications(self, user_id: str) -> List[Verification]:
        """Get user verifications"""
        with self._lock:
            return [v for v in self.verifications.values() if v.user_id == user_id]
    
    def cleanup(self) -> int:
        """Cleanup expired verifications"""
        try:
            count = 0
            with self._lock:
                expired = [
                    vid for vid, v in self.verifications.items()
                    if v.status in [VerificationStatus.EXPIRED, VerificationStatus.VERIFIED,
                                   VerificationStatus.CANCELLED, VerificationStatus.MAX_ATTEMPTS]
                ]
                for vid in expired:
                    del self.verifications[vid]
                    count += 1
            return count
        except Exception as e:
            logger.error(f"Error cleaning up: {e}")
            return 0
    
    def get_stats(self) -> Dict[str, Any]:
        """Get statistics"""
        with self._lock:
            return {
                'total': len(self.verifications),
                'pending': sum(1 for v in self.verifications.values() if v.status == VerificationStatus.PENDING),
                'verified': sum(1 for v in self.verifications.values() if v.status == VerificationStatus.VERIFIED),
                'failed': sum(1 for v in self.verifications.values() if v.status == VerificationStatus.FAILED),
                'expired': sum(1 for v in self.verifications.values() if v.status == VerificationStatus.EXPIRED)
            }


