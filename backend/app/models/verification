import uuid
import hashlib
import hmac
import base64
import secrets
import time
import struct
from datetime import datetime, timedelta
from typing import Optional, Dict, Any, List, Tuple
from enum import Enum
import logging
import threading

logger = logging.getLogger(__name__)


class VerificationType(Enum):
    """Verification types"""
    EMAIL = "email"
    PHONE = "phone"
    TOTP = "totp"
    BIOMETRIC = "biometric"
    KYC = "kyc"
    PASSWORD_RESET = "password_reset"
    WITHDRAWAL = "withdrawal"
    TRADE = "trade"
    LOGIN = "login"
    API_KEY = "api_key"


class VerificationStatus(Enum):
    """Verification status"""
    PENDING = "pending"
    VERIFIED = "verified"
    FAILED = "failed"
    EXPIRED = "expired"
    CANCELLED = "cancelled"
    MAX_ATTEMPTS = "max_attempts"


class VerificationMethod(Enum):
    """Verification methods"""
    EMAIL = "email"
    SMS = "sms"
    WHATSAPP = "whatsapp"
    TELEGRAM = "telegram"
    TOTP = "totp"
    BIOMETRIC = "biometric"
    MANUAL = "manual"


class Verification:
    """ULTRA ADVANCED Verification Model"""
    
    def __init__(self,
                 user_id: str,
                 verification_type: VerificationType,
                 method: VerificationMethod = VerificationMethod.EMAIL,
                 expires_in: int = 300):
        
        # FIX: Validate inputs
        if not user_id:
            raise ValueError("user_id is required")
        
        # Basic
        self.id = str(uuid.uuid4())
        self.user_id = user_id
        self.verification_type = verification_type
        self.method = method
        self.status = VerificationStatus.PENDING
        
        # Code
        self.code = self._generate_code()
        self.code_hash = hashlib.sha256(self.code.encode()).hexdigest()
        
        # Timestamps
        self.created_at = datetime.utcnow()
        self.expires_at = datetime.utcnow() + timedelta(seconds=expires_in)
        self.verified_at: Optional[datetime] = None
        
        # Attempts
        self.attempts: int = 0
        self.max_attempts: int = 3
        
        # Metadata
        self.metadata: Dict[str, Any] = {}
        
        # Thread safety
        self._lock = threading.RLock()
    
    def _generate_code(self) -> str:
        """Generate verification code"""
        if self.verification_type == VerificationType.TOTP:
            return base64.b32encode(secrets.token_bytes(20)).decode().rstrip('=')
        elif self.verification_type == VerificationType.PHONE:
            return ''.join([str(secrets.randbelow(10)) for _ in range(6)])
        elif self.verification_type == VerificationType.EMAIL:
            return ''.join([str(secrets.randbelow(10)) for _ in range(6)])
        else:
            return ''.join([str(secrets.randbelow(10)) for _ in range(6)])
    
    def verify(self, code: str) -> bool:
        """Verify code"""
        try:
            with self._lock:
                if self.status != VerificationStatus.PENDING:
                    return False
                
                if self.is_expired():
                    self.status = VerificationStatus.EXPIRED
                    return False
                
                if self.attempts >= self.max_attempts:
                    self.status = VerificationStatus.MAX_ATTEMPTS
                    return False
                
                self.attempts += 1
                
                code_hash = hashlib.sha256(code.encode()).hexdigest()
                
                if secrets.compare_digest(code_hash, self.code_hash):
                    self.status = VerificationStatus.VERIFIED
                    self.verified_at = datetime.utcnow()
                    return True
                
                if self.attempts >= self.max_attempts:
                    self.status = VerificationStatus.MAX_ATTEMPTS
                
                return False
                
        except Exception as e:
            logger.error(f"Error verifying code: {e}")
            return False
    
    def is_expired(self) -> bool:
        """Check if expired"""
        return datetime.utcnow() > self.expires_at
    
    def is_verified(self) -> bool:
        """Check if verified"""
        return self.status == VerificationStatus.VERIFIED
    
    def cancel(self) -> bool:
        """Cancel verification"""
        try:
            with self._lock:
                if self.status == VerificationStatus.PENDING:
                    self.status = VerificationStatus.CANCELLED
                    return True
                return False
        except Exception as e:
            logger.error(f"Error cancelling: {e}")
            return False
    
    def extend(self, seconds: int = 300) -> bool:
        """Extend expiry"""
        try:
            with self._lock:
                if self.status == VerificationStatus.PENDING:
                    self.expires_at = datetime.utcnow() + timedelta(seconds=seconds)
                    return True
                return False
        except Exception as e:
            logger.error(f"Error extending: {e}")
            return False
    
    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary"""
        return {
            'id': self.id,
            'user_id': self.user_id,
            'verification_type': self.verification_type.value,
            'method': self.method.value,
            'status': self.status.value,
            'created_at': self.created_at.isoformat(),
            'expires_at': self.expires_at.isoformat(),
            'verified_at': self.verified_at.isoformat() if self.verified_at else None,
            'attempts': self.attempts,
            'max_attempts': self.max_attempts
        }
    
    def __repr__(self) -> str:
        return f"<Verification {self.verification_type.value} status={self.status.value}>"


class TOTPVerification(Verification):
    """TOTP Verification"""
    
    def __init__(self, user_id: str, secret: str = None):
        super().__init__(user_id, VerificationType.TOTP, VerificationMethod.TOTP, expires_in=0)
        self.secret = secret or self.code
        self.interval = 30
        self.digits = 6
    
    def generate_code(self) -> str:
        """Generate current TOTP code"""
        try:
            padding = '=' * ((8 - len(self.secret) % 8) % 8)
            key = base64.b32decode(self.secret + padding)
            counter = int(time.time() // self.interval)
            msg = struct.pack('>Q', counter)
            digest = hmac.new(key, msg, hashlib.sha1).digest()
            offset = digest[-1] & 0x0F
            code = struct.unpack('>I', digest[offset:offset+4])[0] & 0x7FFFFFFF
            return str(code % (10 ** self.digits)).zfill(self.digits)
        except:
            return ''.join([str(secrets.randbelow(10)) for _ in range(self.digits)])
    
    def verify_totp(self, user_code: str) -> bool:
        """Verify TOTP with time drift"""
        try:
            padding = '=' * ((8 - len(self.secret) % 8) % 8)
            key = base64.b32decode(self.secret + padding)
            current = int(time.time() // self.interval)
            
            for offset in [-1, 0, 1]:
                counter = current + offset
                msg = struct.pack('>Q', counter)
                digest = hmac.new(key, msg, hashlib.sha1).digest()
                off = digest[-1] & 0x0F
                val = struct.unpack('>I', digest[off:off+4])[0] & 0x7FFFFFFF
                expected = str(val % (10 ** self.digits)).zfill(self.digits)
                if hmac.compare_digest(expected, user_code):
                    self.status = VerificationStatus.VERIFIED
                    self.verified_at = datetime.utcnow()
                    return True
            return False
        except:
            return False


