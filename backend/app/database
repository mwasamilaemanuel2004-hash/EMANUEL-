        db = SessionLocal()
        db.execute("SELECT 1")
        db.close()
        logger.info("✅ Database connection successful!")
        return True
    except Exception as e:
        logger.error(f"❌ Database connection failed: {e}")
        return False

# ============================================
# AUTO INIT
# ============================================
if settings.ENVIRONMENT == "development":
    test_connection()
    init_db()