class DataProviderBase:
    """Base class for all data providers"""
    
    def __init__(self):
        self.cache = {}
        self.cache_ttl = 30  # seconds
        self._lock = threading.Lock()
        self.rate_limiter = RateLimiter()
        self.failure_count = 0
        self.max_failures = 5
        self.is_healthy = True
        self.last_success = datetime.now()
    
    def _cache_get(self, key: str) -> Optional[Any]:
        """Get from cache"""
        with self._lock:
            if key in self.cache:
                data, timestamp = self.cache[key]
                if time.time() - timestamp < self.cache_ttl:
                    return data
                else:
                    del self.cache[key]
        return None
    
    def _cache_set(self, key: str, data: Any, ttl: int = None) -> None:
        """Set cache"""
        with self._lock:
            self.cache[key] = (data, time.time())
            # Clean old cache
            current_time = time.time()
            expired = [k for k, (_, t) in self.cache.items() if current_time - t > (ttl or self.cache_ttl * 2)]
            for k in expired:
                del self.cache[k]
    
    def _handle_success(self):
        """Handle successful request"""
        self.failure_count = 0
        self.is_healthy = True
        self.last_success = datetime.now()
    
    def _handle_failure(self, error: Exception):
        """Handle failed request"""
        self.failure_count += 1
        if self.failure_count >= self.max_failures:
            self.is_healthy = False
        logger.error(f"Provider error: {error}")
    
    def is_available(self) -> bool:
        """Check if provider is available"""
        return self.is_healthy


class RateLimiter:
    """Advanced rate limiter"""
    
    def __init__(self):
        self.requests = {}
        self._lock = threading.Lock()
    
    def check(self, key: str, max_requests: int, window_seconds: int) -> bool:
        """Check if request is allowed"""
        with self._lock:
            current_time = time.time()
            
            if key not in self.requests:
                self.requests[key] = deque()
            
            queue = self.requests[key]
            
            while queue and current_time - queue[0] > window_seconds:
                queue.popleft()
            
            if len(queue) >= max_requests:
                return False
            
            queue.append(current_time)
            return True
    
    def wait_if_needed(self, key: str, max_requests: int, window_seconds: int) -> None:
        """Wait if rate limit reached"""
        while not self.check(key, max_requests, window_seconds):
            time.sleep(0.1)


