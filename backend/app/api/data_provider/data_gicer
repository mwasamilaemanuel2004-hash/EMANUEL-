        self._lock = threading.Lock()
        
        logger.info("📊 Data Provider Manager initialized")
        logger.info(f"   Active providers: {[p for p in self.provider_order if self.providers[p].is_available()]}")
    
    def get_quote(self, symbol: str) -> Dict[str, Any]:
        """Get quote with fallback"""
        for provider_name in self.provider_order:
            provider = self.providers[provider_name]
            
            if not provider.is_available():
                continue
            
            quote = provider.get_quote(symbol)
            
            if quote:
                quote['provider'] = provider_name
                return quote
        
        logger.error(f"All providers failed for {symbol}")
        return {}
    
    def get_historical_data(self, symbol: str, period: str = "1mo", interval: str = "1d") -> Dict[str, Any]:
        """Get historical data with fallback"""
        for provider_name in self.provider_order:
            provider = self.providers[provider_name]
            
            if not provider.is_available():
                continue
            
            data = provider.get_historical_data(symbol, period, interval)
            
            if data:
                data['provider'] = provider_name
                return data
        
        return {}
    
    def get_market_overview(self) -> Dict[str, Any]:
        """Get market overview"""
        yahoo = self.providers['yahoo']
        return yahoo.get_market_overview()
    
    def search(self, query: str) -> List[Dict]:
        """Search symbols"""
        yahoo = self.providers['yahoo']
        return yahoo.search(query)
    
    def get_news(self, symbol: str = None, limit: int = 10) -> List[Dict]:
        """Get news with fallback"""
        for provider_name in ['polygon', 'finnhub']:
            provider = self.providers[provider_name]
            
            if provider.is_available() and hasattr(provider, 'get_news'):
                news = provider.get_news(symbol, limit)
                if news:
                    return news
        
        return []
    
    def get_sentiment(self, symbol: str) -> Dict[str, Any]:
        """Get sentiment"""
        finnhub = self.providers['finnhub']
        if finnhub.is_available():
            return finnhub.get_sentiment(symbol)
        return {}
    
    def get_provider_status(self) -> Dict[str, bool]:
        """Get all provider status"""
        return {
            name: provider.is_available()
            for name, provider in self.providers.items()
        }


