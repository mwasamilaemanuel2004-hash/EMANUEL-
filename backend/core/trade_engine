class SimpleExchangeClient:
    """
    Simple exchange client with pure Python
    No external dependencies except requests
    """
    
    def __init__(self, name: str, api_key: str = "", secret_key: str = ""):
        self.name = name
        self.api_key = api_key
        self.secret_key = secret_key
        self.base_url = ""
        self.session = None
    
    def set_base_url(self, url: str):
        self.base_url = url
    
    def _get_headers(self, method: str, endpoint: str, params: Dict = None) -> Dict:
        """Get request headers - override per exchange"""
        return {
            'User-Agent': 'ESH.TRADE/3.0',
            'Accept': 'application/json',
            'Content-Type': 'application/json'
        }
    
    def _sign_request(self, method: str, endpoint: str, params: Dict = None) -> Dict:
        """Sign request - override per exchange"""
        return params or {}
    
    def _make_request(self, method: str, endpoint: str, params: Dict = None, data: Dict = None) -> Dict:
        """Make HTTP request - pure Python"""
        try:
            import urllib.request
            import urllib.parse
            
            url = f"{self.base_url}{endpoint}"
            headers = self._get_headers(method, endpoint, params)
            
            if params:
                url += "?" + urllib.parse.urlencode(params)
            
            req = urllib.request.Request(url, method=method, headers=headers)
            
            if data:
                req.data = json.dumps(data).encode('utf-8')
                req.add_header('Content-Type', 'application/json')
            
            with urllib.request.urlopen(req, timeout=30) as response:
                return json.loads(response.read().decode('utf-8'))
                
        except Exception as e:
            logger.error(f"Request error: {e}")
            return {'error': str(e)}

# ============================================
# TRADING ENGINE CLASS
