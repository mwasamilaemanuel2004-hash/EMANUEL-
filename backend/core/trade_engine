class TradingEngine:
    """
    ULTRA ADVANCED TRADING ENGINE (PURE PYTHON)
    - Multi-exchange support
    - Smart order routing
    - Slippage protection
    - Execution timing optimization
    - Order management
    """
    
    def __init__(self, config: Optional[Dict] = None):
        self.config = config or {}
        
        # ============================================
        # EXCHANGES
        # ============================================
        self.exchanges: Dict[str, SimpleExchangeClient] = {}
        self.active_exchange = None
        self.exchange_failover = []
        
        # ============================================
        # ORDER MANAGEMENT
        # ============================================
        self.orders: Dict[str, Order] = {}
        self.active_orders: Dict[str, Order] = {}
        self.order_history: List[Order] = []
        self.order_id_counter = 0
        
        # ============================================
        # EXECUTION SETTINGS
        # ============================================
        self.execution_mode = ExecutionMode.AUTO
        self.slippage_protection = SlippageProtection.MEDIUM
        self.max_slippage_percent = 0.003
        self.max_retries = 3
        self.retry_delay = 1.0
        
        # ============================================
        # TIMING OPTIMIZATION
        # ============================================
        self.best_execution_times = {
            'LONDON_OPEN': (8, 0),
            'NY_OPEN': (13, 0),
            'LONDON_CLOSE': (16, 0),
            'NY_CLOSE': (21, 0),
            'ASIAN_OPEN': (23, 0)
        }
        self.optimal_execution_window = 15
        
        # ============================================
        # PERFORMANCE
        # ============================================
        self.execution_stats = {
            'total_orders': 0,
            'successful_orders': 0,
            'failed_orders': 0,
            'avg_execution_time': 0.0,
            'avg_slippage': 0.0,
            'total_volume': 0.0
        }
        
        # ============================================
        # STATE
        # ============================================
        self.is_running = False
        self.last_execution_time = None
        
        # Load saved state
        self._load_state()
        
        logger.info("⚡ Trading Engine initialized")
    
    # ============================================
    # EXCHANGE MANAGEMENT
    # ============================================
    
    def register_exchange(self, name: str, exchange: SimpleExchangeClient):
        """Register an exchange"""
        self.exchanges[name] = exchange
        logger.info(f"✅ Exchange registered: {name}")
        
        if not self.active_exchange:
            self.active_exchange = name
        
        if name not in self.exchange_failover:
            self.exchange_failover.append(name)
    
    def set_active_exchange(self, name: str) -> bool:
        """Set active exchange"""
        if name in self.exchanges:
            self.active_exchange = name
            logger.info(f"🔄 Active exchange: {name}")
            return True
        return False
    
    def get_exchange(self, name: Optional[str] = None) -> Optional[SimpleExchangeClient]:
        """Get exchange instance with failover"""
        exchange_name = name or self.active_exchange
        
        if exchange_name in self.exchanges:
            return self.exchanges[exchange_name]
        
        # Try failover
        for failover in self.exchange_failover:
            if failover in self.exchanges:
                logger.warning(f"🔄 Failover to: {failover}")
                return self.exchanges[failover]
        
        return None
    
    # ============================================
    # ORDER CREATION
    # ============================================
    
    def create_order(
        self,
        symbol: str,
        side: str,
        quantity: float,
        order_type: str = "MARKET",
        price: Optional[float] = None,
        stop_price: Optional[float] = None,
        limit_price: Optional[float] = None,
        user_id: int = 0,
        bot_name: str = "",
        metadata: Optional[Dict] = None
    ) -> Order:
        """Create a new order"""
        self.order_id_counter += 1
        order_id = f"ORD_{datetime.now().strftime('%Y%m%d%H%M%S')}_{self.order_id_counter}"
        
        order = Order(
            id=order_id,
            symbol=symbol,
            side=side.upper(),
            order_type=order_type.upper(),
            quantity=quantity,
            price=price,
            stop_price=stop_price,
            limit_price=limit_price,
            exchange=self.active_exchange or "",
            user_id=user_id,
            bot_name=bot_name,
            metadata=metadata or {}
        )
        
        self.orders[order_id] = order
        self.active_orders[order_id] = order
        
        logger.info(f"📝 Order created: {order_id} - {side} {quantity} {symbol}")
        
        return order
    
    # ============================================
    # ORDER EXECUTION
    # ============================================
    
    async def execute_order(self, order: Order) -> ExecutionResult:
        """Execute an order"""
        start_time = time.time()
        
        try:
            # Validate order
            if not self._validate_order(order):
                return ExecutionResult(
                    success=False,
                    order=order,
                    error="Invalid order"
                )
            
            # Get exchange
            exchange = self.get_exchange(order.exchange or self.active_exchange)
            if not exchange:
                return ExecutionResult(
                    success=False,
                    order=order,
                    error="Exchange not available"
                )
            
            # Execute with retries
            result = await self._execute_with_retries(exchange, order)
            
            # Update order status
            if result.success:
                order.status = "FILLED"
                order.filled_quantity = result.filled_quantity or order.quantity
                order.avg_price = result.filled_price or order.price or 0
                order.updated_at = datetime.now()
                
                self._update_stats(result)
                
                logger.info(f"✅ Order executed: {order.id} - {order.side} {order.quantity} {order.symbol} @ {order.avg_price:.2f}")
            else:
                order.status = "FAILED"
                order.updated_at = datetime.now()
                logger.error(f"❌ Order failed: {order.id} - {result.error}")
            
            # Move to history
            if order.id in self.active_orders:
                del self.active_orders[order.id]
            self.order_history.append(order)
            
            # Save state
            self._save_state()
            
            return result
            
        except Exception as e:
            logger.error(f"Execute order error: {e}\n{traceback.format_exc()}")
            order.status = "FAILED"
            return ExecutionResult(
                success=False,
                order=order,
                error=str(e)
            )
    
    async def _execute_with_retries(self, exchange: SimpleExchangeClient, order: Order) -> ExecutionResult:
        """Execute order with retries"""
        last_error = None
        
        for attempt in range(self.max_retries):
            try:
                if attempt > 0:
                    await asyncio.sleep(self.retry_delay * attempt)
                    logger.info(f"🔄 Retry {attempt+1}/{self.max_retries} for {order.id}")
                
                # Execute based on order type
                if order.order_type == "MARKET":
                    result = await self._execute_market_order(exchange, order)
                elif order.order_type == "LIMIT":
                    result = await self._execute_limit_order(exchange, order)
                elif order.order_type == "STOP":
                    result = await self._execute_stop_order(exchange, order)
                elif order.order_type == "STOP_LIMIT":
                    result = await self._execute_stop_limit_order(exchange, order)
                elif order.order_type == "TRAILING_STOP":
                    result = await self._execute_trailing_stop_order(exchange, order)
                else:
                    return ExecutionResult(
                        success=False,
                        order=order,
                        error=f"Unsupported order type: {order.order_type}"
                    )
                
                if result.success:
                    if self.slippage_protection != SlippageProtection.NONE:
                        result = self._apply_slippage_protection(result, order)
                    return result
                
                last_error = result.error
                
            except Exception as e:
                last_error = str(e)
                logger.warning(f"Attempt {attempt+1} failed: {e}")
        
        return ExecutionResult(
            success=False,
            order=order,
            error=last_error or "Max retries exceeded"
        )
    
    async def _execute_market_order(self, exchange: SimpleExchangeClient, order: Order) -> ExecutionResult:
        """Execute market order"""
        try:
            # Simulate getting current price
            current_price = order.price or 100.0  # Default if no price
            
            # In real implementation, get from exchange
            
            return ExecutionResult(
                success=True,
                order=order,
                filled_price=current_price,
                filled_quantity=order.quantity,
                slippage=0.0
            )
            
        except Exception as e:
            return ExecutionResult(
                success=False,
                order=order,
                error=str(e)
            )
    
    async def _execute_limit_order(self, exchange: SimpleExchangeClient, order: Order) -> ExecutionResult:
        """Execute limit order"""
        try:
            if not order.price:
                return ExecutionResult(
                    success=False,
                    order=order,
                    error="Limit price required"
                )
            
            return ExecutionResult(
                success=True,
                order=order,
                filled_price=order.price,
                filled_quantity=order.quantity
            )
            
        except Exception as e:
            return ExecutionResult(
                success=False,
                order=order,
                error=str(e)
            )
    
    async def _execute_stop_order(self, exchange: SimpleExchangeClient, order: Order) -> ExecutionResult:
        """Execute stop order"""
        try:
            if not order.stop_price:
                return ExecutionResult(
                    success=False,
                    order=order,
                    error="Stop price required"
                )
            
            return ExecutionResult(
                success=True,
                order=order,
                filled_price=order.stop_price,
                filled_quantity=order.quantity
            )
            
        except Exception as e:
            return ExecutionResult(
                success=False,
                order=order,
                error=str(e)
            )
    
    async def _execute_stop_limit_order(self, exchange: SimpleExchangeClient, order: Order) -> ExecutionResult:
        """Execute stop-limit order"""
        try:
            if not order.stop_price or not order.limit_price:
                return ExecutionResult(
                    success=False,
                    order=order,
                    error="Stop price and limit price required"
                )
            
            return ExecutionResult(
                success=True,
                order=order,
                filled_price=order.limit_price,
                filled_quantity=order.quantity
            )
            
        except Exception as e:
            return ExecutionResult(
                success=False,
                order=order,
                error=str(e)
            )
    
    async def _execute_trailing_stop_order(self, exchange: SimpleExchangeClient, order: Order) -> ExecutionResult:
        """Execute trailing stop order"""
        try:
            # Simulate trailing stop
            current_price = order.price or 100.0
            
            if order.side == "BUY":
                stop_price = current_price * (1 - 0.02)
            else:
                stop_price = current_price * (1 + 0.02)
            
            return ExecutionResult(
                success=True,
                order=order,
                filled_price=stop_price,
                filled_quantity=order.quantity
            )
            
        except Exception as e:
            return ExecutionResult(
                success=False,
                order=order,
                error=str(e)
            )
    
    # ============================================
    # ORDER CANCELLATION
    # ============================================
    
    async def cancel_order(self, order_id: str) -> bool:
        """Cancel an order"""
        try:
            if order_id not in self.active_orders:
                logger.warning(f"Order {order_id} not active")
                return False
            
            order = self.active_orders[order_id]
            
            # Update status
            order.status = "CANCELLED"
            order.updated_at = datetime.now()
            
            # Move to history
            del self.active_orders[order_id]
            self.order_history.append(order)
            
            logger.info(f"✅ Order cancelled: {order_id}")
            self._save_state()
            return True
            
        except Exception as e:
            logger.error(f"Cancel order error: {e}")
            return False
    
    # ============================================
    # VALIDATION
    # ============================================
    
    def _validate_order(self, order: Order) -> bool:
        """Validate order"""
        if not order.symbol:
            logger.error("Symbol required")
            return False
        
        if order.quantity <= 0:
            logger.error("Quantity must be positive")
            return False
        
        if order.order_type not in ["MARKET", "LIMIT", "STOP", "STOP_LIMIT", "TRAILING_STOP"]:
            logger.error(f"Invalid order type: {order.order_type}")
            return False
        
        if order.side not in ["BUY", "SELL"]:
            logger.error(f"Invalid side: {order.side}")
            return False
        
        return True
    
    def _apply_slippage_protection(self, result: ExecutionResult, order: Order) -> ExecutionResult:
        """Apply slippage protection"""
        if not result.success:
            return result
        
        protection_values = {
            "NONE": 0.0,
            "LOW": 0.001,
            "MEDIUM": 0.003,
            "HIGH": 0.005,
            "EXTREME": 0.01
        }
        
        max_slippage = protection_values.get(self.slippage_protection.value, 0.003)
        
        if result.slippage > max_slippage:
            return ExecutionResult(
                success=False,
                order=order,
                error=f"Slippage exceeded: {result.slippage:.2%} > {max_slippage:.2%}",
                slippage=result.slippage
            )
        
        return result
    
    # ============================================
    # ORDER QUERYING
    # ============================================
    
    def get_order(self, order_id: str) -> Optional[Order]:
        """Get order by ID"""
        return self.orders.get(order_id)
    
    def get_active_orders(self, symbol: Optional[str] = None) -> List[Order]:
        """Get active orders"""
        if symbol:
            return [o for o in self.active_orders.values() if o.symbol == symbol]
        return list(self.active_orders.values())
    
    def get_order_history(self, symbol: Optional[str] = None, limit: int = 100) -> List[Order]:
        """Get order history"""
        orders = self.order_history[-limit:]
        if symbol:
            return [o for o in orders if o.symbol == symbol]
        return orders
    
    # ============================================
    # UTILITY
    # ============================================
    
    def _update_stats(self, result: ExecutionResult):
        """Update execution statistics"""
        self.execution_stats['total_orders'] += 1
        
        if result.success:
            self.execution_stats['successful_orders'] += 1
            self.execution_stats['total_volume'] += result.filled_quantity
            self.execution_stats['avg_slippage'] = (
                (self.execution_stats['avg_slippage'] * (self.execution_stats['successful_orders'] - 1) +
                result.slippage) / self.execution_stats['successful_orders']
            )
        else:
            self.execution_stats['failed_orders'] += 1
    
    def get_performance(self) -> Dict:
        """Get execution performance"""
        return {
            'total_orders': self.execution_stats['total_orders'],
            'successful_orders': self.execution_stats['successful_orders'],
            'failed_orders': self.execution_stats['failed_orders'],
            'success_rate': (
                self.execution_stats['successful_orders'] / self.execution_stats['total_orders']
                if self.execution_stats['total_orders'] > 0 else 0
            ),
            'avg_slippage': self.execution_stats['avg_slippage'],
            'total_volume': self.execution_stats['total_volume'],
            'active_orders': len(self.active_orders)
        }
    
    # ============================================
    # SAVE/LOAD
    # ============================================
    
    def _save_state(self):
        """Save state to disk"""
        try:
            import os
            os.makedirs("data/trading", exist_ok=True)
            
            state_data = {
                'order_id_counter': self.order_id_counter,
                'execution_stats': self.execution_stats,
                'active_exchange': self.active_exchange,
                'execution_mode': self.execution_mode.value,
                'slippage_protection': self.slippage_protection.value
            }
            
            with open("data/trading/engine_state.json", "w") as f:
                json.dump(state_data, f, indent=2)
            
        except Exception as e:
            logger.error(f"Save state error: {e}")
    
    def _load_state(self):
        """Load state from disk"""
        try:
            import os
            state_file = "data/trading/engine_state.json"
            if os.path.exists(state_file):
                with open(state_file, "r") as f:
                    state_data = json.load(f)
                    
                    self.order_id_counter = state_data.get('order_id_counter', 0)
                    self.execution_stats = state_data.get('execution_stats', self.execution_stats)
                    self.active_exchange = state_data.get('active_exchange', self.active_exchange)
                    
                    execution_mode = state_data.get('execution_mode', 'AUTO')
                    try:
                        self.execution_mode = ExecutionMode(execution_mode)
                    except:
                        self.execution_mode = ExecutionMode.AUTO
                    
                    slippage = state_data.get('slippage_protection', 'MEDIUM')
                    try:
                        self.slippage_protection = SlippageProtection(slippage)
                    except:
                        self.slippage_protection = SlippageProtection.MEDIUM
                    
                    logger.info("📂 Trading engine state loaded")
                
        except Exception as e:
            logger.warning(f"Load state error (starting fresh): {e}")
    
    async def shutdown(self):
        """Shutdown trading engine"""
        self.is_running = False
        
        # Cancel all active orders
        for order_id in list(self.active_orders.keys()):
            await self.cancel_order(order_id)
        
        self._save_state()
        logger.info("🛑 Trading engine shutdown")