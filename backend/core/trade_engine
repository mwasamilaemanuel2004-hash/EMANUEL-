    AUTO = "AUTO"
    MANUAL = "MANUAL"
    SEMI_AUTO = "SEMI_AUTO"

class SlippageProtection(Enum):
    NONE = "NONE"
    LOW = "LOW"
    MEDIUM = "MEDIUM"
    HIGH = "HIGH"
    EXTREME = "EXTREME"

