    def _add_alert(self, type: str, title: str, message: str, source: str = "system") -> None:
        """Add an alert"""
        self.alert_counter += 1
        alert = SystemAlert(
            id=f"alert_{self.alert_counter}",
            type=type,
            title=title,
            message=message,
            source=source
        )
        self.alerts.append(alert)
        self.unread_alerts.append(alert)
        
        # Keep only last 1000 alerts
        if len(self.alerts) > 1000:
            self.alerts = self.alerts[-1000:]
        if len(self.unread_alerts) > 500:
            self.unread_alerts = self.unread_alerts[-500:]
        
        self.system_state.alerts_count = len(self.alerts)
    
