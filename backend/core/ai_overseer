    def _get_profit_factor(self) -> float:
        """Get profit factor"""
        total_profit = sum(t.profit for t in self.trade_history if t.profit > 0)
        total_loss = abs(sum(t.profit for t in self.trade_history if t.profit < 0))
        return total_profit / total_loss if total_loss > 0 else 1.0
    
    def _get_sharpe_ratio(self) -> float:
        """Get Sharpe ratio"""
        profits = [t.profit for t in self.trade_history if t.profit != 0]
        if not profits:
            return 0.0
        return np.mean(profits) / (np.std(profits) + 0.0001)
    
    def _get_expectancy(self) -> float:
        """Get expectancy"""
        if not self.trade_history:
            return 0.0
        total_profit = sum(t.profit for t in self.trade_history)
        return total_profit / len(self.trade_history)
    
