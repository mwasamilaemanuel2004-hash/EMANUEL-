    async def _scan_all_bots(self):
        """Scan all bots for health"""
        for bot_name, bot in self.bots.items():
            try:
                health = await self._scan_bot(bot_name, bot)
                self.bot_health[bot_name] = health
            except Exception as e:
                logger.error(f"Scan error for {bot_name}: {e}")
    
    async def _scan_bot(self, bot_name: str, bot: Any) -> BotHealth:
        """Scan a single bot"""
        try:
            perf = bot.state.performance if hasattr(bot, 'state') else None
            
            if not perf:
                return BotHealth(
                    bot_name=bot_name,
                    status=BotStatus.WARNING,
                    win_rate=0.5,
                    profit_factor=1.0,
                    drawdown=0.0,
                    total_trades=0,
                    recent_performance=0.5,
                    confidence_score=50,
                    issues=["No performance data"],
                    recommendations=["Start bot"]
                )
            
            win_rate = getattr(perf, 'win_rate', 0.5)
            profit_factor = getattr(perf, 'profit_factor', 1.0)
            drawdown = getattr(perf, 'current_drawdown', 0.0)
            total_trades = getattr(perf, 'total_trades', 0)
            
            recent_trades = getattr(perf, 'recent_trades', []) or []
            recent_performance = 0.5
            if recent_trades:
                wins = sum(1 for t in recent_trades[-20:] if t.get('profit', 0) > 0)
                recent_performance = wins / len(recent_trades[-20:]) if recent_trades else 0.5
            
            confidence_score = self._calculate_confidence(
                win_rate, profit_factor, drawdown, total_trades
            )
            status, issues = self._determine_status(
                win_rate, profit_factor, drawdown, total_trades
            )
            recommendations = self._generate_recommendations(
                bot_name, win_rate, profit_factor, drawdown, total_trades, status
            )
            
            # Update system state
            active_bots = sum(1 for h in self.bot_health.values() if h.is_active)
            self.system_state.bots_active = active_bots
            
            # Add performance history
            self.performance_history.append({
                'bot': bot_name,
                'timestamp': datetime.now().isoformat(),
                'win_rate': win_rate,
                'profit_factor': profit_factor,
                'drawdown': drawdown,
                'total_trades': total_trades,
                'status': status.value
            })
            if len(self.performance_history) > 1000:
                self.performance_history = self.performance_history[-1000:]
            
            return BotHealth(
                bot_name=bot_name,
                status=status,
                win_rate=win_rate,
                profit_factor=profit_factor,
                drawdown=drawdown,
                total_trades=total_trades,
                recent_performance=recent_performance,
                confidence_score=confidence_score,
                issues=issues,
                recommendations=recommendations
            )
            
        except Exception as e:
            logger.error(f"Scan error {bot_name}: {e}")
            return BotHealth(
                bot_name=bot_name,
                status=BotStatus.FAILED,
                win_rate=0.5,
                profit_factor=1.0,
                drawdown=0.0,
                total_trades=0,
                recent_performance=0.5,
                confidence_score=0,
                issues=[str(e)],
                recommendations=["Restart bot"]
            )
    
    async def _check_system_health(self):
        """Check overall system health"""
        try:
            # Check if any bots are critical
            critical_bots = [h for h in self.bot_health.values() if h.status == BotStatus.CRITICAL]
            if critical_bots:
                for bot in critical_bots:
                    self._add_alert(
                        type="error",
                        title="Critical Bot Health",
                        message=f"Bot '{bot.bot_name}' is in critical state. Needs immediate attention.",
                        source="system"
                    )
            
            # Check drawdown
            if self.system_state.drawdown > self.thresholds['drawdown_critical']:
                self._add_alert(
                    type="warning",
                    title="High Drawdown",
                    message=f"System drawdown is {self.system_state.drawdown:.1%}",
                    source="system"
                )
            
        except Exception as e:
            logger.error(f"Health check error: {e}")
    
    async def _update_market_data(self):
        """Update market data"""
        try:
            # Would fetch real market data
            # For demo, generate mock data
            self.market_data = {
                'timestamp': datetime.now().isoformat(),
                'volatility': 1.5 + (time.time() % 2) * 0.5,
                'sentiment': 0.5 + (time.time() % 3) * 0.1,
                'regime': ['BULLISH', 'BEARISH', 'RANGING'][int(time.time()) % 3]
            }
            
            self.market_regime = self.market_data['regime']
            self.market_sentiment = self.market_data['sentiment']
            self.volatility_level = "HIGH" if self.market_data['volatility'] > 2.5 else "MODERATE" if self.market_data['volatility'] > 1.5 else "LOW"
            
        except Exception as e:
            logger.error(f"Market data update error: {e}")
    
    def _clean_old_alerts(self):
        """Clean old alerts"""
        try:
            cutoff = datetime.now() - timedelta(days=7)
            self.alerts = [a for a in self.alerts if a.timestamp > cutoff]
            self.unread_alerts = [a for a in self.unread_alerts if a.timestamp > cutoff]
            self.system_state.alerts_count = len(self.alerts)
        except Exception as e:
            logger.error(f"Alert cleaner error: {e}")
    
