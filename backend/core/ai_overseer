@dataclass
class ChatMessage:
    """Chat message data"""
    id: str
    sender: str
    receiver: str
    type: str
    content: str
    timestamp: datetime = field(default_factory=datetime.now)
    action: Optional[str] = None
    action_data: Optional[Dict] = None
    is_read: bool = False
    requires_response: bool = False
    category: str = "general"
    priority: int = 0

@dataclass
class BotHealth:
    """Bot health data"""
    bot_name: str
    status: BotStatus
    win_rate: float
    profit_factor: float
    drawdown: float
    total_trades: int
    recent_performance: float
    confidence_score: float
    issues: List[str]
    recommendations: List[str]
    last_healing: Optional[datetime] = None
    healing_count: int = 0
    is_active: bool = True
    uptime: float = 0.0
    error_count: int = 0
    last_error: Optional[str] = None
    performance_history: List[Dict] = field(default_factory=list)
    strategy_used: str = "default"
    market_regime: str = "neutral"

@dataclass
class Token:
    """Token for user access"""
    token: str
    user_id: str
    created_at: datetime
    expires_at: datetime
    is_active: bool = True
    permissions: List[str] = field(default_factory=list)
    usage_count: int = 0
    last_used: Optional[datetime] = None
    created_by: str = "admin"

@dataclass
class SystemAlert:
    """System alert"""
    id: str
    type: str  # info, warning, error, critical
    title: str
    message: str
    timestamp: datetime = field(default_factory=datetime.now)
    is_read: bool = False
    is_resolved: bool = False
    source: str = "system"
    data: Dict = field(default_factory=dict)

