    async def heal_bot(self, bot_name: str) -> Dict[str, Any]:
        """Heal a bot"""
        bot = self.bots.get(bot_name)
        
        if bot is None:
            return {
                "ok": False,
                "bot": bot_name,
                "error": "Bot not found"
            }
        
        try:
            health = self.bot_health.get(bot_name)
            if not health:
                return {
                    "ok": False,
                    "bot": bot_name,
                    "error": "Health data not found"
                }
            
            # Check healing cooldown
            if health.last_healing:
                cooldown = (datetime.now() - health.last_healing).total_seconds()
                if cooldown < self.thresholds['healing_cooldown']:
                    return {
                        "ok": False,
                        "bot": bot_name,
                        "error": f"Healing cooldown: {int(self.thresholds['healing_cooldown'] - cooldown)}s remaining"
                    }
            
            # Check daily limit
            if health.healing_count >= self.thresholds['max_healings_per_day']:
                return {
                    "ok": False,
                    "bot": bot_name,
                    "error": "Daily healing limit reached"
                }
            
            # Apply healing based on status
            if health.status == BotStatus.CRITICAL:
                # Critical healing
                if hasattr(bot, 'pause'):
                    await bot.pause("Critical healing")
                if hasattr(bot, 'reset_to_defaults'):
                    bot.reset_to_defaults()
                if hasattr(bot, 'restart'):
                    await bot.restart()
                health.status = BotStatus.WARNING
                health.issues = ["Critical healing applied"]
                
            elif health.status == BotStatus.WARNING:
                # Warning healing
                if hasattr(bot, 'update_parameters'):
                    params = {'min_confidence': 70, 'max_risk_per_trade': 0.015}
                    bot.update_parameters(params)
                if hasattr(bot, 'clear_errors'):
                    bot.clear_errors()
                health.status = BotStatus.GOOD
                health.issues = ["Warning healing applied"]
            
            elif health.status == BotStatus.FAILED:
                # Failed healing
                if hasattr(bot, 'stop'):
                    await bot.stop()
                await asyncio.sleep(2)
                if hasattr(bot, '_load_state'):
                    bot._load_state()
                if hasattr(bot, 'start'):
                    await bot.start()
                health.status = BotStatus.RECOVERING
                health.issues = ["Failed healing applied - Restarted"]
            
            else:
                # No healing needed
                return {
                    "ok": True,
                    "bot": bot_name,
                    "result": "No healing needed"
                }
            
            # Update health
            health.last_healing = datetime.now()
            health.healing_count += 1
            health.recommendations = ["Monitor closely", "Reduce risk temporarily"]
            
            # Log healing
            self.healing_history.append({
                'bot': bot_name,
                'timestamp': datetime.now().isoformat(),
                'status': health.status.value,
                'healing_count': health.healing_count
            })
            
            logger.info(f"✅ Healed bot: {bot_name}")
            
            return {
                "ok": True,
                "bot": bot_name,
                "result": "Bot healed successfully",
                "status": health.status.value,
                "healing_count": health.healing_count
            }
            
        except Exception as e:
            logger.exception(f"Failed to heal bot: {bot_name}")
            return {
                "ok": False,
                "bot": bot_name,
                "error": str(e)
            }
    
