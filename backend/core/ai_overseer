    async def _cmd_trade_close(self, user_id: str, message: str, is_admin: bool) -> Dict:
        """Close a position"""
        try:
            parts = message.split()
            if len(parts) < 2:
                return {
                    'response': '❌ Please specify symbol. Example: close BTC/USDT',
                    'type': 'ERROR',
                    'category': 'trading'
                }
            
            symbol = parts[1]
            to_close = [t for t in self.active_trades.values() if t.symbol == symbol]
            
            if not to_close:
                return {'response': f'❌ No position found for {symbol}', 'type': 'ERROR', 'category': 'trading'}
            
            closed = []
            for trade in to_close:
                trade.status = "CANCELLED"
                trade.executed_price = self._get_price(symbol)
                trade.executed_at = datetime.now()
                trade.profit = (trade.executed_price - trade.entry_price) * trade.amount if trade.action == "BUY" else (trade.entry_price - trade.executed_price) * trade.amount
                trade.profit_percent = (trade.profit / trade.amount) * 100
                closed.append(trade)
                del self.active_trades[trade.id]
            
            total_profit = sum(t.profit for t in closed)
            
            self._add_alert(
                type="info",
                title="Position Closed",
                message=f"Closed {len(closed)} position(s) for {symbol}. Profit: ${total_profit:.2f}",
                source="trading"
            )
            
            return {
                'response': f"""✅ **Position Closed**

📊 **Closed {len(closed)} position(s) for {symbol}**
💵 **Total Profit: ${total_profit:.2f}**

📈 **Details:**
• Average Entry: ${sum(t.entry_price for t in closed) / len(closed):.2f}
• Average Exit: ${sum(t.executed_price for t in closed) / len(closed):.2f}
• Total Volume: ${sum(t.amount for t in closed):.2f}

✅ {len(closed)} position(s) closed successfully
""",
                'type': 'SUCCESS',
                'category': 'trading'
            }
            
        except Exception as e:
            return {'response': f'❌ Error: {e}', 'type': 'ERROR', 'category': 'trading'}
    
