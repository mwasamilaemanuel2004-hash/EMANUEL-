                    is_admin=is_admin,
                ),
                timeout=self.chat_timeout,
            )
            
            # Store chat message
            self.chat_counter += 1
            chat_msg = ChatMessage(
                id=f"msg_{self.chat_counter}",
                sender="user" if not is_admin else "admin",
                receiver="ai",
                type=result.get('type', 'INFO'),
                content=result.get('response', ''),
                action=result.get('action'),
                action_data=result.get('action_data'),
                requires_response=result.get('requires_response', False),
                category=result.get('category', 'general')
            )
            self.chat_messages.append(chat_msg)
            if len(self.chat_messages) > self.chat_history_limit:
                self.chat_messages = self.chat_messages[-self.chat_history_limit:]
            
            return {
                "ok": True,
                "user_id": user_id,
                "response": result.get('response', ''),
                "type": result.get('type', 'INFO'),
                "action": result.get('action'),
                "action_data": result.get('action_data'),
                "requires_response": result.get('requires_response', False),
                "category": result.get('category', 'general')
            }
            
        except asyncio.TimeoutError:
            logger.warning(f"Chat timeout for user={user_id}")
            return {
                "ok": False,
                "error": "Request timed out"
            }
        
        except Exception as e:
            logger.exception(f"Chat failed for user={user_id}")
            return {
                "ok": False,
                "error": str(e)
            }
    
    async def _handle_message(
        self,
        *,
        user_id: str,
        message: str,
        is_admin: bool,
    ) -> Dict[str, Any]:
        """Handle chat message"""
        command = message.strip().lower()
        
        # Check for exact command match
        if command in self.commands:
            return await self.commands[command](user_id, is_admin)
        
        # Check for partial matches
        for cmd, handler in self.commands.items():
            if command.startswith(cmd):
                return await handler(user_id, is_admin)
        
        # Check for trade entry
        if any(word in command for word in ['entry', 'enter', 'buy', 'sell']):
            return await self._cmd_trade_entry(user_id, message, is_admin)
        
        # Check for bot action
        if "start" in command and "bot" in command:
            return await self._cmd_bot_start(user_id, message, is_admin)
        if "stop" in command and "bot" in command:
            return await self._cmd_bot_stop(user_id, message, is_admin)
        if "pause" in command and "bot" in command:
            return await self._cmd_bot_pause(user_id, message, is_admin)
        if "resume" in command and "bot" in command:
            return await self._cmd_bot_resume(user_id, message, is_admin)
        if "heal" in command and "bot" in command:
            return await self._cmd_bot_heal(user_id, message, is_admin)
        
        # Check for risk
        if "risk" in command:
            return await self._cmd_risk_status(user_id, is_admin)
        
        # Check for status
        if "status" in command:
            return await self._cmd_status(user_id, is_admin)
        
        # Default response
