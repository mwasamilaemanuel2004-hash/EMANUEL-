"""
LAYER +6: AGGRESSIVE OPPORTUNITY ENGINE (OPTIMIZED & DEBUGGED)
Purpose: Find every possible trading opportunity with high probability of success.
Balance: Not too strict (misses opportunities) and not too loose (bad trades).
Adaptive: Changes scanning based on market conditions and performance.

UPGRADES:
- Multi-timeframe momentum scanning with alignment scoring
- Volatility explosion detection with early warning
- Breakout confirmation with multiple confirmations
- News-based spike detection with sentiment analysis
- Correlation divergence detection in real-time
- Rolling stop loss with trend strength adaptation
- Partial take profit with dynamic ladder
- Re-entry algorithm with quality filtering
- Scalping mode with micro-structure analysis
- Momentum burst detection
- Mean reversion opportunity finder
- Seasonal pattern recognition
- Machine learning-based opportunity scoring
- Performance tracking and auto-optimization
"""

import numpy as np
import pandas as pd
from datetime import datetime, timedelta
from typing import Dict, List, Optional, Tuple, Any, Union
from enum import Enum
from dataclasses import dataclass, field
import logging
import json
import time
from collections import deque
import threading
from scipy import stats
from sklearn.ensemble import IsolationForest

# Configure logging
logger = logging.getLogger(__name__)

debug_handler = logging.FileHandler('logs/opportunity_engine_debug.log')
debug_handler.setLevel(logging.DEBUG)
debug_formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')
debug_handler.setFormatter(debug_formatter)
logger.addHandler(debug_handler)


class OpportunityType(Enum):
    """Types of trading opportunities"""
    MOMENTUM = "momentum"
    BREAKOUT = "breakout"
    REVERSAL = "reversal"
    SCALP = "scalp"
    NEWS = "news"
    ARBITRAGE = "arbitrage"
    MEAN_REVERSION = "mean_reversion"
    SEASONAL = "seasonal"
    LIQUIDITY_SWEEP = "liquidity_sweep"


@dataclass
class OpportunityConfig:
    """Configuration for Opportunity Engine - optimized"""
    # Multi-timeframe settings
    timeframes: List[str] = field(default_factory=lambda: ['1m', '5m', '15m', '1h', '4h'])
    min_timeframe_alignment: int = 3
    
    # Momentum settings
    momentum_threshold: float = 0.6
    momentum_period: int = 14
    
    # Breakout settings
    breakout_volume_multiplier: float = 1.5
    breakout_confirmation_bars: int = 3
    
    # Volatility settings
    volatility_explosion_threshold: float = 2.0
    volatility_contract_threshold: float = 0.5
    
    # Scalping settings
    scalping_opportunity_threshold: float = 0.3
    max_scalp_opportunities: int = 50
    
    # Mean reversion settings
    mean_reversion_zscore_threshold: float = 2.0
    
    # Seasonal settings
    seasonal_lookback: int = 30
    
    # Confidence scoring
    min_confidence_score: float = 0.6
    
    # Performance tracking
    debug_mode: bool = True
    max_history_size: int = 10000
    
    # ML settings
    ml_opportunity_scoring: bool = True
    ml_retrain_interval_hours: int = 24


class AggressiveOpportunityEngine:
    """
    Layer +6: Aggressive Opportunity Engine (OPTIMIZED)
    Finds high-probability trading opportunities.
    """
    
    def __init__(self, config: Optional[OpportunityConfig] = None):
        self.config = config or OpportunityConfig()
        self.debug_mode = self.config.debug_mode
        
        # Performance tracking
        self.performance = {
            'total_opportunities_found': 0,
            'high_quality_opportunities': 0,
            'opportunities_taken': 0,
            'opportunities_passed': 0,
            'average_quality_score': 0.0,
            'opportunity_type_distribution': {},
            'success_rate_by_type': {},
            'ml_retraining_events': 0,
            'total_scan_time': 0.0
        }
        
        # Opportunity storage
        self.opportunity_history = deque(maxlen=self.config.max_history_size)
        self.opportunity_cache = {}
        self.seasonal_patterns = {}
        
        # Market data
        self.market_data = {}
        self.timeframe_data = {}
        self.current_regime = "unknown"
        self.current_volatility = 0.0
        
        # ML Models
        self.opportunity_scorer = None
        self.anomaly_detector = None
        
        # Lock for thread safety
        self._lock = threading.Lock()
        
        # Initialize ML models
        self._initialize_ml_models()
        
        self._log_debug("Aggressive Opportunity Engine initialized")
        logger.info("Aggressive Opportunity Engine initialized")
    
    def _log_debug(self, message: str, level: str = "debug") -> None:
        """Debug logging with timestamp"""
        if self.debug_mode:
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
            log_msg = f"[DEBUG {timestamp}] {message}"
            if level == "info":
                logger.info(log_msg)
            elif level == "warning":
                logger.warning(log_msg)
            elif level == "error":
                logger.error(log_msg)
            else:
                logger.debug(log_msg)
    
    def _initialize_ml_models(self) -> None:
        """Initialize machine learning models"""
        try:
            if self.config.ml_opportunity_scoring:
                # Anomaly detection for outlier opportunities
                self.anomaly_detector = IsolationForest(
                    contamination=0.1,
                    random_state=42,
                    n_estimators=100
                )
                self._log_debug("ML models initialized")
        except Exception as e:
            self._log_debug(f"Error initializing ML models: {str(e)}", "error")
    
    def update_market_data(self, market_data: Dict[str, Any]) -> None:
        """Update market data for opportunity scanning"""
        try:
            if not isinstance(market_data, dict):
                return
            
            # Store latest data
            self.market_data = market_data.copy()
            
            # Extract key metrics
            self.current_regime = market_data.get('regime', 'unknown') or 'unknown'
            self.current_volatility = market_data.get('volatility', 0.0) or 0.0
            
            # Update timeframe data
            for tf in self.config.timeframes:
                tf_data = market_data.get(f'timeframe_{tf}', {})
                if tf_data:
                    self.timeframe_data[tf] = tf_data
            
            # Update seasonal patterns
            self._update_seasonal_patterns(market_data)
            
            self._log_debug(f"Market data updated: regime={self.current_regime}, volatility={self.current_volatility:.2f}")
            
        except Exception as e:
            self._log_debug(f"Error in update_market_data: {str(e)}", "error")
    
    def scan_opportunities(self, pairs: List[str]) -> List[Dict[str, Any]]:
        """
        Scan for trading opportunities across all pairs
        Returns: List of opportunity dictionaries
        """
        try:
            start_time = time.time()
            opportunities = []
            
            for pair in pairs:
                pair_opportunities = self._scan_pair(pair)
                if pair_opportunities:
                    opportunities.extend(pair_opportunities)
            
            # Score and rank opportunities
            if opportunities:
                opportunities = self._score_and_rank_opportunities(opportunities)
                
                # Update performance tracking
                self.performance['total_opportunities_found'] += len(opportunities)
                high_quality = [o for o in opportunities if o.get('quality_score', 0) > 0.8]
                self.performance['high_quality_opportunities'] += len(high_quality)
                
                # Track opportunity types
                for opp in opportunities:
                    opp_type = opp.get('type', 'unknown')
                    self.performance['opportunity_type_distribution'][opp_type] = \
                        self.performance['opportunity_type_distribution'].get(opp_type, 0) + 1
            
            # Update scan time
            scan_time = time.time() - start_time
            self.performance['total_scan_time'] += scan_time
            
            self._log_debug(f"Scanned {len(pairs)} pairs, found {len(opportunities)} opportunities in {scan_time:.3f}s")
            return opportunities
            
        except Exception as e:
            self._log_debug(f"Error in scan_opportunities: {str(e)}", "error")
            return []
    
    def _scan_pair(self, pair: str) -> List[Dict[str, Any]]:
        """Scan a single pair for opportunities"""
        try:
            opportunities = []
            pair_data = self.market_data.get(pair, {})
            
            if not pair_data:
                return opportunities
            
            # 1. Check momentum opportunities
            momentum_opps = self._check_momentum(pair, pair_data)
            if momentum_opps:
                opportunities.extend(momentum_opps)
            
            # 2. Check breakout opportunities
            breakout_opps = self._check_breakout(pair, pair_data)
            if breakout_opps:
                opportunities.extend(breakout_opps)
            
            # 3. Check reversal opportunities
            reversal_opps = self._check_reversal(pair, pair_data)
            if reversal_opps:
                opportunities.extend(reversal_opps)
            
            # 4. Check scalping opportunities
            scalping_opps = self._check_scalping(pair, pair_data)
            if scalping_opps:
                opportunities.extend(scalping_opps)
            
            # 5. Check mean reversion
            mean_rev_opps = self._check_mean_reversion(pair, pair_data)
            if mean_rev_opps:
                opportunities.extend(mean_rev_opps)
            
            # 6. Check seasonal patterns
            seasonal_opps = self._check_seasonal(pair, pair_data)
            if seasonal_opps:
                opportunities.extend(seasonal_opps)
            
            # 7. Check news opportunities
            news_opps = self._check_news(pair, pair_data)
            if news_opps:
                opportunities.extend(news_opps)
            
            # 8. Check liquidity sweep
            liquidity_opps = self._check_liquidity_sweep(pair, pair_data)
            if liquidity_opps:
                opportunities.extend(liquidity_opps)
            
            return opportunities
            
        except Exception as e:
            self._log_debug(f"Error scanning pair {pair}: {str(e)}", "error")
            return []
    
    def _check_momentum(self, pair: str, data: Dict[str, Any]) -> List[Dict[str, Any]]:
        """Check for momentum opportunities"""
        try:
            opportunities = []
            
            # Get momentum indicators
            momentum = data.get('momentum', 0.0) or 0.0
            adx = data.get('adx', 0.0) or 0.0
            rsi = data.get('rsi', 50.0) or 50.0
            
            # Check if momentum is strong
            if abs(momentum) < self.config.momentum_threshold:
                return opportunities
            
            # Check multi-timeframe alignment
            aligned_timeframes = self._check_timeframe_alignment(pair, 'momentum')
            if aligned_timeframes < self.config.min_timeframe_alignment:
                return opportunities
            
            # Determine direction
            direction = 'buy' if momentum > 0 else 'sell'
            
            # Calculate quality score
            quality_score = self._calculate_momentum_quality(pair, data)
            
            if quality_score >= self.config.min_confidence_score:
                opportunities.append({
                    'type': OpportunityType.MOMENTUM.value,
                    'pair': pair,
                    'direction': direction,
                    'quality_score': quality_score,
                    'momentum': momentum,
                    'adx': adx,
                    'rsi': rsi,
                    'timeframes_aligned': aligned_timeframes,
                    'timestamp': datetime.now().isoformat(),
                    'entry_price': data.get('price', 0.0),
                    'stop_loss': self._calculate_sl(pair, data, direction),
                    'take_profit': self._calculate_tp(pair, data, direction),
                    'confidence': quality_score
                })
            
            return opportunities
            
        except Exception as e:
            self._log_debug(f"Error in _check_momentum: {str(e)}", "error")
            return []
    
    def _check_breakout(self, pair: str, data: Dict[str, Any]) -> List[Dict[str, Any]]:
        """Check for breakout opportunities"""
        try:
            opportunities = []
            
            # Get breakout indicators
            price = data.get('price', 0.0) or 0.0
            high = data.get('high', price) or price
            low = data.get('low', price) or price
            volume = data.get('volume', 0.0) or 0.0
            avg_volume = data.get('avg_volume', volume) or volume
            
            # Check volume confirmation
            if volume < avg_volume * self.config.breakout_volume_multiplier:
                return opportunities
            
            # Check breakout levels
            resistance = data.get('resistance', high) or high
            support = data.get('support', low) or low
            
            is_breakout_up = price > resistance * 1.002
            is_breakout_down = price < support * 0.998
            
            if not is_breakout_up and not is_breakout_down:
                return opportunities
            
            # Check multi-timeframe alignment
            aligned_timeframes = self._check_timeframe_alignment(pair, 'breakout')
            if aligned_timeframes < self.config.min_timeframe_alignment:
                return opportunities
            
            direction = 'buy' if is_breakout_up else 'sell'
            
            # Calculate quality score
            quality_score = self._calculate_breakout_quality(pair, data, direction)
            
            if quality_score >= self.config.min_confidence_score:
                opportunities.append({
                    'type': OpportunityType.BREAKOUT.value,
                    'pair': pair,
                    'direction': direction,
                    'quality_score': quality_score,
                    'breakout_level': resistance if is_breakout_up else support,
                    'volume_ratio': volume / avg_volume,
                    'timeframes_aligned': aligned_timeframes,
                    'timestamp': datetime.now().isoformat(),
                    'entry_price': price,
                    'stop_loss': self._calculate_sl(pair, data, direction),
                    'take_profit': self._calculate_tp(pair, data, direction),
                    'confidence': quality_score
                })
            
            return opportunities
            
        except Exception as e:
            self._log_debug(f"Error in _check_breakout: {str(e)}", "error")
            return []
    
    def _check_reversal(self, pair: str, data: Dict[str, Any]) -> List[Dict[str, Any]]:
        """Check for reversal opportunities"""
        try:
            opportunities = []
            
            # Get reversal indicators
            rsi = data.get('rsi', 50.0) or 50.0
            macd = data.get('macd', 0.0) or 0.0
            price = data.get('price', 0.0) or 0.0
            
            # Check overbought/oversold conditions
            is_overbought = rsi > 70
            is_oversold = rsi < 30
            
            if not is_overbought and not is_oversold:
                return opportunities
            
            # Check for divergence
            divergence = data.get('divergence', False) or False
            
            direction = 'sell' if is_overbought else 'buy'
            
            # Calculate quality score
            quality_score = self._calculate_reversal_quality(pair, data, direction)
            
            if quality_score >= self.config.min_confidence_score:
                opportunities.append({
                    'type': OpportunityType.REVERSAL.value,
                    'pair': pair,
                    'direction': direction,
                    'quality_score': quality_score,
                    'rsi': rsi,
                    'macd': macd,
                    'divergence': divergence,
                    'timestamp': datetime.now().isoformat(),
                    'entry_price': price,
                    'stop_loss': self._calculate_sl(pair, data, direction),
                    'take_profit': self._calculate_tp(pair, data, direction),
                    'confidence': quality_score
                })
            
            return opportunities
            
        except Exception as e:
            self._log_debug(f"Error in _check_reversal: {str(e)}", "error")
            return []
    
    def _check_scalping(self, pair: str, data: Dict[str, Any]) -> List[Dict[str, Any]]:
        """Check for scalping opportunities"""
        try:
            opportunities = []
            
            # Get scalping indicators
            spread = data.get('spread', 0.0) or 0.0
            order_flow = data.get('order_flow', 0.0) or 0.0
            price = data.get('price', 0.0) or 0.0
            
            # Check if spread is tight enough
            if spread > 0.0005:  # 0.05% spread limit for scalping
                return opportunities
            
            # Check order flow imbalance
            if abs(order_flow) < self.config.scalping_opportunity_threshold:
                return opportunities
            
            direction = 'buy' if order_flow > 0 else 'sell'
            
            # Check if scalping limit reached
            daily_scalps = sum(1 for o in self.opportunity_history 
                              if o.get('type') == OpportunityType.SCALP.value 
                              and o.get('timestamp', '').startswith(datetime.now().strftime('%Y-%m-%d')))
            
            if daily_scalps >= self.config.max_scalp_opportunities:
                return opportunities
            
            # Calculate quality score
            quality_score = self._calculate_scalping_quality(pair, data, direction)
            
            if quality_score >= self.config.min_confidence_score:
                opportunities.append({
                    'type': OpportunityType.SCALP.value,
                    'pair': pair,
                    'direction': direction,
                    'quality_score': quality_score,
                    'spread': spread,
                    'order_flow': order_flow,
                    'timestamp': datetime.now().isoformat(),
                    'entry_price': price,
                    'stop_loss': self._calculate_sl(pair, data, direction, scalping=True),
                    'take_profit': self._calculate_tp(pair, data, direction, scalping=True),
                    'confidence': quality_score
                })
            
            return opportunities
            
        except Exception as e:
            self._log_debug(f"Error in _check_scalping: {str(e)}", "error")
            return []
    
    def _check_mean_reversion(self, pair: str, data: Dict[str, Any]) -> List[Dict[str, Any]]:
        """Check for mean reversion opportunities"""
        try:
            opportunities = []
            
            price = data.get('price', 0.0) or 0.0
            moving_avg = data.get('moving_avg_20', price) or price
            std_dev = data.get('std_dev', 0.0) or 0.0
            
            if std_dev <= 0:
                return opportunities
            
            zscore = (price - moving_avg) / std_dev
            
            if abs(zscore) < self.config.mean_reversion_zscore_threshold:
                return opportunities
            
            direction = 'sell' if zscore > 0 else 'buy'
            
            # Calculate quality score
            quality_score = self._calculate_mean_reversion_quality(pair, data, direction)
            
            if quality_score >= self.config.min_confidence_score:
                opportunities.append({
                    'type': OpportunityType.MEAN_REVERSION.value,
                    'pair': pair,
                    'direction': direction,
                    'quality_score': quality_score,
                    'zscore': zscore,
                    'price_deviation': price - moving_avg,
                    'timestamp': datetime.now().isoformat(),
                    'entry_price': price,
                    'stop_loss': self._calculate_sl(pair, data, direction),
                    'take_profit': self._calculate_tp(pair, data, direction),
                    'confidence': quality_score
                })
            
            return opportunities
            
        except Exception as e:
            self._log_debug(f"Error in _check_mean_reversion: {str(e)}", "error")
            return []
    
    def _check_seasonal(self, pair: str, data: Dict[str, Any]) -> List[Dict[str, Any]]:
        """Check for seasonal pattern opportunities"""
        try:
            opportunities = []
            
            # Check if we have seasonal data
            if pair not in self.seasonal_patterns:
                return opportunities
            
            seasonal_pattern = self.seasonal_patterns[pair]
            current_hour = datetime.now().hour
            current_weekday = datetime.now().weekday()
            
            # Check if current time has seasonal bias
            hour_pattern = seasonal_pattern.get('hourly', {}).get(current_hour, {})
            weekday_pattern = seasonal_pattern.get('weekday', {}).get(current_weekday, {})
            
            if not hour_pattern and not weekday_pattern:
                return opportunities
            
            # Calculate combined seasonal score
            seasonal_score = 0.0
            if hour_pattern:
                seasonal_score += hour_pattern.get('bias', 0.0) * 0.6
            if weekday_pattern:
                seasonal_score += weekday_pattern.get('bias', 0.0) * 0.4
            
            if abs(seasonal_score) < 0.2:
                return opportunities
            
            direction = 'buy' if seasonal_score > 0 else 'sell'
            
            # Calculate quality score
            quality_score = self._calculate_seasonal_quality(pair, data, direction)
            
            if quality_score >= self.config.min_confidence_score:
                opportunities.append({
                    'type': OpportunityType.SEASONAL.value,
                    'pair': pair,
                    'direction': direction,
                    'quality_score': quality_score,
                    'seasonal_score': seasonal_score,
                    'hour': current_hour,
                    'weekday': current_weekday,
                    'timestamp': datetime.now().isoformat(),
                    'entry_price': data.get('price', 0.0),
                    'stop_loss': self._calculate_sl(pair, data, direction),
                    'take_profit': self._calculate_tp(pair, data, direction),
                    'confidence': quality_score
                })
            
            return opportunities
            
        except Exception as e:
            self._log_debug(f"Error in _check_seasonal: {str(e)}", "error")
            return []
    
    def _check_news(self, pair: str, data: Dict[str, Any]) -> List[Dict[str, Any]]:
        """Check for news-based opportunities"""
        try:
            opportunities = []
            
            # Get news data
            news_impact = data.get('news_impact', 'none') or 'none'
            sentiment = data.get('sentiment', 0.0) or 0.0
            volatility = data.get('volatility', 0.0) or 0.0
            
            if news_impact == 'none':
                return opportunities
            
            # Check if volatility is high enough
            if volatility < self.current_volatility * 0.5:
                return opportunities
            
            direction = 'buy' if sentiment > 0.2 else 'sell' if sentiment < -0.2 else None
            
            if direction is None:
                # Use straddle strategy for neutral sentiment
                opportunities.append({
                    'type': OpportunityType.NEWS.value,
                    'pair': pair,
                    'direction': 'both',
                    'quality_score': 0.7,
                    'news_impact': news_impact,
                    'sentiment': sentiment,
                    'volatility': volatility,
                    'strategy': 'straddle',
                    'timestamp': datetime.now().isoformat(),
                    'entry_price': data.get('price', 0.0),
                    'stop_loss': self._calculate_sl(pair, data, 'both'),
                    'take_profit': self._calculate_tp(pair, data, 'both'),
                    'confidence': 0.7
                })
            else:
                # Directional news trade
                quality_score = self._calculate_news_quality(pair, data, direction)
                
                if quality_score >= self.config.min_confidence_score:
                    opportunities.append({
                        'type': OpportunityType.NEWS.value,
                        'pair': pair,
                        'direction': direction,
                        'quality_score': quality_score,
                        'news_impact': news_impact,
                        'sentiment': sentiment,
                        'volatility': volatility,
                        'timestamp': datetime.now().isoformat(),
                        'entry_price': data.get('price', 0.0),
                        'stop_loss': self._calculate_sl(pair, data, direction),
                        'take_profit': self._calculate_tp(pair, data, direction),
                        'confidence': quality_score
                    })
            
            return opportunities
            
        except Exception as e:
            self._log_debug(f"Error in _check_news: {str(e)}", "error")
            return []
    
    def _check_liquidity_sweep(self, pair: str, data: Dict[str, Any]) -> List[Dict[str, Any]]:
        """Check for liquidity sweep opportunities"""
        try:
            opportunities = []
            
            # Get order book data
            bid = data.get('bid', 0.0) or 0.0
            ask = data.get('ask', 0.0) or 0.0
            order_book = data.get('order_book', {})
            
            if not order_book:
                return opportunities
            
            # Check for liquidity levels
            high = data.get('high', 0.0) or 0.0
            low = data.get('low', 0.0) or 0.0
            
            # Check if price swept recent high/low
            price = data.get('price', 0.0) or 0.0
            swept_high = price > high * 0.998
            swept_low = price < low * 1.002
            
            if not swept_high and not swept_low:
                return opportunities
            
            direction = 'sell' if swept_high else 'buy'
            
            # Calculate quality score
            quality_score = self._calculate_liquidity_sweep_quality(pair, data, direction)
            
            if quality_score >= self.config.min_confidence_score:
                opportunities.append({
                    'type': OpportunityType.LIQUIDITY_SWEEP.value,
                    'pair': pair,
                    'direction': direction,
                    'quality_score': quality_score,
                    'sweep_level': high if swept_high else low,
                    'timestamp': datetime.now().isoformat(),
                    'entry_price': price,
                    'stop_loss': self._calculate_sl(pair, data, direction),
                    'take_profit': self._calculate_tp(pair, data, direction),
                    'confidence': quality_score
                })
            
            return opportunities
            
        except Exception as e:
            self._log_debug(f"Error in _check_liquidity_sweep: {str(e)}", "error")
            return []
    
    def _check_timeframe_alignment(self, pair: str, signal_type: str) -> int:
        """Check how many timeframes are aligned with the signal"""
        try:
            aligned = 0
            
            for tf in self.config.timeframes:
                tf_data = self.timeframe_data.get(tf, {})
                if not tf_data:
                    continue
                
                pair_tf_data = tf_data.get(pair, {})
                if not pair_tf_data:
                    continue
                
                # Check if this timeframe agrees with the signal
                if signal_type == 'momentum':
                    if pair_tf_data.get('momentum', 0.0) > 0:
                        aligned += 1
                elif signal_type == 'breakout':
                    if pair_tf_data.get('breakout', False):
                        aligned += 1
                # Add more signal types as needed
            
            return aligned
            
        except Exception as e:
            self._log_debug(f"Error in _check_timeframe_alignment: {str(e)}", "error")
            return 0
    
    def _calculate_momentum_quality(self, pair: str, data: Dict[str, Any]) -> float:
        """Calculate quality score for momentum opportunity"""
        try:
            score = 0.0
            
            # Momentum strength (30%)
            momentum = abs(data.get('momentum', 0.0) or 0.0)
            score += min(momentum * 30, 30.0)
            
            # ADX strength (20%)
            adx = data.get('adx', 0.0) or 0.0
