    def _calculate_breakout_quality(self, pair: str, data: Dict[str, Any], direction: str) -> float:
        """Calculate quality score for breakout opportunity"""
        try:
            score = 0.0
            
            # Volume confirmation (30%)
            volume = data.get('volume', 0.0) or 0.0
            avg_volume = data.get('avg_volume', volume) or volume
            score += min((volume / avg_volume) * 15, 30.0)
            
            # Breakout strength (25%)
            price = data.get('price', 0.0) or 0.0
            if direction == 'buy':
                resistance = data.get('resistance', price) or price
                breakout_strength = (price - resistance) / resistance * 100
            else:
                support = data.get('support', price) or price
                breakout_strength = (support - price) / support * 100
            score += min(abs(breakout_strength) * 25, 25.0)
            
            # Timeframe alignment (20%)
            aligned = self._check_timeframe_alignment(pair, 'breakout')
            score += (aligned / len(self.config.timeframes)) * 20.0
            
            # False breakout protection (15%)
            false_breakout_risk = data.get('false_breakout_risk', 0.0) or 0.0
            score += (1 - false_breakout_risk) * 15.0
            
            # Regime adjustment (10%)
            if 'trend' in self.current_regime.lower():
                score += 10.0
            elif 'range' in self.current_regime.lower():
                score += 5.0
            
            return min(score / 100, 1.0)
            
        except Exception as e:
            self._log_debug(f"Error in _calculate_breakout_quality: {str(e)}", "error")
            return 0.5
    
    def _calculate_reversal_quality(self, pair: str, data: Dict[str, Any], direction: str) -> float:
