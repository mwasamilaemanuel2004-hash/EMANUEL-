# Configure logging
logger = logging.getLogger(__name__)

debug_handler = logging.FileHandler('logs/profit_optimizer_debug.log')
debug_handler.setLevel(logging.DEBUG)
debug_formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')
debug_handler.setFormatter(debug_formatter)
logger.addHandler(debug_handler)


class ProfitMode(Enum):
    """Profit modes for optimization"""
    AGGRESSIVE = "aggressive"      # Maximize profit, higher risk
    BALANCED = "balanced"          # Balanced profit and risk (DEFAULT)
    CONSERVATIVE = "conservative"  # Protect capital, steady profit
    AUTO = "auto"                  # Auto-detect based on conditions


class WinRateMode(Enum):
    """User selectable win rate modes"""
    WIN_55 = "win_55"          # 55% win rate (realistic, balanced)
    WIN_60 = "win_60"          # 60% win rate (good performance)
    WIN_80 = "win_80"          # 80% win rate (very strict, fewer trades)
    AUTO_ADAPT = "auto_adapt"  # System auto-adapts win rate
    SIMPLE = "simple"          # Simple mode - no optimization


@dataclass
class ProfitOptimizerConfig:
    """Configuration for Profit Optimizer - ULTIMATE UPGRADE"""
    
    # Win Rate Modes (User Selectable)
    win_rate_mode: str = "WIN_55"  # WIN_55, WIN_60, WIN_80, AUTO_ADAPT, SIMPLE
    
    # Win Rate Parameters (Auto-calculated based on mode)
    target_win_rate: float = 0.55
    min_win_rate: float = 0.45
    max_win_rate: float = 0.80
    
    # Risk-Reward (BALANCED)
    min_rr_ratio: float = 1.2
    max_rr_ratio: float = 4.0
    default_rr_ratio: float = 2.0
    
    # Position sizing (BALANCED)
    max_position_size: float = 1.5
    min_position_size: float = 0.2
    default_position_size: float = 0.8
    
    # Profit lock (BALANCED)
    profit_lock_level1: float = 8.0
    profit_lock_level2: float = 16.0
    profit_lock_level3: float = 25.0
    
    # Reinvestment (BALANCED)
    reinvestment_ratio: float = 0.35
    max_reinvestment: float = 3.0
    
    # Capital generation
    capital_generation_target: float = 0.15
    
    # Adaptive parameters
    adaptive_optimization: bool = True
    adaptive_interval_minutes: int = 30
    
    # Safety limits
    max_optimization_level: float = 1.3
    min_optimization_level: float = 0.7
    optimization_step: float = 0.02
    
    # Debug mode
    debug_mode: bool = True
    max_history_size: int = 5000


class ProfitOptimizer:
    """
    Combined Profit Optimizer Engine - ULTIMATE UPGRADE
    User selectable win rate + auto-adapt
    """
    
    def __init__(self, config: Optional[ProfitOptimizerConfig] = None):
        self.config = config or ProfitOptimizerConfig()
        self.debug_mode = self.config.debug_mode
        
        # Set win rate mode
        self.win_rate_mode = self.config.win_rate_mode
        self._apply_win_rate_mode(self.win_rate_mode)
        
        # Performance tracking
        self.performance = {
            'total_trades_optimized': 0,
            'total_profit_generated': 0.0,
            'total_loss_prevented': 0.0,
            'capital_generated': 0.0,
            'avg_profit_per_trade': 0.0,
            'avg_rr_ratio_used': 2.0,
            'avg_position_size': 0.8,
            'profit_lock_events': 0,
            'reinvestment_events': 0,
            'optimization_events': 0,
            'mode_changes': 0,
            'auto_corrections': 0,
            'win_rate_adjustments': 0,
            'trades_rejected_low_rr': 0,
            'trades_rejected_high_risk': 0,
            'trades_rejected_win_rate': 0
        }
        
        # Trade history
        self.trade_history = deque(maxlen=self.config.max_history_size)
        self.optimization_history = deque(maxlen=1000)
        
        # Capital tracking
        self.initial_capital = 0.0
        self.current_capital = 0.0
        self.locked_profits = 0.0
        self.capital_reserve = 0.0
        self.peak_equity = 0.0
        
        # Mode
        self.mode = ProfitMode.BALANCED
        self.current_optimization_level = 1.0
        
        # Market data
        self.current_regime = "unknown"
        self.current_volatility = 0.0
        self.current_adx = 0.0
        
        # Performance metrics
        self.recent_win_rate = 0.55
        self.recent_profit_factor = 1.8
        self.consecutive_losses = 0
        self.consecutive_wins = 0
        self.rolling_win_rates = deque(maxlen=50)
        
        # Lock for thread safety
        self._lock = threading.Lock()
        
        self._log_debug(f"Profit Optimizer initialized with WIN_RATE_MODE={self.win_rate_mode}, target={self.config.target_win_rate*100:.0f}%")
        logger.info(f"Profit Optimizer initialized with WIN_RATE_MODE={self.win_rate_mode}, target={self.config.target_win_rate*100:.0f}%")
    
    def _log_debug(self, message: str, level: str = "debug") -> None:
        """Debug logging with timestamp"""
        if self.debug_mode:
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
            log_msg = f"[DEBUG {timestamp}] {message}"
            if level == "info":
                logger.info(log_msg)
            elif level == "warning":
                logger.warning(log_msg)
            elif level == "error":
                logger.error(log_msg)
            else:
                logger.debug(log_msg)
    
    def set_win_rate_mode(self, mode: str) -> bool:
        """
        User can change win rate mode at any time.
        Modes: WIN_55, WIN_60, WIN_80, AUTO_ADAPT, SIMPLE
        """
        try:
            if mode not in ['WIN_55', 'WIN_60', 'WIN_80', 'AUTO_ADAPT', 'SIMPLE']:
                self._log_debug(f"Invalid win rate mode: {mode}", "warning")
                return False
            
            self.win_rate_mode = mode
            self._apply_win_rate_mode(mode)
            self.performance['win_rate_adjustments'] += 1
            
            self._log_debug(f"Win rate mode changed to: {mode}, target={self.config.target_win_rate*100:.0f}%", "info")
            logger.info(f"Win rate mode changed to: {mode}, target={self.config.target_win_rate*100:.0f}%")
            return True
            
        except Exception as e:
            self._log_debug(f"Error in set_win_rate_mode: {str(e)}", "error")
            return False
    
    def _apply_win_rate_mode(self, mode: str) -> None:
        """Apply win rate mode parameters"""
        try:
            if mode == "WIN_55":
                self.config.target_win_rate = 0.55
                self.config.min_win_rate = 0.45
                self.config.max_win_rate = 0.65
                self.config.min_rr_ratio = 1.2
                self.config.max_rr_ratio = 3.5
                self.config.default_rr_ratio = 1.8
                self.config.max_position_size = 1.5
                self.config.default_position_size = 0.9
                self._log_debug("WIN_55: Balanced realistic mode")
                
            elif mode == "WIN_60":
                self.config.target_win_rate = 0.60
                self.config.min_win_rate = 0.50
                self.config.max_win_rate = 0.70
                self.config.min_rr_ratio = 1.5
                self.config.max_rr_ratio = 4.0
                self.config.default_rr_ratio = 2.5
                self.config.max_position_size = 1.2
                self.config.default_position_size = 0.7
                self._log_debug("WIN_60: Good performance mode")
                
            elif mode == "WIN_80":
                self.config.target_win_rate = 0.80
                self.config.min_win_rate = 0.70
                self.config.max_win_rate = 0.90
                self.config.min_rr_ratio = 1.8
                self.config.max_rr_ratio = 2.5
                self.config.default_rr_ratio = 2.0
                self.config.max_position_size = 0.8
                self.config.default_position_size = 0.5
                self.config.profit_lock_level1 = 5.0
                self.config.profit_lock_level2 = 10.0
                self.config.profit_lock_level3 = 15.0
                self._log_debug("WIN_80: Strict quality mode - fewer trades, higher win rate")
                
            elif mode == "AUTO_ADAPT":
                self.config.target_win_rate = 0.55  # Start at 55%
                self.config.min_win_rate = 0.40
                self.config.max_win_rate = 0.85
                self.config.min_rr_ratio = 1.2
                self.config.max_rr_ratio = 4.0
                self.config.default_rr_ratio = 2.0
                self.config.max_position_size = 1.5
                self.config.default_position_size = 0.8
                self._log_debug("AUTO_ADAPT: System will auto-adapt win rate")
                
            elif mode == "SIMPLE":
                self.config.target_win_rate = 0.50
                self.config.min_win_rate = 0.40
                self.config.max_win_rate = 0.60
                self.config.min_rr_ratio = 1.0
                self.config.max_rr_ratio = 2.5
                self.config.default_rr_ratio = 1.5
                self.config.max_position_size = 1.0
                self.config.default_position_size = 0.5
