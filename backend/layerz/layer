                    'avg_rr_ratio': self.performance['avg_rr_ratio_used'],
                    'avg_position_size': self.performance['avg_position_size']
                },
                'capital': {
                    'initial': self.initial_capital,
                    'current': self.current_capital,
                    'peak': self.peak_equity,
