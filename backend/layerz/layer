            return {'error': str(e)}
    
    def set_mode(self, mode: str) -> None:
        """Manually set optimization mode"""
        try:
            mode_map = {
                'aggressive': ProfitMode.AGGRESSIVE,
                'balanced': ProfitMode.BALANCED,
                'conservative': ProfitMode.CONSERVATIVE,
                'auto': ProfitMode.AUTO
            }
            
            new_mode = mode_map.get(mode.lower(), ProfitMode.BALANCED)
            if new_mode != self.mode:
                self.mode = new_mode
                self.performance['mode_changes'] += 1
                self._log_debug(f"Mode manually set to {self.mode.value}")
                
        except Exception as e:
            self._log_debug(f"Error in set_mode: {str(e)}", "error")
    
    def reset_capital(self) -> None:
        """Reset capital tracking"""
        try:
            self.initial_capital = self.current_capital
            self.peak_equity = self.current_capital
            self.locked_profits = 0.0
            self.capital_reserve = 0.0
            self._log_debug("Capital tracking reset")
        except Exception as e:
            self._log_debug(f"Error in reset_capital: {str(e)}", "error")