    """Available strategy types"""
    CONSERVATIVE = "conservative"
    BALANCED = "balanced"
    AGGRESSIVE = "aggressive"
    SCALPING = "scalping"
    TREND_FOLLOWING = "trend_following"
    MEAN_REVERSION = "mean_reversion"
    GRID = "grid"
    DCA = "dca"
    ARBITRAGE = "arbitrage"
    MOMENTUM = "momentum"
    BREAKOUT = "breakout"
    NEWS = "news"
    SMART_MONEY = "smart_money"


@dataclass
class CapitalStrategyConfig:
    """Configuration for Capital & Strategy Optimization - ADVANCED"""
    
    # CAPITAL THRESHOLDS FOR STRATEGY UNLOCKING
    strategy_unlock_thresholds: Dict[str, float] = field(default_factory=lambda: {
        'conservative': 50.0,
        'dca': 100.0,
        'balanced': 200.0,
        'scalping': 300.0,
        'mean_reversion': 400.0,
        'grid': 500.0,
        'aggressive': 600.0,
        'trend_following': 800.0,
        'momentum': 1000.0,
        'breakout': 1200.0,
        'news': 1500.0,
        'smart_money': 2000.0,
        'arbitrage': 2500.0
    })
    
    # ALLOCATION LIMITS
    max_allocation_per_strategy: float = 0.40  # 40% per strategy
    min_allocation_per_strategy: float = 0.03   # 3% per strategy
    reserve_percentage: float = 0.10            # 10% reserve
    
    # REBALANCING
    rebalance_threshold: float = 0.05           # 5% deviation triggers rebalance
    rebalance_interval_hours: int = 12
    max_strategies_active: int = 8
    
    # STRATEGY SCORING
    strategy_score_weights: Dict[str, float] = field(default_factory=lambda: {
        'capital_efficiency': 0.25,
        'profit_potential': 0.25,
        'risk_adjusted_return': 0.20,
        'market_alignment': 0.15,
        'implementation_cost': 0.10,
        'scalability': 0.05
    })
    
    # GROWTH FORECASTING
    forecast_days: int = 30
    forecast_samples: int = 100
    
    # DEBUG
    debug_mode: bool = True
    max_history_size: int = 10000


