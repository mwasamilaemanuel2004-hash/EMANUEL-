    def _log_debug(self, message: str, level: str = "debug") -> None:
        """Debug logging with timestamp and level"""
        if self.debug_mode:
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
            log_msg = f"[DEBUG {timestamp}] {message}"
            if level == "info":
                logger.info(log_msg)
            elif level == "warning":
                logger.warning(log_msg)
            elif level == "error":
                logger.error(log_msg)
            else:
                logger.debug(log_msg)
    
    def _safe_get(self, data: Dict, key: str, default: Any = None) -> Any:
        """Safe get with error handling"""
        try:
            return data.get(key, default) if data else default
        except Exception as e:
            self._log_debug(f"Safe get error for {key}: {str(e)}", "warning")
            return default
    
    def detect_capital(self, capital_data: Dict[str, Any]) -> Dict[str, Any]:
        """
        Detect available capital from various sources with full validation
        """
        try:
            self.performance['capital_detections'] += 1
            
            if not isinstance(capital_data, dict):
                self._log_debug("Invalid capital_data: not a dict", "warning")
                return {'error': 'Invalid capital data'}
            
            # Extract capital from various sources
            exchange_balances = self._safe_get(capital_data, 'exchange_balances', {})
            wallet_balances = self._safe_get(capital_data, 'wallet_balances', {})
            broker_balances = self._safe_get(capital_data, 'broker_balances', {})
            total_balance = self._safe_get(capital_data, 'total_balance', 0.0)
            
            # Calculate total detected capital
            detected = total_balance
            
            # If not provided, sum up all sources
            if detected == 0:
                for source, balance in exchange_balances.items():
                    detected += balance
                for source, balance in wallet_balances.items():
                    detected += balance
                for source, balance in broker_balances.items():
                    detected += balance
            
            # Store detected capital
            self.detected_capital = detected
            
            # Store capital sources
            self.capital_sources = {
                'exchanges': exchange_balances,
                'wallets': wallet_balances,
                'brokers': broker_balances,
                'total': detected,
                'timestamp': datetime.now().isoformat()
            }
            
            # Update available capital
            self.available_capital = detected - self.reserve_capital
            
            # Update total capital if higher
            if detected > self.total_capital:
                self.total_capital = detected
                self.performance['peak_capital'] = max(self.performance['peak_capital'], detected)
            
            # Update detection history
            self.detection_history.append({
                'timestamp': datetime.now(),
                'detected': detected,
                'sources': self.capital_sources
            })
            
            # Auto-expand strategies
            expansion_result = self._expand_strategies()
            
            self._log_debug(f"Capital detected: ${detected:.2f} (available: ${self.available_capital:.2f})", "info")
            logger.info(f"Capital detected: ${detected:.2f}")
            
            return {
                'detected_capital': detected,
                'available_capital': self.available_capital,
                'utilized_capital': self.utilized_capital,
                'reserve_capital': self.reserve_capital,
                'sources': self.capital_sources,
                'expansion': expansion_result,
                'timestamp': datetime.now().isoformat()
            }
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in detect_capital: {str(e)}", "error")
            return {'error': str(e)}
    
    def _expand_strategies(self) -> Dict[str, Any]:
        """
        Dynamically expand strategies based on available capital
        """
        try:
            expansion_result = {
                'unlocked': [],
                'activated': [],
                'skipped': []
            }
            
            # Get available strategies based on capital
            for strategy, threshold in self.config.strategy_unlock_thresholds.items():
                if self.total_capital >= threshold:
                    if strategy not in self.active_strategies:
                        # Unlock the strategy
                        self.active_strategies[strategy] = {
                            'status': 'active',
                            'unlocked_at': datetime.now(),
                            'capital_threshold': threshold,
                            'performance': {'wins': 0, 'losses': 0, 'pnl': 0.0},
                            'allocation': 0.0
                        }
                        self.performance['strategies_unlocked'] += 1
                        expansion_result['unlocked'].append(strategy)
                        
                        self._log_debug(f"Strategy unlocked: {strategy} (capital: ${self.total_capital:.2f} >= ${threshold:.2f})", "info")
                        logger.info(f"Strategy unlocked: {strategy}")
                else:
                    if strategy in self.active_strategies and strategy != 'conservative':
                        # Don't deactivate, just mark as limited
                        if self.active_strategies[strategy].get('status') == 'active':
                            self.active_strategies[strategy]['status'] = 'limited'
                            expansion_result['skipped'].append(strategy)
            
            # Limit number of active strategies
            active_count = len([s for s in self.active_strategies if self.active_strategies[s].get('status') == 'active'])
            if active_count > self.config.max_strategies_active:
                # Deactivate least performing strategies
                sorted_strategies = sorted(
                    [(s, self.active_strategies[s]['performance']['pnl']) for s in self.active_strategies if self.active_strategies[s].get('status') == 'active'],
                    key=lambda x: x[1]
                )
                to_deactivate = sorted_strategies[:active_count - self.config.max_strategies_active]
                for strategy, _ in to_deactivate:
                    self.active_strategies[strategy]['status'] = 'inactive'
                    expansion_result['skipped'].append(strategy)
            
            # Update allocations
            self._rebalance_allocations()
            
            return expansion_result
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in _expand_strategies: {str(e)}", "error")
            return {'error': str(e)}
    
    def _rebalance_allocations(self) -> None:
        """Rebalance capital allocation across active strategies"""
        try:
            active_strategies = [s for s in self.active_strategies if self.active_strategies[s].get('status') == 'active']
            if not active_strategies:
                self.current_allocations = {}
                return
            
            # Calculate scores for each active strategy
            scores = {}
            total_score = 0.0
            
            for strategy in active_strategies:
                score = self._calculate_strategy_score(strategy)
                scores[strategy] = score
                total_score += score
            
            if total_score == 0:
                # Equal allocation
                for strategy in active_strategies:
                    self.current_allocations[strategy] = 100.0 / len(active_strategies)
            else:
                # Proportional allocation based on scores
                for strategy in active_strategies:
                    self.current_allocations[strategy] = (scores[strategy] / total_score) * 100.0
            
            # Ensure limits
            for strategy in self.current_allocations:
                min_alloc = self.config.min_allocation_per_strategy * 100
                max_alloc = self.config.max_allocation_per_strategy * 100
                self.current_allocations[strategy] = max(min_alloc, min(max_alloc, self.current_allocations[strategy]))
            
            # Normalize to 100%
            total_alloc = sum(self.current_allocations.values())
            if total_alloc > 0:
                for strategy in self.current_allocations:
                    self.current_allocations[strategy] = (self.current_allocations[strategy] / total_alloc) * 100
            
            # Update active strategies with allocations
            for strategy in self.current_allocations:
                if strategy in self.active_strategies:
                    self.active_strategies[strategy]['allocation'] = self.current_allocations[strategy]
            
            self.allocation_history.append({
                'timestamp': datetime.now(),
                'allocations': self.current_allocations.copy()
            })
            
            self.performance['rebalances'] += 1
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in _rebalance_allocations: {str(e)}", "error")
    
    def _calculate_strategy_score(self, strategy: str) -> float:
        """Calculate score for a strategy based on multiple factors"""
        try:
            score = 0.0
            weights = self.config.strategy_score_weights
            
            # 1. Capital Efficiency (25%)
            capital_required = self.config.strategy_unlock_thresholds.get(strategy, 100.0)
            if self.total_capital > 0:
                capital_efficiency = min(1.0, self.total_capital / capital_required)
                score += capital_efficiency * weights['capital_efficiency']
            
            # 2. Profit Potential (25%)
            profit_potential = self._get_strategy_potential(strategy)
            score += profit_potential * weights['profit_potential']
            
            # 3. Risk-Adjusted Return (20%)
            risk_adjusted = self._get_risk_adjusted_return(strategy)
            score += risk_adjusted * weights['risk_adjusted_return']
            
            # 4. Market Alignment (15%)
            market_alignment = self._get_market_alignment(strategy)
            score += market_alignment * weights['market_alignment']
            
            # 5. Implementation Cost (10%)
            impl_cost = self._get_implementation_cost(strategy)
            score += (1.0 - impl_cost) * weights['implementation_cost']
            
            # 6. Scalability (5%)
            scalability = self._get_scalability(strategy)
            score += scalability * weights['scalability']
            
            return max(0.01, min(1.0, score))
            
        except Exception as e:
            self._log_debug(f"Error in _calculate_strategy_score: {str(e)}", "error")
            return 0.5
    
