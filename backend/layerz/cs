    def update_capital_growth(self, growth: float) -> None:
        """Update capital growth tracking with safety"""
        try:
            self.growth_history.append(growth)
            self.total_capital += growth
            self.utilized_capital += growth * 0.9
            
            # Update growth metrics
            if len(self.growth_history) > 0:
                recent = list(self.growth_history)[-30:]
                self.monthly_growth = sum(recent) / len(recent) if recent else 0
            
            self.performance['avg_capital_growth'] = (self.performance['avg_capital_growth'] * 0.9 + growth * 0.1)
            
            # Update capital utilization
            if self.total_capital > 0:
                self.capital_utilization_rate = self.utilized_capital / self.total_capital
            
            self._log_debug(f"Capital growth: ${growth:.2f}, total: ${self.total_capital:.2f}")
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in update_capital_growth: {str(e)}", "error")
    
