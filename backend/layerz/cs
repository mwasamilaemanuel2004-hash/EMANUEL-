    def get_recommended_strategy(self) -> Dict[str, Any]:
        """
        Get recommended strategy based on capital and market conditions with full validation
        """
        try:
            # Detect available strategies
            available = [s for s in self.active_strategies if self.active_strategies[s].get('status') == 'active']
            
            if not available:
                # Fallback to conservative
                primary = StrategyType.CONSERVATIVE
            else:
                # Score each available strategy
                scored_strategies = []
                for strategy in available:
                    score = self._calculate_strategy_score(strategy)
                    scored_strategies.append((strategy, score))
                
                # Sort by score
                scored_strategies.sort(key=lambda x: x[1], reverse=True)
                
                # Get top strategy
                primary_strategy = scored_strategies[0][0]
                primary = StrategyType(primary_strategy) if primary_strategy in [s.value for s in StrategyType] else StrategyType.CONSERVATIVE
                
                # Get secondary strategy
                if len(scored_strategies) > 1:
                    secondary_strategy = scored_strategies[1][0]
                    secondary = StrategyType(secondary_strategy) if secondary_strategy in [s.value for s in StrategyType] else StrategyType.BALANCED
                else:
                    secondary = StrategyType.BALANCED
            
            # Calculate allocation
            allocation = self.current_allocations.get(primary.value if primary else 'conservative', 20.0)
            
            result = {
                'primary_strategy': primary.value if primary else 'conservative',
                'secondary_strategy': secondary.value if secondary else 'balanced',
                'allocation': allocation,
                'capital_required': self.config.strategy_unlock_thresholds.get(primary.value if primary else 'conservative', 100.0),
                'current_capital': self.total_capital,
                'available_strategies': available,
                'strategy_scores': {s: self._calculate_strategy_score(s) for s in available},
                'active_count': len(available),
                'max_active': self.config.max_strategies_active,
                'confidence': self._get_strategy_confidence(primary),
                'risk_level': self._get_risk_level(primary),
                'expected_return': self._get_expected_return(primary),
                'volatility_adjusted': self.current_volatility > 1.0,
                'regime': self.current_regime,
                'timestamp': datetime.now().isoformat()
            }
            
            self.current_recommendations = result
            self.recommendation_history.append({
                'timestamp': datetime.now(),
                'recommendation': result
            })
            self.performance['total_optimizations'] += 1
            
            self._log_debug(f"Recommended: {primary.value if primary else 'conservative'} (allocation: {allocation:.1f}%)", "info")
            return result
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in get_recommended_strategy: {str(e)}", "error")
            return {
                'primary_strategy': 'conservative',
                'secondary_strategy': 'balanced',
                'allocation': 20.0,
                'error': str(e)
            }
    
    def _get_strategy_confidence(self, strategy: Optional[StrategyType]) -> float:
        """Get confidence in a strategy with fallback"""
        try:
            if not strategy:
                return 0.70
            
            base_confidence = {
                StrategyType.CONSERVATIVE: 0.85,
                StrategyType.BALANCED: 0.80,
                StrategyType.AGGRESSIVE: 0.70,
                StrategyType.SCALPING: 0.75,
                StrategyType.TREND_FOLLOWING: 0.80,
                StrategyType.MEAN_REVERSION: 0.70,
                StrategyType.GRID: 0.75,
                StrategyType.DCA: 0.80,
                StrategyType.ARBITRAGE: 0.90,
                StrategyType.MOMENTUM: 0.75,
                StrategyType.BREAKOUT: 0.70,
                StrategyType.NEWS: 0.65,
                StrategyType.SMART_MONEY: 0.75
            }.get(strategy, 0.70)
            
            # Adjust based on market conditions
            if self.current_volatility > 2.0:
                if strategy in [StrategyType.AGGRESSIVE, StrategyType.SCALPING]:
                    base_confidence *= 0.8
            
            return max(0.3, min(1.0, base_confidence))
            
        except Exception as e:
            self._log_debug(f"Error in _get_strategy_confidence: {str(e)}", "error")
            return 0.70
    
