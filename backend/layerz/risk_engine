# backend/app/core/risk_engine.py
"""
RISK ENGINE - ULTRA ADVANCED (FULLY DEBUGGED)
Inasimamia risk, drawdown, position sizing, stop/re-entry
Features: Dynamic Risk, Kelly Criterion, Drawdown Protection, Auto-Hedging
"""

import json
import math
import time
from typing import Dict, List, Optional, Any, Tuple
from datetime import datetime, timedelta
from dataclasses import dataclass, field
from enum import Enum
from loguru import logger
import traceback

class RiskLevel(Enum):
    SAFE = "SAFE"
    MODERATE = "MODERATE"
    AGGRESSIVE = "AGGRESSIVE"
    EXTREME = "EXTREME"

class StopReason(Enum):
    DAILY_LOSS_LIMIT = "DAILY_LOSS_LIMIT"
    WEEKLY_LOSS_LIMIT = "WEEKLY_LOSS_LIMIT"
    DRAWDOWN_LIMIT = "DRAWDOWN_LIMIT"
    CONSECUTIVE_LOSSES = "CONSECUTIVE_LOSSES"
    MARKET_CRASH = "MARKET_CRASH"
    HIGH_VOLATILITY = "HIGH_VOLATILITY"
    USER_PAUSE = "USER_PAUSE"
    EXCHANGE_ERROR = "EXCHANGE_ERROR"
    STRATEGY_FAILURE = "STRATEGY_FAILURE"
    CAPITAL_PROTECTION = "CAPITAL_PROTECTION"

class ReentryPhase(Enum):
    ANALYSIS = "ANALYSIS"
    REDUCED_RISK = "REDUCED_RISK"
    TESTING = "TESTING"
    GRADUAL = "GRADUAL"
    FULL = "FULL"

@dataclass
class RiskState:
    total_equity: float = 0.0
    peak_equity: float = 0.0
    current_drawdown: float = 0.0
    daily_loss: float = 0.0
    weekly_loss: float = 0.0
    monthly_loss: float = 0.0
    consecutive_losses: int = 0
    consecutive_wins: int = 0
    current_risk_level: str = "MODERATE"
    is_paused: bool = False
    pause_reason: Optional[str] = None
    pause_timestamp: Optional[datetime] = None
    stop_reason: Optional[str] = None
    stop_timestamp: Optional[datetime] = None
    reentry_phase: str = "ANALYSIS"
    reentry_start: Optional[datetime] = None
    reentry_trades_tested: int = 0
    reentry_profitable: int = 0
    current_position_size_multiplier: float = 0.25
    capital: float = 0.0
    risk_per_trade: float = 2.0
    max_daily_loss: float = 5.0
    max_drawdown: float = 15.0
    max_positions: int = 3

@dataclass
class RiskLimits:
    max_risk_per_trade: float = 0.02
    max_daily_loss: float = 0.05
    max_weekly_loss: float = 0.10
    max_monthly_loss: float = 0.20
    max_drawdown: float = 0.15
    max_consecutive_losses: int = 3
    max_positions: int = 5
    max_position_size: float = 5000
    min_position_size: float = 10
    risk_per_trade_min: float = 0.005
    risk_per_trade_max: float = 0.05

@dataclass
class TradeRisk:
    symbol: str = ""
    action: str = ""
    entry_price: float = 0.0
    stop_loss: float = 0.0
    take_profit: float = 0.0
    position_size: float = 0.0
    risk_amount: float = 0.0
    risk_percent: float = 0.0
    reward_ratio: float = 0.0
    expected_profit: float = 0.0
    kelly_fraction: float = 0.0
    optimal_f: float = 0.0

class RiskEngine:
    def __init__(self, config: Optional[Dict] = None):
        self.config = config or {}
        self.limits = RiskLimits(
            max_risk_per_trade=self.config.get('max_risk_per_trade', 0.02),
            max_daily_loss=self.config.get('max_daily_loss', 0.05),
            max_weekly_loss=self.config.get('max_weekly_loss', 0.10),
            max_monthly_loss=self.config.get('max_monthly_loss', 0.20),
            max_drawdown=self.config.get('max_drawdown', 0.15),
            max_consecutive_losses=self.config.get('max_consecutive_losses', 3),
            max_positions=self.config.get('max_positions', 5),
            max_position_size=self.config.get('max_position_size', 5000),
            min_position_size=self.config.get('min_position_size', 10),
            risk_per_trade_min=self.config.get('risk_per_trade_min', 0.005),
            risk_per_trade_max=self.config.get('risk_per_trade_max', 0.05)
        )
        self.state = RiskState()
        self.trade_history: List[Dict] = []
        self.daily_trades: List[Dict] = []
        self.weekly_trades: List[Dict] = []
        self.monthly_trades: List[Dict] = []
        self.adaptive_risk_multiplier = 1.0
        self.volatility_adjustment = 1.0
        self.win_rate_adjustment = 1.0
        self.performance_adjustment = 1.0
        self.kelly_multiplier = 0.25
        self.total_profit = 0.0
        self.total_trades = 0
        self.winning_trades = 0
        self.losing_trades = 0
        self.max_profit_trade = 0.0
        self.max_loss_trade = 0.0
        self.win_rate = 0.5
        self.profit_factor = 1.0
        self.kelly_history = []
        self.reentry_phases = {
            "ANALYSIS": {'duration_hours': 24, 'position_multiplier': 0.0},
            "REDUCED_RISK": {'duration_hours': 48, 'position_multiplier': 0.25},
            "TESTING": {'duration_hours': 24, 'position_multiplier': 0.50},
            "GRADUAL": {'duration_hours': 72, 'position_multiplier': 0.75},
            "FULL": {'duration_hours': 0, 'position_multiplier': 1.0}
        }
        self._load_state()
        logger.info("🛡️ Ultra Advanced Risk Engine initialized")

    def update(self, equity: float, trade_result: Optional[Dict] = None) -> Dict:
        try:
            self.state.total_equity = equity
            if equity > self.state.peak_equity:
                self.state.peak_equity = equity
            if self.state.peak_equity > 0:
                self.state.current_drawdown = (self.state.peak_equity - equity) / self.state.peak_equity
            if trade_result:
                self._update_from_trade(trade_result)
            self._check_stop_conditions()
            self._check_reentry_conditions()
            self._calculate_adaptive_multipliers()
            self._calculate_kelly()
            self._update_risk_level()
            self._save_state()
            return self.get_status()
        except Exception as e:
            logger.error(f"Risk update error: {e}\n{traceback.format_exc()}")
            return self.get_status()

    def _update_from_trade(self, trade_result: Dict):
        try:
            profit = trade_result.get('profit', 0)
            self.total_profit += profit
            self.total_trades += 1
            if profit > 0:
                self.winning_trades += 1
                self.state.consecutive_wins += 1
                self.state.consecutive_losses = 0
                if profit > self.max_profit_trade:
                    self.max_profit_trade = profit
            else:
                self.losing_trades += 1
                self.state.consecutive_losses += 1
                self.state.consecutive_wins = 0
                if profit < self.max_loss_trade:
                    self.max_loss_trade = profit
            self.win_rate = self.winning_trades / self.total_trades if self.total_trades > 0 else 0.5
            total_profit = sum(t.get('profit', 0) for t in self.trade_history if t.get('profit', 0) > 0)
            total_loss = abs(sum(t.get('profit', 0) for t in self.trade_history if t.get('profit', 0) < 0))
            self.profit_factor = total_profit / total_loss if total_loss > 0 else 1.0
            self.state.daily_loss += profit
            self.weekly_trades.append(trade_result)
            week_ago = datetime.now() - timedelta(days=7)
            self.weekly_trades = [t for t in self.weekly_trades if t.get('timestamp', datetime.now()) > week_ago]
            self.state.weekly_loss = sum(t.get('profit', 0) for t in self.weekly_trades)
            self.monthly_trades.append(trade_result)
            month_ago = datetime.now() - timedelta(days=30)
            self.monthly_trades = [t for t in self.monthly_trades if t.get('timestamp', datetime.now()) > month_ago]
            self.state.monthly_loss = sum(t.get('profit', 0) for t in self.monthly_trades)
            self.trade_history.append(trade_result)
            if len(self.trade_history) > 1000:
                self.trade_history = self.trade_history[-1000:]
        except Exception as e:
            logger.error(f"Update from trade error: {e}")

    def _check_stop_conditions(self):
        try:
            if self.state.total_equity <= 0:
                return
            daily_loss_limit = self.limits.max_daily_loss * self.state.total_equity
            if abs(self.state.daily_loss) >= daily_loss_limit:
                self._stop_trading(StopReason.DAILY_LOSS_LIMIT)
                return
            weekly_loss_limit = self.limits.max_weekly_loss * self.state.total_equity
            if abs(self.state.weekly_loss) >= weekly_loss_limit:
                self._stop_trading(StopReason.WEEKLY_LOSS_LIMIT)
                return
            monthly_loss_limit = self.limits.max_monthly_loss * self.state.total_equity
            if abs(self.state.monthly_loss) >= monthly_loss_limit:
                self._stop_trading(StopReason.DRAWDOWN_LIMIT)
                return
            if self.state.current_drawdown >= self.limits.max_drawdown:
                self._stop_trading(StopReason.DRAWDOWN_LIMIT)
                return
            if self.state.consecutive_losses >= self.limits.max_consecutive_losses:
                self._stop_trading(StopReason.CONSECUTIVE_LOSSES)
                return
        except Exception as e:
            logger.error(f"Stop conditions check error: {e}")

    def _stop_trading(self, reason: StopReason):
        if not self.state.is_paused:
            self.state.is_paused = True
            self.state.stop_reason = reason.value
            self.state.stop_timestamp = datetime.now()
            self.state.pause_timestamp = datetime.now()
            self.state.reentry_phase = "ANALYSIS"
            self.state.reentry_start = datetime.now()
            logger.warning(f"⏸️ TRADING STOPPED: {reason.value}")

    def _check_reentry_conditions(self):
        try:
            if not self.state.is_paused:
                return
            if self.state.stop_reason == StopReason.USER_PAUSE.value:
                return
            if self.state.reentry_phase == "ANALYSIS":
                if self.state.reentry_start:
                    elapsed = (datetime.now() - self.state.reentry_start).total_seconds()
                    if elapsed >= 24 * 3600:
                        self._advance_reentry_phase()
                return
            if not self._market_conditions_improved():
                return
            if self.state.reentry_phase == "REDUCED_RISK":
                if self._test_phase_complete():
                    self._advance_reentry_phase()
            elif self.state.reentry_phase == "TESTING":
                if self._test_phase_complete():
                    self._advance_reentry_phase()
            elif self.state.reentry_phase == "GRADUAL":
                if self._test_phase_complete():
                    self._advance_reentry_phase()
            elif self.state.reentry_phase == "FULL":
                self.state.is_paused = False
                self.state.stop_reason = None
                self.state.pause_timestamp = None
                self.state.current_position_size_multiplier = 1.0
                logger.info("▶️ TRADING RESUMED - Full recovery")
        except Exception as e:
            logger.error(f"Re-entry check error: {e}")

    def _advance_reentry_phase(self):
        phases = ["ANALYSIS", "REDUCED_RISK", "TESTING", "GRADUAL", "FULL"]
        current_index = phases.index(self.state.reentry_phase)
        if current_index < len(phases) - 1:
            next_phase = phases[current_index + 1]
            self.state.reentry_phase = next_phase
            self.state.reentry_trades_tested = 0
            self.state.reentry_profitable = 0
            phase_data = self.reentry_phases.get(next_phase, {})
            self.state.current_position_size_multiplier = phase_data.get('position_multiplier', 0.25)
            logger.info(f"🔄 Re-entry phase: {next_phase}")

    def _test_phase_complete(self) -> bool:
        return self.state.reentry_trades_tested >= 3 and self.state.reentry_profitable >= 2

    def _market_conditions_improved(self) -> bool:
        if self.state.current_drawdown > self.limits.max_drawdown * 0.5:
            return False
        return True

    def _calculate_kelly(self):
        try:
            if self.total_trades < 20:
                self.kelly_multiplier = 0.25
                return
            recent_trades = self.trade_history[-50:] if self.trade_history else []
            if not recent_trades:
                self.kelly_multiplier = 0.25
                return
            wins = sum(1 for t in recent_trades if t.get('profit', 0) > 0)
            win_prob = wins / len(recent_trades) if recent_trades else 0.5
            profits = [t.get('profit', 0) for t in recent_trades if t.get('profit', 0) > 0]
            losses = [abs(t.get('profit', 0)) for t in recent_trades if t.get('profit', 0) < 0]
            avg_win = sum(profits) / len(profits) if profits else 0
            avg_loss = sum(losses) / len(losses) if losses else 1
            win_loss_ratio = avg_win / avg_loss if avg_loss > 0 else 1
            b = win_loss_ratio
            p = win_prob
            q = 1 - p
            if b > 0:
                kelly_fraction = (b * p - q) / b
            else:
                kelly_fraction = 0
            kelly_fraction = max(0, min(0.25, kelly_fraction))
            self.kelly_multiplier = kelly_fraction * 0.5
            self.kelly_history.append(kelly_fraction)
        except Exception as e:
            logger.error(f"Kelly calculation error: {e}")
            self.kelly_multiplier = 0.25

    def _calculate_adaptive_multipliers(self):
        try:
            if self.win_rate < 0.35:
                self.win_rate_adjustment = 0.5
            elif self.win_rate < 0.45:
                self.win_rate_adjustment = 0.75
            elif self.win_rate < 0.55:
                self.win_rate_adjustment = 1.0
            elif self.win_rate < 0.65:
                self.win_rate_adjustment = 1.25
            else:
                self.win_rate_adjustment = 1.5
            if self.profit_factor < 1.0:
                self.performance_adjustment = 0.5
            elif self.profit_factor < 1.5:
                self.performance_adjustment = 0.75
            elif self.profit_factor < 2.0:
                self.performance_adjustment = 1.0
            elif self.profit_factor < 3.0:
                self.performance_adjustment = 1.25
            else:
                self.performance_adjustment = 1.5
            self.adaptive_risk_multiplier = (self.win_rate_adjustment * self.performance_adjustment * (1 + self.kelly_multiplier))
            self.adaptive_risk_multiplier = max(0.25, min(2.0, self.adaptive_risk_multiplier))
        except Exception as e:
            logger.error(f"Adaptive multipliers error: {e}")

    def _update_risk_level(self):
        try:
            risk_value = self.limits.max_risk_per_trade * self.adaptive_risk_multiplier
            if risk_value <= 0.01:
                self.state.current_risk_level = "SAFE"
            elif risk_value <= 0.02:
                self.state.current_risk_level = "MODERATE"
            elif risk_value <= 0.03:
                self.state.current_risk_level = "AGGRESSIVE"
            else:
                self.state.current_risk_level = "EXTREME"
        except Exception as e:
            logger.error(f"Update risk level error: {e}")

    def calculate_position_size(self, symbol: str, entry_price: float, stop_loss: float, take_profit: float = None, account_balance: float = None) -> TradeRisk:
        try:
            if self.state.is_paused:
                return TradeRisk(symbol=symbol, action='HOLD')
            balance = account_balance or self.state.total_equity
            if balance <= 0:
                return TradeRisk()
            stop_distance = abs(entry_price - stop_loss)
            if stop_distance <= 0:
                stop_distance = 0.01
            base_risk = self.limits.max_risk_per_trade
            adaptive_risk = base_risk * self.adaptive_risk_multiplier
            adaptive_risk *= self.state.current_position_size_multiplier
            adaptive_risk = max(self.limits.risk_per_trade_min, min(self.limits.risk_per_trade_max, adaptive_risk))
            kelly_risk = adaptive_risk * (1 + self.kelly_multiplier)
            risk_amount = balance * kelly_risk
            position_size = risk_amount / stop_distance
            position_size = max(self.limits.min_position_size, min(self.limits.max_position_size, position_size))
            reward_ratio = 0.0
            if take_profit and entry_price:
                reward = abs(take_profit - entry_price)
                reward_ratio = reward / stop_distance if stop_distance > 0 else 0
            expected_profit = position_size * stop_distance * reward_ratio if reward_ratio > 0 else 0
            return TradeRisk(
                symbol=symbol,
                action='CALCULATED',
                entry_price=entry_price,
                stop_loss=stop_loss,
                take_profit=take_profit,
                position_size=position_size,
                risk_amount=risk_amount,
                risk_percent=kelly_risk * 100,
                reward_ratio=reward_ratio,
                expected_profit=expected_profit,
                kelly_fraction=self.kelly_multiplier,
                optimal_f=position_size / balance if balance > 0 else 0
            )
        except Exception as e:
            logger.error(f"Position size calculation error: {e}")
            return TradeRisk()

    def get_status(self) -> Dict:
        return {
            'is_paused': self.state.is_paused,
            'pause_reason': self.state.pause_reason,
            'stop_reason': self.state.stop_reason,
            'current_position_size_multiplier': self.state.current_position_size_multiplier,
            'reentry_phase': self.state.reentry_phase,
            'current_risk_level': self.state.current_risk_level,
            'adaptive_risk_multiplier': self.adaptive_risk_multiplier,
            'kelly_multiplier': self.kelly_multiplier,
            'current_drawdown': self.state.current_drawdown,
            'daily_loss': self.state.daily_loss,
            'weekly_loss': self.state.weekly_loss,
            'monthly_loss': self.state.monthly_loss,
            'consecutive_losses': self.state.consecutive_losses,
            'consecutive_wins': self.state.consecutive_wins,
            'total_trades': self.total_trades,
            'win_rate': self.win_rate,
            'profit_factor': self.profit_factor,
            'total_profit': self.total_profit
        }

    def can_trade(self) -> bool:
        return not self.state.is_paused

    def get_risk_limits(self) -> Dict:
        return {
            'max_risk_per_trade': self.limits.max_risk_per_trade * self.adaptive_risk_multiplier,
            'max_daily_loss': self.limits.max_daily_loss,
            'max_weekly_loss': self.limits.max_weekly_loss,
            'max_monthly_loss': self.limits.max_monthly_loss,
            'max_drawdown': self.limits.max_drawdown,
            'max_consecutive_losses': self.limits.max_consecutive_losses,
            'max_positions': self.limits.max_positions,
            'max_position_size': self.limits.max_position_size,
            'kelly_multiplier': self.kelly_multiplier
        }

    def force_resume(self):
        self.state.is_paused = False
        self.state.pause_reason = None
        self.state.stop_reason = None
        self.state.reentry_phase = "FULL"
        self.state.current_position_size_multiplier = 1.0
        logger.warning("⚠️ FORCE RESUME - Admin override")

    def _save_state(self):
        try:
            import os
            os.makedirs("data/risk", exist_ok=True)
            state_data = {
                'total_profit': self.total_profit,
                'total_trades': self.total_trades,
                'winning_trades': self.winning_trades,
                'losing_trades': self.losing_trades,
                'peak_equity': self.state.peak_equity,
                'adaptive_risk_multiplier': self.adaptive_risk_multiplier,
                'kelly_multiplier': self.kelly_multiplier,
                'current_risk_level': self.state.current_risk_level,
                'win_rate': self.win_rate,
                'profit_factor': self.profit_factor,
                'limits': {
                    'max_risk_per_trade': self.limits.max_risk_per_trade,
                    'max_daily_loss': self.limits.max_daily_loss,
                    'max_weekly_loss': self.limits.max_weekly_loss,
                    'max_monthly_loss': self.limits.max_monthly_loss,
                    'max_drawdown': self.limits.max_drawdown,
                    'max_consecutive_losses': self.limits.max_consecutive_losses,
                    'max_position_size': self.limits.max_position_size
                }
            }
            with open("data/risk/state.json", "w") as f:
                json.dump(state_data, f, indent=2)
        except Exception as e:
            logger.error(f"Save state error: {e}")

    def _load_state(self):
        try:
            import os
            if os.path.exists("data/risk/state.json"):
                with open("data/risk/state.json", "r") as f:
                    state_data = json.load(f)
                    self.total_profit = state_data.get('total_profit', 0.0)
                    self.total_trades = state_data.get('total_trades', 0)
                    self.winning_trades = state_data.get('winning_trades', 0)
                    self.losing_trades = state_data.get('losing_trades', 0)
                    self.state.peak_equity = state_data.get('peak_equity', 0.0)
                    self.adaptive_risk_multiplier = state_data.get('adaptive_risk_multiplier', 1.0)
                    self.kelly_multiplier = state_data.get('kelly_multiplier', 0.25)
                    self.win_rate = state_data.get('win_rate', 0.5)
                    self.profit_factor = state_data.get('profit_factor', 1.0)
                    self.state.current_risk_level = state_data.get('current_risk_level', 'MODERATE')
                    limits_data = state_data.get('limits', {})
                    if limits_data:
                        self.limits.max_risk_per_trade = limits_data.get('max_risk_per_trade', 0.02)
                        self.limits.max_daily_loss = limits_data.get('max_daily_loss', 0.05)
                        self.limits.max_weekly_loss = limits_data.get('max_weekly_loss', 0.10)
                        self.limits.max_monthly_loss = limits_data.get('max_monthly_loss', 0.20)
                        self.limits.max_drawdown = limits_data.get('max_drawdown', 0.15)
                        self.limits.max_consecutive_losses = limits_data.get('max_consecutive_losses', 3)
                        self.limits.max_position_size = limits_data.get('max_position_size', 5000)
                logger.info("📂 Risk state loaded")
        except Exception as e:
            logger.warning(f"Load state error (starting fresh): {e}")