logger.addHandler(debug_handler)


class MarketRegime(Enum):
    """Market regimes detected"""
    STRONG_TREND = "strong_trend"      # ADX > 40
    WEAK_TREND = "weak_trend"          # ADX 25-40
    RANGING = "ranging"                # ADX < 25
    HIGH_VOLATILITY = "high_volatility" # ATR > 2x average
    LOW_VOLATILITY = "low_volatility"  # ATR < 0.5x average
    NEWS_IMPACT = "news_impact"        # Major news
    LOW_LIQUIDITY = "low_liquidity"    # Wide spreads


class StrategyType(Enum):
    """Strategies to use based on regime"""
    TREND_FOLLOWING = "trend_following"    # Strong trends
    MEAN_REVERSION = "mean_reversion"      # Ranging markets
    GRID_SCALPING = "grid_scalping"        # Sideways with volatility
    DEFENSIVE = "defensive"                # High volatility
    AGGRESSIVE = "aggressive"              # Low volatility
    NEWS_PROTOCOL = "news_protocol"        # News events
    PAUSED = "paused"                      # Low liquidity
    ADAPTIVE = "adaptive"                  # Hybrid approach


