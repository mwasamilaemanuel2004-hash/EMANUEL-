                    'score': self.macro_score,
                    'confidence': self.macro_confidence,
                    'signal': self.current_signal.value,
                    'momentum': self.signal_momentum,
                    'regime': self.current_regime
                },
                'factors': self.factor_scores,
                'recent_signals': list(self.signal_history)[-10:] if self.signal_history else [],
                'macro_data': self.macro_data,
                'timestamp': datetime.now().isoformat()
            }
        except Exception as e:
            self._log_debug(f"Error in get_performance_report: {str(e)}", "error")
            return {'error': str(e)}