    sr_confidence_threshold: float = 0.6
    
    # Loss zone detection
    loss_zone_lookback: int = 30
    loss_zone_threshold: float = 0.3  # 30% loss rate
    
    # False breakout detection
    fb_lookback: int = 20
    fb_volume_threshold: float = 1.5
    fb_confidence_threshold: float = 0.6
    
    # Momentum failure
    momentum_failure_threshold: float = 0.3
    momentum_lookback: int = 10
    
    # Liquidity detection
    liquidity_threshold: float = 0.3
    spread_expansion_threshold: float = 2.0
    
    # Reversal detection
    reversal_lookback: int = 5
    reversal_threshold: float = 0.5
    
    # Pre-trade gate
    min_risk_score: float = 0.6
    max_loss_probability: float = 0.4
    
    # Recovery
    recovery_step: float = 0.25
    max_recovery_days: int = 7
    
    # History limits for memory optimization
    max_history_size: int = 5000
    
    # Auto-correction thresholds
    auto_correction_threshold: float = 5.0  # 5% deviation
    
    # Debug mode
    debug_mode: bool = True


