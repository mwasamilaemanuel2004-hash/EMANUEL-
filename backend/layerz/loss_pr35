                'risk_per_trade': self.config.risk_per_trade,
                'min_lp_score': self.config.min_lp_score,
                'is_paused': self.is_paused,
                'pause_remaining': round((self.pause_until - datetime.now()).total_seconds() / 60) if self.is_paused else 0,
                'current_regime': self.current_regime,
