    CAUTION = "caution"        # Increased protection
    WARNING = "warning"        # High protection
    CRITICAL = "critical"      # Maximum protection
    EMERGENCY = "emergency"    # Stop all trading
    RECOVERY = "recovery"      # Recovering from losses


