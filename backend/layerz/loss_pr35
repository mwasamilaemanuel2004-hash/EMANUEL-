    """Configuration for Loss Prevention - ULTIMATE BALANCED"""
    
    # Risk per trade (0.5% - 2%)
    risk_per_trade: float = 1.0  # 1% default
    
    # Daily loss limit (1% - 4%)
    daily_loss_limit: float = 2.0  # 2% default
    
    # Monthly drawdown limit (3% - 10%)
    monthly_drawdown_limit: float = 5.0  # 5% default
    
    # Consecutive losses before pause
    max_consecutive_losses: int = 3
    
    # Pause duration after consecutive losses (hours)
    pause_duration_hours: int = 2
    
    # Minimum SL multiplier (0.5 - 2.0)
    min_sl_multiplier: float = 0.8
    
    # Maximum SL multiplier (1.0 - 3.0)
    max_sl_multiplier: float = 2.0
    
    # Minimum TP multiplier (1.5 - 4.0)
    min_tp_multiplier: float = 2.0
    
    # Maximum TP multiplier (2.0 - 6.0)
    max_tp_multiplier: float = 5.0
    
    # Max positions at once
    max_positions: int = 5
    
    # Correlation limit between positions
    correlation_limit: float = 0.7
    
    # Loss Prevention Score minimum for entry
    min_lp_score: float = 65.0  # 65-80 range
    
    # Emergency volatility trigger (ATR multiplier)
    emergency_volatility_trigger: float = 3.0
    
    # Recovery mode - reduce risk after drawdown
    recovery_risk_reduction: float = 0.5  # Reduce by 50%
    
    # Recovery threshold
    recovery_threshold: float = 5.0  # 5% drawdown triggers recovery
    
    # Support/Resistance detection
    sr_lookback: int = 50
