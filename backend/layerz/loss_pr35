    def get_performance_report(self) -> Dict[str, Any]:
        """Get detailed performance report"""
        try:
            total_checked = self.performance['total_trades_checked']
            approval_rate = (self.performance['trades_approved'] / max(1, total_checked)) * 100
            
            return {
                'mode': self.mode.value,
                'total_trades_checked': total_checked,
                'trades_approved': self.performance['trades_approved'],
                'trades_rejected': self.performance['trades_rejected'],
                'approval_rate': approval_rate,
                'total_loss_prevented': self.performance['total_loss_prevented'],
                'avg_lp_score': self.performance['avg_lp_score'],
                'consecutive_wins': self.consecutive_wins,
                'consecutive_losses': self.consecutive_losses,
                'daily_pnl': self.daily_pnl,
                'monthly_pnl': self.monthly_pnl,
                'current_drawdown': abs(self.monthly_drawdown),
                'emergency_blocks': self.performance['emergency_blocks'],
                'recovery_events': self.performance['recovery_events'],
                'correction_count': self.performance['correction_count'],
                'is_paused': self.is_paused,
                'timestamp': datetime.now().isoformat()
            }
        except Exception as e:
            self._log_debug(f"Error in get_performance_report: {str(e)}", "error")
            return {'error': str(e)}