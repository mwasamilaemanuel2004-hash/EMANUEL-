"""
LAYER +24: ADAPTIVE TRADE FREQUENCY ENGINE (ULTIMATE OPTIMIZED)
Purpose: Dynamically adjust trade frequency based on market conditions and opportunity quality.
Balance: GOLDILOCKS - Not too frequent (overtrading) and not too infrequent (missed opportunities).

KEY IMPROVEMENTS:
- No fixed minimum trade count
- No forced trading
- Dynamic trade frequency based on market conditions
- Opportunity-based trading (quality over quantity)
- Adaptive cooldown between trades
- Market regime-based frequency adjustment
- Performance-based frequency optimization
- Auto-pause during dangerous conditions
- Self-correcting frequency thresholds
"""

import numpy as np
import pandas as pd
from datetime import datetime, timedelta
from typing import Dict, List, Optional, Tuple, Any, Union
from enum import Enum
from dataclasses import dataclass, field
import logging
import json
import time
from collections import deque
import threading

# Configure logging
logger = logging.getLogger(__name__)

debug_handler = logging.FileHandler('logs/trade_frequency_debug.log')
debug_handler.setLevel(logging.DEBUG)
debug_formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')
debug_handler.setFormatter(debug_formatter)
logger.addHandler(debug_handler)


class FrequencyMode(Enum):
    """Trade frequency modes"""
    AGGRESSIVE = "aggressive"      # High frequency
    NORMAL = "normal"              # Medium frequency
    CONSERVATIVE = "conservative"  # Low frequency
    PAUSED = "paused"              # No trading
    ADAPTIVE = "adaptive"          # Auto-adjust


@dataclass
class TradeFrequencyConfig:
    """Configuration for Trade Frequency Engine - OPTIMIZED"""
    
    # FREQUENCY LIMITS
    max_trades_per_day: int = 20
    min_trades_per_day: int = 0          # No minimum - can be 0
    max_trades_per_hour: int = 5
    max_trades_per_minute: int = 2
    
    # COOLDOWN
    cooldown_seconds_min: int = 30
    cooldown_seconds_max: int = 300
    
    # ADAPTIVE PARAMETERS
    frequency_multipliers: Dict[str, float] = field(default_factory=lambda: {
        'strong_trend': 1.8,
        'weak_trend': 1.2,
        'ranging': 0.6,
        'high_volatility': 0.4,
        'low_volatility': 1.5,
        'news_impact': 0.2,
        'low_liquidity': 0.1
    })
    
    # OPPORTUNITY THRESHOLDS
    min_opportunity_score: float = 0.55
    max_opportunity_score: float = 0.95
    
    # PERFORMANCE ADJUSTMENT
    performance_window: int = 50
    adjustment_step: float = 0.05
    max_adjustment: float = 0.50
    
    # DEBUG
    debug_mode: bool = True
    max_history_size: int = 10000


class TradeFrequencyEngine:
    """
    Trade Frequency Engine - Adaptively adjusts trade frequency
    """
    
    def __init__(self, config: Optional[TradeFrequencyConfig] = None):
        self.config = config or TradeFrequencyConfig()
        self.debug_mode = self.config.debug_mode
        
        # PERFORMANCE TRACKING
        self.performance = {
            'total_trades': 0,
            'frequency_adjustments': 0,
            'cooldown_activations': 0,
            'pauses_triggered': 0,
            'avg_trades_per_day': 0.0,
            'peak_trades_per_day': 0
        }
        
        # FREQUENCY STATE
        self.mode = FrequencyMode.ADAPTIVE
        self.current_frequency = 1.0
        self.trades_today = 0
        self.trades_this_hour = 0
        self.trades_this_minute = 0
        self.last_trade_time = None
        
        # COOLDOWN STATE
        self.cooldown_until = None
        self.is_cooldown = False
        self.cooldown_duration = 0
        
        # HISTORY
        self.trade_history = deque(maxlen=self.config.max_history_size)
        self.frequency_history = deque(maxlen=1000)
        self.opportunity_history = deque(maxlen=1000)
        
        # TRACKING
        self.daily_reset_time = datetime.now()
        self.hourly_reset_time = datetime.now()
        self.minute_reset_time = datetime.now()
        
        # PERFORMANCE
        self.win_rate_history = deque(maxlen=self.config.performance_window)
        self.profit_factor_history = deque(maxlen=self.config.performance_window)
        
        # MARKET CONTEXT
        self.current_regime = "unknown"
        self.current_volatility = 0.0
        
        # LOCK
        self._lock = threading.Lock()
        
        self._log_debug("Trade Frequency Engine initialized - ADAPTIVE MODE")
        logger.info("Trade Frequency Engine initialized - ADAPTIVE MODE")
    
    def _log_debug(self, message: str, level: str = "debug") -> None:
        """Debug logging with timestamp"""
        if self.debug_mode:
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
            log_msg = f"[DEBUG {timestamp}] {message}"
            if level == "info":
                logger.info(log_msg)
            elif level == "warning":
                logger.warning(log_msg)
            elif level == "error":
                logger.error(log_msg)
            else:
                logger.debug(log_msg)
    
    def update_market_data(self, market_data: Dict[str, Any]) -> None:
        """Update market context and adapt frequency"""
        try:
            if not isinstance(market_data, dict):
                return
            
            self.current_regime = market_data.get('regime', 'unknown') or 'unknown'
            self.current_volatility = market_data.get('volatility', 0.0) or 0.0
            
            # Adapt frequency based on market conditions
            self._adapt_frequency()
            
            # Reset daily counters if needed
            self._reset_counters()
            
            self._log_debug(f"Market context: regime={self.current_regime}, frequency={self.current_frequency:.2f}")
            
        except Exception as e:
            self._log_debug(f"Error in update_market_data: {str(e)}", "error")
    
    def _adapt_frequency(self) -> None:
        """Adapt trade frequency based on market conditions"""
        try:
            # Get base frequency multiplier from regime
            regime_multiplier = self.config.frequency_multipliers.get(
                self.current_regime, 1.0
            )
            
            # Adjust for volatility
            volatility_multiplier = 1.0
            if self.current_volatility > 3.0:
                volatility_multiplier = 0.2
            elif self.current_volatility > 2.0:
                volatility_multiplier = 0.5
            elif self.current_volatility < 0.5:
                volatility_multiplier = 1.5
            
            # Adjust for performance
            performance_multiplier = self._get_performance_multiplier()
            
            # Calculate final frequency
            self.current_frequency = regime_multiplier * volatility_multiplier * performance_multiplier
            
            # Ensure limits
            self.current_frequency = max(0.1, min(3.0, self.current_frequency))
            
            # Update mode
            if self.current_frequency < 0.3:
                self.mode = FrequencyMode.CONSERVATIVE
            elif self.current_frequency > 1.5:
                self.mode = FrequencyMode.AGGRESSIVE
            elif self.current_frequency < 0.1:
                self.mode = FrequencyMode.PAUSED
            else:
                self.mode = FrequencyMode.ADAPTIVE
            
            self.performance['frequency_adjustments'] += 1
            self.frequency_history.append({
                'timestamp': datetime.now(),
                'frequency': self.current_frequency,
                'mode': self.mode.value,
                'regime': self.current_regime
            })
            
        except Exception as e:
            self._log_debug(f"Error in _adapt_frequency: {str(e)}", "error")
    
    def _get_performance_multiplier(self) -> float:
        """Get multiplier based on recent performance"""
        try:
            if len(self.trade_history) < 10:
                return 1.0
            
            recent_trades = list(self.trade_history)[-self.config.performance_window:]
            wins = sum(1 for t in recent_trades if t.get('won', False))
            win_rate = wins / len(recent_trades) if recent_trades else 0.5
            
            # Calculate total profit/loss
            total_profit = sum(t.get('pnl', 0) for t in recent_trades if t.get('pnl', 0) > 0)
            total_loss = abs(sum(t.get('pnl', 0) for t in recent_trades if t.get('pnl', 0) < 0))
            profit_factor = total_profit / total_loss if total_loss > 0 else 10.0
            
            # Store for tracking
            self.win_rate_history.append(win_rate)
            self.profit_factor_history.append(profit_factor)
            
            # Calculate multiplier
            if win_rate > 0.6 and profit_factor > 2.0:
                return 1.3  # Increase frequency
            elif win_rate < 0.4 or profit_factor < 1.2:
                return 0.6  # Decrease frequency
            else:
                return 1.0
            
        except Exception as e:
            self._log_debug(f"Error in _get_performance_multiplier: {str(e)}", "error")
            return 1.0
    
    def _reset_counters(self) -> None:
        """Reset daily/hourly/minute counters"""
        try:
            now = datetime.now()
            
            # Daily reset
            if now.date() > self.daily_reset_time.date():
                self.trades_today = 0
                self.daily_reset_time = now
                self._log_debug("Daily trade counter reset")
            
            # Hourly reset
            if now.hour > self.hourly_reset_time.hour or now.day > self.hourly_reset_time.day:
                self.trades_this_hour = 0
                self.hourly_reset_time = now
            
            # Minute reset
            if now.minute > self.minute_reset_time.minute or now.hour > self.minute_reset_time.hour:
                self.trades_this_minute = 0
                self.minute_reset_time = now
            
        except Exception as e:
            self._log_debug(f"Error in _reset_counters: {str(e)}", "error")
    
    def can_trade(self, opportunity_score: float = 0.5) -> Tuple[bool, str, int]:
        """
        Check if trading is allowed based on frequency rules
        Returns: (can_trade, reason, cooldown_seconds)
        """
        try:
            # Check if paused
            if self.mode == FrequencyMode.PAUSED:
                return False, "Trading paused - dangerous conditions", 0
            
            # Check cooldown
            if self.is_cooldown:
                if datetime.now() < self.cooldown_until:
                    remaining = (self.cooldown_until - datetime.now()).total_seconds()
                    return False, f"Cooldown: {remaining:.0f}s remaining", int(remaining)
                else:
                    self.is_cooldown = False
                    self.cooldown_until = None
            
            # Check daily limit
            max_trades = int(self.config.max_trades_per_day * self.current_frequency)
            if self.trades_today >= max_trades:
                return False, f"Daily limit reached: {self.trades_today}/{max_trades}", 0
            
            # Check hourly limit
            max_hourly = int(self.config.max_trades_per_hour * self.current_frequency)
            if self.trades_this_hour >= max_hourly:
                return False, f"Hourly limit reached: {self.trades_this_hour}/{max_hourly}", 0
            
            # Check minute limit
            max_minute = int(self.config.max_trades_per_minute * self.current_frequency)
            if self.trades_this_minute >= max_minute:
                return False, f"Minute limit reached: {self.trades_this_minute}/{max_minute}", 0
            
            # Check opportunity quality
            if opportunity_score < self.config.min_opportunity_score:
                return False, f"Opportunity score too low: {opportunity_score:.2f}", 0
            
            # Check if opportunity is excellent (adjust cooldown)
            cooldown_seconds = self._calculate_cooldown(opportunity_score)
            
            return True, "Trading allowed", cooldown_seconds
            
        except Exception as e:
            self._log_debug(f"Error in can_trade: {str(e)}", "error")
            return False, f"Error: {str(e)}", 0
    
    def _calculate_cooldown(self, opportunity_score: float) -> int:
        """Calculate cooldown duration based on opportunity quality"""
        try:
            # Base cooldown from config
            base_cooldown = self.config.cooldown_seconds_min
            
            # Adjust based on frequency
            freq_adjustment = 1.0 / max(0.1, self.current_frequency)
            
            # Adjust based on opportunity score (higher score = shorter cooldown)
            score_adjustment = 1.0 - (opportunity_score * 0.5)
            
            # Calculate final cooldown
            cooldown = base_cooldown * freq_adjustment * score_adjustment
            
            # Ensure limits
            cooldown = max(self.config.cooldown_seconds_min, min(self.config.cooldown_seconds_max, cooldown))
            
            return int(cooldown)
            
        except Exception as e:
            self._log_debug(f"Error in _calculate_cooldown: {str(e)}", "error")
            return self.config.cooldown_seconds_min
    
    def record_trade(self, trade_result: Dict[str, Any]) -> None:
        """Record a trade and update statistics"""
        try:
            if not isinstance(trade_result, dict):
                return
            
            # Update counters
            self.trades_today += 1
            self.trades_this_hour += 1
            self.trades_this_minute += 1
            
            # Record trade
            self.trade_history.append({
                'timestamp': datetime.now(),
                'result': trade_result,
                'won': trade_result.get('pnl', 0) > 0,
                'pnl': trade_result.get('pnl', 0)
            })
            
            # Update performance
            self.performance['total_trades'] += 1
            if self.trades_today > self.performance['peak_trades_per_day']:
                self.performance['peak_trades_per_day'] = self.trades_today
            
            # Calculate average trades per day
            if len(self.trade_history) > 0:
                days = max(1, (datetime.now() - self.trade_history[0]['timestamp']).days)
                self.performance['avg_trades_per_day'] = len(self.trade_history) / days
            
            # Update cooldown
            opportunity_score = trade_result.get('opportunity_score', 0.5)
            cooldown_seconds = self._calculate_cooldown(opportunity_score)
            
            self.is_cooldown = True
            self.cooldown_until = datetime.now() + timedelta(seconds=cooldown_seconds)
            self.cooldown_duration = cooldown_seconds
            self.performance['cooldown_activations'] += 1
            
            self._log_debug(f"Trade recorded: {self.trades_today} trades today, cooldown: {cooldown_seconds}s")
            
        except Exception as e:
            self._log_debug(f"Error in record_trade: {str(e)}", "error")
    
    def get_frequency_status(self) -> Dict[str, Any]:
        """Get current frequency status"""
        try:
            return {
                'mode': self.mode.value,
                'current_frequency': self.current_frequency,
                'trades_today': self.trades_today,
                'trades_this_hour': self.trades_this_hour,
                'trades_this_minute': self.trades_this_minute,
                'max_trades_per_day': int(self.config.max_trades_per_day * self.current_frequency),
                'is_cooldown': self.is_cooldown,
                'cooldown_remaining': max(0, (self.cooldown_until - datetime.now()).total_seconds()) if self.is_cooldown else 0,
                'win_rate': sum(1 for t in self.trade_history if t.get('won', False)) / max(1, len(self.trade_history)),
                'avg_trades_per_day': self.performance['avg_trades_per_day'],
                'current_regime': self.current_regime,
                'current_volatility': self.current_volatility,
                'timestamp': datetime.now().isoformat()
            }
        except Exception as e:
            self._log_debug(f"Error in get_frequency_status: {str(e)}", "error")
            return {'status': 'ERROR', 'error': str(e)}
    
    def get_performance_report(self) -> Dict[str, Any]:
        """Get detailed performance report"""
        try:
            total_trades = len(self.trade_history)
            wins = sum(1 for t in self.trade_history if t.get('won', False))
            win_rate = wins / max(1, total_trades)
            
            total_profit = sum(t.get('pnl', 0) for t in self.trade_history if t.get('pnl', 0) > 0)
            total_loss = abs(sum(t.get('pnl', 0) for t in self.trade_history if t.get('pnl', 0) < 0))
            profit_factor = total_profit / total_loss if total_loss > 0 else 10.0
            
            return {
                'summary': {
                    'total_trades': total_trades,
                    'win_rate': win_rate,
                    'profit_factor': profit_factor,
                    'avg_trades_per_day': self.performance['avg_trades_per_day'],
                    'peak_trades_per_day': self.performance['peak_trades_per_day']
                },
                'frequency': {
                    'current_mode': self.mode.value,
                    'current_multiplier': self.current_frequency,
                    'adjustments': self.performance['frequency_adjustments'],
                    'cooldowns': self.performance['cooldown_activations'],
                    'pauses': self.performance['pauses_triggered']
                },
                'recent_frequency': list(self.frequency_history)[-20:] if self.frequency_history else [],
                'timestamp': datetime.now().isoformat()
            }
        except Exception as e:
            self._log_debug(f"Error in get_performance_report: {str(e)}", "error")
            return {'error': str(e)}