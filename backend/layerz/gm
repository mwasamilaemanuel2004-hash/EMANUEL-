    def _log_debug(self, message: str, level: str = "debug") -> None:
        """Debug logging with timestamp and level"""
        if self.debug_mode:
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
            log_msg = f"[DEBUG {timestamp}] {message}"
            if level == "info":
                logger.info(log_msg)
            elif level == "warning":
                logger.warning(log_msg)
            elif level == "error":
                logger.error(log_msg)
            else:
                logger.debug(log_msg)
    
    def _safe_get(self, data: Dict, key: str, default: Any = None) -> Any:
        """Safe get with error handling"""
        try:
            return data.get(key, default) if data else default
        except Exception as e:
            self._log_debug(f"Safe get error for {key}: {str(e)}", "warning")
            return default
    
    def update_macro_data(self, macro_data: Dict[str, Any]) -> None:
        """Update macro data and analyze signals with confidence"""
        try:
            if not isinstance(macro_data, dict):
                self._log_debug("Invalid macro_data: not a dict", "warning")
                return
            
            self.macro_data = macro_data.copy()
            
            # Update current regime and volatility with safe gets
            self.current_regime = self._safe_get(macro_data, 'regime', 'unknown')
            self.current_volatility = self._safe_get(macro_data, 'volatility', 0.0)
            
            # ============================================================
            # ANALYZE ALL MACRO FACTORS (10 FACTORS)
            # ============================================================
            self._analyze_interest_rates()
            self._analyze_yield_curve()
            self._analyze_geopolitical_risk()
            self._analyze_liquidity()
            self._analyze_economic_indicators()
            self._analyze_confidence()
            
            # ============================================================
            # DETECT ECONOMIC CYCLE
            # ============================================================
            if self.config.cycle_detection_enabled:
                self._detect_economic_cycle()
            
            # ============================================================
            # CALCULATE MACRO SCORE (WEIGHTED)
            # ============================================================
            self._calculate_macro_score()
            
            # ============================================================
            # CALCULATE MACRO CONFIDENCE
            # ============================================================
            self._calculate_macro_confidence()
            
            # ============================================================
            # DETERMINE MACRO SIGNAL
            # ============================================================
            self._determine_macro_signal()
            
            # ============================================================
            # UPDATE MACRO CORRELATIONS
            # ============================================================
            self._update_macro_correlations()
            
            # ============================================================
            # STORE HISTORY
            # ============================================================
            self.macro_history.append({
                'timestamp': datetime.now(),
                'macro_score': self.macro_score,
                'signal': self.current_signal.value if self.current_signal else 'unknown',
                'confidence': self.macro_confidence,
                'cycle': self.current_cycle.value if hasattr(self.current_cycle, 'value') else 'neutral',
                'data': macro_data,
                'factor_scores': self.factor_scores.copy()
            })
            
            self.performance['total_checks'] += 1
            
            self._log_debug(f"Macro score: {self.macro_score:.2f}, signal: {self.current_signal.value if self.current_signal else 'unknown'}, confidence: {self.macro_confidence:.2f}", "info")
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in update_macro_data: {str(e)}", "error")
    
    def _analyze_interest_rates(self) -> None:
        """Analyze interest rate differentials with momentum"""
        try:
            rates = self._safe_get(self.macro_data, 'interest_rates', {})
            if not rates:
                self.factor_scores['interest_rates'] = 50.0
                return
            
            # Key rates with fallbacks
            fed_rate = self._safe_get(rates, 'fed', 0.0)
            ecb_rate = self._safe_get(rates, 'ecb', 0.0)
            boj_rate = self._safe_get(rates, 'boj', 0.0)
            boe_rate = self._safe_get(rates, 'boe', 0.0)
            
            # Calculate differentials
            us_eu_diff = fed_rate - ecb_rate
            us_jp_diff = fed_rate - boj_rate
            us_uk_diff = fed_rate - boe_rate
            
            # Calculate momentum
            prev_diff = self._safe_get(self.macro_data, 'prev_rate_differentials', {})
            us_eu_momentum = us_eu_diff - self._safe_get(prev_diff, 'us_eu', us_eu_diff)
            
            # Store
            if 'rate_differentials' not in self.macro_data:
                self.macro_data['rate_differentials'] = {}
            self.macro_data['rate_differentials'].update({
                'us_eu': us_eu_diff,
                'us_jp': us_jp_diff,
                'us_uk': us_uk_diff,
                'us_eu_momentum': us_eu_momentum
            })
            
            # Calculate factor score
            diff_score = max(0, min(100, 50.0 + (us_eu_diff * 20)))
            momentum_score = max(0, min(100, 50.0 + (us_eu_momentum * 100)))
            
            self.factor_scores['interest_rates'] = (diff_score * 0.7) + (momentum_score * 0.3)
            self.performance['interest_updates'] += 1
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in _analyze_interest_rates: {str(e)}", "error")
            self.factor_scores['interest_rates'] = 50.0
    
    def _analyze_yield_curve(self) -> None:
        """Analyze yield curve with inversion and steepness"""
        try:
            yields = self._safe_get(self.macro_data, 'yield_curve', {})
            if not yields:
                self.factor_scores['yield_curve'] = 50.0
                return
            
            # Key yields with fallbacks
            two_year = self._safe_get(yields, '2y', 0.0)
            ten_year = self._safe_get(yields, '10y', 0.0)
            thirty_year = self._safe_get(yields, '30y', 0.0)
            
            # Calculate spreads
            two_ten_spread = ten_year - two_year
            ten_thirty_spread = thirty_year - ten_year
            
            # Determine inversion and steepness
            is_inverted = two_ten_spread < self.config.yield_curve_inversion_threshold
            is_steep = two_ten_spread > self.config.yield_curve_steep_threshold
            
            if 'yield_curve' not in self.macro_data:
                self.macro_data['yield_curve'] = {}
            self.macro_data['yield_curve'].update({
                'two_ten_spread': two_ten_spread,
                'ten_thirty_spread': ten_thirty_spread,
                'is_inverted': is_inverted,
                'is_steep': is_steep
            })
            
            # Calculate factor score
            if is_inverted:
                score = 20.0
            elif is_steep:
                score = 60.0
            else:
                score = max(0, min(100, 50.0 + (two_ten_spread * 20)))
            
            self.factor_scores['yield_curve'] = score
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in _analyze_yield_curve: {str(e)}", "error")
            self.factor_scores['yield_curve'] = 50.0
    
    def _analyze_geopolitical_risk(self) -> None:
        """Analyze geopolitical risk with momentum"""
        try:
            risk = self._safe_get(self.macro_data, 'geopolitical_risk', 0.0)
            prev_risk = self._safe_get(self.macro_data, 'prev_geopolitical_risk', risk)
            
            risk_momentum = risk - prev_risk
            
            if risk > self.config.geopolitical_risk_threshold:
                self.performance['geopolitical_events'] += 1
                self._log_debug(f"Geopolitical risk detected: {risk:.2f}", "warning")
            
            self.macro_data['geopolitical_risk'] = risk
            self.macro_data['geopolitical_momentum'] = risk_momentum
            
            # Calculate factor score
            score = max(0, min(100, 100.0 - (risk * 100) - (risk_momentum * 100)))
            self.factor_scores['geopolitical'] = score
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in _analyze_geopolitical_risk: {str(e)}", "error")
            self.factor_scores['geopolitical'] = 50.0
    
    def _analyze_liquidity(self) -> None:
        """Analyze global liquidity with trends"""
        try:
            liquidity = self._safe_get(self.macro_data, 'liquidity', {})
            if not liquidity:
                self.factor_scores['liquidity'] = 50.0
                return
            
            # Key metrics with fallbacks
            central_bank_balance = self._safe_get(liquidity, 'central_bank_balance', 0.0)
            m2_supply = self._safe_get(liquidity, 'm2_supply', 0.0)
            qe_status = self._safe_get(liquidity, 'qe_status', 'neutral')
            
            # Previous values
            prev_balance = self._safe_get(self.macro_data, 'prev_central_bank_balance', central_bank_balance)
            balance_change = central_bank_balance - prev_balance
            
            if 'liquidity' not in self.macro_data:
                self.macro_data['liquidity'] = {}
            self.macro_data['liquidity'].update({
                'central_bank_balance': central_bank_balance,
                'm2_supply': m2_supply,
                'qe_status': qe_status,
                'balance_change': balance_change
            })
            
            # Calculate factor score
            balance_score = max(0, min(100, 50.0 + (balance_change * 10)))
            
            if qe_status == 'expanding':
                qe_score = 70.0
            elif qe_status == 'tapering':
                qe_score = 30.0
            else:
                qe_score = 50.0
            
            self.factor_scores['liquidity'] = (balance_score + qe_score) / 2
            self.performance['liquidity_changes'] += 1
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in _analyze_liquidity: {str(e)}", "error")
            self.factor_scores['liquidity'] = 50.0
    
    def _analyze_economic_indicators(self) -> None:
        """Analyze economic indicators with momentum"""
        try:
            indicators = self._safe_get(self.macro_data, 'economic_indicators', {})
            if not indicators:
                self.factor_scores['gdp_growth'] = 50.0
                self.factor_scores['inflation'] = 50.0
                self.factor_scores['employment'] = 50.0
                return
            
            # Key indicators with fallbacks
            gdp_growth = self._safe_get(indicators, 'gdp_growth', 0.0)
            inflation = self._safe_get(indicators, 'inflation', 0.0)
            unemployment = self._safe_get(indicators, 'unemployment', 0.0)
            
            # Previous values
            prev_gdp = self._safe_get(self.macro_data, 'prev_gdp_growth', gdp_growth)
            prev_inflation = self._safe_get(self.macro_data, 'prev_inflation', inflation)
            prev_unemployment = self._safe_get(self.macro_data, 'prev_unemployment', unemployment)
            
            gdp_momentum = gdp_growth - prev_gdp
            inflation_momentum = inflation - prev_inflation
            employment_momentum = prev_unemployment - unemployment
            
            if 'economic_indicators' not in self.macro_data:
                self.macro_data['economic_indicators'] = {}
            self.macro_data['economic_indicators'].update({
                'gdp_growth': gdp_growth,
                'inflation': inflation,
                'unemployment': unemployment,
                'gdp_momentum': gdp_momentum,
                'inflation_momentum': inflation_momentum,
                'employment_momentum': employment_momentum
            })
            
            # GDP score
            gdp_score = max(0, min(100, 50.0 + (gdp_growth * 100) + (gdp_momentum * 50)))
            
            # Inflation score
            inflation_score = max(0, min(100, 100.0 - (inflation * 100) - (inflation_momentum * 50)))
            
            # Employment score
            employment_score = max(0, min(100, 100.0 - (unemployment * 100) + (employment_momentum * 50)))
            
            self.factor_scores['gdp_growth'] = gdp_score
            self.factor_scores['inflation'] = inflation_score
            self.factor_scores['employment'] = employment_score
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in _analyze_economic_indicators: {str(e)}", "error")
            self.factor_scores['gdp_growth'] = 50.0
            self.factor_scores['inflation'] = 50.0
            self.factor_scores['employment'] = 50.0
    
