    def get_macro_recommendation(self) -> Dict[str, Any]:
        """Get macro-based trading recommendation with error handling"""
        try:
            signal = self.current_signal
            confidence = self.macro_confidence
            cycle = self.current_cycle
            
            # Default recommendation
            action = "HOLD"
            reason = "Neutral macro environment"
            risk_adjustment = 0.8
            
            if signal in [MacroSignal.STRONG_BULLISH, MacroSignal.BULLISH]:
                action = "BUY"
                reason = f"Bullish macro environment ({signal.value if signal else 'unknown'})"
                risk_adjustment = 1.0
            elif signal in [MacroSignal.STRONG_BEARISH, MacroSignal.BEARISH]:
                action = "SELL"
                reason = f"Bearish macro environment ({signal.value if signal else 'unknown'})"
                risk_adjustment = 0.5
            
            # Adjust based on cycle
            if cycle == EconomicCycle.EXPANSION:
                action = "BUY" if action != "SELL" else action
                reason += " - Economic expansion"
                risk_adjustment = min(1.5, risk_adjustment * 1.2)
            elif cycle == EconomicCycle.CONTRACTION:
                action = "SELL" if action != "BUY" else action
                reason += " - Economic contraction"
                risk_adjustment = max(0.2, risk_adjustment * 0.6)
            elif cycle == EconomicCycle.RECOVERY:
                action = "BUY" if action != "SELL" else action
                reason += " - Economic recovery"
                risk_adjustment = min(1.3, risk_adjustment * 1.1)
            
            return {
                'action': action,
                'reason': reason,
                'risk_adjustment': risk_adjustment,
                'signal': signal.value if signal else 'unknown',
                'confidence': confidence,
                'score': self.macro_score,
                'cycle': cycle.value if hasattr(cycle, 'value') else 'neutral',
                'timestamp': datetime.now().isoformat()
            }
        except Exception as e:
            self._log_debug(f"Error in get_macro_recommendation: {str(e)}", "error")
            return {'error': str(e), 'action': 'HOLD', 'risk_adjustment': 0.8}
    
