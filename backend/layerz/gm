    def _detect_economic_cycle(self) -> None:
        """Detect current economic cycle phase"""
        try:
            self.performance['cycle_updates'] += 1
            
            # Get key indicators with fallbacks
            indicators = self._safe_get(self.macro_data, 'economic_indicators', {})
            gdp = self._safe_get(indicators, 'gdp_growth', 0.0)
            inflation = self._safe_get(indicators, 'inflation', 0.0)
            unemployment = self._safe_get(indicators, 'unemployment', 0.0)
            
            confidence = self._safe_get(self.macro_data, 'confidence', {})
            pmi = self._safe_get(confidence, 'pmi', 50.0)
            
            # Determine cycle with fallbacks
            if gdp > 0.03 and inflation < 0.025 and unemployment < 0.04 and pmi > 55:
                self.current_cycle = EconomicCycle.EXPANSION
                cycle_confidence = 0.8
            elif gdp > 0.02 and inflation > 0.025 and unemployment < 0.05 and pmi > 50:
                self.current_cycle = EconomicCycle.PEAK
                cycle_confidence = 0.7
            elif gdp < 0.02 and inflation > 0.02 and unemployment > 0.05 and pmi < 50:
                self.current_cycle = EconomicCycle.CONTRACTION
                cycle_confidence = 0.8
            elif gdp < 0.01 and inflation < 0.01 and unemployment > 0.06 and pmi < 45:
                self.current_cycle = EconomicCycle.TROUGH
                cycle_confidence = 0.7
            else:
                self.current_cycle = EconomicCycle.RECOVERY
                cycle_confidence = 0.6
            
            self.cycle_confidence = cycle_confidence
            
            if 'cycle_data' not in self.macro_data:
                self.macro_data['cycle_data'] = {}
            self.macro_data['cycle_data'].update({
                'phase': self.current_cycle.value if hasattr(self.current_cycle, 'value') else 'neutral',
                'confidence': cycle_confidence,
                'gdp': gdp,
                'inflation': inflation,
                'unemployment': unemployment,
                'pmi': pmi
            })
            
            self.cycle_history.append({
                'timestamp': datetime.now(),
                'cycle': self.current_cycle.value if hasattr(self.current_cycle, 'value') else 'neutral',
                'confidence': cycle_confidence
            })
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in _detect_economic_cycle: {str(e)}", "error")
            self.current_cycle = EconomicCycle.NEUTRAL
            self.cycle_confidence = 0.5
    
    def _calculate_macro_score(self) -> None:
        """Calculate overall macro score with weighted factors"""
        try:
            total_score = 0.0
            total_weight = 0.0
            
            for factor, weight in self.config.factor_weights.items():
                if factor in self.factor_scores:
                    total_score += self.factor_scores[factor] * weight
                    total_weight += weight
            
            if total_weight > 0:
                self.macro_score = total_score / total_weight
            else:
                self.macro_score = 50.0
            
            # Adjust score based on cycle
            if self.config.cycle_detection_enabled:
                if self.current_cycle == EconomicCycle.EXPANSION:
                    self.macro_score += 5
                elif self.current_cycle == EconomicCycle.CONTRACTION:
                    self.macro_score -= 5
            
            self.macro_score = max(0, min(100, self.macro_score))
            
            self.performance['avg_macro_score'] = (self.performance['avg_macro_score'] * (self.performance['total_checks'] - 1) + self.macro_score) / max(1, self.performance['total_checks'])
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in _calculate_macro_score: {str(e)}", "error")
            self.macro_score = 50.0
    
    def _calculate_macro_confidence(self) -> None:
        """Calculate macro confidence score"""
        try:
            score_variance = 0.0
            factor_count = 0
            
            for factor, score in self.factor_scores.items():
                score_variance += abs(score - self.macro_score)
                factor_count += 1
            
            if factor_count > 0:
                avg_variance = score_variance / factor_count
                
                if avg_variance < 5:
                    base_confidence = 0.90
                elif avg_variance < 10:
                    base_confidence = 0.80
                elif avg_variance < 15:
                    base_confidence = 0.70
                elif avg_variance < 20:
                    base_confidence = 0.60
                else:
                    base_confidence = 0.50
                
                # Adjust for data recency
                data_age = self._safe_get(self.macro_data, 'data_age', 0)
                if data_age > 3600:
                    base_confidence *= 0.8
                
                # Adjust for cycle confidence
                if self.config.cycle_detection_enabled:
                    base_confidence = (base_confidence + self.cycle_confidence) / 2
                
                self.macro_confidence = base_confidence
                self.performance['confidence_adjustments'] += 1
            else:
                self.macro_confidence = 0.50
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in _calculate_macro_confidence: {str(e)}", "error")
            self.macro_confidence = 0.50
    
    def _determine_macro_signal(self) -> None:
        """Determine macro signal from score with hold duration"""
        try:
            score = self.macro_score
            
            # Determine signal with fallbacks
            if score > 75:
                new_signal = MacroSignal.STRONG_BULLISH
            elif score > 65:
                new_signal = MacroSignal.BULLISH
            elif score > 45:
                new_signal = MacroSignal.NEUTRAL
            elif score > 35:
                new_signal = MacroSignal.BEARISH
            else:
                new_signal = MacroSignal.STRONG_BEARISH
            
            # Check hold duration
            if self.current_signal != new_signal:
                time_since = (datetime.now() - self.last_signal_change).total_seconds() / 60
                min_hold = self.config.signal_hold_duration_minutes
                
                if time_since < min_hold:
                    if new_signal in [MacroSignal.STRONG_BULLISH, MacroSignal.STRONG_BEARISH]:
                        self._change_signal(new_signal)
                    else:
                        self._log_debug(f"Signal hold: {new_signal.value} pending ({time_since:.0f}/{min_hold} minutes)")
                else:
                    self._change_signal(new_signal)
            else:
                self.signal_momentum = (self.macro_score - 50) / 25
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in _determine_macro_signal: {str(e)}", "error")
    
    def _change_signal(self, new_signal: MacroSignal) -> None:
        """Change macro signal"""
        try:
            old_signal = self.current_signal
            self.current_signal = new_signal
            self.last_signal_change = datetime.now()
            self.signal_hold_until = datetime.now() + timedelta(minutes=self.config.signal_hold_duration_minutes)
            
            self.performance['signal_changes'] += 1
            self.performance['macro_signals'] += 1
            
            # Store history
            self.signal_history.append({
                'from': old_signal.value if old_signal else 'unknown',
                'to': new_signal.value if new_signal else 'unknown',
                'score': self.macro_score,
                'confidence': self.macro_confidence,
                'cycle': self.current_cycle.value if hasattr(self.current_cycle, 'value') else 'neutral',
                'timestamp': datetime.now().isoformat()
            })
            
            self._log_debug(f"MACRO SIGNAL CHANGE: {old_signal.value if old_signal else 'unknown'} -> {new_signal.value if new_signal else 'unknown'} (score: {self.macro_score:.1f}, confidence: {self.macro_confidence:.2f})", "info")
            logger.info(f"MACRO SIGNAL CHANGE: {old_signal.value if old_signal else 'unknown'} -> {new_signal.value if new_signal else 'unknown'}")
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in _change_signal: {str(e)}", "error")
    
    def _update_macro_correlations(self) -> None:
        """Update macro factor correlations"""
        try:
            if len(self.factor_history) > 10:
                recent_factors = list(self.factor_history)[-10:]
                
                for factor1 in self.factor_scores:
                    for factor2 in self.factor_scores:
                        if factor1 != factor2:
                            key = f"{factor1}|{factor2}"
                            if key not in self.macro_correlations:
                                self.macro_correlations[key] = 0.0
            
            self.factor_history.append(self.factor_scores.copy())
            
        except Exception as e:
            self.performance['errors'] += 1
            self._log_debug(f"Error in _update_macro_correlations: {str(e)}", "error")
    
