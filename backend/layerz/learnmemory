    def update_market_data(self, market_data: Dict[str, Any]) -> None:
        """Update market context and trigger learning"""
        try:
            if not isinstance(market_data, dict):
                return
            
            self.current_regime = market_data.get('regime', 'unknown') or 'unknown'
            self.current_volatility = market_data.get('volatility', 0.0) or 0.0
            self.current_strategy = market_data.get('strategy', 'unknown') or 'unknown'
            self.current_time = datetime.now()
            self.current_day = datetime.now().weekday()
            self.current_hour = datetime.now().hour
            self.market_context = market_data
            
            # Auto-save journal
            if self.config.auto_save:
                if (datetime.now() - self.last_journal_save).total_seconds() > self.config.journal_save_interval_minutes * 60:
                    self._save_journal()
                    self.last_journal_save = datetime.now()
            
            # Auto-prune memory
            if (datetime.now() - self.last_memory_prune).total_seconds() > self.config.memory_prune_interval_hours * 3600:
                self._prune_memory()
                self.last_memory_prune = datetime.now()
            
            # Run learning cycle
            if (datetime.now() - self.last_learning_update).total_seconds() > 300:  # Every 5 minutes
                self._run_learning_cycle()
                self.last_learning_update = datetime.now()
            
        except Exception as e:
            self._log_debug(f"Error in update_market_data: {str(e)}", "error")
    
    def journal_trade(self, trade_data: Dict[str, Any]) -> None:
        """
        Journal a trade - ALL TRADES ARE RECORDED
        This is the main learning entry point.
        """
        try:
            if not isinstance(trade_data, dict):
                return
            
            self.performance['total_trades_journaled'] += 1
            
            # ============================================================
            # CREATE COMPREHENSIVE JOURNAL ENTRY
            # ============================================================
            entry = {
                'id': trade_data.get('id', f"TRADE_{int(time.time())}_{np.random.randint(1000, 9999)}"),
                'timestamp': datetime.now().isoformat(),
                'pair': trade_data.get('pair', 'unknown'),
                'direction': trade_data.get('direction', 'unknown'),
                'entry_price': trade_data.get('entry_price', 0.0),
                'exit_price': trade_data.get('exit_price', 0.0),
                'pnl': trade_data.get('pnl', 0.0),
                'won': trade_data.get('pnl', 0.0) > 0,
                'regime': self.current_regime,
                'volatility': self.current_volatility,
                'strategy': trade_data.get('strategy', self.current_strategy),
                'quality_score': trade_data.get('quality_score', 0.0),
                'confidence': trade_data.get('confidence', 0.0),
                'entry_reason': trade_data.get('entry_reason', ''),
                'exit_reason': trade_data.get('exit_reason', ''),
                'duration_seconds': trade_data.get('duration_seconds', 0),
                'risk_reward': trade_data.get('risk_reward', 0.0),
                'position_size': trade_data.get('position_size', 0.0),
                'day_of_week': self.current_day,
                'hour_of_day': self.current_hour,
                'details': trade_data.get('details', {}),
                'signals': trade_data.get('signals', {}),
                'filters_passed': trade_data.get('filters_passed', []),
                'filters_failed': trade_data.get('filters_failed', [])
            }
            
            # ============================================================
            # ADD TO ALL JOURNALS
            # ============================================================
            self.trade_journal.append(entry)
            self.all_trades.append(entry)
            
            if entry['won']:
                self.success_journal.append(entry)
            else:
                self.failure_journal.append(entry)
                self._learn_from_failure(entry)
            
            # ============================================================
            # LEARN FROM THIS TRADE (ALL LEARNING SYSTEMS)
            # ============================================================
            self._learn_from_trade(entry)
            
            # ============================================================
            # IDENTIFY ALL PATTERNS
            # ============================================================
            self._identify_all_patterns(entry)
            
            # ============================================================
            # UPDATE ALL MEMORIES
            # ============================================================
            self._update_all_memories(entry)
            
            # ============================================================
            # SEQUENCE LEARNING
            # ============================================================
            if self.config.sequence_learning_enabled:
                self._learn_sequences(entry)
            
            # ============================================================
            # CORRELATION LEARNING
            # ============================================================
            if self.config.correlation_learning_enabled:
                self._learn_correlations(entry)
            
            # ============================================================
            # TIME LEARNING
            # ============================================================
            if self.config.time_learning_enabled:
                self._learn_time_patterns(entry)
            
            # ============================================================
            # VOLATILITY LEARNING
            # ============================================================
            if self.config.volatility_learning_enabled:
                self._learn_volatility_patterns(entry)
            
            # ============================================================
            # MAKE PREDICTIONS
            # ============================================================
            if self.config.predictive_learning_enabled:
                self._make_predictions(entry)
            
            # ============================================================
            # ADAPTIVE LEARNING
            # ============================================================
            self._adaptive_learning(entry)
            
            self._log_debug(f"Journaled trade: {entry['id']} PnL={entry['pnl']:.2f} {'WON' if entry['won'] else 'LOSS'} | Regime: {entry['regime']}")
            
        except Exception as e:
            self._log_debug(f"Error in journal_trade: {str(e)}", "error")
    
    def _learn_from_trade(self, entry: Dict[str, Any]) -> None:
        """LEARN FROM EVERY TRADE - Comprehensive learning"""
        try:
            self.performance['learning_events'] += 1
            self.learning_iteration += 1
            
            # ============================================================
            # 1. LEARN FROM SUCCESS
            # ============================================================
            if entry['won']:
                key = f"{entry['pair']}_{entry['strategy']}_{entry['regime']}"
                if key not in self.learning_data:
                    self.learning_data[key] = {'successes': 0, 'failures': 0, 'total_pnl': 0.0}
                self.learning_data[key]['successes'] += 1
                self.learning_data[key]['total_pnl'] += entry['pnl']
                
                # Boost confidence for successful pattern
                pattern_key = self._create_pattern_key(entry)
                if pattern_key in self.confidence_memory:
                    self.confidence_memory[pattern_key]['confidence'] = min(1.0, 
                        self.confidence_memory[pattern_key]['confidence'] * 1.1)
                self.performance['confidence_adjustments'] += 1
            
            # ============================================================
            # 2. LEARN FROM FAILURE
            # ============================================================
            else:
                key = f"{entry['pair']}_{entry['strategy']}_{entry['regime']}"
                if key not in self.learning_data:
                    self.learning_data[key] = {'successes': 0, 'failures': 0, 'total_pnl': 0.0}
                self.learning_data[key]['failures'] += 1
                self.learning_data[key]['total_pnl'] += entry['pnl']
                
                # Reduce confidence for failing pattern
                pattern_key = self._create_pattern_key(entry)
                if pattern_key in self.confidence_memory:
                    self.confidence_memory[pattern_key]['confidence'] = max(0.1, 
                        self.confidence_memory[pattern_key]['confidence'] * 0.9)
                self.performance['confidence_adjustments'] += 1
            
            # ============================================================
            # 3. LEARN REGIME PATTERNS
            # ============================================================
            if self.config.regime_learning_enabled:
                regime_key = f"{entry['regime']}_{entry['pair']}"
                if regime_key not in self.regime_learning:
                    self.regime_learning[regime_key] = {'wins': 0, 'losses': 0, 'pnl': 0.0}
                if entry['won']:
                    self.regime_learning[regime_key]['wins'] += 1
                else:
                    self.regime_learning[regime_key]['losses'] += 1
                self.regime_learning[regime_key]['pnl'] += entry['pnl']
                self.performance['regime_learnings'] += 1
            
            # ============================================================
            # 4. LEARN STRATEGY PATTERNS
            # ============================================================
            if self.config.strategy_learning_enabled:
                strategy_key = f"{entry['strategy']}_{entry['pair']}"
                if strategy_key not in self.strategy_learning:
                    self.strategy_learning[strategy_key] = {'wins': 0, 'losses': 0, 'pnl': 0.0}
                if entry['won']:
                    self.strategy_learning[strategy_key]['wins'] += 1
                else:
                    self.strategy_learning[strategy_key]['losses'] += 1
                self.strategy_learning[strategy_key]['pnl'] += entry['pnl']
                self.performance['strategy_learnings'] += 1
            
            # ============================================================
            # 5. STORE LEARNING HISTORY
            # ============================================================
            self.correction_history.append({
                'timestamp': datetime.now(),
                'trade_id': entry['id'],
                'won': entry['won'],
                'pnl': entry['pnl'],
                'learning': self.learning_data.get(key, {}),
                'regime_learning': self.regime_learning.get(regime_key, {}) if self.config.regime_learning_enabled else {},
                'strategy_learning': self.strategy_learning.get(strategy_key, {}) if self.config.strategy_learning_enabled else {}
            })
            
        except Exception as e:
            self._log_debug(f"Error in _learn_from_trade: {str(e)}", "error")
    
    def _learn_from_failure(self, entry: Dict[str, Any]) -> None:
        """DEEP LEARNING FROM FAILURE - Analyze why it failed"""
        try:
            # Analyze failure
            failure_analysis = {
                'id': entry['id'],
                'timestamp': entry['timestamp'],
                'pair': entry['pair'],
                'pnl': entry['pnl'],
                'regime': entry['regime'],
                'volatility': entry['volatility'],
                'strategy': entry['strategy'],
                'entry_reason': entry['entry_reason'],
                'exit_reason': entry['exit_reason'],
                'quality_score': entry['quality_score'],
                'confidence': entry['confidence'],
                'duration_seconds': entry['duration_seconds'],
                'risk_reward': entry['risk_reward'],
                'signals': entry.get('signals', {}),
                'filters_passed': entry.get('filters_passed', []),
                'filters_failed': entry.get('filters_failed', [])
            }
            
            # Add to failure journal
            self.failure_journal.append(failure_analysis)
            
            # Identify failed signals
            failed_signals = []
            for signal, value in entry.get('signals', {}).items():
                if value > 0 and not entry['won']:
                    failed_signals.append(signal)
            
            if failed_signals:
                self.failure_patterns[entry['id']] = {
                    'signals': failed_signals,
                    'timestamp': datetime.now(),
                    'recovered': False,
                    'analysis': failure_analysis
                }
            
            # Store failure learning
            self.failure_learning[entry['id']] = {
                'pattern': self._create_pattern_key(entry),
                'failed_signals': failed_signals,
                'timestamp': datetime.now(),
                'learned': False
            }
            
            self._log_debug(f"Deep learning from failure: {entry['id']} (loss: {entry['pnl']:.2f}) - Failed signals: {failed_signals}")
            
        except Exception as e:
            self._log_debug(f"Error in _learn_from_failure: {str(e)}", "error")
    
    def _identify_all_patterns(self, entry: Dict[str, Any]) -> None:
        """IDENTIFY ALL PATTERNS - Comprehensive pattern recognition"""
        try:
            self.performance['patterns_identified'] += 1
            
            # ============================================================
            # 1. PATTERN KEY
            # ============================================================
            pattern_key = self._create_pattern_key(entry)
            
            # ============================================================
            # 2. PROFIT/LOSS PATTERNS
            # ============================================================
            if entry['won']:
                if pattern_key not in self.profit_patterns:
                    self.profit_patterns[pattern_key] = {
                        'count': 0,
                        'total_pnl': 0.0,
                        'avg_pnl': 0.0,
                        'max_pnl': 0.0,
                        'last_seen': datetime.now(),
                        'examples': [],
                        'confidence': 0.0
                    }
                self.profit_patterns[pattern_key]['count'] += 1
                self.profit_patterns[pattern_key]['total_pnl'] += entry['pnl']
                self.profit_patterns[pattern_key]['avg_pnl'] = self.profit_patterns[pattern_key]['total_pnl'] / self.profit_patterns[pattern_key]['count']
                self.profit_patterns[pattern_key]['max_pnl'] = max(self.profit_patterns[pattern_key]['max_pnl'], entry['pnl'])
                self.profit_patterns[pattern_key]['last_seen'] = datetime.now()
                self.profit_patterns[pattern_key]['confidence'] = min(1.0, self.profit_patterns[pattern_key]['count'] / 10)
                
                if len(self.profit_patterns[pattern_key]['examples']) < 10:
                    self.profit_patterns[pattern_key]['examples'].append(entry)
            else:
                if pattern_key not in self.loss_patterns:
                    self.loss_patterns[pattern_key] = {
                        'count': 0,
                        'total_loss': 0.0,
                        'avg_loss': 0.0,
                        'max_loss': 0.0,
                        'last_seen': datetime.now(),
                        'examples': [],
                        'confidence': 0.0
                    }
                self.loss_patterns[pattern_key]['count'] += 1
                self.loss_patterns[pattern_key]['total_loss'] += abs(entry['pnl'])
                self.loss_patterns[pattern_key]['avg_loss'] = self.loss_patterns[pattern_key]['total_loss'] / self.loss_patterns[pattern_key]['count']
                self.loss_patterns[pattern_key]['max_loss'] = max(self.loss_patterns[pattern_key]['max_loss'], abs(entry['pnl']))
                self.loss_patterns[pattern_key]['last_seen'] = datetime.now()
                self.loss_patterns[pattern_key]['confidence'] = min(1.0, self.loss_patterns[pattern_key]['count'] / 10)
                
                if len(self.loss_patterns[pattern_key]['examples']) < 10:
                    self.loss_patterns[pattern_key]['examples'].append(entry)
            
            # ============================================================
            # 3. REGIME PATTERNS
            # ============================================================
