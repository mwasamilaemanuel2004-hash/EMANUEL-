    def _prune_memory(self) -> None:
        """Prune old memory entries"""
        try:
            self.performance['memory_prunes'] += 1
            cutoff_time = datetime.now() - timedelta(days=self.config.memory_retention_days)
            
            # Prune memory
            old_entries = 0
            for key, memory_data in list(self.memory.items()):
                if memory_data['last_updated'] < cutoff_time:
                    del self.memory[key]
                    old_entries += 1
            
            # Prune pattern databases
            for db in [self.profit_patterns, self.loss_patterns, self.regime_patterns, 
                      self.strategy_patterns, self.sequence_patterns, self.time_patterns, 
                      self.volatility_patterns]:
                for key in list(db.keys()):
                    if db[key]['last_seen'] < cutoff_time:
                        del db[key]
            
            self._save_memory()
            self._log_debug(f"Memory pruned: {old_entries} entries removed")
            
        except Exception as e:
            self._log_debug(f"Error in _prune_memory: {str(e)}", "error")
    
    def match_pattern(self, current_signal: Dict[str, Any]) -> Dict[str, Any]:
        """Match current signal against ALL remembered patterns"""
        try:
            self.performance['patterns_matched'] += 1
            
            current_pattern = self._create_pattern_key_from_signal(current_signal)
            
            best_match = None
            best_score = 0.0
            
            # Search in all memory systems
            memory_systems = [
                ('memory', self.memory),
                ('profit', self.profit_patterns),
                ('regime', self.regime_patterns),
                ('strategy', self.strategy_patterns),
                ('sequence', self.sequence_patterns),
                ('time', self.time_patterns),
                ('volatility', self.volatility_patterns)
            ]
            
            for system_name, memory_data in memory_systems:
                for pattern_key, data in memory_data.items():
                    score = self._calculate_match_score(current_pattern, pattern_key, data, system_name)
                    
                    if score > best_score and score > self.config.matching_threshold:
                        best_score = score
                        best_match = {
                            'pattern_key': pattern_key,
                            'system': system_name,
                            'data': data,
                            'score': score,
                            'win_rate': data.get('win_rate', 0.0) if isinstance(data, dict) else 0.0,
                            'confidence': self.confidence_memory.get(pattern_key, {}).get('confidence', 0.0)
                        }
            
            if best_match:
                self.performance['successful_matches'] += 1
                return {
                    'matched': True,
                    'match': best_match,
                    'score': best_score
                }
            else:
                self.performance['failed_matches'] += 1
                return {'matched': False}
            
        except Exception as e:
            self._log_debug(f"Error in match_pattern: {str(e)}", "error")
            return {'matched': False, 'error': str(e)}
    
    def _create_pattern_key_from_signal(self, signal: Dict[str, Any]) -> str:
        """Create pattern key from trade signal"""
        try:
            features = {
                'pair': signal.get('pair', 'unknown'),
                'regime': self.current_regime,
                'strategy': signal.get('strategy', self.current_strategy),
                'direction': signal.get('direction', 'unknown'),
                'volatility_range': self._get_volatility_range(self.current_volatility),
                'quality_range': self._get_quality_range(signal.get('quality_score', 0.0)),
                'confidence_range': self._get_confidence_range(signal.get('confidence', 0.0))
            }
            
            feature_str = json.dumps(features, sort_keys=True)
            return hashlib.md5(feature_str.encode()).hexdigest()[:16]
            
        except Exception as e:
            self._log_debug(f"Error in _create_pattern_key_from_signal: {str(e)}", "error")
            return f"signal_{int(time.time())}"
    
    def _calculate_match_score(self, current_pattern: str, stored_pattern: str, data: Any, system: str) -> float:
        """Calculate match score between current and stored pattern"""
        try:
            if current_pattern == stored_pattern:
                base_score = 1.0
            else:
                common = sum(1 for a, b in zip(current_pattern[:8], stored_pattern[:8]) if a == b)
                base_score = common / max(len(current_pattern), 1)
            
            # Get confidence
            confidence = self.confidence_memory.get(stored_pattern, {}).get('confidence', 0.0)
            
            # Get win rate
            win_rate = data.get('win_rate', 0.0) if isinstance(data, dict) else 0.0
            
            # System bonus
            system_bonus = {
                'memory': 1.0,
                'profit': 1.1,
                'regime': 1.05,
                'strategy': 1.05,
                'sequence': 1.0,
                'time': 0.9,
                'volatility': 0.9
            }.get(system, 1.0)
            
            score = (base_score * 0.3) + (confidence * 0.35) + (win_rate * 0.25) + (system_bonus * 0.1)
            
            return min(1.0, score)
            
        except Exception as e:
            self._log_debug(f"Error in _calculate_match_score: {str(e)}", "error")
            return 0.0
    
