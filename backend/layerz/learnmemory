    def _consolidate_memory(self) -> None:
        """Consolidate memory - strengthen important patterns"""
        try:
            # Strengthen successful patterns
            for key, pattern in self.profit_patterns.items():
                if pattern['count'] > 5 and pattern['avg_pnl'] > 0:
                    if key in self.confidence_memory:
                        self.confidence_memory[key]['confidence'] = min(1.0, 
                            self.confidence_memory[key]['confidence'] * 1.05)
            
            # Weaken unsuccessful patterns
            for key, pattern in self.loss_patterns.items():
                if pattern['count'] > 5 and pattern['avg_loss'] > 0:
                    if key in self.confidence_memory:
                        self.confidence_memory[key]['confidence'] = max(0.1, 
                            self.confidence_memory[key]['confidence'] * 0.95)
            
