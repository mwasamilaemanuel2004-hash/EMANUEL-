                'regime': entry.get('regime', 'unknown'),
                'strategy': entry.get('strategy', 'unknown'),
                'direction': entry.get('direction', 'unknown'),
                'volatility_range': self._get_volatility_range(entry.get('volatility', 0.0)),
                'quality_range': self._get_quality_range(entry.get('quality_score', 0.0)),
                'confidence_range': self._get_confidence_range(entry.get('confidence', 0.0))
            }
            
            feature_str = json.dumps(features, sort_keys=True)
            return hashlib.md5(feature_str.encode()).hexdigest()[:16]
            
        except Exception as e:
            self._log_debug(f"Error in _create_pattern_key: {str(e)}", "error")
            return f"pattern_{int(time.time())}"
    
    def _get_volatility_range(self, volatility: float) -> str:
        if volatility < 0.5:
            return "low"
        elif volatility < 1.0:
            return "medium"
        elif volatility < 2.0:
            return "high"
        else:
            return "extreme"
    
    def _get_quality_range(self, quality: float) -> str:
        if quality < 0.3:
            return "poor"
        elif quality < 0.5:
            return "average"
        elif quality < 0.7:
            return "good"
        else:
            return "excellent"
    
    def _get_confidence_range(self, confidence: float) -> str:
        if confidence < 0.3:
            return "low"
        elif confidence < 0.6:
            return "medium"
        else:
            return "high"
    
