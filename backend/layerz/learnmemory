    def _calculate_confidence(self, entries: List[Dict]) -> float:
        """Calculate confidence score from entries"""
        try:
            if not entries:
                return 0.0
            
            wins = sum(1 for e in entries if e.get('won', False))
            win_rate = wins / len(entries)
            
            # Weight by recency
            recent_entries = entries[-5:] if len(entries) >= 5 else entries
            recent_wins = sum(1 for e in recent_entries if e.get('won', False))
            recent_win_rate = recent_wins / len(recent_entries) if recent_entries else win_rate
            
            # Weight by pnl
            avg_pnl = sum(e.get('pnl', 0.0) for e in entries) / len(entries) if entries else 0
            pnl_factor = min(1.0, max(0.0, avg_pnl / 10 + 0.5))
            
            # Combined confidence
            confidence = (win_rate * 0.4) + (recent_win_rate * 0.3) + (pnl_factor * 0.3)
            
            return min(1.0, max(0.0, confidence))
            
        except Exception as e:
            self._log_debug(f"Error in _calculate_confidence: {str(e)}", "error")
            return 0.0
    
