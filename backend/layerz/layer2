        except Exception as e:
            self._log_debug(f"Error in execute_smart: {str(e)}", "error")
            return {'success': False, 'message': str(e), 'algorithm': 'SMART'}
    
    def execute_adaptive(self, order: Dict[str, Any]) -> Dict[str, Any]:
        """Execute order using Adaptive algorithm based on market conditions"""
        try:
            size = order.get('size', 1.0)
            price = order.get('price', 0.0)
            direction = order.get('direction', 'buy')
            pair = order.get('pair', 'unknown')
            
            if size <= 0 or price <= 0:
                return {'success': False, 'message': 'Invalid order parameters', 'algorithm': 'ADAPTIVE'}
            
            # Choose algorithm based on current conditions
            if self.current_volatility > 2.0:
                # High volatility - use ICEBERG or SMART
                result = self.execute_iceberg(order)
            elif self.current_spread > 0.001:
                # Wide spread - use VWAP
                result = self.execute_vwap(order)
            elif self.current_volume < 1000:
                # Low volume - use TWAP
                result = self.execute_twap(order)
            else:
                # Normal conditions - use SMART
                result = self.execute_smart(order)
            
            if result.get('success', False):
                result['algorithm'] = f"ADAPTIVE_{result.get('algorithm', 'TWAP')}"
            
            self._log_debug(f"Adaptive execution: {result.get('algorithm', 'UNKNOWN')}")
            
            return result
            
        except Exception as e:
            self._log_debug(f"Error in execute_adaptive: {str(e)}", "error")
            return {'success': False, 'message': str(e), 'algorithm': 'ADAPTIVE'}
    
    def execute_market(self, order: Dict[str, Any]) -> Dict[str, Any]:
