    def get_performance_report(self) -> Dict[str, Any]:
        """Get detailed performance report"""
        try:
            total = self.performance['total_orders']
            success_rate = (self.performance['executed_orders'] / total * 100) if total > 0 else 0
            
            # Calculate quality score distribution
            quality_scores = self.performance['quality_scores']
            quality_distribution = {
                'excellent': sum(1 for q in quality_scores if q >= 90),
                'good': sum(1 for q in quality_scores if 80 <= q < 90),
                'average': sum(1 for q in quality_scores if 70 <= q < 80),
                'poor': sum(1 for q in quality_scores if 60 <= q < 70),
                'bad': sum(1 for q in quality_scores if q < 60)
            }
            
            return {
                'summary': {
                    'total_orders': total,
                    'executed_orders': self.performance['executed_orders'],
                    'failed_orders': self.performance['failed_orders'],
                    'success_rate': success_rate,
                    'total_volume': self.performance['total_volume'],
                    'avg_slippage': self.performance['avg_slippage'],
                    'avg_execution_time': self.performance['avg_execution_time'],
                    'avg_quality_score': sum(quality_scores) / len(quality_scores) if quality_scores else 0
                },
                'algorithms': self.performance['algorithm_usage'],
                'venues': self.performance['venue_usage'],
                'quality_distribution': quality_distribution,
                'dark_pool_usage': self.performance['dark_pool_usage'],
                'auto_corrections': self.performance['auto_corrections'],
                'recent_orders': list(self.order_history)[-10:],
                'rejected_orders': list(self.rejected_orders)[-5:],
                'timestamp': datetime.now().isoformat()
            }
        except Exception as e:
