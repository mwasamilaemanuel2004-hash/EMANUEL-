    def execute_limit(self, order: Dict[str, Any]) -> Dict[str, Any]:
        """Execute limit order"""
        try:
            size = order.get('size', 1.0)
            price = order.get('price', 0.0)
            direction = order.get('direction', 'buy')
            pair = order.get('pair', 'unknown')
            limit_price = order.get('limit_price', price * 0.99 if direction == 'buy' else price * 1.01)
            
            if size <= 0 or price <= 0:
                return {'success': False, 'message': 'Invalid order parameters', 'algorithm': 'LIMIT'}
            
            # Check if limit price is reasonable
            if direction == 'buy' and limit_price > price:
                return {'success': False, 'message': 'Limit price too high for buy', 'algorithm': 'LIMIT'}
            if direction == 'sell' and limit_price < price:
                return {'success': False, 'message': 'Limit price too low for sell', 'algorithm': 'LIMIT'}
            
            start_time = time.time()
            
            # Simulate limit order execution
            # Limit orders may not fill immediately
            fill_probability = 0.8  # 80% chance of fill
            fill_rate = 1.0 if random.random() < fill_probability else 0.5
            
            executed_price = limit_price if fill_rate == 1.0 else price
            slippage = abs(executed_price - price) / price * 100
            execution_time = time.time() - start_time
            
            result = {
                'success': True,
                'algorithm': 'LIMIT',
                'pair': pair,
                'direction': direction,
                'total_size': size * fill_rate,
                'fill_rate': fill_rate,
                'avg_price': executed_price,
                'avg_slippage': slippage,
                'execution_time': execution_time,
                'limit_price': limit_price,
                'venue': 'exchange',
                'timestamp': datetime.now().isoformat()
            }
            
            # Calculate quality score
            quality_score = self.calculate_execution_quality(order, result)
            result['quality_score'] = quality_score
            
            self._update_performance(result)
            self._log_debug(f"Limit execution: {result['total_size']:.2f} @ {result['avg_price']:.4f}, fill_rate={fill_rate:.2f}, quality={quality_score:.2f}")
            
            return result
            
        except Exception as e:
            self._log_debug(f"Error in execute_limit: {str(e)}", "error")
            return {'success': False, 'message': str(e), 'algorithm': 'LIMIT'}
    
    def execute_order(self, order: Dict[str, Any]) -> Dict[str, Any]:
        """Main execution entry point"""
        try:
            # Validate order
            if not isinstance(order, dict):
                return {'success': False, 'message': 'Invalid order format'}
            
            size = order.get('size', 0)
            if size <= 0:
                return {'success': False, 'message': 'Invalid order size'}
            
            price = order.get('price', 0)
            if price <= 0:
                return {'success': False, 'message': 'Invalid price'}
            
            # Select algorithm
            algorithm = self.select_algorithm(order)
            self.performance['algorithm_usage'][algorithm.value] = self.performance['algorithm_usage'].get(algorithm.value, 0) + 1
            
            # Execute based on selected algorithm
            algorithm_map = {
                ExecutionAlgorithm.TWAP: self.execute_twap,
                ExecutionAlgorithm.VWAP: self.execute_vwap,
                ExecutionAlgorithm.ICEBERG: self.execute_iceberg,
                ExecutionAlgorithm.SMART: self.execute_smart,
                ExecutionAlgorithm.ADAPTIVE: self.execute_adaptive,
                ExecutionAlgorithm.MARKET: self.execute_market,
                ExecutionAlgorithm.LIMIT: self.execute_limit,
                ExecutionAlgorithm.POV: self.execute_vwap  # POV uses VWAP for now
            }
            
            executor = algorithm_map.get(algorithm, self.execute_smart)
            result = executor(order)
            
            # Add order ID
            result['order_id'] = f"EXEC{int(time.time())}{np.random.randint(1000, 9999)}"
            
            return result
            
        except Exception as e:
            self._log_debug(f"Error in execute_order: {str(e)}", "error")
            return {'success': False, 'message': str(e)}
    
    def _update_performance(self, result: Dict[str, Any]) -> None:
        """Update performance metrics"""
        try:
            self.performance['total_orders'] += 1
            
            if result.get('success', False):
                self.performance['executed_orders'] += 1
                self.performance['total_volume'] += result.get('total_size', 0)
                
                # Update average slippage
                current_avg = self.performance['avg_slippage']
                new_slippage = result.get('avg_slippage', 0)
                total_orders = self.performance['total_orders']
                self.performance['avg_slippage'] = (current_avg * (total_orders - 1) + new_slippage) / total_orders
                
                # Track slippage events
                if new_slippage > 0:
                    self.performance['slippage_events'].append(new_slippage)
                
                # Update execution time
                current_avg_time = self.performance['avg_execution_time']
                new_time = result.get('execution_time', 0)
                self.performance['avg_execution_time'] = (current_avg_time * (total_orders - 1) + new_time) / total_orders
                
                # Track venue usage
                venue = result.get('venue', 'unknown')
                self.performance['venue_usage'][venue] = self.performance['venue_usage'].get(venue, 0) + 1
                
                # Track quality scores
                quality_score = result.get('quality_score', 70)
                self.performance['quality_scores'].append(quality_score)
                
            else:
                self.performance['failed_orders'] += 1
                self.performance['rejected_orders'] += 1
                self.rejected_orders.append(result)
            
            # Add to history
            self.order_history.append(result)
            
        except Exception as e:
            self._log_debug(f"Error in _update_performance: {str(e)}", "error")
    
    def check_slippage(self, expected_price: float, executed_price: float) -> bool:
        """Check if slippage is acceptable"""
        try:
            if expected_price <= 0:
                return False
            
            slippage = abs(executed_price - expected_price) / expected_price * 100
            return slippage <= self.config.max_slippage_percent
            
        except Exception as e:
            self._log_debug(f"Error in check_slippage: {str(e)}", "error")
            return False
    
