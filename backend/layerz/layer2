class ExecutionAlgorithm(Enum):
    """Execution algorithms available"""
    TWAP = "twap"          # Time-Weighted Average Price
    VWAP = "vwap"          # Volume-Weighted Average Price
    SMART = "smart"        # Smart Order Routing
    ADAPTIVE = "adaptive"  # Adaptive execution
    ICEBERG = "iceberg"    # Iceberg order
    POV = "pov"            # Percentage of Volume
    MARKET = "market"      # Market order (immediate)
    LIMIT = "limit"        # Limit order


class VenueType(Enum):
    """Trading venues available"""
    PRIMARY = "primary"           # Primary exchange
    DARK_POOL = "dark_pool"       # Dark pool
    ECN = "ecn"                   # Electronic Communication Network
    EXCHANGE = "exchange"         # Direct exchange
    BROKER = "broker"             # Broker internalization


@dataclass
class ExecutionConfig:
    """Configuration for Execution Algorithms - adaptive with debug support"""
    # Order execution parameters
    max_slippage_percent: float = 0.5      # 0.5% max slippage
    min_execution_quality: float = 0.7     # 70% min quality
    max_execution_time: float = 5.0        # 5 seconds max
    
    # Order size limits
    max_order_size: float = 100.0          # 100 units max
    min_order_size: float = 0.01           # 0.01 units min
    
    # Algorithm parameters
    twap_interval: int = 10                # 10 intervals
    vwap_window: int = 20                  # 20 bars
    iceberg_visible_size: float = 10.0     # 10 units visible
    pov_volume_percent: float = 10.0       # 10% of volume
    
    # Dark pool
    dark_pool_usage: bool = True
    dark_pool_threshold: float = 50.0      # 50 units threshold
    
    # Latency
    max_latency_ms: float = 100.0          # 100ms max
    latency_adjustment: bool = True        # Auto-adjust for latency
    
    # Slippage
    slippage_prediction: bool = True       # Predict slippage before execution
    
    # Debug mode
    debug_mode: bool = True
    
    # History limits
    max_history_size: int = 1000
    
    # Auto-correction
    auto_correction: bool = True
    auto_correction_threshold: float = 5.0 # 5% deviation


class ExecutionAlgorithms:
    """
    Layer -2: Execution Algorithms (UPGRADED)
    Executes trades with optimal pricing and minimal slippage.
    """
    
    def __init__(self, config: Optional[ExecutionConfig] = None):
        self.config = config or ExecutionConfig()
        self.debug_mode = self.config.debug_mode
        
        # Performance tracking
        self.performance = {
            'total_orders': 0,
            'executed_orders': 0,
            'failed_orders': 0,
            'avg_slippage': 0.0,
            'avg_execution_time': 0.0,
            'total_volume': 0.0,
            'venue_usage': {},
            'dark_pool_usage': 0,
            'algorithm_usage': {},
            'auto_corrections': 0,
            'quality_scores': [],
            'rejected_orders': 0,
            'slippage_events': []
        }
        
        # Order history
        self.order_history = deque(maxlen=self.config.max_history_size)
        self.rejected_orders = deque(maxlen=self.config.max_history_size)
        
        # Market data
        self.current_volatility = 0.0
        self.current_spread = 0.0
        self.current_volume = 0.0
        self.current_regime = "unknown"
        self.current_latency = 0.0
        self.current_bid = 0.0
        self.current_ask = 0.0
        
        # Venue quality scores
        self.venue_quality = {
            'primary': 0.85,
            'dark_pool': 0.90,
            'ecn': 0.80,
            'exchange': 0.75,
            'broker': 0.70
        }
        
        # Active orders
        self.active_orders = {}
        
        # Auto-correction
        self.correction_count = 0
        self.last_correction = None
        
        # Lock for thread safety
        self._lock = threading.Lock()
        
        # Startup log
        self._log_debug("Execution Algorithms initialized with upgraded features")
        logger.info("Execution Algorithms initialized")
    
    def _log_debug(self, message: str, level: str = "debug") -> None:
        """Debug logging with timestamp"""
        if self.debug_mode:
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
            log_msg = f"[DEBUG {timestamp}] {message}"
            if level == "info":
                logger.info(log_msg)
            elif level == "warning":
                logger.warning(log_msg)
            elif level == "error":
                logger.error(log_msg)
            else:
                logger.debug(log_msg)
    
    def update_market_data(self, market_data: Dict[str, Any]) -> None:
        """Update market data for execution optimization"""
        try:
            if not isinstance(market_data, dict):
                self._log_debug(f"Invalid market data type: {type(market_data)}", "warning")
                return
            
            self.current_volatility = market_data.get('volatility', 0.0) or 0.0
            self.current_spread = market_data.get('spread', 0.0) or 0.0
            self.current_volume = market_data.get('volume', 0.0) or 0.0
            self.current_regime = market_data.get('regime', 'unknown') or 'unknown'
            self.current_bid = market_data.get('bid', 0.0) or 0.0
            self.current_ask = market_data.get('ask', 0.0) or 0.0
            
            # Update venue quality based on market conditions
            self._update_venue_quality()
            
            # Auto-correction check
            if self.config.auto_correction:
                self._check_auto_correction()
            
            self._log_debug(f"Market data updated: spread={self.current_spread:.4f}, volatility={self.current_volatility:.2f}")
            
        except Exception as e:
            self._log_debug(f"Error in update_market_data: {str(e)}", "error")
    
    def _update_venue_quality(self) -> None:
        """Update venue quality scores based on current conditions"""
        try:
            # Adjust quality based on market conditions
            if self.current_volatility > 2.0:
                self.venue_quality['dark_pool'] = max(0.7, self.venue_quality['dark_pool'] - 0.1)
                self.venue_quality['primary'] = max(0.7, self.venue_quality['primary'] - 0.05)
            
            if self.current_spread > 0.001:
                self.venue_quality['ecn'] = max(0.6, self.venue_quality['ecn'] - 0.1)
                self.venue_quality['exchange'] = max(0.6, self.venue_quality['exchange'] - 0.05)
            
            if self.current_volume < 1000:
                self.venue_quality['dark_pool'] = min(0.95, self.venue_quality['dark_pool'] + 0.05)
            
        except Exception as e:
            self._log_debug(f"Error in _update_venue_quality: {str(e)}", "error")
    
    def _check_auto_correction(self) -> None:
        """Auto-correction to optimize execution"""
        try:
            # Check if slippage is consistently high
            if len(self.performance['slippage_events']) > 10:
                recent_slippage = self.performance['slippage_events'][-10:]
                avg_slippage = sum(recent_slippage) / len(recent_slippage)
                
                if avg_slippage > self.config.max_slippage_percent * 1.5:
                    self.correction_count += 1
                    self.performance['auto_corrections'] += 1
                    
                    # Reduce max slippage threshold
                    self.config.max_slippage_percent = max(0.2, self.config.max_slippage_percent * 0.8)
                    self._log_debug(f"AUTO-CORRECTION: Reduced slippage limit to {self.config.max_slippage_percent:.2f}%", "info")
            
            # Check if execution time is too high
            if self.performance['avg_execution_time'] > self.config.max_execution_time * 0.8:
                self.config.max_execution_time = min(8.0, self.config.max_execution_time * 1.2)
                self._log_debug(f"AUTO-CORRECTION: Increased execution time limit to {self.config.max_execution_time:.2f}s", "info")
            
        except Exception as e:
            self._log_debug(f"Error in _check_auto_correction: {str(e)}", "error")
    
    def select_algorithm(self, order: Dict[str, Any]) -> ExecutionAlgorithm:
        """Select the best execution algorithm based on order and market conditions"""
        try:
            order_size = order.get('size', 1.0)
            urgency = order.get('urgency', 'medium')
            price = order.get('price', 0.0)
            pair = order.get('pair', 'unknown')
            direction = order.get('direction', 'buy')
            
            # Check if market order needed (high urgency)
            if urgency == 'immediate' or self.current_volatility > 3.0:
                return ExecutionAlgorithm.MARKET
            
            # Check if large order
            if order_size > 50.0:
                # Use VWAP or POV for large orders
                if self.current_volume > 0 and self.current_volume > 1000:
                    return ExecutionAlgorithm.VWAP
                else:
                    return ExecutionAlgorithm.POV
            
            # Check if urgent
            if urgency == 'high':
                if self.current_volatility > 2.0:
                    return ExecutionAlgorithm.MARKET
                return ExecutionAlgorithm.SMART
            
            # Check if need stealth
            if order_size > 10.0 and self.config.dark_pool_usage:
                return ExecutionAlgorithm.ICEBERG
            
            # Check volatility
            if self.current_volatility > 2.0:
                return ExecutionAlgorithm.ADAPTIVE
            elif self.current_volatility > 1.5:
                return ExecutionAlgorithm.SMART
            
            # Check spread
            if self.current_spread < 0.0005:
                return ExecutionAlgorithm.LIMIT
            
            # Default to TWAP
            return ExecutionAlgorithm.TWAP
            
        except Exception as e:
            self._log_debug(f"Error in select_algorithm: {str(e)}", "error")
            return ExecutionAlgorithm.SMART
    
    def select_venue(self, order: Dict[str, Any]) -> VenueType:
        """Select the best venue for execution"""
        try:
            order_size = order.get('size', 1.0)
            urgency = order.get('urgency', 'medium')
            
            # For large orders, prefer dark pool
            if order_size > self.config.dark_pool_threshold and self.config.dark_pool_usage:
                return VenueType.DARK_POOL
            
            # For urgent orders, prefer direct exchange
            if urgency in ['high', 'immediate']:
                return VenueType.EXCHANGE
            
            # For normal orders, use smart routing
            # Select venue with highest quality score
            best_venue = max(self.venue_quality, key=self.venue_quality.get)
            
            # Map to VenueType
            venue_map = {
                'primary': VenueType.PRIMARY,
                'dark_pool': VenueType.DARK_POOL,
                'ecn': VenueType.ECN,
                'exchange': VenueType.EXCHANGE,
                'broker': VenueType.BROKER
            }
            
            return venue_map.get(best_venue, VenueType.PRIMARY)
            
        except Exception as e:
            self._log_debug(f"Error in select_venue: {str(e)}", "error")
            return VenueType.PRIMARY
    
    def predict_slippage(self, order: Dict[str, Any]) -> float:
        """Predict slippage before execution"""
        try:
            order_size = order.get('size', 1.0)
            price = order.get('price', 0.0)
            direction = order.get('direction', 'buy')
            
            # Base slippage
            base_slippage = 0.01  # 0.01% base
            
            # Adjust for order size
            size_factor = min(1.0, order_size / 100.0)
            base_slippage += size_factor * 0.05  # 0.05% per 100 units
            
            # Adjust for volatility
            vol_factor = min(1.0, self.current_volatility / 5.0)
            base_slippage += vol_factor * 0.1  # 0.1% per 5 volatility
            
            # Adjust for spread
            spread_factor = min(1.0, self.current_spread * 1000)
            base_slippage += spread_factor * 0.05  # 0.05% per 0.001 spread
            
            # Adjust for liquidity
            if self.current_volume < 1000:
                base_slippage += 0.05  # 0.05% low liquidity penalty
            
            # Cap at max slippage
            predicted_slippage = min(base_slippage, self.config.max_slippage_percent / 100)
            
            return predicted_slippage
            
        except Exception as e:
            self._log_debug(f"Error in predict_slippage: {str(e)}", "error")
            return 0.05  # Conservative fallback
    
    def calculate_execution_quality(self, order: Dict[str, Any], result: Dict[str, Any]) -> float:
        """Calculate execution quality score"""
        try:
            quality_score = 0.0
            
            # Factor 1: Slippage (40%)
            slippage = result.get('avg_slippage', 0)
            max_slippage = self.config.max_slippage_percent
            slippage_score = max(0, 100 - (slippage / max_slippage * 100))
            quality_score += slippage_score * 0.4
            
            # Factor 2: Execution time (30%)
            exec_time = result.get('execution_time', 0)
            max_time = self.config.max_execution_time
            time_score = max(0, 100 - (exec_time / max_time * 100))
            quality_score += time_score * 0.3
            
            # Factor 3: Fill rate (20%)
            fill_rate = result.get('fill_rate', 1.0)
            quality_score += fill_rate * 20
            
            # Factor 4: Venue quality (10%)
            venue = result.get('venue', 'primary')
            venue_quality = self.venue_quality.get(venue, 0.7)
            quality_score += venue_quality * 10
            
            # Cap at 100
            quality_score = min(100.0, max(0.0, quality_score))
            
            return quality_score
            
        except Exception as e:
            self._log_debug(f"Error in calculate_execution_quality: {str(e)}", "error")
            return 70.0  # Conservative fallback
    
