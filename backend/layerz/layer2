            return {'success': False, 'message': str(e), 'algorithm': 'ICEBERG'}
    
    def execute_smart(self, order: Dict[str, Any]) -> Dict[str, Any]:
        """Execute order using Smart Order Routing"""
        try:
            size = order.get('size', 1.0)
            price = order.get('price', 0.0)
            direction = order.get('direction', 'buy')
            pair = order.get('pair', 'unknown')
            
            if size <= 0 or price <= 0:
                return {'success': False, 'message': 'Invalid order parameters', 'algorithm': 'SMART'}
            
            # Predict slippage
            predicted_slippage = self.predict_slippage(order)
            if predicted_slippage > self.config.max_slippage_percent / 100:
                return {
                    'success': False, 
                    'message': f'Predicted slippage {predicted_slippage:.2f}% exceeds limit',
                    'algorithm': 'SMART'
                }
            
            # Select venue
            venue = self.select_venue(order)
            
            start_time = time.time()
            
            # Simulate smart routing across venues
            venues = ['primary', 'dark_pool', 'ecn', 'exchange', 'broker']
            venue_prices = {}
            venue_quality = {}
            
            for v in venues:
                # Simulate different prices and quality
                price_diff = np.random.normal(0, 0.001)  # 0.1% variation
                venue_prices[v] = price + price_diff
                venue_quality[v] = self.venue_quality.get(v, 0.7)
            
            # Select best venue
            best_venue = max(venues, key=lambda v: venue_quality[v] * (1 - abs(venue_prices[v] - price) / price))
            executed_price = venue_prices[best_venue]
            
            slippage = abs(executed_price - price) / price * 100
            execution_time = time.time() - start_time
            
            result = {
                'success': True,
                'algorithm': 'SMART',
                'pair': pair,
                'direction': direction,
                'total_size': size,
                'avg_price': executed_price,
                'avg_slippage': slippage,
                'venue': best_venue,
                'venue_prices': venue_prices,
                'venue_quality': venue_quality,
                'execution_time': execution_time,
                'predicted_slippage': predicted_slippage * 100,
                'timestamp': datetime.now().isoformat()
            }
            
            # Calculate quality score
            quality_score = self.calculate_execution_quality(order, result)
            result['quality_score'] = quality_score
            
            self._update_performance(result)
