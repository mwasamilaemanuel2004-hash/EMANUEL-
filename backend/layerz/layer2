    def execute_iceberg(self, order: Dict[str, Any]) -> Dict[str, Any]:
        """Execute order using Iceberg algorithm (hidden orders)"""
        try:
            size = order.get('size', 1.0)
            price = order.get('price', 0.0)
            direction = order.get('direction', 'buy')
            pair = order.get('pair', 'unknown')
            visible_size = min(self.config.iceberg_visible_size, size)
            
            if size <= 0 or price <= 0:
                return {'success': False, 'message': 'Invalid order parameters', 'algorithm': 'ICEBERG'}
            
            # Predict slippage
            predicted_slippage = self.predict_slippage(order)
            if predicted_slippage > self.config.max_slippage_percent / 100:
                return {
                    'success': False, 
                    'message': f'Predicted slippage {predicted_slippage:.2f}% exceeds limit',
                    'algorithm': 'ICEBERG'
                }
            
            # Split into visible chunks
            chunks = []
            remaining = size
            
            while remaining > 0:
                chunk = min(visible_size, remaining)
                chunks.append(chunk)
                remaining -= chunk
            
            start_time = time.time()
            
            execution_results = []
            total_slippage = 0.0
            
            for i, chunk in enumerate(chunks):
                # Simulate stealth execution with minimal price impact
                price_impact = np.random.normal(0, self.current_volatility * 0.002)
                current_price = price + price_impact
                
                slippage = abs(current_price - price) / price * 100
                total_slippage += slippage
                
                execution_results.append({
                    'chunk': i + 1,
                    'size': chunk,
                    'price': current_price,
                    'slippage': slippage,
                    'visible': i == 0  # First chunk is visible
                })
                
                time.sleep(0.02)  # 20ms between chunks
            
            avg_price = sum(r['price'] * r['size'] for r in execution_results) / sum(r['size'] for r in execution_results)
            avg_slippage = total_slippage / len(execution_results)
            execution_time = time.time() - start_time
            
            # Record dark pool usage
            if len(chunks) > 1:
                self.performance['dark_pool_usage'] += 1
            
            result = {
                'success': True,
                'algorithm': 'ICEBERG',
                'pair': pair,
                'direction': direction,
                'total_size': size,
                'avg_price': avg_price,
                'avg_slippage': avg_slippage,
                'chunks': execution_results,
                'execution_time': execution_time,
                'venue': 'dark_pool',
                'predicted_slippage': predicted_slippage * 100,
                'timestamp': datetime.now().isoformat()
            }
            
            # Calculate quality score
            quality_score = self.calculate_execution_quality(order, result)
            result['quality_score'] = quality_score
            
            self._update_performance(result)
            self._log_debug(f"Iceberg execution: {result['total_size']:.2f} @ {result['avg_price']:.4f}, quality={quality_score:.2f}")
            
