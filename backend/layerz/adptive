    def manual_regime_override(self, regime: str) -> bool:
        """Manually override the detected regime"""
        try:
            regime_map = {
                'strong_trend': MarketRegime.STRONG_TREND,
                'weak_trend': MarketRegime.WEAK_TREND,
                'ranging': MarketRegime.RANGING,
                'high_volatility': MarketRegime.HIGH_VOLATILITY,
                'low_volatility': MarketRegime.LOW_VOLATILITY,
                'news_impact': MarketRegime.NEWS_IMPACT,
                'low_liquidity': MarketRegime.LOW_LIQUIDITY
            }
            
            if regime not in regime_map:
                return False
            
            new_regime = regime_map[regime]
            self._handle_regime_change(new_regime)
            self._log_debug(f"MANUAL OVERRIDE: Set regime to {regime}", "info")
            return True
            
        except Exception as e:
            self._log_debug(f"Error in manual_regime_override: {str(e)}", "error")
            return False