class ExecutionQualityLevel(Enum):
    """Execution quality levels"""
    EXCELLENT = "excellent"   # Score >= 90
    GOOD = "good"             # Score >= 80
    ACCEPTABLE = "acceptable" # Score >= 70
    POOR = "poor"             # Score >= 60
    REJECT = "reject"         # Score < 60


@dataclass
class ExecutionQualityConfig:
    """Configuration for Execution Quality Engine - ULTIMATE"""
    
    # SPREAD
    max_spread_percent: float = 0.0005  # 0.05% max spread
    min_spread_percent: float = 0.00001 # 0.001% min spread
    spread_tolerance_multiplier: float = 1.5
    
    # SLIPPAGE
    max_slippage_percent: float = 0.005  # 0.5% max slippage
    slippage_prediction_window: int = 20
    slippage_penalty_multiplier: float = 2.0
    
    # LATENCY
    max_latency_ms: float = 100.0  # 100ms max
    min_latency_ms: float = 10.0   # 10ms min
    latency_tolerance_ms: float = 50.0
    
    # LIQUIDITY
    min_liquidity_units: float = 10000
    liquidity_check_window: int = 10
    liquidity_penalty_multiplier: float = 1.5
    
    # FEES
    fee_taker: float = 0.001  # 0.1%
    fee_maker: float = 0.0005 # 0.05%
    fee_estimate_buffer: float = 0.0001 # 0.01%
    
    # MARKET IMPACT
    market_impact_threshold: float = 0.001  # 0.1%
    market_impact_window: int = 10
    
    # EXECUTION SCORE
    min_quality_score: float = 70.0
    quality_weights: Dict[str, float] = field(default_factory=lambda: {
        'spread': 0.18,
        'slippage': 0.18,
        'latency': 0.15,
        'liquidity': 0.12,
        'fee': 0.12,
        'impact': 0.10,
        'venue': 0.08,
        'fill_rate': 0.07
    })
    
    # AUTO-CORRECTION
    auto_correction_threshold: float = 0.15  # 15% degradation triggers correction
    correction_step: float = 0.05
    
    # DEBUG
    debug_mode: bool = True
    max_history_size: int = 10000


class ExecutionQualityEngine:
    """
    Execution Quality Engine - ULTIMATE UPGRADE
    Ensures trade execution quality with 8-factor scoring.
    """
    
    def __init__(self, config: Optional[ExecutionQualityConfig] = None):
        self.config = config or ExecutionQualityConfig()
        self.debug_mode = self.config.debug_mode
        
        # PERFORMANCE TRACKING
        self.performance = {
            'total_checks': 0,
            'executions_approved': 0,
            'executions_rejected': 0,
            'executions_partial': 0,
            'avg_quality_score': 0.0,
            'avg_latency': 0.0,
            'avg_slippage': 0.0,
            'avg_spread': 0.0,
            'rejection_reasons': {},
            'slippage_events': deque(maxlen=1000),
            'latency_events': deque(maxlen=1000),
            'spread_events': deque(maxlen=1000),
            'auto_corrections': 0,
            'best_venue': None
        }
        
        # QUALITY STATE
        self.quality_scores = {}
        self.broker_quality = {}
        self.exchange_quality = {}
        self.venue_ranking = {}
        
        # MARKET CONTEXT
        self.current_spread = 0.0
        self.current_volatility = 0.0
        self.current_liquidity = 0.0
        self.current_volume = 0.0
        
        # HISTORY
        self.history = deque(maxlen=self.config.max_history_size)
        self.rejection_history = deque(maxlen=1000)
        
        # LOCK
        self._lock = threading.Lock()
        
        self._log_debug("Execution Quality Engine initialized - ULTIMATE UPGRADE", "info")
        logger.info("Execution Quality Engine initialized - ULTIMATE UPGRADE")
    
    def _log_debug(self, message: str, level: str = "debug") -> None:
        """Debug logging with timestamp"""
        if self.debug_mode:
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
            log_msg = f"[DEBUG {timestamp}] {message}"
            if level == "info":
                logger.info(log_msg)
            elif level == "warning":
                logger.warning(log_msg)
            elif level == "error":
                logger.error(log_msg)
            else:
                logger.debug(log_msg)
    
    def update_market_data(self, market_data: Dict[str, Any]) -> None:
        """Update market context with error handling"""
        try:
            if not isinstance(market_data, dict):
                self._log_debug("Invalid market_data: not a dict", "warning")
                return
            
            self.current_spread = market_data.get('spread', 0.0) or 0.0
            self.current_volatility = market_data.get('volatility', 0.0) or 0.0
            self.current_liquidity = market_data.get('liquidity', 0.0) or 0.0
            self.current_volume = market_data.get('volume', 0.0) or 0.0
            
            # Track spread
            if self.current_spread > 0:
                self.performance['spread_events'].append(self.current_spread)
                self.performance['avg_spread'] = sum(self.performance['spread_events']) / len(self.performance['spread_events']) if self.performance['spread_events'] else 0
            
            # Auto-correction check
            self._check_auto_correction()
            
        except Exception as e:
            self._log_debug(f"Error in update_market_data: {str(e)}", "error")
    
    def _check_auto_correction(self) -> None:
        """Auto-correction to optimize execution quality"""
        try:
            # Check if quality is degrading
            if len(self.history) > 20:
                recent = list(self.history)[-20:]
                recent_scores = [r.get('quality_score', 70) for r in recent]
                avg_recent = sum(recent_scores) / len(recent_scores) if recent_scores else 70
                
                older = list(self.history)[-40:-20] if len(self.history) >= 40 else []
                if older:
                    older_scores = [r.get('quality_score', 70) for r in older]
                    avg_older = sum(older_scores) / len(older_scores) if older_scores else 70
                    
                    if avg_older - avg_recent > self.config.auto_correction_threshold:
                        # Degradation detected - adjust thresholds
                        self.config.max_slippage_percent *= (1 + self.config.correction_step)
                        self.config.max_latency_ms *= (1 + self.config.correction_step)
                        self.performance['auto_corrections'] += 1
                        
                        self._log_debug(f"AUTO-CORRECTION: Adjusted thresholds - slippage: {self.config.max_slippage_percent:.4f}, latency: {self.config.max_latency_ms:.1f}ms", "info")
            
            # Update venue ranking
            self._update_venue_ranking()
            
        except Exception as e:
            self._log_debug(f"Error in _check_auto_correction: {str(e)}", "error")
    
    def _update_venue_ranking(self) -> None:
        """Update venue ranking based on performance"""
        try:
            if len(self.history) > 10:
                venue_scores = {}
                for entry in self.history:
                    venue = entry.get('venue', 'unknown')
                    score = entry.get('quality_score', 0)
                    if venue not in venue_scores:
                        venue_scores[venue] = []
                    venue_scores[venue].append(score)
                
                for venue, scores in venue_scores.items():
                    if scores:
                        avg_score = sum(scores) / len(scores)
                        self.venue_ranking[venue] = avg_score
                
                # Find best venue
                if self.venue_ranking:
                    best = max(self.venue_ranking, key=self.venue_ranking.get)
                    self.performance['best_venue'] = best
                    
        except Exception as e:
            self._log_debug(f"Error in _update_venue_ranking: {str(e)}", "error")
    
    def calculate_quality_score(self, execution_data: Dict[str, Any]) -> Dict[str, Any]:
        """
        Calculate execution quality score with 8 factors
        Returns: quality_score, quality_level, and detailed metrics
        """
        try:
            self.performance['total_checks'] += 1
            
            # Extract data with safe gets
            price = execution_data.get('price', 0.0)
            size = execution_data.get('size', 0.0)
            expected_price = execution_data.get('expected_price', price)
            entry_time = execution_data.get('entry_time', datetime.now())
            execution_time = execution_data.get('execution_time', datetime.now())
            pair = execution_data.get('pair', 'unknown')
            venue = execution_data.get('venue', 'unknown')
            order_type = execution_data.get('order_type', 'market')
            filled_size = execution_data.get('filled_size', size)
            
            # ============================================================
            # 1. SPREAD CHECK (18%)
            # ============================================================
            spread = self.current_spread
            if spread == 0:
                spread_quality = 100.0
            elif spread < self.config.max_spread_percent:
                spread_quality = 100.0 - (spread / self.config.max_spread_percent * 100)
            else:
                spread_quality = max(0, 100.0 - (spread / self.config.max_spread_percent * 100 * self.config.spread_tolerance_multiplier))
            spread_quality = max(0, min(100, spread_quality))
            
            # ============================================================
            # 2. SLIPPAGE CHECK (18%)
            # ============================================================
            if expected_price > 0:
                slippage = abs(price - expected_price) / expected_price
                slippage_percent = slippage * 100
            else:
                slippage_percent = 0
            
            if slippage_percent < self.config.max_slippage_percent:
                slippage_quality = 100.0 - (slippage_percent / self.config.max_slippage_percent * 100)
            else:
                slippage_quality = max(0, 100.0 - (slippage_percent / self.config.max_slippage_percent * 100 * self.config.slippage_penalty_multiplier))
            slippage_quality = max(0, min(100, slippage_quality))
            
            # Track slippage
            self.performance['slippage_events'].append(slippage_percent)
            self.performance['avg_slippage'] = sum(self.performance['slippage_events']) / len(self.performance['slippage_events']) if self.performance['slippage_events'] else 0
            
            # ============================================================
            # 3. LATENCY CHECK (15%)
            # ============================================================
            if execution_time and entry_time:
                latency = (execution_time - entry_time).total_seconds() * 1000
            else:
                latency = 0
            
            if latency <= self.config.max_latency_ms:
                latency_quality = 100.0 - (latency / self.config.max_latency_ms * 100)
            else:
                latency_quality = max(0, 100.0 - (latency / self.config.max_latency_ms * 100 * 1.5))
            latency_quality = max(0, min(100, latency_quality))
            
            # Track latency
            self.performance['latency_events'].append(latency)
            self.performance['avg_latency'] = sum(self.performance['latency_events']) / len(self.performance['latency_events']) if self.performance['latency_events'] else 0
            
            # ============================================================
            # 4. LIQUIDITY CHECK (12%)
            # ============================================================
            liquidity = self.current_liquidity
            if liquidity >= self.config.min_liquidity_units:
                liquidity_quality = min(100, (liquidity / self.config.min_liquidity_units) * 100)
            else:
                liquidity_quality = max(0, (liquidity / self.config.min_liquidity_units) * 100 * self.config.liquidity_penalty_multiplier)
            liquidity_quality = max(0, min(100, liquidity_quality))
            
            # ============================================================
            # 5. FEE CHECK (12%)
            # ============================================================
            if order_type.lower() == 'market':
                fee_rate = self.config.fee_taker
            else:
                fee_rate = self.config.fee_maker
            
            fee = size * price * fee_rate
            fee_quality = 100.0 - (fee_rate * 1000 * 10)  # Scale for visibility
            fee_quality = max(0, min(100, fee_quality))
            
            # ============================================================
            # 6. MARKET IMPACT CHECK (10%)
            # ============================================================
            impact_quality = 100.0
            if size > 0 and self.current_liquidity > 0:
                impact_ratio = size / max(self.current_liquidity, 1)
                if impact_ratio > self.config.market_impact_threshold:
                    impact_quality = max(0, 100.0 - (impact_ratio / self.config.market_impact_threshold * 100 * 1.2))
                impact_quality = max(0, min(100, impact_quality))
            
            # ============================================================
            # 7. VENUE QUALITY (8%)
            # ============================================================
            venue_quality = self.broker_quality.get(venue, 85.0)
            if venue in self.venue_ranking:
                venue_quality = (venue_quality + self.venue_ranking[venue]) / 2
            
            # ============================================================
            # 8. FILL RATE (7%)
            # ============================================================
            if size > 0:
                fill_rate = filled_size / size
            else:
                fill_rate = 1.0
            fill_rate_quality = fill_rate * 100
            fill_rate_quality = max(0, min(100, fill_rate_quality))
            
            # ============================================================
            # CALCULATE WEIGHTED SCORE
            # ============================================================
            weights = self.config.quality_weights
            
            quality_score = (
                spread_quality * weights['spread'] +
                slippage_quality * weights['slippage'] +
                latency_quality * weights['latency'] +
                liquidity_quality * weights['liquidity'] +
                fee_quality * weights['fee'] +
                impact_quality * weights['impact'] +
                venue_quality * weights['venue'] +
                fill_rate_quality * weights['fill_rate']
            )
            
            # ============================================================
            # DETERMINE QUALITY LEVEL
            # ============================================================
            if quality_score >= 90:
                level = ExecutionQualityLevel.EXCELLENT
            elif quality_score >= 80:
                level = ExecutionQualityLevel.GOOD
            elif quality_score >= 70:
                level = ExecutionQualityLevel.ACCEPTABLE
            elif quality_score >= 60:
                level = ExecutionQualityLevel.POOR
            else:
                level = ExecutionQualityLevel.REJECT
            
            # Update performance
            self.performance['avg_quality_score'] = (self.performance['avg_quality_score'] * (self.performance['total_checks'] - 1) + quality_score) / self.performance['total_checks']
            
            result = {
                'quality_score': quality_score,
                'quality_level': level.value,
                'passed': quality_score >= self.config.min_quality_score,
                'metrics': {
                    'spread': spread,
                    'spread_quality': spread_quality,
                    'slippage': slippage_percent,
                    'slippage_quality': slippage_quality,
                    'latency': latency,
                    'latency_quality': latency_quality,
                    'liquidity': liquidity,
                    'liquidity_quality': liquidity_quality,
                    'fee': fee,
                    'fee_quality': fee_quality,
                    'impact_quality': impact_quality,
                    'venue_quality': venue_quality,
                    'fill_rate': fill_rate,
                    'fill_rate_quality': fill_rate_quality
                },
                'venue': venue,
                'order_type': order_type,
                'pair': pair,
                'timestamp': datetime.now().isoformat()
            }
            
            self.history.append(result)
            
            self._log_debug(f"Quality score: {quality_score:.1f} ({level.value}) - Venue: {venue}")
            return result
            
        except Exception as e:
            self._log_debug(f"Error in calculate_quality_score: {str(e)}", "error")
            return {'quality_score': 50.0, 'quality_level': 'reject', 'passed': False, 'error': str(e)}
    
    def check_execution(self, execution_data: Dict[str, Any]) -> Tuple[bool, str, float]:
        """
        Check if execution is acceptable
        Returns: (can_execute, reason, adjusted_size)
        """
        try:
            quality = self.calculate_quality_score(execution_data)
            
            if not quality.get('passed', False):
                reason = quality.get('quality_level', 'unknown')
                self.performance['executions_rejected'] += 1
                self.performance['rejection_reasons'][reason] = self.performance['rejection_reasons'].get(reason, 0) + 1
                self.rejection_history.append({
                    'timestamp': datetime.now(),
                    'reason': reason,
                    'quality': quality
                })
                return False, f"Quality check failed: {reason}", 0.0
            
            # Adjust size based on quality
            score = quality.get('quality_score', 70)
            if score >= 90:
                size_multiplier = 1.0
            elif score >= 80:
                size_multiplier = 0.9
            elif score >= 70:
                size_multiplier = 0.8
            else:
                size_multiplier = 0.5
            
            # Check if partial fill
            fill_rate = quality.get('metrics', {}).get('fill_rate', 1.0)
            if fill_rate < 0.9 and fill_rate > 0:
                self.performance['executions_partial'] += 1
            
            self.performance['executions_approved'] += 1
            return True, f"Execution approved (quality: {score:.1f})", size_multiplier
            
        except Exception as e:
            self._log_debug(f"Error in check_execution: {str(e)}", "error")
            return False, f"Error: {str(e)}", 0.0
    
    def get_best_venue(self, pair: str = None) -> str:
        """Get the best venue for execution"""
        try:
            if not self.venue_ranking:
                return 'primary'
            
            # If pair-specific ranking available, use it
            if pair and pair in self.exchange_quality:
                return max(self.exchange_quality[pair], key=self.exchange_quality[pair].get)
            
            return self.performance.get('best_venue', 'primary')
            
        except Exception as e:
            self._log_debug(f"Error in get_best_venue: {str(e)}", "error")
            return 'primary'
    
    def get_status(self) -> Dict[str, Any]:
        """Get current status"""
        try:
            total = self.performance['total_checks']
            approved = self.performance['executions_approved']
            rejected = self.performance['executions_rejected']
            partial = self.performance['executions_partial']
            
            return {
                'total_checks': total,
                'executions_approved': approved,
                'executions_rejected': rejected,
                'executions_partial': partial,
                'approval_rate': (approved / total * 100) if total > 0 else 0,
                'rejection_rate': (rejected / total * 100) if total > 0 else 0,
                'avg_quality_score': self.performance['avg_quality_score'],
                'avg_latency_ms': self.performance['avg_latency'],
                'avg_slippage_percent': self.performance['avg_slippage'],
                'avg_spread': self.performance['avg_spread'],
                'rejection_reasons': self.performance['rejection_reasons'],
                'broker_quality': self.broker_quality,
                'venue_ranking': self.venue_ranking,
                'best_venue': self.performance.get('best_venue', 'unknown'),
                'auto_corrections': self.performance['auto_corrections'],
                'current_spread': self.current_spread,
                'current_volatility': self.current_volatility,
                'current_liquidity': self.current_liquidity,
                'timestamp': datetime.now().isoformat()
            }
        except Exception as e:
            self._log_debug(f"Error in get_status: {str(e)}", "error")
            return {'status': 'ERROR', 'error': str(e)}
    
    def get_performance_report(self) -> Dict[str, Any]:
        """Get detailed performance report"""
        try:
            total = self.performance['total_checks']
            approved = self.performance['executions_approved']
            rejected = self.performance['executions_rejected']
            
            # Calculate quality distribution
            quality_scores = [h.get('quality_score', 0) for h in self.history if 'quality_score' in h]
            if quality_scores:
                distribution = {
                    'excellent': sum(1 for s in quality_scores if s >= 90),
                    'good': sum(1 for s in quality_scores if 80 <= s < 90),
                    'acceptable': sum(1 for s in quality_scores if 70 <= s < 80),
                    'poor': sum(1 for s in quality_scores if 60 <= s < 70),
                    'reject': sum(1 for s in quality_scores if s < 60)
                }
            else:
                distribution = {}
            
            return {
                'summary': {
                    'total_checks': total,
                    'executions_approved': approved,
                    'executions_rejected': rejected,
                    'executions_partial': self.performance['executions_partial'],
                    'approval_rate': (approved / total * 100) if total > 0 else 0,
                    'rejection_rate': (rejected / total * 100) if total > 0 else 0,
                    'avg_quality_score': self.performance['avg_quality_score']
                },
                'quality_distribution': distribution,
                'metrics': {
                    'avg_latency_ms': self.performance['avg_latency'],
                    'avg_slippage_percent': self.performance['avg_slippage'],
                    'avg_spread': self.performance['avg_spread'],
                    'rejection_reasons': self.performance['rejection_reasons']
                },
                'venue_ranking': self.venue_ranking,
                'best_venue': self.performance.get('best_venue', 'unknown'),
                'auto_corrections': self.performance['auto_corrections'],
                'recent_quality': list(self.history)[-10:] if self.history else [],
                'recent_rejections': list(self.rejection_history)[-5:] if self.rejection_history else [],
                'timestamp': datetime.now().isoformat()
            }
        except Exception as e:
            self._log_debug(f"Error in get_performance_report: {str(e)}", "error")
            return {'error': str(e)}