    def emergency_stop(self) -> None:
        """Emergency stop - stop all trading"""
        try:
            self.mode = ProtectionMode.EMERGENCY
            self.config.max_position_size = 0.0
            self.config.max_leverage = 0.0
            self.circuit_breaker_active = True
            self.circuit_breaker_until = datetime.now() + timedelta(hours=24)
            self.circuit_breaker_reason = "Manual emergency stop"
            self._send_alert("emergency", "EMERGENCY STOP ACTIVATED")
            self._log_debug("EMERGENCY STOP ACTIVATED", "error")
            logger.error("EMERGENCY STOP ACTIVATED")
        except Exception as e:
            self._log_debug(f"Error in emergency_stop: {str(e)}", "error")
    
    def emergency_resume(self) -> None:
        """Resume trading after emergency stop"""
        try:
            self.mode = ProtectionMode.RECOVERY
            self.config.max_position_size = 0.5
            self.config.max_leverage = 2.0
            self.circuit_breaker_active = False
            self.circuit_breaker_until = None
            self.circuit_breaker_reason = None
            self.is_recovering = True
            self.recovery_start = datetime.now()
            self.recovery_target = self.peak_capital
            self._send_alert("info", "Emergency stop lifted. Resuming in RECOVERY mode")
            self._log_debug("Emergency stop lifted. Resuming in RECOVERY mode", "info")
            logger.info("Emergency stop lifted. Resuming in RECOVERY mode")
        except Exception as e:
            self._log_debug(f"Error in emergency_resume: {str(e)}", "error")