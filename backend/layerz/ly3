    def save_models(self, path: Optional[str] = None) -> None:
        """Save trained models to disk"""
        try:
            save_path = path or self.config.model_save_path
            os.makedirs(save_path, exist_ok=True)
            
            for model_name, model in self.models.items():
                if model is not None:
                    model_path = os.path.join(save_path, f"{model_name}.pkl")
                    with open(model_path, 'wb') as f:
                        pickle.dump(model, f)
                    
            self._log_debug(f"Models saved to {save_path}", "info")
            
        except Exception as e:
            self._log_debug(f"Error saving models: {str(e)}", "error")
    
    def load_models(self, path: Optional[str] = None) -> None:
        """Load trained models from disk"""
        try:
            load_path = path or self.config.model_save_path
            
            for model_name in self.models:
                model_path = os.path.join(load_path, f"{model_name}.pkl")
                if os.path.exists(model_path):
                    with open(model_path, 'rb') as f:
                        self.models[model_name] = pickle.load(f)
                    
            self._log_debug(f"Models loaded from {load_path}", "info")
            
        except Exception as e:
            self._log_debug(f"Error loading models: {str(e)}", "error")