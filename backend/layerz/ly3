    def _create_lstm_model(self):
        """Create LSTM model with PyTorch"""
        if not TORCH_AVAILABLE:
            return None
        
        class LSTMModel(nn.Module):
            def __init__(self, input_size=50, hidden_size=128, num_layers=2, output_size=3):
                super(LSTMModel, self).__init__()
                self.lstm = nn.LSTM(input_size, hidden_size, num_layers, batch_first=True, dropout=0.2)
                self.fc1 = nn.Linear(hidden_size, 64)
                self.fc2 = nn.Linear(64, 32)
                self.fc3 = nn.Linear(32, output_size)
                self.dropout = nn.Dropout(0.3)
                self.relu = nn.ReLU()
            
            def forward(self, x):
                lstm_out, _ = self.lstm(x)
                out = self.relu(self.fc1(lstm_out[:, -1, :]))
                out = self.dropout(out)
                out = self.relu(self.fc2(out))
                out = self.dropout(out)
                out = self.fc3(out)
                return out
        
        return LSTMModel(input_size=self.config.n_features)
    
    def _create_transformer_model(self):
        """Create Transformer model with PyTorch"""
        if not TORCH_AVAILABLE:
            return None
        
        class TransformerModel(nn.Module):
            def __init__(self, input_size=50, d_model=128, nhead=8, num_layers=3, output_size=3):
                super(TransformerModel, self).__init__()
                self.embedding = nn.Linear(input_size, d_model)
                self.pos_encoder = nn.Linear(1, d_model)  # Positional encoding
                
                encoder_layer = nn.TransformerEncoderLayer(
                    d_model=d_model, 
                    nhead=nhead, 
                    dim_feedforward=512,
                    dropout=0.1,
                    batch_first=True
                )
                self.transformer = nn.TransformerEncoder(encoder_layer, num_layers=num_layers)
                self.fc1 = nn.Linear(d_model, 64)
                self.fc2 = nn.Linear(64, 32)
                self.fc3 = nn.Linear(32, output_size)
                self.relu = nn.ReLU()
                self.dropout = nn.Dropout(0.3)
            
            def forward(self, x):
                # Embedding
                x = self.embedding(x)
                
                # Positional encoding
                positions = torch.arange(x.size(1), device=x.device).float().unsqueeze(0).unsqueeze(-1)
                pos_enc = self.pos_encoder(positions).expand(x.size(0), -1, -1)
                x = x + pos_enc
                
                # Transformer
                x = self.transformer(x)
                x = x.mean(dim=1)  # Global average pooling
                
                # Output layers
                x = self.relu(self.fc1(x))
                x = self.dropout(x)
                x = self.relu(self.fc2(x))
                x = self.dropout(x)
                x = self.fc3(x)
                return x
        
        return TransformerModel(input_size=self.config.n_features)
    
    def update_market_data(self, market_data: Dict[str, Any]) -> None:
        """Update market data and detect anomalies"""
        try:
            if not isinstance(market_data, dict):
                return
            
            # Store historical data
            self.market_data_history.append({
                'timestamp': datetime.now(),
                'data': market_data,
                'regime': market_data.get('regime', 'unknown'),
                'volatility': market_data.get('volatility', 0.0)
            })
            
            # Update current state
            self.current_regime = market_data.get('regime', 'unknown') or 'unknown'
            self.current_volatility = market_data.get('volatility', 0.0) or 0.0
            
            # Detect anomalies
            self._detect_anomalies(market_data)
            
            # Check if retraining is needed
            if self._should_retrain():
                self._retrain_models()
            
            self._log_debug(f"Market data updated: regime={self.current_regime}, volatility={self.current_volatility:.2f}")
            
        except Exception as e:
            self._log_debug(f"Error in update_market_data: {str(e)}", "error")
    
    def _detect_anomalies(self, market_data: Dict[str, Any]) -> None:
        """Detect market anomalies using AI"""
        try:
            # Multiple anomaly detection methods
            anomalies = []
            
            # 1. Volatility spike detection
            if self.current_volatility > 3.0:
                anomalies.append(f"Extreme volatility: {self.current_volatility:.2f}")
            
            # 2. Price movement anomaly
            price_change = market_data.get('price_change', 0.0) or 0.0
            if abs(price_change) > 5.0:
                anomalies.append(f"Large price move: {price_change:.2f}%")
            
            # 3. Volume spike detection
            volume = market_data.get('volume', 0.0) or 0.0
            avg_volume = market_data.get('avg_volume', volume) or volume
            if volume > avg_volume * 3:
                anomalies.append(f"Volume spike: {volume/avg_volume:.1f}x average")
            
            # 4. Spread anomaly
            spread = market_data.get('spread', 0.0) or 0.0
            avg_spread = market_data.get('avg_spread', spread) or spread
            if spread > avg_spread * 5:
                anomalies.append(f"Wide spread: {spread:.4f}")
            
            if anomalies:
                self.performance['anomalies_detected'] += 1
                self._log_debug(f"Anomalies detected: {anomalies}", "warning")
                
                # Alert system
                for anomaly in anomalies:
                    self._send_alert("anomaly", anomaly)
            
        except Exception as e:
            self._log_debug(f"Error in _detect_anomalies: {str(e)}", "error")
    
    def _should_retrain(self) -> bool:
        """Check if models should be retrained"""
        try:
            # Check if enough time has passed
            hours_since_training = (datetime.now() - self.last_training_time).total_seconds() / 3600
            if hours_since_training < self.config.train_interval_hours:
                return False
            
            # Check if enough data is available
            if len(self.market_data_history) < self.config.min_training_samples:
                return False
            
            # Check if performance dropped
            if self.performance['total_predictions'] > 100:
                accuracy = self.performance['correct_predictions'] / self.performance['total_predictions']
                if accuracy < self.config.retrain_threshold_accuracy:
                    return True
            
            return True
            
        except Exception as e:
            self._log_debug(f"Error in _should_retrain: {str(e)}", "error")
            return False
    
    def _retrain_models(self) -> None:
        """Retrain all AI models"""
        try:
            self._log_debug("Starting model retraining", "info")
            start_time = time.time()
            
            # Prepare training data
            X_train, y_train = self._prepare_training_data()
            
            if X_train is None or y_train is None:
                self._log_debug("Insufficient training data", "warning")
                return
            
            # Train each model
            for model_name, model in self.models.items():
                if model is not None and model_name != 'ensemble':
                    self._train_single_model(model_name, model, X_train, y_train)
            
            # Train ensemble
            self._train_ensemble(X_train, y_train)
            
            self.last_training_time = datetime.now()
            self.performance['retraining_events'] += 1
            training_time = time.time() - start_time
            
            self._log_debug(f"Model retraining completed in {training_time:.2f}s", "info")
            logger.info(f"Model retraining completed in {training_time:.2f}s")
            
        except Exception as e:
            self._log_debug(f"Error in _retrain_models: {str(e)}", "error")
    
    def _prepare_training_data(self) -> Tuple[Optional[np.ndarray], Optional[np.ndarray]]:
        """Prepare training data from historical market data"""
        try:
            if len(self.market_data_history) < self.config.min_training_samples:
                return None, None
            
            # Extract features and labels
            features = []
            labels = []
            
            for item in list(self.market_data_history)[-self.config.min_training_samples:]:
                data = item.get('data', {})
                
                # Feature engineering
                feature_vector = self._extract_features(data)
                if feature_vector is not None:
                    features.append(feature_vector)
                    
                    # Label: 1 = bullish, 0 = neutral, -1 = bearish
                    price_change = data.get('price_change', 0.0) or 0.0
                    if price_change > 0.5:
                        labels.append(1)
                    elif price_change < -0.5:
                        labels.append(-1)
                    else:
                        labels.append(0)
            
            if len(features) < self.config.min_training_samples:
                return None, None
            
            # Scale features
            features = np.array(features)
            self.scaler.fit(features)
            features_scaled = self.scaler.transform(features)
            
            return features_scaled, np.array(labels)
            
        except Exception as e:
            self._log_debug(f"Error in _prepare_training_data: {str(e)}", "error")
            return None, None
    
    def _extract_features(self, data: Dict[str, Any]) -> Optional[np.ndarray]:
        """Extract feature vector from market data"""
        try:
            features = []
            
            # Price features
            features.append(data.get('price', 0.0) or 0.0)
            features.append(data.get('price_change', 0.0) or 0.0)
            features.append(data.get('high', 0.0) or 0.0)
            features.append(data.get('low', 0.0) or 0.0)
            
            # Volume features
            features.append(data.get('volume', 0.0) or 0.0)
            features.append(data.get('volume_change', 0.0) or 0.0)
            
            # Volatility features
            features.append(data.get('volatility', 0.0) or 0.0)
            features.append(data.get('atr', 0.0) or 0.0)
            
            # Technical indicators
            features.append(data.get('rsi', 50.0) or 50.0)
            features.append(data.get('macd', 0.0) or 0.0)
            features.append(data.get('adx', 0.0) or 0.0)
            
            # Spread features
            features.append(data.get('spread', 0.0) or 0.0)
            
            # Regime encoding
            regime = str(data.get('regime', 'unknown')).lower()
            regime_encoded = {
                'strong_trend': 1.0,
                'weak_trend': 0.5,
                'ranging': 0.0,
                'volatile': -0.5,
                'news': -1.0
            }.get(regime, 0.0)
            features.append(regime_encoded)
            
            # Sentiment (if available)
            features.append(data.get('sentiment', 0.0) or 0.0)
            
            return np.array(features[:self.config.n_features])
            
        except Exception as e:
            self._log_debug(f"Error in _extract_features: {str(e)}", "error")
            return None
    
    def _train_single_model(self, model_name: str, model, X_train: np.ndarray, y_train: np.ndarray) -> None:
        """Train a single model"""
        try:
            if model is None:
                return
            
            # For PyTorch models
            if model_name in ['lstm', 'transformer'] and TORCH_AVAILABLE:
                self._train_deep_learning_model(model_name, model, X_train, y_train)
                return
            
            # For sklearn models
            model.fit(X_train, y_train)
            
            # Evaluate
            y_pred = model.predict(X_train)
            accuracy = accuracy_score(y_train, y_pred)
            f1 = f1_score(y_train, y_pred, average='weighted')
            
            self.model_performance[model_name] = {
                'accuracy': accuracy,
                'f1': f1,
                'usage': self.model_performance.get(model_name, {}).get('usage', 0)
            }
            
            self.performance['model_accuracy'][model_name] = accuracy
            
            self._log_debug(f"Model {model_name} trained: accuracy={accuracy:.3f}, f1={f1:.3f}")
            
        except Exception as e:
            self._log_debug(f"Error training {model_name}: {str(e)}", "error")
    
    def _train_deep_learning_model(self, model_name: str, model, X_train: np.ndarray, y_train: np.ndarray) -> None:
        """Train deep learning model with PyTorch"""
        if not TORCH_AVAILABLE:
            return
        
        try:
            # Convert to PyTorch tensors
            X_tensor = torch.FloatTensor(X_train).unsqueeze(1)  # Add sequence dimension
            y_tensor = torch.LongTensor(y_train + 1)  # Shift labels to 0,1,2
            
            # Create dataset
            dataset = TensorDataset(X_tensor, y_tensor)
            dataloader = DataLoader(dataset, batch_size=32, shuffle=True)
            
            # Training setup
            optimizer = optim.Adam(model.parameters(), lr=0.001)
            criterion = nn.CrossEntropyLoss()
            
            # Train for epochs
            epochs = 10
            for epoch in range(epochs):
                for batch_X, batch_y in dataloader:
                    optimizer.zero_grad()
                    output = model(batch_X)
                    loss = criterion(output, batch_y)
                    loss.backward()
                    optimizer.step()
            
            # Evaluate
            model.eval()
            with torch.no_grad():
                predictions = model(X_tensor)
                _, predicted = torch.max(predictions, 1)
                accuracy = (predicted == y_tensor).float().mean().item()
                
                self.model_performance[model_name] = {
                    'accuracy': accuracy,
                    'f1': accuracy,  # Simplified
                    'usage': self.model_performance.get(model_name, {}).get('usage', 0)
                }
                
                self.performance['model_accuracy'][model_name] = accuracy
                self._log_debug(f"Deep Learning model {model_name} trained: accuracy={accuracy:.3f}")
            
        except Exception as e:
            self._log_debug(f"Error training deep learning model {model_name}: {str(e)}", "error")
    
    def _train_ensemble(self, X_train: np.ndarray, y_train: np.ndarray) -> None:
        """Train ensemble model"""
        try:
            # Collect predictions from all models
            predictions = []
            for model_name, model in self.models.items():
                if model is not None and model_name != 'ensemble':
                    try:
                        if model_name in ['lstm', 'transformer'] and TORCH_AVAILABLE:
                            # Deep learning model prediction
                            X_tensor = torch.FloatTensor(X_train).unsqueeze(1)
                            model.eval()
                            with torch.no_grad():
                                output = model(X_tensor)
                                _, pred = torch.max(output, 1)
                                pred_np = pred.numpy() - 1  # Shift back
                        else:
                            pred_np = model.predict(X_train)
                        
                        predictions.append(pred_np)
                    except Exception as e:
                        self._log_debug(f"Error getting predictions from {model_name}: {str(e)}", "warning")
            
            if not predictions:
                return
            
            # Stack predictions and take mode (majority vote)
            stacked = np.stack(predictions, axis=0)
            ensemble_pred = np.apply_along_axis(lambda x: np.bincount(x + 1).argmax() - 1, 0, stacked)
            
            # Calculate ensemble accuracy
            accuracy = accuracy_score(y_train, ensemble_pred)
            self.model_performance['ensemble'] = {
                'accuracy': accuracy,
                'f1': f1_score(y_train, ensemble_pred, average='weighted'),
                'usage': 0
            }
            
            self.performance['model_accuracy']['ensemble'] = accuracy
            self._log_debug(f"Ensemble model trained: accuracy={accuracy:.3f}")
            
        except Exception as e:
            self._log_debug(f"Error training ensemble: {str(e)}", "error")
    
    def predict(self, market_data: Dict[str, Any]) -> Dict[str, Any]:
        """
        Make prediction using the best available model
        Returns: prediction_result with direction, confidence, and details
        """
        try:
            self.performance['total_predictions'] += 1
            start_time = time.time()
            
            # Extract features
            features = self._extract_features(market_data)
            if features is None:
                return {'direction': 0, 'confidence': 0.5, 'error': 'Feature extraction failed'}
            
            # Scale features
            features_scaled = self.scaler.transform(features.reshape(1, -1))
            
            # Select best model
            best_model = self._select_best_model()
            
            # Make prediction
            prediction = None
            confidence = 0.5
            
            if best_model in ['lstm', 'transformer'] and TORCH_AVAILABLE:
                # Deep learning model
                X_tensor = torch.FloatTensor(features_scaled).unsqueeze(1)
                model = self.models.get(best_model)
                if model is not None:
                    model.eval()
                    with torch.no_grad():
                        output = model(X_tensor)
                        probabilities = torch.softmax(output, dim=1)
                        pred = torch.argmax(output, dim=1).item() - 1  # Shift back
                        confidence = probabilities[0, pred + 1].item()
                        prediction = pred
            else:
                # ML model
                model = self.models.get(best_model)
                if model is not None:
                    pred = model.predict(features_scaled)[0]
                    prediction = pred
                    
                    # Get probability if available
                    if hasattr(model, 'predict_proba'):
                        proba = model.predict_proba(features_scaled)[0]
                        confidence = max(proba)
                    else:
                        confidence = 0.6
            
            # Use ensemble if available
            if prediction is None:
                prediction = self._ensemble_predict(features_scaled)
                confidence = 0.6
            
            # Update performance
            prediction_time = time.time() - start_time
            self.performance['average_prediction_time'] = (self.performance['average_prediction_time'] * 
                                                          (self.performance['total_predictions'] - 1) + prediction_time) / \
                                                          self.performance['total_predictions']
            
            # Store prediction
            result = {
                'direction': int(prediction) if prediction is not None else 0,
                'confidence': float(confidence),
                'model_used': best_model,
                'prediction_time': prediction_time,
                'timestamp': datetime.now().isoformat()
            }
            
            self.prediction_history.append(result)
            self._log_debug(f"Prediction: direction={result['direction']}, confidence={result['confidence']:.3f}, model={best_model}")
            
            return result
            
        except Exception as e:
            self._log_debug(f"Error in predict: {str(e)}", "error")
            return {'direction': 0, 'confidence': 0.5, 'error': str(e)}
    
    def _select_best_model(self) -> str:
        """Select the best performing model"""
        try:
            # Check performance data
            if not self.model_performance:
                return 'random_forest'
            
            # Get models with accuracy
            model_scores = {}
            for model_name, perf in self.model_performance.items():
                if perf.get('accuracy', 0) > 0:
                    # Weight by usage (less used models get bonus)
                    usage = perf.get('usage', 0)
                    bonus = max(0, 0.05 - usage * 0.001)
                    model_scores[model_name] = perf.get('accuracy', 0) + bonus
            
            if model_scores:
                return max(model_scores, key=model_scores.get)
            
            return 'random_forest'
            
        except Exception as e:
            self._log_debug(f"Error in _select_best_model: {str(e)}", "error")
            return 'random_forest'
    
    def _ensemble_predict(self, features: np.ndarray) -> int:
        """Make prediction using ensemble of models"""
        try:
            predictions = []
            weights = []
            
            for model_name, model in self.models.items():
                if model is not None and model_name != 'ensemble':
                    try:
                        if model_name in ['lstm', 'transformer'] and TORCH_AVAILABLE:
                            # Deep learning
                            X_tensor = torch.FloatTensor(features).unsqueeze(1)
                            model.eval()
                            with torch.no_grad():
                                output = model(X_tensor)
                                pred = torch.argmax(output, dim=1).item() - 1
                        else:
                            pred = model.predict(features)[0]
                        
                        predictions.append(pred)
                        weights.append(self.model_weights.get(model_name, 1.0))
                    except Exception as e:
                        self._log_debug(f"Error getting ensemble prediction from {model_name}: {str(e)}", "warning")
            
            if not predictions:
                return 0
            
            # Weighted voting
            weighted_sum = sum(p * w for p, w in zip(predictions, weights))
            return 1 if weighted_sum > 0 else -1 if weighted_sum < 0 else 0
            
        except Exception as e:
            self._log_debug(f"Error in _ensemble_predict: {str(e)}", "error")
            return 0
    
    def update_prediction_result(self, actual_result: Dict[str, Any]) -> None:
        """Update model performance based on actual result"""
        try:
            if not self.prediction_history:
                return
            
            # Get last prediction
            last_pred = self.prediction_history[-1]
            if not last_pred:
                return
            
            predicted_direction = last_pred.get('direction', 0)
            actual_direction = actual_result.get('direction', 0)
            
            # Check if prediction was correct
            is_correct = predicted_direction == actual_direction
            if is_correct:
                self.performance['correct_predictions'] += 1
            
            # Update model performance
            model_used = last_pred.get('model_used', 'unknown')
            if model_used in self.model_performance:
                self.model_performance[model_used]['usage'] += 1
            
            self._log_debug(f"Prediction result: {'Correct' if is_correct else 'Incorrect'}")
            
        except Exception as e:
            self._log_debug(f"Error in update_prediction_result: {str(e)}", "error")
    
