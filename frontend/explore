    <script>
        (function () {
            'use strict';

            // ===== THEME SWITCHER =====
            const themeBtns = document.querySelectorAll('.theme-btn');

            function setTheme(theme) {
                document.body.className = document.body.className
                    .split(' ')
                    .filter(c => !c.startsWith('theme-'))
                    .join(' ');
                if (theme !== 'navy') document.body.classList.add('theme-' + theme);
                themeBtns.forEach(btn => btn.classList.toggle('active', btn.dataset.theme === theme));
                localStorage.setItem('esh_theme', theme);
            }

            themeBtns.forEach(btn => btn.addEventListener('click', () => setTheme(btn.dataset.theme)));
            setTheme(localStorage.getItem('esh_theme') || 'navy');

            // ===== MARKET TABS =====
            const marketTabs = document.querySelectorAll('.market-tab');
            const marketContents = {
                forex: document.getElementById('content-forex'),
                crypto: document.getElementById('content-crypto'),
                commodities: document.getElementById('content-commodities')
            };

            function switchMarket(market) {
                marketTabs.forEach(tab => tab.classList.toggle('active', tab.dataset.market === market));
                Object.keys(marketContents).forEach(key => {
                    marketContents[key].classList.toggle('active', key === market);
                });
            }

            marketTabs.forEach(tab => {
                tab.addEventListener('click', () => switchMarket(tab.dataset.market));
            });

            // ===== SEARCH =====
            const searchInput = document.getElementById('searchInput');
            const searchBtn = document.getElementById('searchBtn');

            function performSearch() {
                const query = searchInput.value.trim().toLowerCase();
                if (!query) return;

                const allSymbols = document.querySelectorAll('.price-row .symbol, .card-title');
                let found = false;

                allSymbols.forEach(el => {
                    if (el.textContent.toLowerCase().includes(query)) {
                        el.closest('.card, .price-row')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        el.closest('.card, .price-row')?.style.outline = '2px solid var(--accent)';
                        setTimeout(() => {
                            el.closest('.card, .price-row').style.outline = '';
                        }, 2000);
                        found = true;
                    }
                });

                if (!found) {
                    alert('🔍 No results found for: ' + query);
                }
            }

            searchBtn.addEventListener('click', performSearch);
            searchInput.addEventListener('keypress', e => { if (e.key === 'Enter') performSearch(); });

            // ===== LIVE UPDATES =====
            setInterval(() => {
                const activeContent = document.querySelector('.market-content.active');
                if (!activeContent) return;

                activeContent.querySelectorAll('.price-row span:nth-child(2)').forEach(el => {
                    const current = parseFloat(el.textContent.replace(/[$,€]/g, ''));
                    if (!isNaN(current)) {
                        const change = (Math.random() - 0.48) * 0.2;
                        el.textContent = (current + change).toFixed(4);
                    }
                });
            }, 3000);

            // ===== INIT =====
            switchMarket('forex');
            console.log('%c 🚀 ESH TRADE Explore ', 'background:linear-gradient(135deg,#0b1a2e,#2563eb); color:#fff; font-size:1.2rem; padding:0.8rem 1.5rem; border-radius:8px; font-weight:bold;');
        })();
    </script>

