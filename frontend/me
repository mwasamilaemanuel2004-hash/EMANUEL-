<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1a2e" />
    <title>ESH TRADE · Profile & Settings</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&display=swap"
        rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f0f7ff;
            min-height: 100vh;
            transition: background 0.4s;
            -webkit-font-smoothing: antialiased;
        }

        /* THEMES (6) */
        body {
            --bg-body: #f0f7ff;
            --bg-card: #ffffff;
            --bg-sidebar: #0b1a2e;
            --text-primary: #0b1a2e;
            --text-secondary: #475569;
            --text-sidebar: #94a3b8;
            --border: #dbeafe;
            --accent: #2563eb;
            --accent-light: #dbeafe;
            --accent-hover: #1d4ed8;
            --shadow: 0 4px 24px rgba(37, 99, 235, 0.08);
            --shadow-hover: 0 8px 32px rgba(37, 99, 235, 0.15);
            --positive: #22c55e;
            --negative: #ef4444;
            --warning: #f59e0b;
            --badge-bg: #dbeafe;
            --badge-text: #1e3a8a;
            --gradient-start: #2563eb;
            --gradient-end: #0b1a2e;
        }

        body.theme-charcoal {
            --bg-body: #eef0f2;
            --bg-card: #ffffff;
            --bg-sidebar: #1a1d23;
            --text-primary: #1a1d23;
            --text-secondary: #4b5563;
            --text-sidebar: #9ca3af;
            --border: #d1d5db;
            --accent: #84cc16;
            --accent-light: #e5f4d0;
            --accent-hover: #65a30d;
            --shadow: 0 4px 24px rgba(132, 204, 22, 0.08);
            --badge-bg: #e5f4d0;
            --badge-text: #3f6212;
            --gradient-start: #84cc16;
            --gradient-end: #1a1d23;
        }

        body.theme-emerald {
            --bg-body: #ecfdf5;
            --bg-card: #ffffff;
            --bg-sidebar: #064e3b;
            --text-primary: #064e3b;
            --text-secondary: #065f46;
            --text-sidebar: #6ee7b7;
            --border: #a7f3d0;
            --accent: #059669;
            --accent-light: #d1fae5;
            --accent-hover: #047857;
            --shadow: 0 4px 24px rgba(5, 150, 105, 0.08);
            --badge-bg: #d1fae5;
            --badge-text: #065f46;
            --gradient-start: #059669;
            --gradient-end: #064e3b;
        }

        body.theme-teal {
            --bg-body: #f0fdfa;
            --bg-card: #ffffff;
            --bg-sidebar: #0f3b3b;
            --text-primary: #0f3b3b;
            --text-secondary: #115e59;
            --text-sidebar: #5eead4;
            --border: #99f6e4;
            --accent: #0d9488;
            --accent-light: #ccfbf1;
            --accent-hover: #0f766e;
            --shadow: 0 4px 24px rgba(13, 148, 136, 0.08);
            --badge-bg: #ccfbf1;
            --badge-text: #115e59;
            --positive: #f97316;
            --gradient-start: #0d9488;
            --gradient-end: #0f3b3b;
        }

        body.theme-plum {
            --bg-body: #faf5ff;
            --bg-card: #ffffff;
            --bg-sidebar: #3b1f4a;
            --text-primary: #3b1f4a;
            --text-secondary: #5b21b6;
            --text-sidebar: #c4b5d4;
            --border: #e9d5ff;
            --accent: #8b5cf6;
            --accent-light: #ede9fe;
            --accent-hover: #7c3aed;
            --shadow: 0 4px 24px rgba(139, 92, 246, 0.08);
            --badge-bg: #ede9fe;
            --badge-text: #5b21b6;
            --gradient-start: #8b5cf6;
            --gradient-end: #3b1f4a;
        }

        body.theme-terracotta {
            --bg-body: #fef6f0;
            --bg-card: #ffffff;
            --bg-sidebar: #4a2818;
            --text-primary: #4a2818;
            --text-secondary: #7c2d12;
            --text-sidebar: #fbbf8d;
            --border: #fed7aa;
            --accent: #c2410c;
            --accent-light: #fee2d6;
            --accent-hover: #9a3412;
            --shadow: 0 4px 24px rgba(194, 65, 12, 0.08);
            --badge-bg: #fee2d6;
            --badge-text: #7c2d12;
            --gradient-start: #c2410c;
            --gradient-end: #4a2818;
        }

        /* LAYOUT */
        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 260px;
            background: var(--bg-sidebar);
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            padding: 1.5rem 1rem;
            gap: 1.5rem;
            z-index: 100;
            transition: transform 0.3s, background 0.4s;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: #fff;
            font-size: 1.3rem;
            font-weight: 800;
            padding: 0 0.5rem 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .sidebar-brand i {
            color: var(--accent);
            font-size: 1.5rem;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
        }

        .nav-label {
            font-size: 0.6rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-sidebar);
            opacity: 0.4;
            padding: 0.8rem 0.8rem 0.3rem;
            font-weight: 600;
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 0.7rem 0.8rem;
            border-radius: 12px;
            color: var(--text-sidebar);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.25s;
        }

        .sidebar-nav a:hover {
            background: rgba(255, 255, 255, 0.06);
            color: #fff;
            transform: translateX(4px);
        }

        .sidebar-nav a.active {
            background: var(--accent);
            color: #fff;
        }

        .sidebar-nav a i {
            width: 20px;
            text-align: center;
        }

        /* MAIN */
        .main {
            flex: 1;
            margin-left: 260px;
            padding: 1.5rem;
            transition: margin 0.3s;
        }

        /* HEADER */
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .header h1 {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-primary);
        }

        .header h1 i {
            color: var(--accent);
        }

        .theme-btn {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.25s;
        }

        .theme-btn:hover {
            transform: scale(1.2);
        }

        .theme-btn.active {
            border-color: #fff;
            box-shadow: 0 0 0 2px var(--accent);
        }

        .theme-btn[data-theme="navy"] {
            background: linear-gradient(135deg, #0b1a2e 50%, #2563eb 50%);
        }

        .theme-btn[data-theme="charcoal"] {
            background: linear-gradient(135deg, #1a1d23 50%, #84cc16 50%);
        }

        .theme-btn[data-theme="emerald"] {
            background: linear-gradient(135deg, #064e3b 50%, #059669 50%);
        }

        .theme-btn[data-theme="teal"] {
            background: linear-gradient(135deg, #0f3b3b 50%, #0d9488 50%);
        }

        .theme-btn[data-theme="plum"] {
            background: linear-gradient(135deg, #3b1f4a 50%, #8b5cf6 50%);
        }

        .theme-btn[data-theme="terracotta"] {
            background: linear-gradient(135deg, #4a2818 50%, #c2410c 50%);
        }

        /* PROFILE HEADER */
        .profile-header {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            border-radius: 20px;
            padding: 2rem;
            text-align: center;
            margin-bottom: 1.5rem;
            position: relative;
            overflow: hidden;
        }

        .profile-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
        }

        .profile-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 800;
            margin: 0 auto 1rem;
            border: 3px solid rgba(255, 255, 255, 0.3);
            position: relative;
        }

        .profile-name {
            font-size: 1.5rem;
            font-weight: 800;
            color: #fff;
            position: relative;
        }

        .profile-email {
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.7);
            margin-top: 0.3rem;
            position: relative;
        }

        .profile-badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            padding: 0.2rem 1rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            margin-top: 0.5rem;
            position: relative;
        }

        /* SETTINGS TABS */
        .settings-tabs {
            display: flex;
            gap: 0.3rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            background: var(--bg-card);
            padding: 0.3rem;
            border-radius: 40px;
            border: 1px solid var(--border);
            width: fit-content;
        }

        .settings-tab {
            padding: 0.5rem 1.2rem;
            border-radius: 30px;
            border: none;
            background: transparent;
            color: var(--text-secondary);
            font-weight: 600;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.25s;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .settings-tab.active {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            color: #fff;
        }

        .settings-tab:hover:not(.active) {
            background: var(--bg-body);
        }

        /* SETTINGS CONTENT */
        .settings-content {
            display: none;
            animation: fadeUp 0.35s ease;
        }

        .settings-content.active {
            display: block;
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }

        .card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 1.25rem;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            transition: all 0.25s;
        }

        .card:hover {
            box-shadow: var(--shadow-hover);
        }

        .card-title {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-secondary);
            opacity: 0.5;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .card-title i {
            color: var(--accent);
        }

        /* FORM */
        .form-group {
            margin-bottom: 0.75rem;
        }

        .form-group label {
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--text-secondary);
            display: block;
            margin-bottom: 0.3rem;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 0.6rem;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: var(--bg-body);
            color: var(--text-primary);
            font-family: inherit;
            font-size: 0.85rem;
            outline: none;
            transition: border 0.25s;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: var(--accent);
        }

        .btn {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            color: #fff;
            border: none;
            padding: 0.5rem 1.5rem;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.25s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-hover);
        }

        .btn-danger {
            background: var(--negative);
        }

        .btn-outline {
            background: transparent;
            color: var(--text-primary);
            border: 1px solid var(--border);
        }

        /* TOGGLE */
        .toggle {
            width: 44px;
            height: 24px;
            border-radius: 20px;
            background: var(--border);
            position: relative;
            cursor: pointer;
            transition: all 0.3s;
            border: none;
        }

        .toggle.active {
            background: var(--accent);
        }

        .toggle::after {
            content: '';
            position: absolute;
            top: 2px;
            left: 2px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #fff;
            transition: all 0.3s;
        }

        .toggle.active::after {
            left: 22px;
        }

        .toggle-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.5rem 0;
            border-bottom: 1px solid var(--border);
        }

        .toggle-row:last-child {
            border-bottom: none;
        }

        .toggle-label {
            font-size: 0.85rem;
            color: var(--text-primary);
            font-weight: 500;
        }

        .toggle-desc {
            font-size: 0.7rem;
            color: var(--text-secondary);
            opacity: 0.6;
        }

        /* STATS */
        .stat-item {
            text-align: center;
            padding: 1rem;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--accent);
        }

        .stat-label {
            font-size: 0.7rem;
            color: var(--text-secondary);
            margin-top: 0.2rem;
        }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.mobile-open {
                transform: translateX(0);
            }

            .main {
                margin-left: 0;
                padding: 1rem;
            }

            .grid-2,
            .grid-3 {
                grid-template-columns: 1fr;
            }

            .header h1 {
                font-size: 1.4rem;
            }
        }
    </style>
</head>

<body>

    <div class="layout">
        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand"><i class="fas fa-chart-line"></i> ESH TRADE</div>
            <nav class="sidebar-nav">
                <div class="nav-label">Navigation</div>
                <a href="dashboard.html"><i class="fas fa-home"></i> Dashboard</a>
                <a href="explore.html"><i class="fas fa-compass"></i> Explore</a>
                <a href="inbox.html"><i class="fas fa-inbox"></i> Inbox</a>
                <a href="terminal.html"><i class="fas fa-terminal"></i> Terminal</a>
                <a href="chatbot.html"><i class="fas fa-robot"></i> Chatbot</a>
                <a class="active" href="me.html"><i class="fas fa-user"></i> Profile</a>
            </nav>
        </aside>

        <!-- MAIN -->
        <main class="main">
            <!-- HEADER -->
            <div class="header">
                <h1><i class="fas fa-user-circle"></i> Profile & Settings</h1>
                <div style="display:flex; gap:0.3rem;">
                    <button class="theme-btn active" data-theme="navy"></button>
                    <button class="theme-btn" data-theme="charcoal"></button>
                    <button class="theme-btn" data-theme="emerald"></button>
                    <button class="theme-btn" data-theme="teal"></button>
                    <button class="theme-btn" data-theme="plum"></button>
                    <button class="theme-btn" data-theme="terracotta"></button>
                </div>
            </div>

            <!-- PROFILE HEADER -->
            <div class="profile-header">
                <div class="profile-avatar">N</div>
                <div class="profile-name">Nadia</div>
                <div class="profile-email">estradingmachine@gmail.com</div>
                <div class="profile-badge"><i class="fas fa-crown"></i> Premium Trader</div>
            </div>

            <!-- STATS -->
            <div class="grid-3" style="margin-bottom:1.5rem;">
                <div class="card">
                    <div class="stat-item">
                        <div class="stat-value">$12,304</div>
                        <div class="stat-label">Total Balance</div>
                    </div>
                </div>
                <div class="card">
                    <div class="stat-item">
                        <div class="stat-value">68%</div>
                        <div class="stat-label">Win Rate</div>
                    </div>
                </div>
                <div class="card">
                    <div class="stat-item">
                        <div class="stat-value">34</div>
                        <div class="stat-label">Active Positions</div>
                    </div>
                </div>
            </div>

            <!-- SETTINGS TABS -->
            <div class="settings-tabs">
                <button class="settings-tab active" data-tab="profile"><i class="fas fa-user"></i> Profile</button>
                <button class="settings-tab" data-tab="api"><i class="fas fa-key"></i> API Keys</button>
                <button class="settings-tab" data-tab="security"><i class="fas fa-shield"></i> Security</button>
                <button class="settings-tab" data-tab="trading"><i class="fas fa-chart-line"></i> Trading</button>
                <button class="settings-tab" data-tab="notifications"><i class="fas fa-bell"></i> Notifications</button>
            </div>

            <!-- PROFILE SETTINGS -->
            <div class="settings-content active" id="content-profile">
                <div class="grid-2">
                    <div class="card">
                        <div class="card-title"><i class="fas fa-user-edit"></i> Personal Information</div>
                        <div class="form-group"><label>First Name</label><input type="text" value="Nadia" /></div>
                        <div class="form-group"><label>Last Name</label><input type="text" value=""
                                placeholder="Last name" /></div>
                        <div class="form-group"><label>Email</label><input type="email"
                                value="estradingmachine@gmail.com" /></div>
                        <div class="form-group"><label>Phone</label><input type="tel" placeholder="+255..." /></div>
                        <button class="btn"><i class="fas fa-save"></i> Save Changes</button>
                    </div>
                    <div class="card">
                        <div class="card-title"><i class="fas fa-globe"></i> Preferences</div>
                        <div class="form-group"><label>Language</label><select>
                                <option>English</option>
                                <option>Swahili</option>
                            </select></div>
                        <div class="form-group"><label>Timezone</label><select>
                                <option>Africa/Dar_es_Salaam</option>
                                <option>UTC</option>
                            </select></div>
                        <div class="form-group"><label>Currency</label><select>
                                <option>USD</option>
                                <option>EUR</option>
                                <option>TZS</option>
                            </select></div>
                        <div class="form-group"><label>Theme</label><select id="themeSelect">
