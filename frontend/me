    <script>
        (function () {
            'use strict';

            // ===== THEME =====
            const themeBtns = document.querySelectorAll('.theme-btn');
            const themeSelect = document.getElementById('themeSelect');

            function setTheme(theme) {
                document.body.className = document.body.className
                    .split(' ').filter(c => !c.startsWith('theme-')).join(' ');
                if (theme !== 'navy') document.body.classList.add('theme-' + theme);
                themeBtns.forEach(btn => btn.classList.toggle('active', btn.dataset.theme === theme));
                if (themeSelect) themeSelect.value = theme;
                localStorage.setItem('esh_theme', theme);
            }

            themeBtns.forEach(btn => btn.addEventListener('click', () => setTheme(btn.dataset.theme)));
            if (themeSelect) themeSelect.addEventListener('change', () => setTheme(themeSelect.value));
            setTheme(localStorage.getItem('esh_theme') || 'navy');

            // ===== SETTINGS TABS =====
            const tabs = document.querySelectorAll('.settings-tab');
            const contents = {
                profile: document.getElementById('content-profile'),
                api: document.getElementById('content-api'),
                security: document.getElementById('content-security'),
                trading: document.getElementById('content-trading'),
                notifications: document.getElementById('content-notifications')
            };

            function switchTab(tab) {
                tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
                Object.keys(contents).forEach(key => {
                    contents[key].classList.toggle('active', key === tab);
                });
            }

            tabs.forEach(tab => tab.addEventListener('click', () => switchTab(tab.dataset.tab)));

            // ===== LOGOUT =====
            window.logout = function () {
                if (confirm('Are you sure you want to logout?')) {
                    window.location.href = 'index.html';
                }
            };

            // ===== INIT =====
            switchTab('profile');
            console.log('%c 🚀 ESH TRADE Profile ', 'background:linear-gradient(135deg,#0b1a2e,#2563eb); color:#fff; font-size:1.2rem; padding:0.8rem 1.5rem; border-radius:8px; font-weight:bold;');
        })();
    </script>

