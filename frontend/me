                                <option value="plum">Plum</option>
                                <option value="terracotta">Terracotta</option>
                            </select></div>
                        <button class="btn"><i class="fas fa-save"></i> Save Preferences</button>
                    </div>
                </div>
            </div>

            <!-- API KEYS -->
            <div class="settings-content" id="content-api">
                <div class="card">
                    <div class="card-title"><i class="fas fa-key"></i> Exchange API Keys</div>
                    <div class="toggle-row">
                        <div>
                            <div class="toggle-label">Binance</div>
                            <div class="toggle-desc">Connect your Binance account</div>
                        </div>
                        <button class="btn btn-outline" style="font-size:0.7rem;"><i class="fas fa-plus"></i> Add
                            Key</button>
                    </div>
                    <div class="toggle-row">
                        <div>
                            <div class="toggle-label">Bybit</div>
                            <div class="toggle-desc">Connect your Bybit account</div>
                        </div>
                        <button class="btn btn-outline" style="font-size:0.7rem;"><i class="fas fa-plus"></i> Add
                            Key</button>
                    </div>
                    <div class="toggle-row">
                        <div>
                            <div class="toggle-label">KuCoin</div>
                            <div class="toggle-desc">Connect your KuCoin account</div>
                        </div>
                        <button class="btn btn-outline" style="font-size:0.7rem;"><i class="fas fa-plus"></i> Add
                            Key</button>
                    </div>
                    <div class="toggle-row">
                        <div>
                            <div class="toggle-label">Coinbase</div>
                            <div class="toggle-desc">Connect your Coinbase account</div>
                        </div>
                        <button class="btn btn-outline" style="font-size:0.7rem;"><i class="fas fa-plus"></i> Add
                            Key</button>
                    </div>
                    <div class="toggle-row">
                        <div>
                            <div class="toggle-label">OKX</div>
                            <div class="toggle-desc">Connect your OKX account</div>
                        </div>
                        <button class="btn btn-outline" style="font-size:0.7rem;"><i class="fas fa-plus"></i> Add
                            Key</button>
                    </div>
                </div>
            </div>

            <!-- SECURITY -->
            <div class="settings-content" id="content-security">
                <div class="grid-2">
                    <div class="card">
                        <div class="card-title"><i class="fas fa-shield-halved"></i> Two-Factor Authentication</div>
                        <div class="toggle-row">
                            <div>
                                <div class="toggle-label">TOTP (Google Authenticator)</div>
                                <div class="toggle-desc">Time-based one-time password</div>
                            </div>
                            <button class="toggle active" onclick="this.classList.toggle('active')"></button>
                        </div>
                        <div class="toggle-row">
                            <div>
                                <div class="toggle-label">Email OTP</div>
                                <div class="toggle-desc">One-time password via email</div>
