<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1a2e" />
    <title>ESH TRADE · Inbox & Notifications</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&display=swap" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background: #f0f7ff;
            min-height: 100vh;
            transition: background 0.4s;
            -webkit-font-smoothing: antialiased;
        }

        /* THEMES */
        body {
            --bg-body: #f0f7ff; --bg-card: #ffffff; --bg-sidebar: #0b1a2e;
            --text-primary: #0b1a2e; --text-secondary: #475569; --text-sidebar: #94a3b8;
            --border: #dbeafe; --accent: #2563eb; --accent-light: #dbeafe; --accent-hover: #1d4ed8;
            --shadow: 0 4px 24px rgba(37,99,235,0.08); --shadow-hover: 0 8px 32px rgba(37,99,235,0.15);
            --positive: #22c55e; --negative: #ef4444; --warning: #f59e0b;
            --badge-bg: #dbeafe; --badge-text: #1e3a8a;
            --gradient-start: #2563eb; --gradient-end: #0b1a2e;
        }

        body.theme-charcoal {
            --bg-body: #eef0f2; --bg-card: #ffffff; --bg-sidebar: #1a1d23;
            --text-primary: #1a1d23; --text-secondary: #4b5563; --text-sidebar: #9ca3af;
            --border: #d1d5db; --accent: #84cc16; --accent-light: #e5f4d0; --accent-hover: #65a30d;
            --shadow: 0 4px 24px rgba(132,204,22,0.08); --badge-bg: #e5f4d0; --badge-text: #3f6212;
            --gradient-start: #84cc16; --gradient-end: #1a1d23;
        }

        body.theme-emerald {
            --bg-body: #ecfdf5; --bg-card: #ffffff; --bg-sidebar: #064e3b;
            --text-primary: #064e3b; --text-secondary: #065f46; --text-sidebar: #6ee7b7;
            --border: #a7f3d0; --accent: #059669; --accent-light: #d1fae5; --accent-hover: #047857;
            --shadow: 0 4px 24px rgba(5,150,105,0.08); --badge-bg: #d1fae5; --badge-text: #065f46;
            --gradient-start: #059669; --gradient-end: #064e3b;
        }

        body.theme-teal {
            --bg-body: #f0fdfa; --bg-card: #ffffff; --bg-sidebar: #0f3b3b;
            --text-primary: #0f3b3b; --text-secondary: #115e59; --text-sidebar: #5eead4;
            --border: #99f6e4; --accent: #0d9488; --accent-light: #ccfbf1; --accent-hover: #0f766e;
            --shadow: 0 4px 24px rgba(13,148,136,0.08); --badge-bg: #ccfbf1; --badge-text: #115e59;
            --positive: #f97316; --gradient-start: #0d9488; --gradient-end: #0f3b3b;
        }

        body.theme-plum {
            --bg-body: #faf5ff; --bg-card: #ffffff; --bg-sidebar: #3b1f4a;
            --text-primary: #3b1f4a; --text-secondary: #5b21b6; --text-sidebar: #c4b5d4;
            --border: #e9d5ff; --accent: #8b5cf6; --accent-light: #ede9fe; --accent-hover: #7c3aed;
            --shadow: 0 4px 24px rgba(139,92,246,0.08); --badge-bg: #ede9fe; --badge-text: #5b21b6;
            --gradient-start: #8b5cf6; --gradient-end: #3b1f4a;
        }

        body.theme-terracotta {
            --bg-body: #fef6f0; --bg-card: #ffffff; --bg-sidebar: #4a2818;
            --text-primary: #4a2818; --text-secondary: #7c2d12; --text-sidebar: #fbbf8d;
            --border: #fed7aa; --accent: #c2410c; --accent-light: #fee2d6; --accent-hover: #9a3412;
            --shadow: 0 4px 24px rgba(194,65,12,0.08); --badge-bg: #fee2d6; --badge-text: #7c2d12;
            --gradient-start: #c2410c; --gradient-end: #4a2818;
        }

        /* LAYOUT */
        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 260px;
            background: var(--bg-sidebar);
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            padding: 1.5rem 1rem;
            gap: 1.5rem;
            z-index: 100;
            transition: transform 0.3s, background 0.4s;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: #fff;
            font-size: 1.3rem;
            font-weight: 800;
            padding: 0 0.5rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .sidebar-brand i { color: var(--accent); font-size: 1.5rem; }

        .sidebar-nav { display: flex; flex-direction: column; gap: 0.2rem; }
        .nav-label {
            font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.1em;
            color: var(--text-sidebar); opacity: 0.4; padding: 0.8rem 0.8rem 0.3rem; font-weight: 600;
        }
        .sidebar-nav a {
            display: flex; align-items: center; gap: 0.8rem;
            padding: 0.7rem 0.8rem; border-radius: 12px;
            color: var(--text-sidebar); text-decoration: none;
            font-size: 0.85rem; font-weight: 500; cursor: pointer;
            transition: all 0.25s; position: relative;
        }
        .sidebar-nav a:hover { background: rgba(255,255,255,0.06); color: #fff; transform: translateX(4px); }
        .sidebar-nav a.active { background: var(--accent); color: #fff; }
        .sidebar-nav a i { width: 20px; text-align: center; }
        .sidebar-nav a .badge {
            margin-left: auto; background: var(--accent); color: #fff;
            padding: 0.1rem 0.5rem; border-radius: 10px; font-size: 0.6rem; font-weight: 700;
        }

        /* MAIN */
        .main {
            flex: 1;
            margin-left: 260px;
            padding: 1.5rem;
            transition: margin 0.3s;
        }

        /* HEADER */
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .header h1 {
            font-size: 1.8rem; font-weight: 800; color: var(--text-primary);
            display: flex; align-items: center; gap: 0.7rem;
        }
        .header h1 i { color: var(--accent); }
        .header-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }

        .btn {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            color: #fff; border: none; padding: 0.5rem 1.2rem; border-radius: 40px;
            font-weight: 600; font-size: 0.8rem; cursor: pointer;
            transition: all 0.25s; display: inline-flex; align-items: center; gap: 0.5rem;
        }
        .btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-hover); }
        .btn-outline {
            background: transparent; color: var(--text-primary);
            border: 1px solid var(--border);
        }

        .theme-btn {
            width: 24px; height: 24px; border-radius: 50%;
            border: 2px solid transparent; cursor: pointer; transition: all 0.25s;
        }
        .theme-btn:hover { transform: scale(1.2); }
        .theme-btn.active { border-color: #fff; box-shadow: 0 0 0 2px var(--accent); }
        .theme-btn[data-theme="navy"] { background: linear-gradient(135deg, #0b1a2e 50%, #2563eb 50%); }
        .theme-btn[data-theme="charcoal"] { background: linear-gradient(135deg, #1a1d23 50%, #84cc16 50%); }
        .theme-btn[data-theme="emerald"] { background: linear-gradient(135deg, #064e3b 50%, #059669 50%); }
        .theme-btn[data-theme="teal"] { background: linear-gradient(135deg, #0f3b3b 50%, #0d9488 50%); }
        .theme-btn[data-theme="plum"] { background: linear-gradient(135deg, #3b1f4a 50%, #8b5cf6 50%); }
        .theme-btn[data-theme="terracotta"] { background: linear-gradient(135deg, #4a2818 50%, #c2410c 50%); }

        /* TABS */
        .tabs {
            display: flex; gap: 0.3rem; margin-bottom: 1.5rem; flex-wrap: wrap;
            background: var(--bg-card); padding: 0.3rem; border-radius: 40px;
            border: 1px solid var(--border); width: fit-content;
        }
        .tab {
            padding: 0.5rem 1.2rem; border-radius: 30px; border: none;
            background: transparent; color: var(--text-secondary);
            font-weight: 600; font-size: 0.8rem; cursor: pointer; transition: all 0.25s;
        }
        .tab.active {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            color: #fff;
        }
        .tab:hover:not(.active) { background: var(--bg-body); }

        /* NOTIFICATION LIST */
        .notification-list {
            display: flex; flex-direction: column; gap: 0.5rem;
            max-width: 800px;
        }

        .notification {
            display: flex; align-items: flex-start; gap: 1rem;
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 16px; padding: 1rem 1.2rem;
            cursor: pointer; transition: all 0.25s;
            animation: slideIn 0.3s ease;
        }
        .notification:hover { box-shadow: var(--shadow-hover); transform: translateX(4px); }
        .notification.unread { border-left: 4px solid var(--accent); }

        @keyframes slideIn {
            from { opacity: 0; transform: translateX(-20px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .notification-icon {
            width: 40px; height: 40px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0; font-size: 1rem;
        }
        .notification-icon.trade { background: rgba(37,99,235,0.1); color: #2563eb; }
        .notification-icon.security { background: rgba(239,68,68,0.1); color: #ef4444; }
        .notification-icon.bot { background: rgba(34,197,94,0.1); color: #22c55e; }
        .notification-icon.system { background: rgba(245,158,11,0.1); color: #f59e0b; }
        .notification-icon.alert { background: rgba(139,92,246,0.1); color: #8b5cf6; }

        .notification-content { flex: 1; }
        .notification-title { font-weight: 600; color: var(--text-primary); font-size: 0.9rem; }
        .notification-message { font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.2rem; }
        .notification-time { font-size: 0.65rem; color: var(--text-secondary); opacity: 0.5; margin-top: 0.3rem; }

        .notification-actions { display: flex; gap: 0.3rem; }
        .icon-action {
            width: 30px; height: 30px; border-radius: 50%; border: none;
            background: var(--bg-body); color: var(--text-secondary);
            cursor: pointer; font-size: 0.7rem; transition: all 0.2s;
            display: flex; align-items: center; justify-content: center;
        }
        .icon-action:hover { background: var(--accent); color: #fff; }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.mobile-open { transform: translateX(0); }
            .main { margin-left: 0; padding: 1rem; }
            .header h1 { font-size: 1.4rem; }
        }
    </style>
</head>
<body>

    <div class="layout">
        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand"><i class="fas fa-chart-line"></i> ESH TRADE</div>
            <nav class="sidebar-nav">
                <div class="nav-label">Navigation</div>
                <a href="dashboard.html"><i class="fas fa-home"></i> Dashboard</a>
                <a href="explore.html"><i class="fas fa-compass"></i> Explore</a>
                <a class="active" href="inbox.html"><i class="fas fa-inbox"></i> Inbox <span class="badge">5</span></a>
                <a href="terminal.html"><i class="fas fa-terminal"></i> Terminal</a>
                <a href="chatbot.html"><i class="fas fa-robot"></i> Chatbot</a>
                <a href="me.html"><i class="fas fa-user"></i> Profile</a>
            </nav>
        </aside>

        <!-- MAIN -->
        <main class="main">
            <!-- HEADER -->
            <div class="header">
                <h1><i class="fas fa-inbox"></i> Inbox & Notifications</h1>
                <div class="header-actions">
                    <button class="theme-btn active" data-theme="navy"></button>
                    <button class="theme-btn" data-theme="charcoal"></button>
                    <button class="theme-btn" data-theme="emerald"></button>
                    <button class="theme-btn" data-theme="teal"></button>
                    <button class="theme-btn" data-theme="plum"></button>
                    <button class="theme-btn" data-theme="terracotta"></button>
                    <button class="btn" id="markAllRead"><i class="fas fa-check-double"></i> Mark All Read</button>
                    <button class="btn btn-outline" id="clearAll"><i class="fas fa-trash"></i> Clear All</button>
                </div>
            </div>

            <!-- TABS -->
            <div class="tabs">
                <button class="tab active" data-tab="all">All <span id="countAll">(8)</span></button>
                <button class="tab" data-tab="unread">Unread <span id="countUnread">(5)</span></button>
                <button class="tab" data-tab="trades">Trades</button>
                <button class="tab" data-tab="security">Security</button>
                <button class="tab" data-tab="bots">Bots</button>
            </div>

            <!-- NOTIFICATIONS -->
            <div class="notification-list" id="notificationList">
                <!-- Will be populated by JS -->
            </div>
        </main>
    </div>

    <script>
        (function() {
            'use strict';

            // ===== NOTIFICATIONS DATA =====
            const notifications = [
                {
                    id: 1, type: 'trade', unread: true,
                    icon: 'fa-exchange-alt', iconClass: 'trade',
                    title: 'Trade Executed: BTC/USD',
                    message: 'Buy order filled: 0.5 BTC @ $67,234.50',
                    time: '2 minutes ago'
                },
                {
                    id: 2, type: 'security', unread: true,
                    icon: 'fa-shield-halved', iconClass: 'security',
                    title: 'New Login Detected',
                    message: 'Login from new device: iPhone 15 Pro (Tanzania)',
                    time: '15 minutes ago'
                },
                {
                    id: 3, type: 'bot', unread: true,
                    icon: 'fa-robot', iconClass: 'bot',
                    title: 'Bot Started: Scalper',
                    message: 'Scalper Bot started on EURUSD with $100 capital',
                    time: '1 hour ago'
                },
                {
                    id: 4, type: 'alert', unread: true,
                    icon: 'fa-bell', iconClass: 'alert',
                    title: 'Price Alert: Gold',
                    message: 'Gold reached $2,345.12 (Target: $2,340)',
                    time: '2 hours ago'
                },
                {
                    id: 5, type: 'trade', unread: true,
                    icon: 'fa-chart-line', iconClass: 'trade',
                    title: 'Take Profit Hit: EUR/USD',
                    message: 'Take profit triggered: +$450 profit',
                    time: '3 hours ago'
                },
                {
                    id: 6, type: 'system', unread: false,
                    icon: 'fa-gear', iconClass: 'system',
                    title: 'System Update',
                    message: 'Platform updated to version 4.0.0',
                    time: '5 hours ago'
                },
                {
                    id: 7, type: 'bot', unread: false,
                    icon: 'fa-robot', iconClass: 'bot',
                    title: 'Bot Stopped: Grid',
                    message: 'Grid Bot stopped due to low volatility',
                    time: '8 hours ago'
                },
                {
                    id: 8, type: 'trade', unread: false,
                    icon: 'fa-wallet', iconClass: 'trade',
                    title: 'Deposit Confirmed',
                    message: 'Deposit of $1,000 confirmed',
                    time: '1 day ago'
                }
            ];

            // ===== THEME SWITCHER =====
            const themeBtns = document.querySelectorAll('.theme-btn');
            
            function setTheme(theme) {
                document.body.className = document.body.className
                    .split(' ').filter(c => !c.startsWith('theme-')).join(' ');
                if (theme !== 'navy') document.body.classList.add('theme-' + theme);
                themeBtns.forEach(btn => btn.classList.toggle('active', btn.dataset.theme === theme));
                localStorage.setItem('esh_theme', theme);
            }

            themeBtns.forEach(btn => btn.addEventListener('click', () => setTheme(btn.dataset.theme)));
            setTheme(localStorage.getItem('esh_theme') || 'navy');

            // ===== RENDER NOTIFICATIONS =====
            const notificationList = document.getElementById('notificationList');
            let currentTab = 'all';

            function renderNotifications() {
                let filtered = notifications;
                
                if (currentTab === 'unread') filtered = notifications.filter(n => n.unread);
                else if (currentTab === 'trades') filtered = notifications.filter(n => n.type === 'trade');
                else if (currentTab === 'security') filtered = notifications.filter(n => n.type === 'security');
                else if (currentTab === 'bots') filtered = notifications.filter(n => n.type === 'bot');

                notificationList.innerHTML = '';
                
                if (filtered.length === 0) {
                    notificationList.innerHTML = `
                        <div style="text-align:center; padding:3rem; color:var(--text-secondary);">
                            <i class="fas fa-inbox" style="font-size:3rem; opacity:0.3; margin-bottom:1rem;"></i>
                            <p>No notifications</p>
                        </div>
                    `;
                    return;
                }

                filtered.forEach(n => {
                    const div = document.createElement('div');
                    div.className = 'notification' + (n.unread ? ' unread' : '');
                    div.innerHTML = `
                        <div class="notification-icon ${n.iconClass}"><i class="fas ${n.icon}"></i></div>
                        <div class="notification-content">
                            <div class="notification-title">${n.title}</div>
                            <div class="notification-message">${n.message}</div>
                            <div class="notification-time"><i class="far fa-clock"></i> ${n.time}</div>
                        </div>
                        <div class="notification-actions">
                            <button class="icon-action" onclick="markRead(${n.id})" title="Mark read"><i class="fas fa-check"></i></button>
                            <button class="icon-action" onclick="deleteNotification(${n.id})" title="Delete"><i class="fas fa-trash"></i></button>
                        </div>
                    `;
                    notificationList.appendChild(div);
                });

                updateCounts();
            }

            function updateCounts() {
                document.getElementById('countAll').textContent = `(${notifications.length})`;
                document.getElementById('countUnread').textContent = `(${notifications.filter(n => n.unread).length})`;
            }

            // ===== TAB SWITCHING =====
            const tabs = document.querySelectorAll('.tab');
            tabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    tabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    currentTab = this.dataset.tab;
                    renderNotifications();
                });
            });

            // ===== MARK READ =====
            window.markRead = function(id) {
                const n = notifications.find(x => x.id === id);
                if (n) {
                    n.unread = false;
                    renderNotifications();
                }
            };

            // ===== DELETE =====
            window.deleteNotification = function(id) {
                const index = notifications.findIndex(x => x.id === id);
                if (index > -1) {
                    notifications.splice(index, 1);
                    renderNotifications();
                }
            };

            // ===== MARK ALL READ =====
            document.getElementById('markAllRead').addEventListener('click', function() {
                notifications.forEach(n => n.unread = false);
                renderNotifications();
            });

            // ===== CLEAR ALL =====
            document.getElementById('clearAll').addEventListener('click', function() {
                if (confirm('Clear all notifications?')) {
                    notifications.length = 0;
                    renderNotifications();
                }
            });

            // ===== INIT =====
            renderNotifications();
            console.log('%c 🚀 ESH TRADE Inbox ', 'background:linear-gradient(135deg,#0b1a2e,#2563eb); color:#fff; font-size:1.2rem; padding:0.8rem 1.5rem; border-radius:8px; font-weight:bold;');
        })();
    </script>

</body>
</html>