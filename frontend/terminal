<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1a2e" />
    <title>ESH TRADE · Trading Terminal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
        rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f0f7ff;
            min-height: 100vh;
            transition: background 0.4s;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        /* THEMES (6) */
        body {
            --bg-body: #f0f7ff;
            --bg-card: #ffffff;
            --bg-sidebar: #0b1a2e;
            --text-primary: #0b1a2e;
            --text-secondary: #475569;
            --text-sidebar: #94a3b8;
            --border: #dbeafe;
            --accent: #2563eb;
            --accent-light: #dbeafe;
            --accent-hover: #1d4ed8;
            --shadow: 0 4px 24px rgba(37, 99, 235, 0.08);
            --shadow-hover: 0 8px 32px rgba(37, 99, 235, 0.15);
            --positive: #22c55e;
            --negative: #ef4444;
            --warning: #f59e0b;
            --badge-bg: #dbeafe;
            --badge-text: #1e3a8a;
            --gradient-start: #2563eb;
            --gradient-end: #0b1a2e;
            --terminal-bg: #0a0e17;
            --terminal-text: #22c55e;
            --terminal-header-bg: #111827;
            --terminal-border: #1e293b;
        }

        body.theme-charcoal {
            --bg-body: #eef0f2;
            --bg-card: #ffffff;
            --bg-sidebar: #1a1d23;
            --text-primary: #1a1d23;
            --text-secondary: #4b5563;
            --text-sidebar: #9ca3af;
            --border: #d1d5db;
            --accent: #84cc16;
            --accent-light: #e5f4d0;
            --accent-hover: #65a30d;
            --shadow: 0 4px 24px rgba(132, 204, 22, 0.08);
            --badge-bg: #e5f4d0;
            --badge-text: #3f6212;
            --gradient-start: #84cc16;
            --gradient-end: #1a1d23;
            --terminal-bg: #111111;
            --terminal-text: #84cc16;
        }

        body.theme-emerald {
            --bg-body: #ecfdf5;
            --bg-card: #ffffff;
            --bg-sidebar: #064e3b;
            --text-primary: #064e3b;
            --text-secondary: #065f46;
            --text-sidebar: #6ee7b7;
            --border: #a7f3d0;
            --accent: #059669;
            --accent-light: #d1fae5;
            --accent-hover: #047857;
            --shadow: 0 4px 24px rgba(5, 150, 105, 0.08);
            --badge-bg: #d1fae5;
            --badge-text: #065f46;
            --gradient-start: #059669;
            --gradient-end: #064e3b;
            --terminal-bg: #0a1a14;
            --terminal-text: #059669;
        }

        body.theme-teal {
            --bg-body: #f0fdfa;
            --bg-card: #ffffff;
            --bg-sidebar: #0f3b3b;
            --text-primary: #0f3b3b;
            --text-secondary: #115e59;
            --text-sidebar: #5eead4;
            --border: #99f6e4;
            --accent: #0d9488;
            --accent-light: #ccfbf1;
            --accent-hover: #0f766e;
            --shadow: 0 4px 24px rgba(13, 148, 136, 0.08);
            --badge-bg: #ccfbf1;
            --badge-text: #115e59;
            --positive: #f97316;
            --gradient-start: #0d9488;
            --gradient-end: #0f3b3b;
            --terminal-bg: #0a1a1a;
            --terminal-text: #0d9488;
        }

        body.theme-plum {
            --bg-body: #faf5ff;
            --bg-card: #ffffff;
            --bg-sidebar: #3b1f4a;
            --text-primary: #3b1f4a;
            --text-secondary: #5b21b6;
            --text-sidebar: #c4b5d4;
            --border: #e9d5ff;
            --accent: #8b5cf6;
            --accent-light: #ede9fe;
            --accent-hover: #7c3aed;
            --shadow: 0 4px 24px rgba(139, 92, 246, 0.08);
            --badge-bg: #ede9fe;
            --badge-text: #5b21b6;
            --gradient-start: #8b5cf6;
            --gradient-end: #3b1f4a;
            --terminal-bg: #1a0a1a;
            --terminal-text: #8b5cf6;
        }

        body.theme-terracotta {
            --bg-body: #fef6f0;
            --bg-card: #ffffff;
            --bg-sidebar: #4a2818;
            --text-primary: #4a2818;
            --text-secondary: #7c2d12;
            --text-sidebar: #fbbf8d;
            --border: #fed7aa;
            --accent: #c2410c;
            --accent-light: #fee2d6;
            --accent-hover: #9a3412;
            --shadow: 0 4px 24px rgba(194, 65, 12, 0.08);
            --badge-bg: #fee2d6;
            --badge-text: #7c2d12;
            --gradient-start: #c2410c;
            --gradient-end: #4a2818;
            --terminal-bg: #1a0e0a;
            --terminal-text: #c2410c;
        }

        /* LAYOUT */
        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 260px;
            background: var(--bg-sidebar);
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            padding: 1.5rem 1rem;
            gap: 1.5rem;
            z-index: 100;
            transition: transform 0.3s, background 0.4s;
            overflow-y: auto;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: #fff;
            font-size: 1.3rem;
            font-weight: 800;
            padding: 0 0.5rem 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            text-decoration: none;
        }

        .sidebar-brand i {
            color: var(--accent);
            font-size: 1.5rem;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
        }

        .nav-label {
            font-size: 0.6rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-sidebar);
            opacity: 0.4;
            padding: 0.8rem 0.8rem 0.3rem;
            font-weight: 600;
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 0.7rem 0.8rem;
            border-radius: 12px;
            color: var(--text-sidebar);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.25s;
        }

        .sidebar-nav a:hover {
            background: rgba(255, 255, 255, 0.06);
            color: #fff;
            transform: translateX(4px);
        }

        .sidebar-nav a.active {
            background: var(--accent);
            color: #fff;
        }

        .sidebar-nav a i {
            width: 20px;
            text-align: center;
        }

        /* SIDEBAR OVERLAY */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 95;
            backdrop-filter: blur(4px);
        }

        .sidebar-overlay.active {
            display: block;
        }

        /* MAIN */
        .main {
            flex: 1;
            margin-left: 260px;
            padding: 1rem 1.5rem;
            transition: margin 0.3s;
        }

        /* HEADER */
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .header h1 {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text-primary);
        }

        .header h1 i {
            color: var(--accent);
        }

        .header-right {
            display: flex;
            gap: 0.3rem;
            align-items: center;
        }

        .mobile-toggle {
            display: none;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 0.5rem;
            cursor: pointer;
            font-size: 1.2rem;
            color: var(--text-primary);
        }

        .theme-btn {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.25s;
        }

        .theme-btn:hover {
            transform: scale(1.2);
        }

        .theme-btn.active {
            border-color: #fff;
            box-shadow: 0 0 0 2px var(--accent);
        }

        .theme-btn[data-theme="navy"] {
            background: linear-gradient(135deg, #0b1a2e 50%, #2563eb 50%);
        }

        .theme-btn[data-theme="charcoal"] {
            background: linear-gradient(135deg, #1a1d23 50%, #84cc16 50%);
        }

        .theme-btn[data-theme="emerald"] {
            background: linear-gradient(135deg, #064e3b 50%, #059669 50%);
        }

        .theme-btn[data-theme="teal"] {
            background: linear-gradient(135deg, #0f3b3b 50%, #0d9488 50%);
        }

        .theme-btn[data-theme="plum"] {
            background: linear-gradient(135deg, #3b1f4a 50%, #8b5cf6 50%);
        }

        .theme-btn[data-theme="terracotta"] {
            background: linear-gradient(135deg, #4a2818 50%, #c2410c 50%);
        }

        /* TERMINAL LAYOUT */
        .terminal-layout {
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 1rem;
            height: calc(100vh - 130px);
            min-height: 500px;
        }

        /* TERMINAL WINDOW */
        .terminal-window {
            background: var(--terminal-bg);
            border-radius: 16px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            border: 1px solid var(--terminal-border);
            box-shadow: var(--shadow-hover);
        }

        .terminal-header {
            background: var(--terminal-header-bg);
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border-bottom: 1px solid var(--terminal-border);
        }

        .terminal-dots {
            display: flex;
            gap: 0.3rem;
        }

        .terminal-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.2s;
        }

        .terminal-dot:hover {
            transform: scale(1.3);
        }

        .terminal-dot.red {
            background: #ef4444;
        }

        .terminal-dot.yellow {
            background: #f59e0b;
        }

        .terminal-dot.green {
            background: #22c55e;
        }

        .terminal-title {
            margin-left: 0.5rem;
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.7rem;
            font-weight: 600;
            font-family: 'JetBrains Mono', monospace;
        }

        .terminal-body {
            flex: 1;
            padding: 1rem;
            overflow-y: auto;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.8rem;
            line-height: 1.7;
            color: var(--terminal-text);
        }

        .terminal-body::-webkit-scrollbar {
            width: 6px;
        }

        .terminal-body::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
        }

        .terminal-line {
            margin-bottom: 0.15rem;
            word-wrap: break-word;
            white-space: pre-wrap;
        }

        .terminal-line .prompt {
            color: var(--accent);
            font-weight: 700;
        }

        .terminal-line .command {
            color: #fff;
        }

        .terminal-line .success {
            color: #22c55e;
        }

        .terminal-line .error {
            color: #ef4444;
        }

        .terminal-line .info {
            color: #60a5fa;
        }

        .terminal-line .warning {
            color: #f59e0b;
        }

        .terminal-line .dim {
            opacity: 0.5;
        }

        .terminal-input {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1rem;
            border-top: 1px solid var(--terminal-border);
            background: rgba(255, 255, 255, 0.03);
        }

        .terminal-input .prompt {
            color: var(--accent);
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.9rem;
        }

        .terminal-input input {
            flex: 1;
            background: transparent;
            border: none;
            color: #fff;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.8rem;
            outline: none;
            caret-color: var(--accent);
        }

        .terminal-input input::placeholder {
            color: rgba(255, 255, 255, 0.3);
        }

        /* TRADE PANEL */
        .trade-panel {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 1rem;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            overflow-y: auto;
        }

        .trade-panel-title {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-secondary);
            opacity: 0.5;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .trade-panel-title i {
            color: var(--accent);
        }

        .order-form-group {
            margin-bottom: 0.5rem;
        }

        .order-form-group label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--text-secondary);
            display: block;
            margin-bottom: 0.2rem;
        }

        .order-form-group input,
        .order-form-group select {
            width: 100%;
            padding: 0.5rem;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--bg-body);
            color: var(--text-primary);
            font-family: inherit;
            font-size: 0.8rem;
            outline: none;
            transition: border 0.25s;
        }

        .order-form-group input:focus,
        .order-form-group select:focus {
            border-color: var(--accent);
        }

        .btn {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            color: #fff;
            border: none;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.25s;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-hover);
        }

        .btn-buy {
            background: var(--positive);
        }

        .btn-sell {
            background: var(--negative);
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        /* POSITIONS */
        .position-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.4rem 0;
            border-bottom: 1px solid var(--border);
            font-size: 0.75rem;
        }

        .position-row:last-child {
            border-bottom: none;
        }

        .position-profit {
            color: var(--positive);
            font-weight: 600;
        }

        .position-loss {
            color: var(--negative);
            font-weight: 600;
        }

        /* NOTIFICATION TOAST */
        .toast {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1rem 1.5rem;
            box-shadow: var(--shadow-hover);
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 0.8rem;
            animation: slideUp 0.3s ease;
            font-size: 0.85rem;
            color: var(--text-primary);
            max-width: 350px;
        }

        .toast i {
            font-size: 1.2rem;
        }

        .toast.success i {
            color: var(--positive);
        }

        .toast.error i {
            color: var(--negative);
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* RESPONSIVE */
        @media (max-width: 1024px) {
            .terminal-layout {
                grid-template-columns: 1fr;
                height: auto;
            }

            .terminal-window {
                height: 400px;
            }
        }

        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.mobile-open {
                transform: translateX(0);
            }

            .main {
                margin-left: 0;
                padding: 0.75rem;
            }

            .mobile-toggle {
                display: block;
            }

            .header h1 {
                font-size: 1.2rem;
            }

            .trade-panel {
                max-height: 500px;
            }
        }

        @media (max-width: 400px) {
            .theme-btn {
                width: 20px;
                height: 20px;
            }

            .terminal-body {
                font-size: 0.7rem;
            }

            .order-form-group input,
            .order-form-group select {
                font-size: 0.7rem;
            }
        }
    </style>
</head>

<body>

    <div class="layout">
        <!-- SIDEBAR OVERLAY -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">
            <a href="index.html" class="sidebar-brand"><i class="fas fa-chart-line"></i> ESH TRADE</a>
            <nav class="sidebar-nav">
                <div class="nav-label">Navigation</div>
                <a href="dashboard.html"><i class="fas fa-home"></i> Dashboard</a>
                <a href="explore.html"><i class="fas fa-compass"></i> Explore</a>
                <a href="inbox.html"><i class="fas fa-inbox"></i> Inbox</a>
                <a class="active" href="terminal.html"><i class="fas fa-terminal"></i> Terminal</a>
                <a href="chatbot.html"><i class="fas fa-robot"></i> Chatbot</a>
                <a href="me.html"><i class="fas fa-user"></i> Profile</a>
            </nav>
        </aside>

        <!-- MAIN -->
        <main class="main">
            <!-- HEADER -->
            <div class="header">
                <div class="header-left">
                    <button class="mobile-toggle" id="mobileToggle"><i class="fas fa-bars"></i></button>
                    <h1><i class="fas fa-terminal"></i> Trading Terminal</h1>
                </div>
                <div class="header-right">
                    <button class="theme-btn active" data-theme="navy" title="Navy"></button>
                    <button class="theme-btn" data-theme="charcoal" title="Charcoal"></button>
                    <button class="theme-btn" data-theme="emerald" title="Emerald"></button>
                    <button class="theme-btn" data-theme="teal" title="Teal"></button>
                    <button class="theme-btn" data-theme="plum" title="Plum"></button>
                    <button class="theme-btn" data-theme="terracotta" title="Terracotta"></button>
                </div>
            </div>

            <!-- TERMINAL LAYOUT -->
            <div class="terminal-layout">
                <!-- TERMINAL WINDOW -->
                <div class="terminal-window">
                    <div class="terminal-header">
                        <div class="terminal-dots">
                            <span class="terminal-dot red" onclick="clearTerminal()" title="Clear"></span>
                            <span class="terminal-dot yellow" title="Minimize"></span>
                            <span class="terminal-dot green" title="Maximize"></span>
                        </div>
                        <span class="terminal-title">esh-trade@terminal: ~/trading</span>
                    </div>
                    <div class="terminal-body" id="terminalBody">
                        <div class="terminal-line"><span
                                class="dim">════════════════════════════════════════════════</span></div>
                        <div class="terminal-line"><span class="success">✅ ESH TRADE Terminal v4.0.0</span></div>
                        <div class="terminal-line"><span class="info">ℹ️ Type 'help' for available commands</span></div>
                        <div class="terminal-line"><span
                                class="dim">════════════════════════════════════════════════</span></div>
                        <div class="terminal-line"></div>
                    </div>
                    <div class="terminal-input">
                        <span class="prompt">➜</span>
                        <input type="text" id="terminalInput" placeholder="Type command..." autofocus
                            autocomplete="off" />
                    </div>
                </div>

                <!-- TRADE PANEL -->
                <div class="trade-panel">
                    <div class="trade-panel-title"><i class="fas fa-exchange-alt"></i> Quick Trade</div>

                    <div class="order-form-group">
                        <label>Symbol</label>
                        <select id="tradeSymbol">
                            <option value="EURUSD">EURUSD - Euro/US Dollar</option>
                            <option value="GBPUSD">GBPUSD - Pound/US Dollar</option>
                            <option value="USDJPY">USDJPY - Dollar/Japanese Yen</option>
                            <option value="BTCUSD">BTCUSD - Bitcoin</option>
                            <option value="ETHUSD">ETHUSD - Ethereum</option>
                            <option value="XAUUSD">XAUUSD - Gold</option>
                        </select>
                    </div>

                    <div class="order-form-group">
                        <label>Order Type</label>
                        <select id="orderType">
                            <option value="market">Market</option>
                            <option value="limit">Limit</option>
                            <option value="stop">Stop</option>
                        </select>
                    </div>

                    <div class="order-form-group">
                        <label>Quantity</label>
                        <input type="number" id="tradeQty" value="0.01" min="0.001" step="0.001" />
                    </div>

                    <div class="order-form-group">
                        <label>Leverage</label>
                        <select id="tradeLeverage">
                            <option value="1">1x</option>
                            <option value="5">5x</option>
                            <option value="10" selected>10x</option>
                            <option value="20">20x</option>
                            <option value="50">50x</option>
                            <option value="100">100x</option>
                        </select>
                    </div>

                    <div class="order-form-group">
                        <label>Stop Loss (Optional)</label>
                        <input type="number" id="stopLoss" placeholder="SL price" step="any" />
                    </div>

                    <div class="order-form-group">
                        <label>Take Profit (Optional)</label>
                        <input type="number" id="takeProfit" placeholder="TP price" step="any" />
                    </div>

                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.5rem; margin-top:0.5rem;">
                        <button class="btn btn-buy" id="btnBuy" onclick="executeTrade('buy')">
                            <i class="fas fa-arrow-up"></i> BUY
                        </button>
                        <button class="btn btn-sell" id="btnSell" onclick="executeTrade('sell')">
                            <i class="fas fa-arrow-down"></i> SELL
                        </button>
                    </div>

                    <div class="trade-panel-title" style="margin-top:1.5rem;">
                        <i class="fas fa-briefcase"></i> Open Positions <span id="positionCount"
                            style="margin-left:auto;">(3)</span>
                    </div>
                    <div id="positionsList">
                        <div class="position-row" data-position="EURUSD"><span>💱 EURUSD</span><span
                                class="position-profit">+$450</span></div>
                        <div class="position-row" data-position="BTCUSD"><span>₿ BTCUSD</span><span
                                class="position-profit">+$1,230</span></div>
                        <div class="position-row" data-position="XAUUSD"><span>🥇 XAUUSD</span><span
                                class="position-loss">-$87</span></div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        (function () {
            'use strict';

            // ===== DOM ELEMENTS =====
            const themeBtns = document.querySelectorAll('.theme-btn');
            const terminalBody = document.getElementById('terminalBody');
            const terminalInput = document.getElementById('terminalInput');
            const mobileToggle = document.getElementById('mobileToggle');
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const positionsList = document.getElementById('positionsList');
            const positionCount = document.getElementById('positionCount');
            const btnBuy = document.getElementById('btnBuy');
            const btnSell = document.getElementById('btnSell');

            // ===== THEME - FIXED =====
            function setTheme(theme) {
                document.body.className = document.body.className
                    .split(' ').filter(c => !c.startsWith('theme-')).join(' ');
                if (theme !== 'navy') document.body.classList.add('theme-' + theme);
                themeBtns.forEach(btn => btn.classList.toggle('active', btn.dataset.theme === theme));
                localStorage.setItem('esh_theme', theme);
            }

            themeBtns.forEach(btn => btn.addEventListener('click', () => setTheme(btn.dataset.theme)));
            setTheme(localStorage.getItem('esh_theme') || 'navy');

            // ===== MOBILE MENU - FIXED =====
            function openMobileMenu() {
                sidebar.classList.add('mobile-open');
                sidebarOverlay.classList.add('active');
            }

            function closeMobileMenu() {
                sidebar.classList.remove('mobile-open');
                sidebarOverlay.classList.remove('active');
            }

            mobileToggle.addEventListener('click', function () {
                if (sidebar.classList.contains('mobile-open')) {
                    closeMobileMenu();
                } else {
                    openMobileMenu();
                }
            });

            sidebarOverlay.addEventListener('click', closeMobileMenu);

            // ===== TERMINAL - FIXED =====
            const commands = {
                help: {
                    text: [
                        'Available commands:',
                        '  help                    - Show this help',
                        '  status                  - System status',
                        '  balance                 - Show balance',
                        '  price [symbol]          - Get price (e.g., price BTCUSD)',
                        '  bot [start/stop]        - Bot control',
                        '  trade [buy/sell] [sym]  - Place trade',
                        '  positions               - Show open positions',
                        '  clear                   - Clear terminal',
                        '  exit                    - Exit terminal'
                    ].join('\n'),
                    type: 'info'
                },
                status: { text: '✅ System: ONLINE | Bots: 5 Running | Uptime: 72h 15m', type: 'success' },
                balance: { text: '💰 Available: $8,450.00 | Locked: $2,340.00 | Total: $12,304.00', type: 'success' },
                positions: { text: '', type: 'info' },
                clear: { text: '__CLEAR__', type: '' },
                exit: { text: '👋 Goodbye!', type: 'error' }
            };

            function addLine(text, type) {
                const div = document.createElement('div');
                div.className = 'terminal-line';
                if (type) div.innerHTML = `<span class="${type}">${escapeHtml(text)}</span>`;
                else div.innerHTML = escapeHtml(text);
                terminalBody.appendChild(div);
                terminalBody.scrollTop = terminalBody.scrollHeight;
            }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            function getPositionsFromDOM() {
                const positions = [];
                document.querySelectorAll('.position-row').forEach(row => {
                    positions.push(row.dataset.position || 'Unknown');
                });
                return positions;
            }

            function executeCommand(cmd) {
                addLine(`<span class="prompt">➜</span> <span class="command">${escapeHtml(cmd)}</span>`, '');

                const parts = cmd.toLowerCase().trim().split(/\s+/);
                const main = parts[0];

                if (main === 'help') {
                    addLine(commands.help.text, 'info');
                } else if (main === 'status') {
                    addLine(commands.status.text, 'success');
                } else if (main === 'balance') {
                    addLine(commands.balance.text, 'success');
                } else if (main === 'price') {
                    const symbol = (parts[1] || 'BTCUSD').toUpperCase();
                    const basePrice = symbol.includes('USD') ? 50000 : 1.08;
                    const price = (Math.random() * 50000 + 1000).toFixed(symbol.includes('USDJPY') ? 2 : 4);
                    addLine(`📊 ${symbol}: $${price}`, 'info');
                } else if (main === 'bot') {
                    const action = parts[1] || 'status';
                    if (action === 'start') {
                        addLine('✅ Bot started successfully', 'success');
                    } else if (action === 'stop') {
                        addLine('⚠️ Bot stopped', 'warning');
                    } else {
                        addLine('🤖 Bots: Scalper(Running), DCA(Running), Grid(Stopped)', 'info');
                    }
                } else if (main === 'trade') {
                    const side = parts[1] || 'buy';
                    const symbol = (parts[2] || 'EURUSD').toUpperCase();
                    if (side === 'buy' || side === 'sell') {
                        addLine(`🔄 ${side.toUpperCase()} ${symbol} order placed`, 'warning');
                        addPositionToDOM(symbol, side);
                    } else {
                        addLine('❌ Usage: trade [buy/sell] [symbol]', 'error');
                    }
                } else if (main === 'positions') {
                    const positions = getPositionsFromDOM();
                    if (positions.length === 0) {
                        addLine('No open positions', 'dim');
                    } else {
                        positions.forEach(p => addLine(`📌 ${p}`, 'info'));
                    }
                } else if (main === 'clear') {
                    terminalBody.innerHTML = '';
                } else if (main === 'exit') {
                    addLine(commands.exit.text, 'error');
                    setTimeout(() => window.location.href = 'dashboard.html', 1000);
                } else if (main === '') {
                    // ignore empty
                } else {
                    addLine(`❌ Command not found: ${cmd}. Type 'help' for commands`, 'error');
                }
            }

            function addPositionToDOM(symbol, side) {
                const div = document.createElement('div');
                div.className = 'position-row';
                div.dataset.position = symbol;
                const pnl = (Math.random() * 100 - 30).toFixed(2);
                div.innerHTML = `<span>📌 ${symbol}</span><span class="${pnl >= 0 ? 'position-profit' : 'position-loss'}">${pnl >= 0 ? '+' : ''}$${pnl}</span>`;
                positionsList.appendChild(div);
                updatePositionCount();
            }

            function updatePositionCount() {
                const count = positionsList.querySelectorAll('.position-row').length;
                positionCount.textContent = `(${count})`;
            }

            window.clearTerminal = function () {
                terminalBody.innerHTML = '';
                addLine('Terminal cleared', 'dim');
            };

            terminalInput.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    const cmd = this.value.trim();
                    if (cmd) executeCommand(cmd);
                    this.value = '';
                }
            });

            // ===== TRADE EXECUTION - FIXED =====
            window.executeTrade = function (side) {
                const symbol = document.getElementById('tradeSymbol').value;
                const orderType = document.getElementById('orderType').value;
                const qty = parseFloat(document.getElementById('tradeQty').value) || 0.01;
                const leverage = document.getElementById('tradeLeverage').value;
                const sl = document.getElementById('stopLoss').value;
                const tp = document.getElementById('takeProfit').value;

                // Validate
                if (qty <= 0) {
                    showToast('❌ Invalid quantity', 'error');
                    return;
                }

                // Disable buttons temporarily
                btnBuy.disabled = true;
                btnSell.disabled = true;

                const tradeLine = `🔄 ${side.toUpperCase()} ${symbol} | Type: ${orderType} | Qty: ${qty} | Lev: ${leverage}x | SL: ${sl || 'N/A'} | TP: ${tp || 'N/A'}`;

                // Add to terminal
                addLine(tradeLine, side === 'buy' ? 'success' : 'error');

                // Add to positions
                addPositionToDOM(symbol, side);

                // Show toast
                showToast(`🎯 ${side.toUpperCase()} ${symbol} order placed!`, 'success');

                // Re-enable buttons
                setTimeout(() => {
                    btnBuy.disabled = false;
                    btnSell.disabled = false;
                }, 500);
            };

            // ===== TOAST NOTIFICATION =====
            function showToast(message, type) {
                const toast = document.createElement('div');
                toast.className = 'toast ' + type;
                toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i> ${message}`;
                document.body.appendChild(toast);

                setTimeout(() => {
                    toast.style.opacity = '0';
                    toast.style.transition = 'opacity 0.3s';
                    setTimeout(() => toast.remove(), 300);
                }, 3000);
            }

            // ===== INIT =====
            updatePositionCount();
            addLine('ℹ️  Type "help" to get started', 'dim');
            terminalInput.focus();

            console.log('%c 🚀 ESH TRADE Terminal ', 'background:linear-gradient(135deg,#0b1a2e,#2563eb); color:#fff; font-size:1.2rem; padding:0.8rem 1.5rem; border-radius:8px; font-weight:bold;');
        })();
    </script>

</body>

</html>