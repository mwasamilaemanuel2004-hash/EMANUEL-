        <div class="modal">
            <div class="modal-header">
                <div class="modal-title" id="modalTitle">Configure Bot</div>
                <button class="modal-close" onclick="closeModal()"><i class="fas fa-times"></i></button>
            </div>
            <div id="modalContent"></div>
        </div>
    </div>

    <script>
        (function() {
            'use strict';

            // ===== THEME =====
            const themeBtns = document.querySelectorAll('.theme-btn');
            function setTheme(theme) {
                document.body.className = document.body.className.split(' ').filter(c => !c.startsWith('theme-')).join(' ');
                if (theme !== 'navy') document.body.classList.add('theme-' + theme);
                themeBtns.forEach(btn => btn.classList.toggle('active', btn.dataset.theme === theme));
                localStorage.setItem('esh_theme', theme);
            }
            themeBtns.forEach(btn => btn.addEventListener('click', function() { setTheme(this.dataset.theme); }));
            setTheme(localStorage.getItem('esh_theme') || 'navy');

            // ===== PAGE SWITCHER =====
            const navLinks = document.querySelectorAll('.bottom-nav a');
            const pages = {
                home: document.getElementById('page-home'),
                bot: document.getElementById('page-bot'),
                trade: document.getElementById('page-trade'),
                chart: document.getElementById('page-chart'),
                chat: document.getElementById('page-chat')
            };
            function switchPage(page) {
                if (!pages[page]) return;
                navLinks.forEach(l => l.classList.toggle('active', l.dataset.page === page));
                Object.keys(pages).forEach(k => pages[k].classList.toggle('active', k === page));
            }
            navLinks.forEach(l => l.addEventListener('click', function() { switchPage(this.dataset.page); }));

            // ===== MARKET SWITCHER =====
            const marketLinks = document.querySelectorAll('.sidebar-nav a[data-market]');
            const marketNames = { forex: 'Forex Market', crypto: 'Crypto Market', commodities: 'Commodities Market' };
            marketLinks.forEach(l => l.addEventListener('click', function() {
                marketLinks.forEach(x => x.classList.remove('active'));
                this.classList.add('active');
                document.getElementById('marketName').textContent = marketNames[this.dataset.market];
                closeMobile();
            }));

            // ===== MOBILE =====
            const menuToggle = document.getElementById('menuToggle');
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            function closeMobile() { sidebar.classList.remove('mobile-open'); overlay.classList.remove('active'); }
            menuToggle.addEventListener('click', function() {
                if (sidebar.classList.contains('mobile-open')) closeMobile();
                else { sidebar.classList.add('mobile-open'); overlay.classList.add('active'); }
            });
            overlay.addEventListener('click', closeMobile);

            // ===== MODAL SYSTEM =====
            const modalOverlay = document.getElementById('modalOverlay');
            const modalTitle = document.getElementById('modalTitle');
            const modalContent = document.getElementById('modalContent');

            window.closeModal = function() { modalOverlay.classList.remove('active'); };
            modalOverlay.addEventListener('click', function(e) { if (e.target === modalOverlay) closeModal(); });

            // ===== BOT ACTIONS =====
            window.startBot = function(btn) {
                const card = btn.closest('.bot-card');
                const badge = card?.querySelector('.badge');
                if (badge) { badge.textContent = '● Running'; badge.style.background = 'rgba(34,197,94,0.1)'; badge.style.color = '#22c55e'; }
                btn.innerHTML = '<i class="fas fa-stop"></i> Stop';
                btn.className = 'btn btn-stop';
                btn.setAttribute('onclick', 'stopBot(this)');
                showToast('✅ Bot started successfully', 'success');
            };

            window.stopBot = function(btn) {
                const card = btn.closest('.bot-card');
                const badge = card?.querySelector('.badge');
                if (badge) { badge.textContent = '● Stopped'; badge.style.background = 'rgba(239,68,68,0.1)'; badge.style.color = '#ef4444'; }
                btn.innerHTML = '<i class="fas fa-play"></i> Start';
                btn.className = 'btn btn-start';
                btn.setAttribute('onclick', 'startBot(this)');
                showToast('⚠️ Bot stopped', 'error');
            };

            window.configBot = function(botName) {
                modalTitle.textContent = '⚙️ Configure ' + botName;
                modalContent.innerHTML = `
                    <div class="modal-form-group"><label>Symbol/Pair</label><select><option>EURUSD</option><option>GBPUSD</option><option>BTCUSD</option><option>XAUUSD</option></select></div>
                    <div class="modal-form-group"><label>Capital Amount ($)</label><input type="number" value="100" min="5" /></div>
                    <div class="modal-form-group"><label>Risk Level</label><select><option>Low</option><option>Medium</option><option>High</option></select></div>
                    <div class="modal-form-group"><label>Max Position Size (%)</label><input type="number" value="10" min="1" max="50" /></div>
                    <div class="modal-form-group"><label>Stop Loss (%)</label><input type="number" value="2" min="0.5" max="20" /></div>
                    <div class="modal-form-group"><label>Take Profit (%)</label><input type="number" value="4" min="1" max="50" /></div>
                    <div class="modal-form-group"><label>Update Interval</label><select><option>1 second</option><option>5 seconds</option><option>30 seconds</option><option>1 minute</option></select></div>
                    <button class="btn" style="width:100%; justify-content:center; margin-top:0.5rem;" onclick="saveBotConfig('${botName}')"><i class="fas fa-save"></i> Save Configuration</button>
                `;
                modalOverlay.classList.add('active');
            };

            window.saveBotConfig = function(botName) {
                closeModal();
                showToast('✅ ' + botName + ' configured successfully', 'success');
            };

            window.viewBotDetails = function(botName) {
                modalTitle.textContent = '🤖 ' + botName + ' Details';
                modalContent.innerHTML = `
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; font-size:0.8rem;">
                        <div class="card" style="padding:0.75rem; text-align:center;"><div style="font-size:1.2rem; font-weight:800; color:var(--positive);">+$450</div><div style="color:var(--text-secondary); font-size:0.65rem;">Today</div></div>
                        <div class="card" style="padding:0.75rem; text-align:center;"><div style="font-size:1.2rem; font-weight:800; color:var(--positive);">+$2,300</div><div style="color:var(--text-secondary); font-size:0.65rem;">This Week</div></div>
                        <div class="card" style="padding:0.75rem; text-align:center;"><div style="font-size:1.2rem; font-weight:800; color:var(--positive);">+$8,500</div><div style="color:var(--text-secondary); font-size:0.65rem;">This Month</div></div>
                        <div class="card" style="padding:0.75rem; text-align:center;"><div style="font-size:1.2rem; font-weight:800; color:var(--accent);">72%</div><div style="color:var(--text-secondary); font-size:0.65rem;">Win Rate</div></div>
                    </div>
                    <div style="margin-top:1rem; font-size:0.75rem; color:var(--text-secondary);">
                        <div class="flex" style="justify-content:space-between; padding:0.3rem 0; border-bottom:1px solid var(--border);"><span>Total Trades:</span><span style="font-weight:600; color:var(--text-primary);">1,234</span></div>
                        <div class="flex" style="justify-content:space-between; padding:0.3rem 0; border-bottom:1px solid var(--border);"><span>Avg Profit:</span><span style="font-weight:600; color:var(--text-primary);">$12.50</span></div>
                        <div class="flex" style="justify-content:space-between; padding:0.3rem 0; border-bottom:1px solid var(--border);"><span>Max Drawdown:</span><span style="font-weight:600; color:var(--negative);">-$450</span></div>
                        <div class="flex" style="justify-content:space-between; padding:0.3rem 0;"><span>Running Time:</span><span style="font-weight:600; color:var(--text-primary);">45 days</span></div>
                    </div>
                    <button class="btn" style="width:100%; justify-content:center; margin-top:1rem;" onclick="closeModal()"><i class="fas fa-check"></i> Close</button>
                `;
                modalOverlay.classList.add('active');
            };

            // ===== TOAST =====
            function showToast(message, type) {
                const toast = document.createElement('div');
                toast.style.cssText = `
                    position: fixed; bottom: 80px; right: 20px; z-index: 300;
                    background: var(--bg-card); border: 1px solid var(--border);
                    border-radius: 12px; padding: 0.8rem 1.2rem;
                    box-shadow: var(--shadow-hover); font-size: 0.8rem;
                    color: var(--text-primary); display: flex; align-items: center; gap: 0.6rem;
                    animation: fadeUp 0.3s ease;
                `;
                toast.innerHTML = '<i class="fas ' + (type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle') + '" style="color:' + (type === 'success' ? 'var(--positive)' : 'var(--negative)') + ';"></i> ' + message;
                document.body.appendChild(toast);
                setTimeout(function() { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.3s'; setTimeout(function() { toast.remove(); }, 300); }, 3000);
            }

            // ===== CHAT =====
            const chatInput = document.getElementById('chatInput');
            const chatSend = document.getElementById('chatSend');
            const chatMessages = document.getElementById('chatMessages');
            function addMessage(text, sender) {
                const div = document.createElement('div');
                div.className = 'message ' + sender;
                div.textContent = text;
                chatMessages.appendChild(div);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
            function sendChat() {
                const text = chatInput.value.trim();
                if (!text) return;
                addMessage(text, 'user');
                chatInput.value = '';
                setTimeout(function() {
                    const responses = [
                        '📊 EUR/USD shows bullish momentum. Consider buying.',
                        '🤖 Scalper Bot profit: +$450 today.',
                        '📈 BTC approaching $68,000 resistance.',
                        '💡 Diversify across all 3 markets.',
                        '🔔 Gold reached $2,345, up 1.2%.'
                    ];
                    addMessage(responses[Math.floor(Math.random() * responses.length)], 'ai');
                }, 800);
            }
            chatSend.addEventListener('click', sendChat);
            chatInput.addEventListener('keypress', function(e) { if (e.key === 'Enter') sendChat(); });

            // ===== LIVE TICKER =====
            setInterval(function() {
                document.getElementById('tickerBTC').textContent = '$' + (Math.random() * 1000 + 67000).toFixed(0);
                document.getElementById('tickerETH').textContent = '$' + (Math.random() * 100 + 3400).toFixed(0);
                document.getElementById('tickerEUR').textContent = (Math.random() * 0.01 + 1.08).toFixed(4);
                document.getElementById('tickerGold').textContent = '$' + (Math.random() * 10 + 2340).toFixed(0);
                document.getElementById('tickerOil').textContent = '$' + (Math.random() * 2 + 82).toFixed(2);
            }, 3000);

            // ===== INIT =====
            switchPage('home');
            console.log('%c 🚀 ESH TRADE Dashboard v3.0 ', 'background:linear-gradient(135deg,#0b1a2e,#2563eb); color:#fff; font-size:1.2rem; padding:0.8rem 1.5rem; border-radius:8px; font-weight:bold;');
        })();
    </script>
