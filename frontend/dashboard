<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1a2e" />
    <meta name="description" content="ESH TRADE - Advanced Trading Dashboard" />
    <title>ESH TRADE · Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&display=swap" rel="stylesheet" />
    <style>
        /* ============ ROOT VARIABLES ============ */
        :root {
            --sidebar-width: 260px;
            --bottom-nav-height: 65px;
            --transition: 0.3s ease;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: #f0f7ff;
            min-height: 100vh;
            transition: background 0.4s;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        /* ============ THEMES (6) ============ */
        body {
            --bg-body: #f0f7ff; --bg-card: #ffffff; --bg-sidebar: #0b1a2e;
            --text-primary: #0b1a2e; --text-secondary: #475569; --text-sidebar: #94a3b8;
            --border: #dbeafe; --accent: #2563eb; --accent-light: #dbeafe; --accent-hover: #1d4ed8;
            --shadow: 0 4px 24px rgba(37,99,235,0.08); --shadow-hover: 0 8px 32px rgba(37,99,235,0.15);
            --positive: #22c55e; --negative: #ef4444; --warning: #f59e0b;
            --badge-bg: #dbeafe; --badge-text: #1e3a8a;
            --gradient-start: #2563eb; --gradient-end: #0b1a2e;
        }
        body.theme-charcoal {
            --bg-body: #eef0f2; --bg-card: #ffffff; --bg-sidebar: #1a1d23;
            --text-primary: #1a1d23; --text-secondary: #4b5563; --text-sidebar: #9ca3af;
            --border: #d1d5db; --accent: #84cc16; --accent-light: #e5f4d0; --accent-hover: #65a30d;
            --shadow: 0 4px 24px rgba(132,204,22,0.08); --badge-bg: #e5f4d0; --badge-text: #3f6212;
            --gradient-start: #84cc16; --gradient-end: #1a1d23;
        }
        body.theme-emerald {
            --bg-body: #ecfdf5; --bg-card: #ffffff; --bg-sidebar: #064e3b;
            --text-primary: #064e3b; --text-secondary: #065f46; --text-sidebar: #6ee7b7;
            --border: #a7f3d0; --accent: #059669; --accent-light: #d1fae5; --accent-hover: #047857;
            --shadow: 0 4px 24px rgba(5,150,105,0.08); --badge-bg: #d1fae5; --badge-text: #065f46;
            --gradient-start: #059669; --gradient-end: #064e3b;
        }
        body.theme-teal {
            --bg-body: #f0fdfa; --bg-card: #ffffff; --bg-sidebar: #0f3b3b;
            --text-primary: #0f3b3b; --text-secondary: #115e59; --text-sidebar: #5eead4;
            --border: #99f6e4; --accent: #0d9488; --accent-light: #ccfbf1; --accent-hover: #0f766e;
            --shadow: 0 4px 24px rgba(13,148,136,0.08); --badge-bg: #ccfbf1; --badge-text: #115e59;
            --positive: #f97316; --gradient-start: #0d9488; --gradient-end: #0f3b3b;
        }
        body.theme-plum {
            --bg-body: #faf5ff; --bg-card: #ffffff; --bg-sidebar: #3b1f4a;
            --text-primary: #3b1f4a; --text-secondary: #5b21b6; --text-sidebar: #c4b5d4;
            --border: #e9d5ff; --accent: #8b5cf6; --accent-light: #ede9fe; --accent-hover: #7c3aed;
            --shadow: 0 4px 24px rgba(139,92,246,0.08); --badge-bg: #ede9fe; --badge-text: #5b21b6;
            --gradient-start: #8b5cf6; --gradient-end: #3b1f4a;
        }
        body.theme-terracotta {
            --bg-body: #fef6f0; --bg-card: #ffffff; --bg-sidebar: #4a2818;
            --text-primary: #4a2818; --text-secondary: #7c2d12; --text-sidebar: #fbbf8d;
            --border: #fed7aa; --accent: #c2410c; --accent-light: #fee2d6; --accent-hover: #9a3412;
            --shadow: 0 4px 24px rgba(194,65,12,0.08); --badge-bg: #fee2d6; --badge-text: #7c2d12;
            --gradient-start: #c2410c; --gradient-end: #4a2818;
        }

        /* ============ LAYOUT ============ */
        .layout { display: flex; min-height: 100vh; }

        /* ============ SIDEBAR ============ */
        .sidebar {
            width: var(--sidebar-width); background: var(--bg-sidebar);
            position: fixed; top: 0; left: 0; bottom: 0;
            display: flex; flex-direction: column; padding: 1.5rem 1rem; gap: 1.2rem;
            z-index: 100; transition: transform 0.3s, background 0.4s; overflow-y: auto;
        }
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 2px; }
        .sidebar-brand {
            display: flex; align-items: center; gap: 0.6rem;
            color: #fff; font-size: 1.3rem; font-weight: 800;
            padding: 0 0.5rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.08);
            text-decoration: none; flex-shrink: 0;
        }
        .sidebar-brand i { color: var(--accent); font-size: 1.5rem; }
        .sidebar-brand span {
            background: linear-gradient(135deg, #fff 60%, var(--accent));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .sidebar-nav { display: flex; flex-direction: column; gap: 0.2rem; flex: 1; }
        .nav-label {
            font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.1em;
            color: var(--text-sidebar); opacity: 0.4; padding: 0.8rem 0.8rem 0.3rem; font-weight: 600;
        }
        .sidebar-nav a {
            display: flex; align-items: center; gap: 0.8rem;
            padding: 0.7rem 0.8rem; border-radius: 12px;
            color: var(--text-sidebar); text-decoration: none;
            font-size: 0.85rem; font-weight: 500; cursor: pointer; transition: all 0.25s; position: relative;
        }
        .sidebar-nav a:hover { background: rgba(255,255,255,0.06); color: #fff; transform: translateX(4px); }
        .sidebar-nav a.active { background: var(--accent); color: #fff; box-shadow: 0 4px 16px rgba(0,0,0,0.2); }
        .sidebar-nav a i { width: 20px; text-align: center; }
        .sidebar-nav a .badge {
            margin-left: auto; background: rgba(255,255,255,0.15);
            padding: 0.1rem 0.5rem; border-radius: 10px; font-size: 0.6rem;
        }
        .sidebar-overlay {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,0.5); z-index: 95; backdrop-filter: blur(4px);
        }
        .sidebar-overlay.active { display: block; }

        /* ============ MAIN ============ */
        .main { flex: 1; margin-left: var(--sidebar-width); padding: 0.75rem 1rem; transition: margin 0.3s; }

        /* ============ TOPBAR ============ */
        .topbar {
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: wrap; gap: 0.8rem; padding: 0.5rem 0; margin-bottom: 0.8rem;
            position: sticky; top: 0; z-index: 50;
            background: var(--bg-body); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
        }
        .topbar-left { display: flex; align-items: center; gap: 0.8rem; }
        .topbar-left h2 { font-size: 1.2rem; color: var(--text-primary); font-weight: 700; }
        .topbar-left h2 span { color: var(--accent); }
        .topbar-left p { font-size: 0.75rem; color: var(--text-secondary); opacity: 0.7; }
        .topbar-right { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
        .icon-btn {
            width: 36px; height: 36px; border-radius: 50%;
            background: var(--bg-card); border: 1px solid var(--border);
            color: var(--text-primary); display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: all 0.25s; position: relative; font-size: 0.85rem;
        }
        .icon-btn:hover { background: var(--accent); color: #fff; transform: translateY(-2px); box-shadow: var(--shadow-hover); }
        .icon-btn .dot {
            position: absolute; top: 5px; right: 5px; width: 7px; height: 7px;
            background: var(--negative); border-radius: 50%; border: 2px solid var(--bg-card); animation: pulse 2s infinite;
        }
        @keyframes pulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.3)} }
        .user-profile {
            display: flex; align-items: center; gap: 0.5rem;
            padding: 0.2rem 0.7rem 0.2rem 0.2rem;
            background: var(--bg-card); border-radius: 40px;
            border: 1px solid var(--border); cursor: pointer; transition: all 0.25s;
        }
        .user-profile:hover { box-shadow: var(--shadow-hover); }
        .user-profile .avatar {
            width: 30px; height: 30px; border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-hover));
            color: #fff; display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 0.7rem;
        }
        .user-profile .name { font-size: 0.75rem; font-weight: 600; color: var(--text-primary); }
        .user-profile .role { font-size: 0.6rem; color: var(--text-secondary); opacity: 0.6; }
        .theme-btn {
            width: 22px; height: 22px; border-radius: 50%;
            border: 2px solid transparent; cursor: pointer; transition: all 0.25s;
        }
        .theme-btn:hover { transform: scale(1.2); }
        .theme-btn.active { border-color: #fff; box-shadow: 0 0 0 2px var(--accent); }
        .theme-btn[data-theme="navy"] { background: linear-gradient(135deg, #0b1a2e 50%, #2563eb 50%); }
        .theme-btn[data-theme="charcoal"] { background: linear-gradient(135deg, #1a1d23 50%, #84cc16 50%); }
        .theme-btn[data-theme="emerald"] { background: linear-gradient(135deg, #064e3b 50%, #059669 50%); }
        .theme-btn[data-theme="teal"] { background: linear-gradient(135deg, #0f3b3b 50%, #0d9488 50%); }
        .theme-btn[data-theme="plum"] { background: linear-gradient(135deg, #3b1f4a 50%, #8b5cf6 50%); }
        .theme-btn[data-theme="terracotta"] { background: linear-gradient(135deg, #4a2818 50%, #c2410c 50%); }

        /* ============ TICKER ============ */
        .ticker {
            display: flex; gap: 1.2rem; overflow-x: auto; padding: 0.5rem 1rem;
            margin-bottom: 0.75rem; white-space: nowrap;
            background: var(--bg-card); border-radius: 12px;
            border: 1px solid var(--border); scrollbar-width: none;
        }
        .ticker::-webkit-scrollbar { display: none; }
        .ticker-item { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; font-weight: 600; color: var(--text-primary); }
        .ticker-item .up { color: var(--positive); }
        .ticker-item .down { color: var(--negative); }

        /* ============ BOTTOM NAV ============ */
        .bottom-nav {
            position: fixed; bottom: 0; left: var(--sidebar-width); right: 0;
            height: var(--bottom-nav-height); background: var(--bg-card);
            border-top: 1px solid var(--border);
            display: flex; align-items: center; justify-content: space-around;
            z-index: 90; box-shadow: 0 -4px 20px rgba(0,0,0,0.05);
            transition: left 0.3s; padding: 0 0.5rem;
        }
        .bottom-nav a {
            display: flex; flex-direction: column; align-items: center; gap: 0.15rem;
            color: var(--text-secondary); text-decoration: none;
            font-size: 0.6rem; font-weight: 500; padding: 0.4rem 0.8rem;
            border-radius: 16px; transition: all 0.25s; cursor: pointer; position: relative;
        }
        .bottom-nav a i { font-size: 1.1rem; transition: all 0.25s; }
        .bottom-nav a:hover { color: var(--accent); }
        .bottom-nav a.active { color: var(--accent); }
        .bottom-nav a.active::before {
            content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
            width: 25px; height: 3px; background: var(--accent); border-radius: 0 0 4px 4px;
        }
        .bottom-nav a.active i { transform: translateY(-2px); }

        /* ============ PAGES ============ */
        .page { display: none; animation: fadeUp 0.35s ease; }
        .page.active { display: block; padding-bottom: calc(var(--bottom-nav-height) + 1rem); }
        @keyframes fadeUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

        /* ============ GRIDS & CARDS ============ */
        .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-bottom: 0.75rem; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-bottom: 0.75rem; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem; }
        .card {
            background: var(--bg-card); border-radius: 16px; padding: 1rem;
            border: 1px solid var(--border); box-shadow: var(--shadow); transition: all 0.25s;
        }
        .card:hover { box-shadow: var(--shadow-hover); }
        .card-title {
            font-size: 0.65rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.06em; color: var(--text-secondary); opacity: 0.5;
            margin-bottom: 0.6rem; display: flex; align-items: center; gap: 0.5rem;
        }
        .card-title i { color: var(--accent); }
        .stat-card {
            background: var(--bg-card); border-radius: 14px; padding: 0.9rem 1rem;
            border: 1px solid var(--border); box-shadow: var(--shadow);
            transition: all 0.25s; position: relative; overflow: hidden;
        }
        .stat-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, var(--gradient-start), var(--gradient-end)); opacity: 0.6;
        }
        .stat-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); }
        .stat-card .label { font-size: 0.65rem; color: var(--text-secondary); opacity: 0.6; text-transform: uppercase; letter-spacing: 0.04em; }
        .stat-card .value { font-size: 1.4rem; font-weight: 800; color: var(--text-primary); margin: 0.15rem 0; }
        .stat-card .change { font-size: 0.65rem; font-weight: 600; }
        .stat-card .change.up { color: var(--positive); }
        .stat-card .change.down { color: var(--negative); }
        .price-row {
            display: flex; justify-content: space-between; align-items: center;
            padding: 0.4rem 0; border-bottom: 1px solid var(--border); font-size: 0.8rem;
        }
        .price-row:last-child { border-bottom: none; }
        .price-row .symbol { font-weight: 600; color: var(--text-primary); }
        .price-row .change { font-weight: 600; padding: 0.1rem 0.5rem; border-radius: 12px; font-size: 0.7rem; }
        .price-row .change.up { color: var(--positive); background: rgba(34,197,94,0.08); }
        .price-row .change.down { color: var(--negative); background: rgba(239,68,68,0.08); }
        .btn {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            color: #fff; border: none; padding: 0.45rem 1.2rem; border-radius: 30px;
            font-weight: 600; font-size: 0.7rem; cursor: pointer;
            transition: all 0.25s; display: inline-flex; align-items: center; gap: 0.4rem;
        }
        .btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-hover); }
        .badge {
            background: var(--badge-bg); color: var(--badge-text);
            padding: 0.1rem 0.6rem; border-radius: 14px; font-size: 0.6rem; font-weight: 600;
            display: inline-flex; align-items: center; gap: 0.2rem;
        }

        /* ============ BOT CARDS ============ */
        .bot-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
        .bot-card {
            background: var(--bg-card); border-radius: 16px; padding: 1rem;
            border: 1px solid var(--border); box-shadow: var(--shadow);
            transition: all 0.25s; cursor: pointer; position: relative;
        }
        .bot-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); }
        .bot-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
            border-radius: 16px 16px 0 0;
            background: linear-gradient(90deg, var(--gradient-start), var(--gradient-end));
            opacity: 0.4;
        }
        .bot-header { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.5rem; padding-top: 0.3rem; }
        .bot-icon {
            width: 40px; height: 40px; border-radius: 12px;
            background: var(--accent-light); color: var(--accent);
            display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
            flex-shrink: 0;
        }
        .bot-name { font-weight: 700; color: var(--text-primary); font-size: 0.85rem; }
        .bot-desc { font-size: 0.7rem; color: var(--text-secondary); margin-bottom: 0.5rem; line-height: 1.5; }
        .bot-stats { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
        .bot-actions { display: flex; gap: 0.4rem; flex-wrap: wrap; }
        .btn-start { background: var(--positive); }
        .btn-stop { background: var(--negative); }
        .btn-config { background: var(--bg-body); color: var(--text-primary); border: 1px solid var(--border); }

        /* ============ MODAL ============ */
        .modal-overlay {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,0.6); z-index: 200;
            backdrop-filter: blur(6px);
            align-items: center; justify-content: center;
        }
        .modal-overlay.active { display: flex; }
        .modal {
            background: var(--bg-card); border-radius: 20px; padding: 1.5rem;
            max-width: 500px; width: 90%; max-height: 80vh; overflow-y: auto;
            border: 1px solid var(--border); box-shadow: var(--shadow-hover);
            animation: modalIn 0.3s ease;
        }
        @keyframes modalIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
        .modal-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 1rem;
        }
        .modal-title { font-size: 1rem; font-weight: 700; color: var(--text-primary); }
        .modal-close {
            width: 30px; height: 30px; border-radius: 50%;
            border: none; background: var(--bg-body); cursor: pointer;
            font-size: 0.9rem; color: var(--text-secondary);
            display: flex; align-items: center; justify-content: center;
            transition: all 0.2s;
        }
        .modal-close:hover { background: var(--negative); color: #fff; }
        .modal-form-group { margin-bottom: 0.6rem; }
        .modal-form-group label { font-size: 0.7rem; font-weight: 600; color: var(--text-secondary); display: block; margin-bottom: 0.2rem; }
        .modal-form-group input, .modal-form-group select {
            width: 100%; padding: 0.55rem; border-radius: 10px;
            border: 1px solid var(--border); background: var(--bg-body);
            color: var(--text-primary); font-family: inherit; font-size: 0.8rem;
            outline: none; transition: border 0.25s;
        }
        .modal-form-group input:focus, .modal-form-group select:focus { border-color: var(--accent); }

        /* ============ ORDER FORM ============ */
        .order-form input, .order-form select {
            width: 100%; padding: 0.5rem; border-radius: 8px;
            border: 1px solid var(--border); background: var(--bg-body);
            color: var(--text-primary); font-family: inherit; font-size: 0.75rem;
            margin-bottom: 0.4rem; outline: none; transition: border 0.25s;
        }
        .order-form input:focus, .order-form select:focus { border-color: var(--accent); }
        .btn-buy { background: var(--positive); width: 100%; border-radius: 8px; }
        .btn-sell { background: var(--negative); width: 100%; border-radius: 8px; }

        /* ============ CHAT ============ */
        .chat-container { display: flex; flex-direction: column; height: 350px; }
        .chat-messages { flex: 1; overflow-y: auto; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.6rem; }
        .message { max-width: 75%; padding: 0.6rem 0.9rem; border-radius: 14px; font-size: 0.75rem; word-wrap: break-word; }
        .message.user { background: var(--accent); color: #fff; align-self: flex-end; border-bottom-right-radius: 4px; }
        .message.ai { background: var(--bg-body); color: var(--text-primary); align-self: flex-start; border: 1px solid var(--border); border-bottom-left-radius: 4px; }
        .chat-input { display: flex; gap: 0.4rem; padding: 0.5rem; border-top: 1px solid var(--border); }
        .chat-input input {
            flex: 1; padding: 0.5rem 0.8rem; border-radius: 20px;
            border: 1px solid var(--border); font-size: 0.75rem; outline: none; font-family: inherit;
        }

        /* ============ RESPONSIVE ============ */
        @media (max-width: 1024px) {
            .grid-4 { grid-template-columns: 1fr 1fr; }
            .bot-grid { grid-template-columns: 1fr; }
        }
        @media (max-width: 768px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.mobile-open { transform: translateX(0); box-shadow: 0 0 40px rgba(0,0,0,0.3); }
            .main { margin-left: 0; padding: 0.5rem; }
            .bottom-nav { left: 0; }
            .grid-3, .grid-2 { grid-template-columns: 1fr; }
            .topbar-left h2 { font-size: 1rem; }
        }
        @media (max-width: 500px) {
            .grid-4 { grid-template-columns: 1fr; }
            .user-profile .name, .user-profile .role { display: none; }
        }
    </style>
</head>
